+}
+
+void nsWindow::OnSizeChanged(const IntSize& aSize) {
+  // 通知合成器客户端尺寸变化
+  if (mWidgetListener) {
+    mWidgetListener->SizeModeChanged(mSizeMode);
+  }
+}
+
+//*****************************************************************************
+// 静态方法
+//*****************************************************************************
+
+nsWindow* nsWindow::TopWindow() {
+  if (!sActiveWindows || sActiveWindows->IsEmpty()) {
+    return nullptr;
+  }
+  return sActiveWindows->ElementAt(sActiveWindows->Length() - 1);
+}
+
+already_AddRefed<nsWindow> nsWindow::From(nsIWidget* aWidget) {
+  if (!aWidget) {
+    return nullptr;
+  }
+  RefPtr<nsWindow> window = static_cast<nsWindow*>(aWidget);
+  return window.forget();
+}
+
+void nsWindow::InitEvent(WidgetGUIEvent& event, LayoutDeviceIntPoint* aPoint) {
+  if (aPoint) {
+    event.mRefPoint = *aPoint - WidgetToScreenOffset();
+  } else {
+    event.mRefPoint = LayoutDeviceIntPoint(0, 0) - WidgetToScreenOffset();
+  }
+}
