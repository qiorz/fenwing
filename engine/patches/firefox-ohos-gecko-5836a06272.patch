+                 sAppData.version ? sAppData.version : "(null)",
+                 sAppData.ID ? sAppData.ID : "(null)",
+                 sAppData.buildID ? sAppData.buildID : "(null)",
+                 sAppData.minVersion ? sAppData.minVersion : "(null)",
