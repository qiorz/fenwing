+//*****************************************************************************
+// 合成器
+//*****************************************************************************
+
+WindowRenderer* nsWindow::GetWindowRenderer() {
+  // v40 诊断:确认 GetWindowRenderer 是否被调用,以及 OMTC 状态
+  OHOS_DiagLog("[XRE] nsWindow::GetWindowRenderer this=%p type=%d mBounds=%dx%d "
+          "mWindowRenderer=%p",
+          (void*)this, (int)mWindowType,
+          mBounds.Width(), mBounds.Height(), (void*)mWindowRenderer);
+  if (!mWindowRenderer) {
+    // v45 根本修复:mBounds=0x0 会导致 CreateCompositor 以 0x0 初始化 WebRender,
+    // 页面内容无法渲染(黑屏)。根因有两种:
+    //   1. Gecko 创建了多个 nsWindow 实例,Create 时设置正确尺寸的那个被丢弃,
+    //      GetWindowRenderer 在另一个 0x0 实例上调用
+    //   2. 同一实例的 mBounds 在 Create 后被某处重置为 0x0
+    // 无论哪种根因,根本修复都是:发现 mBounds=0x0 时,主动从 XComponent 获取
+    // 表面尺寸并设置 mBounds,确保 compositor 以正确尺寸初始化。
+    // 这不是"打补丁",而是修复 OHOS 平台 widget 尺寸链路不完整的根本缺陷:
+    // Gecko 默认假设 widget 尺寸由窗口管理器在 Create 时注入,但 OHOS 的
+    // XComponent 尺寸通过 GeckoBridge_SetSurfaceSize 单独注入,部分 widget
+    // 实例可能错过尺寸注入,必须在此处补齐。
+    // v123 根因修复(≡ 菜单白面板满屏):
+    // 此处 0x0→全屏 Surface 补齐原来对所有 widget 类型生效,popup 在 layout 驱动
+    // Resize 到位之前 GetWindowRenderer 被调用时 mBounds 暂为 0x0 → 被强行设成
+    // 整个 Surface 尺寸。popup 之后委托给 TopLevel compositor 渲染,但其 view 的
+    // widget 层矩形已变成全屏,WR 合成时 popup 的透明/背景区域铺满整个 surface,
+    // 菜单内容只画在左上角(自身坐标 0,0)= 用户看到的"白面板满屏+左上角菜单"。
+    // 与 Create(:172)/Resize(:320) 一致,补齐仅对 TopLevel/Dialog 生效;
+    // popup/child 的 0x0 是 layout 尚未赋尺寸的正常中间态,不应被暴力放大,
+    // 它们走下面的"委托给 TopLevel compositor"路径,尺寸由 layout 正确驱动。
+    if ((mWindowType == WindowType::TopLevel ||
+         mWindowType == WindowType::Dialog) &&
+        (mBounds.Width() <= 1 || mBounds.Height() <= 1)) {
+      int surfaceW = 0, surfaceH = 0;
+      OHOS_GetSurfaceSize(&surfaceW, &surfaceH);
+      if (surfaceW > 1 && surfaceH > 1) {
+        OHOS_DiagLog("[XRE] nsWindow::GetWindowRenderer this=%p type=%d mBounds=%dx%d "
+                "过小,从 XComponent 补齐尺寸=%dx%d",
+                (void*)this, (int)mWindowType, mBounds.Width(), mBounds.Height(),
+                surfaceW, surfaceH);
+        mBounds.SetWidth(surfaceW);
+        mBounds.SetHeight(surfaceH);
+      } else {
+        OHOS_DiagLog("[XRE] nsWindow::GetWindowRenderer this=%p type=%d 警告:XComponent "
+                "表面尺寸未就绪(%dx%d),使用默认 1080x1920",
+                (void*)this, (int)mWindowType, surfaceW, surfaceH);
+        mBounds.SetWidth(1080);
+        mBounds.SetHeight(1920);
+      }
+    } else if (mWindowType == WindowType::Popup) {
+      // popup 不补齐尺寸(保持 layout 给定的值,即使是 0x0 也不放大)。
+      // v128 根因修复(≡ 菜单白面板满屏 + 乒乓闪烁卡死):
+      //   v123 曾把 popup 委托给 TopLevel 的 WebRenderLayerManager(WRLM),
+      //   期望"覆盖式合成"。但实际机制(WebRenderLayerManager.cpp:343-504):
+      //   popup 是独立 display root(view/nsViewManager.cpp:213-229,
+      //   IsMenuPopupFrame 即为 display root,与有无 widget 无关),其 PresShell
+      //   EndTransaction → WR SetDisplayList 是【替换式】而非合并式——
+      //   用菜单内容整体替换 TopLevel 根场景。又因被委托 WRLM 的 mWidget 仍是
+      //   TopLevel,EndTransactionWithoutLayer 用 TopLevel 的 GetClientSize
+      //   (整窗 2090x1394)构建场景:菜单画在自身坐标 (0,0),其余清成白色 →
+      //   白面板满屏 + 左上角菜单。之后主文档 PresShell 检测区域被破坏重绘
+      //   替换回来 → popup 又重绘……两 PresShell 互相 invalidate 乒乓 ~500ms
+      //   = 用户看到的"菜单全屏化 + 反复闪烁卡死"。
+      //   路径 A(widgetless popup)经代码证据证伪:popup frame 由 IsMenuPopupFrame
+      //   判定恒为独立 display root(layout/base/nsLayoutUtils.cpp:6755-6767
+      //   GetDisplayRootFrame / layout/xul/nsMenuPopupFrame.cpp:176 无条件
+      //   AddStateBits(NS_FRAME_IN_POPUP)),无 widget 时 PaintAndRequestComposite
+      //   (PresShell.cpp:6668 aView->GetWidget()->GetWindowRenderer) 取不到
+      //   widget,内容不会被父 display root 绘制。
+      //   正确修复:popup 不再委托 TopLevel WRLM,而是走自身独立 WRLM(下方
+      //   nsBaseWidget::GetWindowRenderer 创建,WindowKind::SECONDARY,
+      //   见 WebRenderLayerManager.cpp:78-83)。这样 popup 的 EndTransaction
+      //   进入自己的 pipeline,不再【替换】TopLevel 根场景,主页面场景保持
+      //   不变 → 无白面板、无乒乓、无冻结(回归 v111 验证过的"残留小面板不闪"
+      //   行为)。popup 内容仍受 OHOS 单 EGL Surface 架构限制不能精确锚定
+      //   渲染(残留面板),但这是单 Surface 平台限制,不再卡死。
+      OHOS_DiagLog("[XRE_POPUP] GetWindowRenderer this=%p mBounds=(%d,%d %dx%d) "
+              "不补齐尺寸,popup 走自身独立 WRLM(不委托 TopLevel,v128 修复)",
+              (void*)this, mBounds.X(), mBounds.Y(),
+              mBounds.Width(), mBounds.Height());
+    }
+
+    // OHOS 根本修复:子 widget(content browser 的 widget)的 mBounds 可能为 0x0
+    // (layout 尚未完成时 GetWindowRenderer 被调用)。如果在此 widget 上创建
+    // compositor,CreateCompositor 收到 0x0,导致 WebRender 以 0x0 初始化,
+    // 页面内容无法渲染(黑屏)。
+    // 根本修复:子 widget(Child 类型,非 popup)不创建自己的 compositor,委托给
+    // TopLevel 窗口的 compositor(所有 content 共享 TopLevel 的 compositor)。
+    // v128: popup 显式排除——popup 委托会导致其 EndTransaction 替换主场景
+    // (见上方 v128 注释)。仅 Child 类型保留委托(content browser 内嵌 widget)。
+    if (mWindowType != WindowType::TopLevel &&
+        mWindowType != WindowType::Dialog &&
+        mWindowType != WindowType::Popup) {
+      nsWindow* topLevel = static_cast<nsWindow*>(GetTopLevelWidget());
+      if (topLevel && topLevel != this) {
+        // Child widget 共享 TopLevel 的 compositor(OHOS 单 EGL Surface)。
+        OHOS_DiagLog("[XRE] nsWindow::GetWindowRenderer Child 委托 TopLevel "
+                "this=%p type=%d mBounds=(%d,%d %dx%d) topLevel=%p",
+                (void*)this, (int)mWindowType, mBounds.X(), mBounds.Y(),
+                mBounds.Width(), mBounds.Height(), (void*)topLevel);
+        return topLevel->GetWindowRenderer();
+      }
+    }
+    bool useOMTC = ShouldUseOffMainThreadCompositing();
+    NSWINDOW_LOG("GetWindowRenderer: ShouldUseOMTC=%{public}d", useOMTC ? 1 : 0);
+    WindowRenderer* result = nsBaseWidget::GetWindowRenderer();
+    NSWINDOW_LOG("GetWindowRenderer: 返回 result=%{public}p", (void*)result);
+    return result;
+  }
+  return mWindowRenderer;
+}
