+  return sGen;
+}
+// v268: 点锚坐标(右键菜单按下点,LayoutDevice px = surface px 屏幕坐标系,
+// 与锚点元素 GetScreenRect 换算路径同空间)。gHasPointAnchor 消费一次即清。
+int32_t gPointAnchorX = 0;
+int32_t gPointAnchorY = 0;
+bool gHasPointAnchor = false;
+
+// pref 名:运行时开关,控制是否拦截 XUL 菜单改走原生浮层。
+// 默认 false(P0 安全默认:不改变现有 XUL 菜单行为,直至真机验证序列化/坐标/命令无误)。
+// 启用方式:user.js 写 ohos.menu.native_overlay=true。
+// 为何默认 false:本桥无法在 P0 阶段真机验证;拦截 menulist/appMenu 的状态机副作用
+// (PanelUI/menulist open 态)未完全闭环,默认关闭保证可构建且无回归。
+constexpr const char* kPrefNativeOverlay = "ohos.menu.native_overlay";
+
+// JSON 字符串转义:把 nsAString 转为合法 JSON 字符串字面量内容(不含外层引号)。
+// 处理 " / \ / 控制字符(\b \f \n \r \t / \uXXXX)。
+std::string JsonEscape(const nsAString& aIn) {
+  std::string out;
+  out.reserve(aIn.Length());
+  const char16_t* p = aIn.BeginReading();
+  const char16_t* end = aIn.EndReading();
+  for (; p < end; ++p) {
+    char16_t c = *p;
+    switch (c) {
+      case '"': out += "\\\""; break;
+      case '\\': out += "\\\\"; break;
+      case '\b': out += "\\b"; break;
+      case '\f': out += "\\f"; break;
+      case '\n': out += "\\n"; break;
+      case '\r': out += "\\r"; break;
+      case '\t': out += "\\t"; break;
+      default:
+        if (c < 0x20) {
+          char buf[8];
+          snprintf(buf, sizeof(buf), "\\u%04x", c);
+          out += buf;
+        } else {
+          // 简化: BMP 内字符原样写出(UTF-16 → UTF-8 近似,ASCII 直接,非 ASCII 用码点)。
+          if (c < 0x80) {
+            out += (char)c;
+          } else {
+            // 非 ASCII:输出 \uXXXX 保证 JSON 合法且 ArkTS JSON.parse 可还原。
+            char buf[8];
+            snprintf(buf, sizeof(buf), "\\u%04x", c);
+            out += buf;
+          }
+        }
+        break;
+    }
+  }
+  return out;
+}
+
+void AppendJsonString(std::string& aOut, const nsAString& aIn) {
+  aOut += '"';
+  aOut += JsonEscape(aIn);
+  aOut += '"';
+}
+
+// 读取元素字符串属性;缺失返回空串。
+void GetAttrValue(dom::Element* aEl, nsAtom* aName, nsString& aOut) {
+  aOut.Truncate();
+  if (aEl) {
+    aEl->GetAttr(kNameSpaceID_None, aName, aOut);
+  }
+}
+
+// 元素是否被 hidden/collapsed 属性隐藏。
+bool IsHiddenEl(dom::Element* aEl) {
+  if (!aEl) return true;
+  if (aEl->HasAttr(kNameSpaceID_None, nsGkAtoms::hidden)) return true;
+  if (aEl->HasAttr(kNameSpaceID_None, nsGkAtoms::collapsed)) return true;
+  return false;
+}
+
+// 元素是否禁用(XUL disabled 属性,或其 command 属性引用的 <command> 元素
+// 的 disabled —— goUpdateCommand 把命令禁用态写到 command 元素,按钮经
+// 广播联动;序列化快照直接读源头,避免原生菜单出现可点但实际禁用的项)。
+bool IsDisabledEl(dom::Element* aEl) {
+  if (!aEl) return false;
+  nsString v;
+  if (aEl->GetAttr(kNameSpaceID_None, nsGkAtoms::disabled, v) &&
+      !v.EqualsLiteral("false")) {
+    return true;
+  }
+  nsString cmdId;
+  aEl->GetAttr(kNameSpaceID_None, nsGkAtoms::command, cmdId);
+  if (!cmdId.IsEmpty()) {
+    if (dom::Document* doc = aEl->GetComposedDoc()) {
+      if (mozilla::dom::Element* cmdEl = doc->GetElementById(cmdId)) {
+        nsString cv;
+        if (cmdEl->GetAttr(kNameSpaceID_None, nsGkAtoms::disabled, cv) &&
+            !cv.EqualsLiteral("false")) {
+          return true;
+        }
+      }
+    }
+  }
+  return false;
+}
+
+// 元素是否 checked(XUL checked="true")。
+bool IsCheckedEl(dom::Element* aEl) {
+  if (!aEl) return false;
+  nsString v;
+  aEl->GetAttr(kNameSpaceID_None, nsGkAtoms::checked, v);
+  return v.EqualsLiteral("true");
+}
+
+// 元素分类角色。
+enum class MenuRole { Separator, Item, Submenu, Container, Skip };
+
+MenuRole GetMenuRole(dom::Element* aEl) {
+  if (!aEl) return MenuRole::Skip;
+  if (aEl->NodeInfo()->Equals(nsGkAtoms::menuseparator, kNameSpaceID_XUL)) {
+    return MenuRole::Separator;
+  }
+  if (aEl->NodeInfo()->Equals(nsGkAtoms::menu, kNameSpaceID_XUL)) {
+    return MenuRole::Submenu;
+  }
+  if (aEl->NodeInfo()->Equals(nsGkAtoms::menuitem, kNameSpaceID_XUL)) {
+    return MenuRole::Item;
+  }
+  if (aEl->NodeInfo()->Equals(nsGkAtoms::toolbarbutton, kNameSpaceID_XUL) ||
+      aEl->NodeInfo()->Equals(nsGkAtoms::button, kNameSpaceID_XUL)) {
+    // toolbarbutton:有 label 视为可执行项;无 label 但含子 toolbarbutton 视为容器。
+    nsString lbl;
+    aEl->GetAttr(kNameSpaceID_None, nsGkAtoms::label, lbl);
+    if (lbl.Length() > 0) {
+      return MenuRole::Item;
+    }
+    return MenuRole::Container;
+  }
+  // 容器:递归向下找可操作子项
+  // v155: mozilla 142 StaticAtoms 已删 vbox/arrowscrollbox 原子(XUL 原子大裁撤),
+  // 这两个连同 panelview/panelmultiview 走下方 tag 名字符串宽松判断。
+  if (aEl->NodeInfo()->Equals(nsGkAtoms::menupopup, kNameSpaceID_XUL) ||
+      aEl->NodeInfo()->Equals(nsGkAtoms::hbox, kNameSpaceID_XUL) ||
+      aEl->NodeInfo()->Equals(nsGkAtoms::box, kNameSpaceID_XUL) ||
+      aEl->NodeInfo()->Equals(nsGkAtoms::toolbaritem, kNameSpaceID_XUL)) {
+    return MenuRole::Container;
+  }
+  // panelview / panelmultiview / html 元素:用 tag 名宽松判断
+  nsAutoString tag;
+  aEl->NodeInfo()->GetName(tag);
+  if (tag.EqualsLiteral("panelview") || tag.EqualsLiteral("panelmultiview") ||
+      tag.EqualsLiteral("div") || tag.EqualsLiteral("vbox")) {
+    return MenuRole::Container;
+  }
+  return MenuRole::Skip;
+}
+
+// 查找 menu 元素的子 menupopup(子菜单内容)。无则 nullptr。
+dom::Element* FindChildMenupopup(dom::Element* aMenu) {
+  for (nsIContent* c = aMenu->GetFirstChild(); c; c = c->GetNextSibling()) {
+    if (c->IsElement() &&
+        c->NodeInfo()->Equals(nsGkAtoms::menupopup, kNameSpaceID_XUL)) {
+      return c->AsElement();
+    }
+  }
+  return nullptr;
+}
+
+// ============================================================================
+// v166:appMenu 二级菜单(subviewbutton-nav → 原生 submenu 飞出)
+//
+// 书签/历史/更多工具/帮助等导航按钮(subviewbutton-nav,无 command 属性)在 XUL
+// 里点击后由 PanelUI/CustomizableWidgets JS 打开目标 panelview 子视图;原生菜单
+// 拦截后该 JS 链路不会执行(主视图 active 态不成立,showSubView 早退),点击无响应。
+// 改为序列化期直接把目标视图的静态内容嵌进 submenu.items(ArkTS 系统
+// SIDE_EXPAND 原生飞出)。运行时动态填充的列表(最近书签/最近历史等)自然为空,
+// 不影响静态项(管理书签/清除历史/空态文案等)。
+//
+// 视图可达性:冷态视图在 <template> content 片段内,走片段递归遍历查找
+// (getElementById 不可见);用过一次后挂在 template 元素下,getElementById
+// 直接命中。片段内视图不经 Fluent(预翻译路径 RSS 爆炸,见 browser-init.js
+// v164/v166 注释),文本由 appmenu-viewcache.inc.xhtml 烤入的静态 label 提供。
+// ============================================================================
+
+// 前置声明(互相递归)。
+bool ElementHasId(dom::Element* aEl, const nsString& aViewId);
+dom::Element* FindViewByIdInSubtree(dom::Element* aRoot, const nsString& aViewId);
+
+// nav 按钮 id → 目标 panelview id(与 panelUI.js onCommand / CustomizableWidgets
+// handleEvent 的运行时映射一致)。空串表示运行时动作型(无视图)。
+struct NavViewMapEntry {
+  const char16_t* mBtnId;
+  const char16_t* mViewId;
+};
+const NavViewMapEntry kNavViewMap[] = {
+    {u"appMenu-bookmarks-button", u"PanelUI-bookmarks"},
+    {u"appMenu-history-button", u"PanelUI-history"},
+    {u"appMenu-help-button2", u"PanelUI-helpView"},
+    {u"appMenu-more-button2", u"appmenu-moreTools"},
+    // 运行时整体动态填充的空壳视图(序列化必空,列出仅为将来扩充留位)
+};
+
+// 元素是否 subviewbutton-nav(打开子视图的导航按钮):class 含该 token。
+bool IsNavButton(dom::Element* aEl) {
+  if (!aEl) return false;
+  nsString cls;
+  aEl->GetAttr(kNameSpaceID_None, nsGkAtoms::_class, cls);
+  return cls.Find(u"subviewbutton-nav") != kNotFound;
+}
+
+// 解析 nav 按钮的目标视图 id。命中映射表返回 true 并写 aViewId。
+bool GetNavViewId(dom::Element* aEl, nsString& aViewId) {
+  nsString id;
+  aEl->GetAttr(kNameSpaceID_None, nsGkAtoms::id, id);
+  if (id.IsEmpty()) return false;
+  for (const auto& e : kNavViewMap) {
+    if (id.Equals(e.mBtnId)) {
+      aViewId = e.mViewId;
+      return true;
+    }
+  }
+  return false;
+}
+
+// 在文档中查找子视图元素。两处查找:
+// ① GetElementById —— 视图经 #placeViewInCache 用过后挂在 template 元素下
+//   (已连接),直接命中;
+// ② appMenu-viewCache 模板 content 片段递归 —— 冷态(未展示过)视图在片段
+//   内,getElementById 不可见,用子树遍历(与序列化同一套 nsIContent 走查)。
+//   片段内视图未经 Fluent(预翻译路径会 RSS 爆炸,见 browser-init.js 注释),
+//   其文本由 appmenu-viewcache.inc.xhtml 里烤入的静态 label 属性提供。
+dom::Element* FindSubview(dom::Element* aFrom, const nsString& aViewId) {
+  dom::Document* doc = aFrom->GetComposedDoc();
+  if (!doc) return nullptr;
+  if (dom::Element* found = doc->GetElementById(aViewId)) {
+    return found;
+  }
+  dom::Element* tmpl = doc->GetElementById(u"appMenu-viewCache"_ns);
+  if (!tmpl) return nullptr;
+  // 深度优先走查 template 元素:content 片段子树 + 模板元素直连子树。
+  dom::Element* result = FindViewByIdInSubtree(tmpl, aViewId);
+  return result;
+}
+
+// 递归:在元素子树(含 template 的 content 片段)中按 id 查找 panelview。
+dom::Element* FindViewByIdInSubtree(dom::Element* aRoot, const nsString& aViewId) {
+  // 先查 template 的 content 片段(html:template 的子节点解析进片段,直连
+  // 子树遍历看不到),再查普通子树。
+  if (dom::HTMLTemplateElement* tmpl =
+          dom::HTMLTemplateElement::FromNode(aRoot)) {
+    if (dom::DocumentFragment* frag = tmpl->Content()) {
+      for (nsIContent* c = frag->GetFirstChild(); c; c = c->GetNextSibling()) {
+        if (!c->IsElement()) continue;
+        dom::Element* el = c->AsElement();
+        if (ElementHasId(el, aViewId)) return el;
+        if (dom::Element* r = FindViewByIdInSubtree(el, aViewId)) return r;
+      }
+    }
+  }
+  for (nsIContent* c = aRoot->GetFirstChild(); c; c = c->GetNextSibling()) {
+    if (!c->IsElement()) continue;
+    dom::Element* el = c->AsElement();
+    if (ElementHasId(el, aViewId)) return el;
+    if (dom::Element* r = FindViewByIdInSubtree(el, aViewId)) return r;
+  }
+  return nullptr;
+}
+
+bool ElementHasId(dom::Element* aEl, const nsString& aViewId) {
+  nsString id;
+  aEl->GetAttr(kNameSpaceID_None, nsGkAtoms::id, id);
+  return id.Equals(aViewId);
+}
+
+// 追加一个可执行项/复选/单选/submenu 的 JSON 对象到 aOut,并登记句柄。
+// aItemsContent:submenu 的子项 JSON(已序列化,直接嵌入本对象的 "items":[...] 内);
+//   非 submenu 传空串(items 为 [])。这样子菜单子项正确嵌套在 submenu.items,
+//   与 ArkTS parseMenuItem 的递归解析 + flattenItems 的 depth 缩进对齐。
+void AppendItemJson(dom::Element* aEl, const std::string& aItemsContent,
+                    bool aIsSubmenu, std::string& aOut) {
+  // 文本提取链:label 属性(Fluent .label 本地化后由 fluent-dom 写回)→
+  // value 属性(XUL <label> / Fluent .value)→ 子树文本压缩空白(Fluent
+  // 纯值消息/文本子节点)。首开竞速(viewcache 预翻译之前)与异构按钮
+  // 均不产出空文本项;真全空(如动态缩放百分比按钮)由调用方 Container
+  // 递归自然跳过。
+  nsString label;
+  GetAttrValue(aEl, nsGkAtoms::label, label);
+  if (label.IsEmpty()) {
+    GetAttrValue(aEl, nsGkAtoms::value, label);
+  }
+  if (label.IsEmpty()) {
+    nsString text;
+    nsContentUtils::GetNodeTextContent(aEl, /*aDeep=*/true, text);
+    text.CompressWhitespace();
+    label = text;
+  }
+  nsString accel;
+  GetAttrValue(aEl, nsGkAtoms::acceltext, accel);
+  if (accel.IsEmpty()) {
+    // appMenu 按钮:PanelUI._ensureShortcutsShown 在 show() 同步段把快捷键
+    // 文本(ShortcutUtils.prettifyShortcut,如 "Ctrl+T")写入 shortcut 属性。
+    // v155 原子裁撤后无静态原子,NS_Atomize 动态取(原子表去重,开销可忽略)。
+    RefPtr<nsAtom> shortcutAtom = NS_Atomize(u"shortcut"_ns);
+    GetAttrValue(aEl, shortcutAtom, accel);
+  }
+  nsString type;
+  GetAttrValue(aEl, nsGkAtoms::type, type);
+
+  // 分配句柄并存表(Item 与 Submenu 都需句柄;Submenu 句柄当前不用于执行,预留)。
+  int32_t handle = gNextItemHandle++;
+  Handles().InsertOrUpdate(handle, RefPtr<dom::Element>(aEl));  // 拷贝 RefPtr(addref)
+
+  const char* kind = "item";
+  if (aIsSubmenu) {
+    kind = "submenu";
+  } else if (type.EqualsLiteral("checkbox")) {
+    kind = "checkbox";
+  } else if (type.EqualsLiteral("radio")) {
+    kind = "radio";
+  }
+
+  aOut += "{\"kind\":\"";
+  aOut += kind;
+  aOut += "\",\"id\":";
+  aOut += std::to_string(handle);
+  aOut += ",\"label\":";
+  AppendJsonString(aOut, label);
+  aOut += ",\"accel\":";
+  AppendJsonString(aOut, accel);
+  aOut += ",\"icon\":\"\",\"disabled\":";
+  aOut += IsDisabledEl(aEl) ? "true" : "false";
+  aOut += ",\"checked\":";
+  aOut += IsCheckedEl(aEl) ? "true" : "false";
+  aOut += ",\"hidden\":false,\"items\":[";
+  aOut += aItemsContent;  // submenu 子项嵌套在此;非 submenu 为空
+  aOut += "]}";
+}
+
+// 递归序列化元素子树到 aOut 的 items 数组(已打开的数组,调用方负责闭合)。
+void SerializeChildren(dom::Element* aContainer, std::string& aOut,
+                       int32_t aDepth);
+
+// 序列化单个元素(追加一个 item 对象,或递归容器)。已调用方保证 aDepth <= kMaxDepth。
+void SerializeElement(dom::Element* aEl, std::string& aOut, int32_t aDepth) {
+  if (!aEl || gSerializedCount >= kMaxItems) {
+    return;
+  }
+  if (IsHiddenEl(aEl)) {
+    return;  // hidden/collapsed 跳过
+  }
+  MenuRole role = GetMenuRole(aEl);
+  switch (role) {
+    case MenuRole::Separator: {
+      gSerializedCount++;
+      aOut += "{\"kind\":\"separator\",\"id\":0,\"label\":\"\",\"accel\":\"\","
+              "\"icon\":\"\",\"disabled\":false,\"checked\":false,\"hidden\":"
+              "false,\"items\":[]}";
+      break;
+    }
+    case MenuRole::Item: {
+      // v166:subviewbutton-nav(书签/历史/更多工具/帮助)展开为原生二级菜单 ——
+      // 目标 panelview 静态内容序列化进 submenu.items。视图不可达/空壳/成环/
+      // 超深时退化为普通项(点击无响应,与拦截前行为一致)。
+      if (IsNavButton(aEl)) {
+        nsString viewId;
+        if (GetNavViewId(aEl, viewId) && !VisitedViews().Contains(viewId) &&
+            aDepth + 1 <= kMaxDepth) {
+          dom::Element* view = FindSubview(aEl, viewId);
+          if (view) {
+            VisitedViews().Insert(viewId);
+            std::string subItems;
+            SerializeChildren(view, subItems, aDepth + 1);
+            if (!subItems.empty()) {
+              gSerializedCount++;
+              AppendItemJson(aEl, subItems, /*aIsSubmenu=*/true, aOut);
+              break;
+            }
+          }
+        }
+      }
+      gSerializedCount++;
+      // 逗号由 SerializeChildren 在元素间统一插入;此处仅追加对象本身。
+      AppendItemJson(aEl, /*aItemsContent=*/"", /*aIsSubmenu=*/false, aOut);
+      break;
+    }
+    case MenuRole::Submenu: {
+      gSerializedCount++;
+      // 先把子菜单 menupopup 的子项序列化到独立缓冲(嵌套进本对象的 items),
+      // 再组装 submenu 对象。子项正确嵌套 → ArkTS parseMenuItem 递归解析 →
+      // flattenItems 按 depth 缩进渲染。真正的 flyout 子菜单(悬停展开)为 P1。
+      std::string subItems;
+      dom::Element* sub = FindChildMenupopup(aEl);
+      if (sub && aDepth + 1 <= kMaxDepth) {
+        SerializeChildren(sub, subItems, aDepth + 1);
+      }
+      AppendItemJson(aEl, subItems, /*aIsSubmenu=*/true, aOut);
+      break;
+    }
+    case MenuRole::Container: {
+      SerializeChildren(aEl, aOut, aDepth + 1);
+      break;
+    }
+    case MenuRole::Skip:
+    default:
+      break;
+  }
+}
+
+void SerializeChildren(dom::Element* aContainer, std::string& aOut,
+                       int32_t aDepth) {
+  if (!aContainer || aDepth > kMaxDepth) return;
+  bool first = true;
+  for (nsIContent* c = aContainer->GetFirstChild(); c; c = c->GetNextSibling()) {
+    if (!c->IsElement()) continue;
+    dom::Element* child = c->AsElement();
+    if (IsHiddenEl(child)) continue;
+    MenuRole role = GetMenuRole(child);
+    if (role == MenuRole::Skip) continue;
+
+    // 子项之间插逗号(首个除外)。需要在追加该元素前判断。
+    // 用临时缓冲收集单个元素序列化结果,非空则加逗号并入 aOut。
+    std::string tmp;
+    SerializeElement(child, tmp, aDepth);
+    // SerializeElement 对 Separator/Item/Submenu 会写内容;Container 递归可能写多个。
+    // 简化:把 tmp 内容并入 aOut,逗号处理在外层(first 标志)。
+    if (tmp.empty()) continue;
+    // tmp 可能含多个对象(容器递归),需要确保对象间也有逗号。
+    if (!first) aOut += ',';
+    aOut += tmp;
+    first = false;
+  }
+}
+
+}  // namespace
+
+// v268: 抑制态右键菜单关闭补发 popuphiding/popuphidden(Gecko 主线程内调用)。
+// XUL popup 被拦截未弹 → 该事件不自然触发;ContextMenuParent.hiding()
+// (回执 child 清上下文)与 browser-context.js(gContextMenu=null)的清理
+// 全挂 popuphiding。必须在命令派发之后调用(oncommand 依赖 gContextMenu)。
+void FireSuppressedContextPopupHiding() {
+  RefPtr<dom::Element> popup = SuppressedContextPopup();
+  SuppressedContextPopup() = nullptr;
+  SuppressedGen()++;
+  if (!popup) {
+    return;
+  }
+  mozilla::dom::Document* doc = popup->OwnerDoc();
+  // Document::GetPresContext 是 hidden 符号(跨链接单元不可见),
+  // 走 PresShell 路径(mozilla/PresShell.h 已含)。
+  nsPresContext* pc = nullptr;
+  if (doc) {
+    if (mozilla::PresShell* ps = doc->GetPresShell()) {
+      pc = ps->GetPresContext();
+    }
+  }
+  if (!pc) {
+    return;
+  }
+  nsEventStatus status = nsEventStatus_eIgnore;
+  WidgetMouseEvent hiding(true, eXULPopupHiding, nullptr,
+                          WidgetMouseEvent::eReal);
+  mozilla::EventDispatcher::Dispatch(popup, pc, &hiding, nullptr, &status);
+  WidgetMouseEvent hiddenEv(true, eXULPopupHidden, nullptr,
+                            WidgetMouseEvent::eReal);
+  mozilla::EventDispatcher::Dispatch(popup, pc, &hiddenEv, nullptr, &status);
+  OHOS_LOG("[OHOSMenu] 抑制右键菜单 popuphiding 已补发\n");
+}
+
+// v268b: 延迟补发(无命令关闭路径专用)。真机定案:ArkUI 系统菜单点项
+// 自动收起的 onClose 先于项 onClick 触发 → ArkTS closeMenu 的 NAPI 调用
+// 排在 resolveMenuCommand 之前,若 CloseNativeMenu 同步补发 popuphiding,
+// gContextMenu 在命令派发前即被清空(browser-context.js:67
+// gContextMenu.copyLink TypeError,复制链接静默失败)。改为再投一个主
+// 线程 runnable 到队尾:无论 close/command 哪个先入队,hiding 恒在命令
+// 之后;纯外点关闭仅晚一个事件循环 tick,无副作用。代际守卫防"延迟
+// 补发落在下一次抑制登记之后"(同元素复用,指针比较失效)。
+void ScheduleSuppressedContextPopupHiding() {
+  RefPtr<dom::Element> popup = SuppressedContextPopup();
+  if (!popup) {
+    return;
+  }
+  const uint32_t gen = SuppressedGen();
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "OHOSMenuDeferredHiding", [popup = std::move(popup), gen]() {
+        if (SuppressedContextPopup() == popup && SuppressedGen() == gen) {
+          FireSuppressedContextPopupHiding();
+        }
+      }));
+}
+
+// 延迟序列化实现(供上方 Show 的延迟 runnable 调用;内部,不导出)。
+void DoShowMenu(dom::Element* aPopup, dom::Element* aAnchor, int32_t aMenuId);
+
+// Gecko-内部入口:拦截判定(同步)+ 序列化(延迟)。
+//
+// 为何延迟序列化(v164):appMenu 面板视图存放于 <template id=appMenu-viewCache>
+// 的未连接片段,Fluent 不预翻译;PanelUI.show() 把视图移入 panel 时才经
+// L10nMutations(挂 RefreshDriver Style tick,vsync 节拍)异步写回 label 属性。
+// nsXULPopupManager::ShowPopup 的拦截点同步早于该 flush → 首开全空文本。
+// 曾在 browser-init.js 用 l10n.translateFragment(viewCache.content) 启动预
+// 翻译,真机实证 RSS 爆炸至 6GB 被 RSS 阈值杀手击杀(疑似逐元素 Fluent
+// 格式化重复加载 locale bundle 的 mmap 不释放),已弃用。改为:拦截即时
+// 返回(取消 XUL popup,主线程回到事件循环),120ms(≥7 个 vsync tick)后
+// 序列化 —— 此时 pending 翻译已 flush,label 已写回。二开起节点本就带
+// label,同样不受影响。菜单打开延迟 120ms 不可感知。
+//
+// 竞态:menuId 单调递增,延迟 runnable 执行时若已有更新的菜单实例
+// (gCurrentMenuId 变化)则放弃本次序列化。元素经 RefPtr 持有防回收。
+bool OHOSMenuBridge_Show(dom::Element* aPopup, dom::Element* aAnchor) {
+  if (!gMenuCb || !aPopup) {
+    // 桥未注册或 popup 缺失 → 降级到 XUL popup(调用方正常流程)。
+    return false;
+  }
+  // 运行时开关(默认 false,见 kPrefNativeOverlay 注释)。
+  if (!Preferences::GetBool(kPrefNativeOverlay, false)) {
+    return false;
+  }
+
+  gCurrentMenuId++;
+  const int32_t menuId = gCurrentMenuId;
+  // 捕获 RefPtr:延迟期间元素可能被移回 viewcache/面板关闭,防悬垂。
+  RefPtr<dom::Element> popup = aPopup;
+  RefPtr<dom::Element> anchor = aAnchor;
+  NS_DispatchToCurrentThreadQueue(
+      NS_NewRunnableFunction(
+          "OHOSMenuShowDelayed",
+          [menuId, popup = std::move(popup), anchor = std::move(anchor)]() {
+            using namespace mozilla::widget;
+            if (gCurrentMenuId != menuId) {
+              return;  // 已被更新的菜单实例取代
+            }
+            DoShowMenu(popup, anchor, menuId);
+          }),
+      /*aDelayMs=*/120, EventQueuePriority::Normal);
+  return true;
+}
+
+// v268: 内容区长按右键菜单入口(点锚模式)——nsXULPopupManager::
+// BeginShowingPopup 在 popupshowing 派发之后调用(菜单项已填充)。
+// 与 OHOSMenuBridge_Show 的差异:①同步序列化(popupshowing 后 DOM 已就绪,
+// 无需 appMenu 的 120ms Fluent 等待);②点锚定位(按下点展开);
+// ③v270 起全形态(含 phone):手机长按菜单此前落 XUL 桌面弹层(字体小/
+// 无暗黑/无系统观感),与平板同为 ArkTS NativeMenuOverlay 系统菜单;
+// ④抑制态登记(SuppressedContextPopup,close 链补发 popuphiding)。
+bool OHOSMenuBridge_ShowContextMenu(dom::Element* aPopup, int32_t aXDevPx,
+                                    int32_t aYDevPx) {
+  if (!gMenuCb || !aPopup) {
+    return false;
+  }
+  if (!Preferences::GetBool(kPrefNativeOverlay, false)) {
+    return false;
+  }
+  // 前次抑制态未关闭(连点右键):先补发其 hiding 清理,再接管本次。
+  FireSuppressedContextPopupHiding();
+  gCurrentMenuId++;
+  const int32_t menuId = gCurrentMenuId;
+  gPointAnchorX = aXDevPx;
+  gPointAnchorY = aYDevPx;
+  gHasPointAnchor = true;
+  SuppressedContextPopup() = aPopup;
+  SuppressedGen()++;
+  OHOS_LOG("[OHOSMenu] ShowContextMenu 拦截 menuId=%d point=(%d,%d)\n",
+           menuId, aXDevPx, aYDevPx);
+  DoShowMenu(aPopup, nullptr, menuId);
+  if (gSerializedCount == 0) {
+    // 无可序列化项:DoShowMenu 已记日志放弃;清理抑制态,降级 XUL 路径。
+    SuppressedContextPopup() = nullptr;
+    return false;
+  }
+  return true;
+}
+
+void DoShowMenu(dom::Element* aPopup, dom::Element* aAnchor, int32_t aMenuId) {
+  // 重置本次会话状态(id 已在拦截时递增分配)
+  gNextItemHandle = 1;
+  gSerializedCount = 0;
+  Handles().Clear();
+  VisitedViews().Clear();
+
+  // 序列化 items
+  std::string items;
+  SerializeChildren(aPopup, items, /*aDepth=*/0);
+  if (gSerializedCount == 0) {
+    // 无可序列化项 → 不弹空菜单,清理并放弃(XUL popup 已被拦截取消,
+    // 此处仅静默,用户感知为点击无响应)。
+    // v223: 加日志——all-tabs 面板 v222 不上屏即此分支(标签行被
+    // PanelMultiViewHidden 清理掏空+静态按钮无 label 属性),此前无任何
+    // 日志导致排查盲飞。
+    OHOS_LOG("[OHOSMenu] SHOW 放弃: 0 项可序列化 popupTag=%s\n",
+             aPopup ? NS_ConvertUTF16toUTF8(aPopup->NodeName()).get() : "(null)");
+    Handles().Clear();
+    return;
+  }
+
+  // anchor rect:必须用设备像素输出。GetScreenRect()(CSS px)在此chrome文档
+  // 下带 3× 缩放误差(实证 ≡ 真实 2466 Surface px 被报成 822 CSS px ——
+  // chrome presContext AppUnitsPerDevPixel=20,即 3 dev px/CSS px)。
+  // 正解:GetScreenRectInAppUnits + presContext->AppUnitsPerDevPixel() 直接
+  // 换算成 LayoutDevice 像素(widget scale=1 时 = Surface px,即 ArkTS 换算
+  // 所期待的坐标空间)。
+  std::string anchorJson = "{\"x\":0,\"y\":0,\"w\":0,\"h\":0}";
+  if (aAnchor) {
+    if (nsIFrame* f = aAnchor->GetPrimaryFrame()) {
+      if (nsPresContext* pc = f->PresContext()) {
+        LayoutDeviceIntRect r = LayoutDeviceIntRect::FromAppUnitsToNearest(
+            f->GetScreenRectInAppUnits(), pc->AppUnitsPerDevPixel());
+        char buf[128];
+        snprintf(buf, sizeof(buf),
+                 "{\"x\":%d,\"y\":%d,\"w\":%d,\"h\":%d}",
+                 r.x, r.y, r.width, r.height);
+        anchorJson = buf;
+      }
+    }
+  }
+  // v268: 点锚模式(右键菜单按下点)——anchor 即点,w=h=0,JSON 顶层 point=true
+  // 标记;ArkTS NativeMenuOverlay 据此从按下点展开而非屏幕右下回退。
+  const bool pointAnchor = !aAnchor && gHasPointAnchor;
+  if (pointAnchor) {
+    char buf[128];
+    snprintf(buf, sizeof(buf), "{\"x\":%d,\"y\":%d,\"w\":0,\"h\":0}",
+             gPointAnchorX, gPointAnchorY);
+    anchorJson = buf;
+  }
+  gHasPointAnchor = false;  // 消费一次即清,防串菜单
+
+  // 组装完整 JSON
+  std::string json;
+  json += "{\"menuId\":";
+  json += std::to_string(aMenuId);
+  json += ",\"title\":\"\",\"rtl\":false";
+  if (pointAnchor) {
+    json += ",\"point\":true";
+  }
+  json += ",\"anchor\":";
+  json += anchorJson;
+  json += ",\"items\":[";
+  json += items;
+  json += "]}";
+
+  OHOS_LOG("[OHOSMenu] SHOW menuId=%d items=%d jsonLen=%zu\n",
+           aMenuId, gSerializedCount, json.size());
+
+  // 转发到 libgeckoview → tsfn → ArkTS
+  gMenuCb(json.c_str());
+}
+
+}  // namespace widget
+}  // namespace mozilla
+
+// ============================================================================
+// 导出符号(visibility default,libxul.symbols 登记)
+// ============================================================================
+
+// libgeckoview.so 的 RegisterMenuCallback napi 调:注册 tsfn 转发函数指针。
+// cb 签名: void(const char* json),libgeckoview 内部 tsfn 投递到 ArkTS registerMenuCallback。
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_SetMenuCallback(void (*cb)(const char* aJson)) {
+  mozilla::widget::gMenuCb = cb;
+  OHOS_LOG("[OHOSMenu] GeckoBridge_SetMenuCallback 已注册 cb=%p\n", (void*)cb);
+}
+
+// ArkTS resolveMenuCommand → libgeckoview napi → 本入口。
+// 查找句柄表,对元素派发 XUL command 事件(触发 oncommand);menuitemid=0 忽略。
+// 命令派发后清空句柄表(命中即关闭,与 ArkTS 侧 dismissLocal 对齐)。
+//
+// 线程:napi 调用在 ArkTS/JS 线程,但句柄表(DOM Element RefPtr)与
+//   DispatchXULCommand(DOM API)必须在 Gecko 主线程访问。故把实际工作
+//   NS_DispatchToMainThread 投递到 Gecko 主线程执行(异步,下一事件循环 tick)。
+//   句柄表的写(Show,主线程)与读/清(本函数派发的 runnable,主线程)均在
+//   Gecko 主线程,单线程串行,无需锁。
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_RunMenuCommand(int32_t aMenuId, int32_t aItemId,
+                                           int32_t aModifiers) {
+  OHOS_LOG("[OHOSMenu] RunMenuCommand menuId=%d itemId=%d mods=%d\n",
+           aMenuId, aItemId, aModifiers);
+  NS_DispatchToMainThread(
+      NS_NewRunnableFunction("OHOSMenuRunCommand",
+                             [aItemId, aModifiers]() {
+                               using namespace mozilla::widget;
+                               if (aItemId == 0) {
+                                 Handles().Clear();
+                                 return;
+                               }
+                               RefPtr<mozilla::dom::Element> el;
+                               if (!Handles().Get(aItemId, &el) || !el) {
+                                 OHOS_LOG(
+                                     "[OHOSMenu] RunMenuCommand 句柄 %d 未命中\n",
+                                     aItemId);
+                                 Handles().Clear();
+                                 return;
+                               }
+                               // modifiers 位掩码:bit0 Ctrl, bit1 Alt, bit2 Shift, bit3 Meta
+                               bool ctrl = (aModifiers & 0x1) != 0;
+                               bool alt = (aModifiers & 0x2) != 0;
+                               bool shift = (aModifiers & 0x4) != 0;
+                               bool meta = (aModifiers & 0x8) != 0;
+                               // v170:元素带 command 属性时,直接把 command 事件派发到
+                               // 命令元素上(手动转发)。nsXULElement 事件链的内置转发
+                               // (GetEventTargetParent→DispatchXULCommand)要求元素在
+                               // 文档内 —— viewcache 模板片段中的按钮(管理书签/管理
+                               // 历史 footer 等)GetUncomposedDoc 为空,转发静默失败,
+                               // 真机实证点击无响应。命令元素经 OwnerDoc 查(片段节点
+                               // 的 OwnerDoc 仍是 browser 文档)。无 command 属性的按钮
+                               // 仍按原元素派发(PanelUI.onCommand 冒泡路径)。
+                               mozilla::dom::Element* dispatchTarget = el;
+                               nsString cmdId;
+                               el->GetAttr(kNameSpaceID_None, nsGkAtoms::command,
+                                           cmdId);
+                               if (!cmdId.IsEmpty()) {
+                                 // 节点所在文档优先(主视图按钮,已在文档树内);
+                                 // viewcache 片段按钮 GetUncomposedDoc 为空且其
+                                 // OwnerDoc 的 ID 表查不到任何 id(真机实证,
+                                 // 疑似 XUL prototype 副本文档),改从主 chrome
+                                 // 窗口拿文档(WindowMediator,ExitFullscreen
+                                 // 同款已验证路径)。
+                                 mozilla::dom::Document* cmdDoc =
+                                     el->GetUncomposedDoc();
+                                 if (!cmdDoc) {
+                                   nsCOMPtr<nsIWindowMediator> med =
+                                       do_GetService(
+                                           "@mozilla.org/appshell/"
+                                           "window-mediator;1");
+                                   nsCOMPtr<mozIDOMWindowProxy> mozWin;
+                                   if (med) {
+                                     med->GetMostRecentWindow(
+                                         u"navigator:browser",
+                                         getter_AddRefs(mozWin));
+                                   }
+                                   if (mozWin) {
+                                     cmdDoc = nsPIDOMWindowOuter::From(mozWin)
+                                                  ->GetDoc();
+                                   }
+                                 }
+                                 if (mozilla::dom::Element* cmdEl =
+                                         cmdDoc
+                                             ? cmdDoc->GetElementById(cmdId)
+                                             : nullptr) {
+                                   dispatchTarget = cmdEl;
+                                   OHOS_LOG(
+                                       "[OHOSMenu] RunMenuCommand 手动转发到命令"
+                                       "元素 %s\n",
+                                       NS_ConvertUTF16toUTF8(cmdId).get());
+                                 } else {
+                                   OHOS_LOG(
+                                       "[OHOSMenu] RunMenuCommand 命令元素 %s "
+                                       "未找到,按原元素派发\n",
+                                       NS_ConvertUTF16toUTF8(cmdId).get());
+                                 }
+                               }
+                               mozilla::PresShell* presShell = nullptr;
+                               if (mozilla::dom::Document* doc =
+                                       dispatchTarget->GetComposedDoc()) {
+                                 presShell = doc->GetPresShell();
+                               }
+                               // DispatchXULCommand 派发 XUL command 事件
+                               // (bubbles,触发 oncommand/command 属性)。
+                               nsContentUtils::DispatchXULCommand(
+                                   dispatchTarget, /*aTrusted=*/true, nullptr,
+                                   presShell, ctrl, alt, shift, meta);
+                               OHOS_LOG(
+                                   "[OHOSMenu] RunMenuCommand 已派发 XUL command\n");
+                               // 命中即关闭:清理本次句柄表。
+                               Handles().Clear();
+                               // v268: 右键菜单抑制态——命令派发后补发 popuphiding
+                               // (oncommand 依赖 gContextMenu,必须先命令后清理)。
+                               FireSuppressedContextPopupHiding();
+                             }));
+}
+
+// ArkTS closeNativeMenu → libgeckoview napi → 本入口。清理本次句柄表(无命令派发)。
+// 同 RunMenuCommand:派发到 Gecko 主线程执行(Handles 表主线程访问)。
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_CloseNativeMenu(int32_t aMenuId) {
+  OHOS_LOG("[OHOSMenu] CloseNativeMenu menuId=%d(清理句柄表)\n", aMenuId);
+  NS_DispatchToMainThread(
+      NS_NewRunnableFunction("OHOSMenuClose", []() {
+        mozilla::widget::Handles().Clear();
+        // v268b: 右键菜单抑制态——无命令关闭走延迟补发(系统菜单点项
+        // 自动收起的 onClose 先于 onClick,同步补发会抢在命令派发前
+        // 清空 gContextMenu);外点/Esc 纯关闭仅晚一个事件循环 tick。
+        mozilla::widget::ScheduleSuppressedContextPopupHiding();
+      }));
+}
+
+// ============================================================================
+// v168:返回手势/Esc 的全屏退出桥
+//
+// 背景:≡ 菜单"全屏"复选框(PanelUI.onCommand → BrowserCommands.fullScreen()
+// → 窗口级 fullScreen 切换)与页面 DOM 全屏(video 等)两种全屏态下,系统返回
+// 手势应优先退出全屏而非后退历史/退出应用。
+// 路径:①任一文档处于 DOM 全屏 → nsIDOMWindowUtils.exitFullscreen(标准退出,
+//   含 beforefullscreenchange 全套语义);
+// ②否则 chrome 窗口 fullScreen(菜单全屏)→ nsPIDOMWindowOuter::SetFullScreen(false)。
+// 状态判断在 Gecko 主线程 runnable 内完成,ArkTS 侧的 domFullscreenActive
+// (GeckoBridge_SetFullscreenCallback 维护)决定是否调用本桥。
+// ============================================================================
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_ExitFullscreen() {
+  OHOS_LOG("[OHOSMenu] ExitFullscreen 请求\n");
+  NS_DispatchToMainThread(NS_NewRunnableFunction("OHOSExitFullscreen", []() {
+    nsCOMPtr<nsIWindowMediator> med =
+        do_GetService("@mozilla.org/appshell/window-mediator;1");
+    if (!med) {
+      OHOS_LOG("[OHOSMenu] ExitFullscreen: window-mediator 不可用\n");
+      return;
+    }
+    nsCOMPtr<mozIDOMWindowProxy> mozWin;
+    med->GetMostRecentWindow(u"navigator:browser",
+                             getter_AddRefs(mozWin));
+    nsPIDOMWindowOuter* win = nsPIDOMWindowOuter::From(mozWin);
+    if (!win) {
+      OHOS_LOG("[OHOSMenu] ExitFullscreen: 无 navigator:browser 窗口\n");
+      return;
+    }
+    // ① DOM 全屏(任一文档):Document::ExitFullscreenInDocTree(静态,标准
+    //   退出路径,含全套 fullscreenchange 语义;免 nsIDOMWindowUtils 的
+    //   ErrorResult 取用繁琐)
+    if (mozilla::dom::Document* doc = win->GetDoc()) {
+      if (doc->Fullscreen()) {
+        OHOS_LOG("[OHOSMenu] ExitFullscreen: DOM 全屏退出\n");
+        mozilla::dom::Document::ExitFullscreenInDocTree(doc);
+        return;
+      }
+    }
+    // ② 浏览器窗口全屏(菜单"全屏"复选框)
+    if (win->GetFullScreen()) {
+      OHOS_LOG("[OHOSMenu] ExitFullscreen: 窗口全屏退出\n");
+      win->SetFullScreen(false);
+      return;
+    }
+    OHOS_LOG("[OHOSMenu] ExitFullscreen: 当前非全屏,无动作\n");
+  }));
+}
diff --git a/widget/openharmony/OHOSMenuBridge.h b/widget/openharmony/OHOSMenuBridge.h
new file mode 100644
index 0000000000..7d022c8a99
--- /dev/null
+++ b/widget/openharmony/OHOSMenuBridge.h
@@ -0,0 +1,72 @@
+/* -*- Mode: C++; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// 通用原生菜单跨 .so 桥(libxul.so ↔ libgeckoview.so ↔ ArkTS)
+//
+// 目标:OHOS 下把 Gecko 的 XUL 菜单(menulist 下拉 / context menu / appMenu 等)
+//   改为 ArkTS 自绘原生菜单浮层(NativeMenuOverlay),不在 Gecko 端创建对应 XUL popup。
+//
+// 范式照抄 OHOSRevealBridge / OHOSPrintBridge 的「函数指针注册 + tsfn」模型,但为
+//   双向(菜单内容 Gecko→ArkTS,命令回填 ArkTS→Gecko):
+//   1. libgeckoview.so 的 RegisterMenuCallback napi 创建 tsfn 后调
+//      GeckoBridge_SetMenuCallback,把 OHOS_MenuNotify(geckoview.cpp 中的 C 函数)
+//      注册到本 .so 的 gMenuCb。
+//   2. Gecko nsXULPopupManager::ShowMenu/ShowPopup 在 OHOS 下调用
+//      OHOSMenuBridge_Show:序列化 menupopup 子树为 JSON → gMenuCb → libgeckoview
+//      tsfn → ArkTS registerMenuCallback → OHOSMenuBridge.showFromJson →
+//      NativeMenuOverlay 渲染。返回 true 表示已处理(调用方不再创建 XUL popup)。
+//   3. ArkTS 用户命中菜单项 → geckoview.resolveMenuCommand → GeckoBridge_RunMenuCommand
+//      (本 .so 导出)→ 查找句柄表 → nsContentUtils::DispatchXULCommand 触发 oncommand。
+//   4. ArkTS 外点/Escape 关闭 → geckoview.closeNativeMenu → GeckoBridge_CloseNativeMenu
+//      (本 .so 导出)→ 清空本次句柄表。
+//
+// 三个导出符号(visibility default,libxul.symbols 登记):
+//   GeckoBridge_SetMenuCallback     libgeckoview.so → libxul.so(注册 tsfn 转发函数)
+//   GeckoBridge_RunMenuCommand      libgeckoview.so → libxul.so(回填执行命令)
+//   GeckoBridge_CloseNativeMenu     libgeckoview.so → libxul.so(回填关闭,清理句柄)
+//
+// 坐标契约:anchor rect 以 CSS 像素下发(单 Surface 薄壳下 ≈ ArkTS vp);
+//   ArkTS 侧据此定位浮层。详见 .cpp 实现注释。
+
+#ifndef widget_openharmony_OHOSMenuBridge_h__
+#define widget_openharmony_OHOSMenuBridge_h__
+
+namespace mozilla {
+namespace dom {
+class Element;
+}  // namespace dom
+}  // namespace mozilla
+
+namespace mozilla {
+namespace widget {
+
+// Gecko-内部入口:由 nsXULPopupManager::ShowMenu/ShowPopup 在 OHOS 下调用。
+//   序列化 aPopup 子树为菜单 JSON,经 gMenuCb 转发到 libgeckoview → ArkTS
+//   NativeMenuOverlay。aAnchor 为锚点元素(菜单按钮/menulist/panel 锚点),
+//   用于计算浮层定位;为 null 时 ArkTS 用默认位置(右上角)。
+// 返回 true 表示已处理(调用方应跳过创建 XUL popup);false 表示未处理/桥未就绪,
+//   调用方应回退到正常 XUL popup 路径(保证降级安全)。
+bool OHOSMenuBridge_Show(mozilla::dom::Element* aPopup,
+                         mozilla::dom::Element* aAnchor);
+
+// v268: 内容区长按右键菜单专用入口(点锚模式,2in1 形态)。
+//   由 nsXULPopupManager::BeginShowingPopup 在 popupshowing 派发之后调用
+//   (此时 nsContextMenu 已填充 menuitem 并裁决 hidden/disabled,序列化即得
+//   真菜单;头部拦截只会拿到未填充空壳——popupshowing 时序坑)。
+//   aXDevPx/aYDevPx = 按下点坐标(LayoutDevice px = surface px 屏幕坐标系,
+//   与锚点元素 GetScreenRect 换算路径同空间);ArkTS 侧按 point 锚定位。
+//   形态门控在实现内(phone 返回 false 维持 XUL 长按菜单,2in1 走系统菜单)。
+//   关闭语义:XUL popup 被抑制后 popuphiding 不自然触发,由
+//   GeckoBridge_CloseNativeMenu/GeckoBridge_RunMenuCommand 补发
+//   (ContextMenuParent.hiding→child 清上下文、gContextMenu=null 全挂该事件)。
+// 返回 true 表示已处理(调用方应抑制 XUL popup 并复位 popup 状态);
+//   false 表示降级走正常 XUL 路径。
+bool OHOSMenuBridge_ShowContextMenu(mozilla::dom::Element* aPopup,
+                                    int32_t aXDevPx, int32_t aYDevPx);
+
+}  // namespace widget
+}  // namespace mozilla
+
+#endif  // widget_openharmony_OHOSMenuBridge_h__
diff --git a/widget/openharmony/OHOSNativeWindowBridge.cpp b/widget/openharmony/OHOSNativeWindowBridge.cpp
new file mode 100644
index 0000000000..e8bb4c9ed1
--- /dev/null
+++ b/widget/openharmony/OHOSNativeWindowBridge.cpp
@@ -0,0 +1,1863 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// OpenHarmony 原生窗口桥接模块
+//
+// 作用:在 libxul.so 内部维护一个全局的 OHNativeWindow 指针,
+// 作为 geckoview.so(libgeckoview.so / libgeckoxcomp.so 副本)与 HeadlessWidget
+// 之间的传递通道。
+//
+// 数据流:
+//   XComponent OnSurfaceCreated (libgeckoxcomp.so 副本中触发)
+//     -> GeckoBridge_SetNativeWindow (libxul.so 导出符号)
+//     -> gOHOSNativeWindow + notify_all (libxul.so 内部唯一状态)
+//     -> GeckoBridge_WaitNativeWindow (libxul.so 导出符号,GeckoMainThread 等待)
+//     -> OHOS_GetNativeWindow (libxul.so 内部调用)
+//     -> HeadlessWidget::GetNativeData(NS_NATIVE_WINDOW)
+//     -> GLContextProviderEGL 创建 EGLWindowSurface
+//
+// 关键设计(跨 .so 副本同步):
+//   libgeckoview.so 与 libgeckoxcomp.so 是同一份 geckoview.cpp 代码的两个文件副本
+//   (build-id 不同),dlopen 后是两个独立的内存映像,各自的全局变量独立。
+//   因此 geckoview.cpp 中的 gNativeWindow/gNativeWindowMutex/gNativeWindowCV
+//   在两个副本中各有一份,OnSurfaceCreated(在 libgeckoxcomp.so 中)设置的
+//   gNativeWindow 与 GeckoMainThread(在 libgeckoview.so 中)等待的 gNativeWindow
+//   是不同的变量,导致 wait_for 必然超时。
+//
+//   根本解决:把同步原语(mutex + condition_variable)移到 libxul.so 中,
+//   libxul.so 在内存中只有一份,所有 .so 副本调用 GeckoBridge_SetNativeWindow /
+//   GeckoBridge_WaitNativeWindow 都操作同一份状态。
+
+#include <atomic>
+#include <mutex>
+#include <condition_variable>
+#include <chrono>
+#include <cstdio>
+#include <cstdarg>
+#include <cstring>     // v226: 前缀采样 strncmp
+#include <sys/stat.h>  // v226: diag 文件大小上限 stat
+#include <thread>
+#include <unistd.h>
+#include <cstdlib>  // v163: getenv(profiler 落盘路径)
+#include "GeckoProfiler.h"  // v163: profiler_save_profile_to_file
+#include "ProfilerControl.h"  // v163: profiler_stop(gecko 实例,非 baseprofiler)
+
+// v137: OH_Input_SetPointerStyle(鼠标光标样式)。头文件无 visibility 属性,
+// libxul -fvisibility=hidden 下直接 include 会得到 hidden 引用,链接期报
+// "undefined hidden symbol"(pasteboard 同族陷阱,见 moz.build 底部注释)。
+// 用 visibility push(default) 包裹使引用为 default,可绑定外部共享库符号。
+#pragma GCC visibility push(default)
+#include <multimodalinput/oh_input_manager.h>
+// v258g: native window buffer geometry 显式重设(GET/SET,键盘白带框架
+// 缓存重同步)。NDK 头无 visibility 属性,同上 push(default) 包裹。
+#include <native_window/external_window.h>
+#pragma GCC visibility pop
+
+#include "nsThreadUtils.h"
+#include "nsITimer.h"
+#include "prtime.h"
+#include <algorithm>
+#include <map>  // v270: 多指触摸跟踪(id → 位置)
+#include <set>  // v270: 多指批集合运算(新落指/结束指)
+#include "OHOSScreenHelper.h"  // v149: SetSurfaceSize 触发 RefreshScreenList
+
+// ============================================================================
+// OHOS 诊断日志共享函数 (持久 FILE* + 节流 flush, EntryAbility 搬运到 hilog)
+// ============================================================================
+// libxul.so 用 -fvisibility=hidden 编译,无法直接链接调用 libhilog_ndk.z.so 的
+// OH_LOG_Print (符号可见性问题)。改写 gecko_xre_diag.txt,EntryAbility 周期搬运
+// 到 hilog。
+// v172 IO 优化(QA"触控流畅度过低"主嫌之一):原实现每条 fopen+fflush+fclose
+// (路径解析+inode 操作+立即 write 同步落盘),调用方含滚动/布局热路径
+// (PresShell::DoReflow 每帧、OnTouchEvent DOWN/UP、fling 150 tick wheel →
+// 每帧 reflow)——主线程被同步 IO 反复刺穿。改为:
+//   ① 持久 FILE*(进程内开一次,O_APPEND);
+//   ② 互斥锁(多线程调用原本靠 O_APPEND 原子性,共享 FILE* 需显式加锁;
+//      IO 密集下锁竞争可忽略);
+//   ③ 节流 flush:距上次落盘 >250ms 才 fflush(崩溃尾部 ≤250ms 丢失,诊断
+//      可接受;pump 5-10s 搬运一轮,不损失可见性)。
+#define OHOS_DIAG_LOG_PATH "/data/storage/el2/base/haps/entry/files/gecko_xre_diag.txt"
+
+// v226: 采样判定助手前置声明(定义见本文件下方,OHOS_DiagLog 汇点前缀
+// 采样要用)。
+extern "C" bool OHOS_DiagLogSampleHit(const char* aTag, uint32_t aFirstN,
+                                      uint32_t aEveryM);
+
+extern "C" void OHOS_DiagLog(const char* fmt, ...) {
+  static FILE* sDiagFile = nullptr;
+  static std::mutex sDiagMutex;
+  static int64_t sLastFlushMs = 0;
+
+  std::lock_guard<std::mutex> lock(sDiagMutex);
+  // v226: 前缀级采样——批量每事务日志([WRBP] 全家族每帧 2-3 条)与
+  // [XRE] GetWindowRenderer(主线程每合成一次)在汇点按消息前缀统一采样,
+  // 免逐调用点改动;参数求值仍在调用点(两处带字符串分配的点已单独包装)。
+  // 低频关键行([XRE] 其余/[APZ_OHOS]/[FRAME_STATS] 等)不在表中,不受影响。
+  {
+    const char* sampleTag = nullptr;
+    if (fmt[0] == '[' && strncmp(fmt, "[WRBP]", 6) == 0) {
+      sampleTag = "[WRBP]";
+    } else if (strncmp(fmt, "[XRE] nsWindow::GetWindowRenderer", 33) == 0) {
+      sampleTag = "[XRE]GWR";
+    }
+    if (sampleTag && !OHOS_DiagLogSampleHit(sampleTag, 20, 200)) {
+      return;
+    }
+  }
+  if (!sDiagFile) {
+    // v226(审计C3): 文件上限——打开时检查既有文件大小,超 16MiB 截断重开
+    // (此前无任何上限,单会话实测 42MB 无界增长;读取端 4MiB 限批不是上限)。
+    // 截断丢失跨会话证据,16MiB 对诊断足够,换磁盘占用/读取端有界。
+    struct stat st;
+    if (stat(OHOS_DIAG_LOG_PATH, &st) == 0 && st.st_size > 16 * 1024 * 1024) {
+      FILE* trunc = fopen(OHOS_DIAG_LOG_PATH, "w");
+      if (trunc) {
+        fclose(trunc);
+      }
+    }
+    sDiagFile = fopen(OHOS_DIAG_LOG_PATH, "a");
+    if (!sDiagFile) {
+      // v177: content 进程若打不开共享路径(挂载别名缺失等),退到 stderr
+      // 兜底一次,避免诊断插桩全盲(parent 进程 stderr 另有搬运通道)。
+      static bool sWarned = false;
+      if (!sWarned) {
+        sWarned = true;
+        fprintf(stderr,
+                "[OHOS_SS] OHOS_DiagLog fopen 失败 pid=%d path=%s\n",
+                (int)getpid(), OHOS_DIAG_LOG_PATH);
+        fflush(stderr);
+      }
+      return;
+    }
+  }
+  struct timespec ts;
+  clock_gettime(CLOCK_REALTIME, &ts);
+  fprintf(sDiagFile, "%ld.%03ld ", ts.tv_sec, ts.tv_nsec / 1000000);
+  va_list args;
+  va_start(args, fmt);
+  vfprintf(sDiagFile, fmt, args);
+  va_end(args);
+  fprintf(sDiagFile, "\n");
+
+  struct timespec mono;
+  clock_gettime(CLOCK_MONOTONIC, &mono);
+  int64_t nowMs = (int64_t)mono.tv_sec * 1000 + mono.tv_nsec / 1000000;
+  if (nowMs - sLastFlushMs > 250) {
+    fflush(sDiagFile);
+    sLastFlushMs = nowMs;
+  }
+}
