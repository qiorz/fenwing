+static void OHOS_ShowKeyboard() {
+    // v220: 去重从纯标志改为 800ms TTL(真机 11.5 实证事故:键盘弹出 1.6s
+    // 后被系统侧收起 —— AceKeyboard "IME shown, hide kb",Gecko 从未发
+    // hide;而 gKeyboardShown 的系统同步回调 OHOS_OnSendKeyboardStatus
+    // 依赖的 libohinputmethod.so 是空实现 stub(v64),永不触发 —— 标志
+    // 恒 true,后续所有 show 请求在旧去重处短路,地址栏再也弹不出键盘)。
+    // TTL 化:800ms 内连续 enabled=1(SetInputContext 抖动)仍去重;
+    // 超过 800ms 的 show 强制重发 —— showTextInput 幂等,重发无害,
+    // 用户再点一下即自愈。
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    const int64_t nowMs =
+        (int64_t)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+    if (gKeyboardShown.load() && nowMs - gLastKeyboardShowMs.load() < 800) {
+        return;  // 800ms 内已 show,防抖
+    }
+    gLastKeyboardShowMs.store(nowMs);
+    gKeyboardShown.store(true);
+    // v64: 通过 libxul.so 单实例桥接,调用 libgeckoview.so 注册的 ArkTS 回调
+    // 解决跨 .so 副本问题:OHOS_ShowKeyboard 运行在 libgeckoxcomp.so 副本中,
+    // 其 gCallbacks.imeCallback 为 nullptr,必须通过 libxul.so 转发到 libgeckoview.so
+    GeckoBridge_NotifyIMEArkTS("show");
+    OH_LOG_INFO(LOG_APP, "[IME] OHOS_ShowKeyboard → GeckoBridge_NotifyIMEArkTS(\"show\") tid=%{public}d",
+                (int)gettid());
+    printf("[IME] OHOS_ShowKeyboard → GeckoBridge_NotifyIMEArkTS(\"show\")\n"); fflush(stdout);
+}
+
+static void OHOS_HideKeyboard() {
+    if (!gKeyboardShown.load()) {
+        return;  // 已隐藏
+    }
+    gKeyboardShown.store(false);
+    // v64: 通过 libxul.so 单实例桥接,调用 libgeckoview.so 注册的 ArkTS 回调
+    GeckoBridge_NotifyIMEArkTS("hide");
+    OH_LOG_INFO(LOG_APP, "[IME] OHOS_HideKeyboard → GeckoBridge_NotifyIMEArkTS(\"hide\") tid=%{public}d",
+                (int)gettid());
+    printf("[IME] OHOS_HideKeyboard → GeckoBridge_NotifyIMEArkTS(\"hide\")\n"); fflush(stdout);
+}
