@@ -299,6 +299,35 @@ nsUnknownContentTypeDialog.prototype = {
             aLauncher.saveDestinationAvailable(result);
             return;
           }
+
+          // OHOS 移植(Gecko→HarmonyOS native 轨道):autodownload 解析失败
+          // (preferredDir 不可写 / validateLeafName 抛错 / aDefaultFileName 为空)
+          // 时,result 仍为 null。落到下方 file picker(modeSave)分支在 OHOS 危险:
+          // OHOSFilePicker 的 save 回填路径在单 EGL Surface 架构下可能永不 resolve,
+          // 导致 saveDestinationAvailable 不被调用 → CreateTransfer 不触发 →
+          // 下载永久挂起(用户视觉=卡死)。
+          // 规避:OHOS 下不进入 picker,改用系统下载目录 + 默认文件名再试一次
+          // validateLeafName(上面失败多因 aDefaultFileName 为空走不到赋值分支);
+          // 仍失败则 saveDestinationAvailable(null) → aLauncher Cancel →
+          // failed 事件(toast 反馈用户),绝不挂起。
+          if (AppConstants.MOZ_BUILD_APP === "mobile/ohos") {
+            try {
+              let preferredDir =
+                await Downloads.getPreferredDownloadsDirectory();
+              let defaultFolder = new FileUtils.File(preferredDir);
+              if (aDefaultFileName) {
+                result = this.validateLeafName(
+                  defaultFolder,
+                  aDefaultFileName,
+                  aSuggestedFileExtension
+                );
+              }
+            } catch (e) {
+              result = null;
+            }
+            aLauncher.saveDestinationAvailable(result);
+            return;
+          }
         }
       }
 
