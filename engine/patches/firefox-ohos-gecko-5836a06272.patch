+// ============================================================================
+
+// 由 libgeckoview.so RegisterTabStateCallback 注册的函数指针
+static void (*gTabStateCallback)(const char* json) = nullptr;
+
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_SetTabStateCallback(void (*cb)(const char*)) {
+  gTabStateCallback = cb;
+  OHOS_LOG("[XRE] GeckoBridge_SetTabStateCallback 已注册 cb=%p\n",
+          (void*)cb);
+}
