+#ifndef mozilla_widget_OHOSClipboard_h
+#define mozilla_widget_OHOSClipboard_h
+
+// v100: OHOS 系统剪贴板实现
+//
+// 背景:此前 widget/openharmony 注册的是 widget/headless/HeadlessClipboard,
+// 它只在进程内存里存剪贴板内容,从不接入 OHOS 系统剪贴板。导致网页内
+// document.execCommand('copy') / navigator.clipboard / 长按选中复制
+// 全部写进内存,系统剪贴板和其他 App 都拿不到。
+//
+// 修复:用 OHOS NDK 的 OH_Pasteboard_* C API 实现真实剪贴板。
+//   - 写(SetData):无需权限
+//   - 读(GetData):需 ohos.permission.READ_PASTEBOARD(在 module.json5 声明),
+//     无权限时静默返回空(降级,不崩溃)
+//
+// 仅处理 kTextMime / kHTMLMime 两种 flavor(与 HeadlessClipboard 一致)。
+
+#include "nsBaseClipboard.h"
+#include "nsIClipboard.h"
+
+namespace mozilla {
+namespace widget {
+
+class OHOSClipboard final : public nsBaseClipboard {
+ public:
+  OHOSClipboard();
+
+  NS_DECL_ISUPPORTS_INHERITED
+  mozilla::Result<int32_t, nsresult> GetNativeClipboardSequenceNumber(
+      ClipboardType aWhichClipboard) override;
+
+ protected:
+  ~OHOSClipboard() = default;
+
+  // 实现原生剪贴板行为。
+  NS_IMETHOD SetNativeClipboardData(nsITransferable* aTransferable,
+                                    ClipboardType aWhichClipboard) override;
+  mozilla::Result<nsCOMPtr<nsISupports>, nsresult> GetNativeClipboardData(
+      const nsACString& aFlavor, ClipboardType aWhichClipboard) override;
+  nsresult EmptyNativeClipboardData(ClipboardType aWhichClipboard) override;
+  mozilla::Result<bool, nsresult> HasNativeClipboardDataMatchingFlavors(
+      const nsTArray<nsCString>& aFlavorList,
+      ClipboardType aWhichClipboard) override;
+
+ private:
+  // 自增序号(GetChangeCount API 需 API 18,统一用内存自增兼容低版本)
+  int32_t mSequenceNumber = 0;
+};
+
+}  // namespace widget
+}  // namespace mozilla
+
+#endif  // mozilla_widget_OHOSClipboard_h
diff --git a/widget/openharmony/OHOSDebug.h b/widget/openharmony/OHOSDebug.h
new file mode 100644
index 0000000000..125eadca24
--- /dev/null
+++ b/widget/openharmony/OHOSDebug.h
@@ -0,0 +1,50 @@
+/* -*- Mode: C++; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// A5: 原生 stderr 日志门控
+//
+// 背景:OHOSForceRepaint.cpp / OHOSProgressListener.cpp / OHOSURILoader.cpp 等
+//   遍布 fprintf(stderr, "[XRE] ...") + fflush,每次进度回调/URL 变化/forceRepaint
+//   都打日志,生产环境无意义且拖慢(尤其 OnProgressChange 高频触发)。
+//
+// 设计:OHOS_LOG 宏,运行时读 gOHOSVerbose 标志(atomic)。
+//   - gOHOSVerbose=true:正常 fprintf + fflush(调试/诊断用)
+//   - gOHOSVerbose=false:空操作(no-op),零开销
+//   gOHOSVerbose 由 GeckoBridge_SetVerbose(bool) 设置,可由 ArkTS 层通过
+//   initFirefox 命令行参数(--ohos-verbose)或专用 NAPI 触发。
+//
+// 用法:在源文件 #include "OHOSDebug.h" 后,把 fprintf(stderr, "[XRE] ...", ...)
+//   替换为 OHOS_LOG("[XRE] ...", 参数...)。注意 OHOS_LOG 内部已含 fflush。
+//
+// 渐进迁移:当前仅在最高频路径(OnProgressChange 等)接入,全量替换留待后续。
+//   新代码应直接用 OHOS_LOG。
+#ifndef widget_openharmony_OHOSDebug_h
+#define widget_openharmony_OHOSDebug_h
+
+#include <cstdio>
+#include <atomic>
+
+namespace mozilla {
+namespace widget {
+
+// 全局 verbose 标志。默认 true(保持旧行为,便于调试),生产环境可关闭。
+// 用 atomic 确保 GeckoBridge_SetVerbose 与各回调线程的读写安全。
+extern std::atomic<bool> gOHOSVerbose;
+
+}  // namespace widget
+}  // namespace mozilla
+
+// OHOS_LOG(fmt, ...):verbose 时 fprintf + fflush,否则 no-op。
+// 与原 fprintf(stderr, fmt, ...) 调用点签名兼容(替换时去掉 fflush 即可)。
+// 注:即使 verbose=false 也保留对参数的求值(避免副作用差异),但跳过 IO。
+#define OHOS_LOG(fmt, ...)                                          \
+  do {                                                              \
+    if (mozilla::widget::gOHOSVerbose.load(std::memory_order_relaxed)) { \
+      fprintf(stderr, fmt, ##__VA_ARGS__);                          \
+      fflush(stderr);                                               \
+    }                                                               \
+  } while (0)
+
+#endif  // widget_openharmony_OHOSDebug_h
diff --git a/widget/openharmony/OHOSDownloadBridge.cpp b/widget/openharmony/OHOSDownloadBridge.cpp
new file mode 100644
index 0000000000..1027a4a371
--- /dev/null
+++ b/widget/openharmony/OHOSDownloadBridge.cpp
@@ -0,0 +1,54 @@
+/* -*- Mode: C++; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// v118: 下载进度回调跨 .so 桥实现(libxul.so 导出端)
+//
+// 一个导出符号(visibility("default"),libxul.symbols 中登记):
+//   GeckoBridge_SetDownloadCallback   libgeckoview.so → libxul.so(注册通知回调)
+// 内部转发函数:
+//   OHOSDownloadBridge_Notify         libxul.so 内部 → gDownloadNotifyCb
+//
+// 与 OHOSFilePickerBridge 的区别:
+//   - 单向通知:ArkTS 不回填结果,故无 GeckoBridge_ResolveDownload 等价物。
+//   - 未注册时不兜底:仅记日志后返回(下载失败/取消由 nsExternalAppHandler
+//     自身处理,通知桥仅作 informational 上报,缺失不影响下载流程)。
+
+#include "OHOSDownloadBridge.h"
+
+#include "OHOSDebug.h"  // OHOS_LOG / OHOS_DiagLog
+
+namespace mozilla {
+namespace widget {
+
+// 通知回调函数指针(由 libgeckoview.so 通过 GeckoBridge_SetDownloadCallback 注册)
+// 签名:(事件 JSON)。libgeckoview.so 内部再 tsfn 投递到 ArkTS downloadCallback。
+static void (*gDownloadNotifyCb)(const char* aJson) = nullptr;
+
+// libxul.so 内部入口:nsExternalAppHandler 各插桩点调用,转发下载事件到 libgeckoview.so
+void OHOSDownloadBridge_Notify(const char* aJson) {
+  if (!gDownloadNotifyCb) {
+    // 桥未注册(ArkTS 层尚未 initFirefox 或 libgeckoview.so 未注册回调)。
+    // 下载是单向通知,直接返回即可;下载流程本身不受影响。
+    OHOS_LOG("[Download] 通知桥未注册,丢弃事件: %s\n",
+             aJson ? aJson : "(null)");
+    return;
+  }
+  gDownloadNotifyCb(aJson);
+}
+
+}  // namespace widget
+}  // namespace mozilla
+
+// ============================================================================
+// 导出符号(visibility default,在 libxul.symbols 登记,供 libgeckoview.so 调用)
+// ============================================================================
+
+// libgeckoview.so 启动时调:RegisterDownloadCallback 等价物,登记通知回调函数指针
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_SetDownloadCallback(void (*cb)(const char* aJson)) {
+  mozilla::widget::gDownloadNotifyCb = cb;
+  OHOS_LOG("[Download] GeckoBridge_SetDownloadCallback 已注册 cb=%p\n",
+           (void*)cb);
+}
