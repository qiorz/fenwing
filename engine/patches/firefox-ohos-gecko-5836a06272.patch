diff --git a/media/libcubeb/src/cubeb_ohaudio.cpp b/media/libcubeb/src/cubeb_ohaudio.cpp
new file mode 100644
index 0000000000..4f2aef2998
--- /dev/null
+++ b/media/libcubeb/src/cubeb_ohaudio.cpp
@@ -0,0 +1,616 @@
+/* ex: set tabstop=2 shiftwidth=2 expandtab:
+ * Copyright © 2024 OhosWeb Project
+ *
+ * This program is made available under an ISC-style license.  See the
+ * accompanying file LICENSE for details.
+ */
+
+// =============================================================================
+// cubeb OHOS OH Audio (OH_AudioRenderer) backend
+// =============================================================================
+//
+// 设计说明
+// --------
+// 1. OH Audio NDK (libohaudio.so) 仅提供回调式写音频接口
+//    (OH_AudioStreamBuilder_SetRendererWriteDataCallback /
+//     OH_AudioRenderer_OnWriteDataCallback),不存在阻塞式
+//    OH_AudioRenderer_Write 函数。因此本后端采用回调模式(与 aaudio 一致):
+//    系统 audio 线程周期性调用 data_callback -> 我们在回调里调用
+//    cubeb_resampler_fill 从 Gecko 取 PCM 数据填入系统缓冲区。
+//
+// 2. compatibleSdkVersion = 6.1.0(23),可安全使用 API 10~12 的接口:
+//    - OH_AudioStreamBuilder_Create / GenerateRenderer / Destroy (10)
+//    - SetSamplingRate / SetChannelCount / SetSampleFormat / SetRendererInfo (10)
+//    - SetRendererWriteDataCallback (12, 返回 OH_AudioData_Callback_Result)
+//    - OH_AudioRenderer_Start / Pause / Stop / Release / Flush (10)
+//    - OH_AudioRenderer_GetFramesWritten (10, 用于 stream_get_position)
+//    - OH_AudioRenderer_GetCurrentState (10)
+//    - OH_AudioRenderer_SetVolume (12)
+//
+// 3. 日志:OHOS_DiagLog 由 widget/openharmony/OHOSNativeWindowBridge.cpp
+//    以 extern "C" 导出 (fopen 写文件 + EntryAbility 转 hilog)。libcubeb
+//    编入 libxul.so (FINAL_LIBRARY='xul'),OHOSNativeWindowBridge.cpp 也在
+//    libxul 内,链接时同一 .so 内符号直接可见,因此 extern 引用即可。
+//    若未来拆分导致符号不可见,改用 fprintf(stderr) 即可(注释保留)。
+//
+// 4. 输入流(capturer)本后端不实现(初版),stream_init 仅处理 output。
+//    voice/duplex 场景不常见,后续按需扩展。
+//
+// 5. 设备变更/错误处理:错误回调里把流标记为 ERROR 并通知 Gecko,不做
+//    自动重建(初版足够,aaudio 的重建逻辑较复杂)。
+// =============================================================================
+
+#include "cubeb-internal.h"
+#include "cubeb/cubeb.h"
+#include "cubeb_log.h"
+#include "cubeb_resampler.h"
+
+// OHOS NDK 头文件无 visibility 属性,Gecko 经 -include config/gcc_hidden.h
+// 全局 #pragma GCC visibility push(hidden),会把 OH_Audio* 引用标记为 hidden,
+// 链接 libxul.so 时报 "undefined hidden symbol"(与 OHOSClipboard 遇到的
+// libpasteboard 问题同类)。OHOSClipboard 用 dlopen+dlsym 规避;cubeb 后端
+// 调用点多(30+ 函数),改用 visibility pragma 让本 TU 内 OH Audio 声明以
+// default visibility 引用。
+// 注意:必须用 GCC 拼写——clang 拼写(#pragma clang visibility)与 gcc_hidden.h
+// 的 GCC 拼写不共享同一个 visibility 栈(经 OHOS NDK clang 实测,clang 拼写
+// push(default) 无法覆盖 GCC 拼写的 push(hidden),符号仍为 HIDDEN)。
+#pragma GCC visibility push(default)
+#include <ohaudio/native_audiostreambuilder.h>
+#pragma GCC visibility pop
+
+#include <atomic>
+#include <cassert>
+#include <chrono>
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <mutex>
+
+// ---------------------------------------------------------------------------
+// 诊断日志:libxul 内 OHOSNativeWindowBridge.cpp 导出的 extern "C" 函数。
+// cubeb_log 走 Gecko 自身日志系统(LOG/LOGV),OHOS_DiagLog 用于 OHOS 侧
+// 设备级诊断(hilog)。两者并存。若 OHOS_DiagLog 不可链接,可改为 fprintf。
+// ---------------------------------------------------------------------------
+extern "C" void OHOS_DiagLog(const char* fmt, ...);
+
+// cubeb 的 LOG/LOGV 已通过 cubeb_log.h 提供,这里再加一条 OHOS 诊断宏,
+// 同时把日志写入设备级诊断文件(由 EntryAbility 转 hilog)。
+#define OHOS_LOG(...)                       \
+  do {                                       \
+    LOG(__VA_ARGS__);                        \
+    OHOS_DiagLog(__VA_ARGS__);               \
+  } while (0)
+
+enum class stream_state {
+  INIT = 0,
+  STOPPED,
+  STARTED,
+  DRAINING,
+  ERROR,
+  SHUTDOWN,
+};
+
+// 返回当前单调时钟纳秒(用于位置估算插值)。
+inline uint64_t
+now_ns()
+{
+  using namespace std::chrono;
+  return duration_cast<nanoseconds>(steady_clock::now().time_since_epoch())
+      .count();
+}
+
+struct cubeb_stream {
+  /* 注意:前两个字段必须与 cubeb.c 中 cubeb_stream 布局一致。 */
+  cubeb * context{};
+  void * user_ptr{};
+
+  std::atomic<stream_state> state{stream_state::INIT};
+  std::atomic<bool> in_data_callback{false};
+  std::atomic<bool> draining{false};
+
+  OH_AudioRenderer * renderer{};
+  cubeb_data_callback data_callback{};
+  cubeb_state_callback state_callback{};
+  cubeb_resampler * resampler{};
+
+  cubeb_stream_params output_params{};
+  uint32_t sample_rate{};       // 应用侧(重采样器输出)采样率
+  uint32_t device_sample_rate{};// 设备实际采样率
+  cubeb_sample_format out_format{};
+  uint32_t out_channels{};
+  uint32_t out_frame_size{};    // 每帧字节数 = sample_size * channels
+  uint32_t latency_frames{};
+  std::atomic<float> volume{1.f};
+
+  // 位置计算辅助:记录最后一次 callback 时间与已写帧数。
+  std::atomic<uint64_t> last_callback_ns{0};
+  std::atomic<int64_t> last_written_frames{0};
+  std::atomic<uint64_t> previous_clock{0};
+};
+
+struct cubeb {
+  struct cubeb_ops const * ops{};
+};
+
+// ---------------------------------------------------------------------------
+// 辅助:cubeb 采样格式 -> OH_AudioStream_SampleFormat + 每样本字节数
+// ---------------------------------------------------------------------------
+static bool
+ohaudio_format(cubeb_sample_format fmt, OH_AudioStream_SampleFormat * oh_fmt,
+               uint32_t * sample_size, uint32_t channels, uint32_t * frame_size)
+{
+  switch (fmt) {
+  case CUBEB_SAMPLE_S16LE:
+  case CUBEB_SAMPLE_S16BE:
+    // OH Audio 设备为 little-endian aarch64,直接用 S16LE。
+    *oh_fmt = AUDIOSTREAM_SAMPLE_S16LE;
+    *sample_size = sizeof(int16_t);
+    break;
+  case CUBEB_SAMPLE_FLOAT32LE:
+  case CUBEB_SAMPLE_FLOAT32BE:
+    *oh_fmt = AUDIOSTREAM_SAMPLE_F32LE;
+    *sample_size = sizeof(float);
+    break;
+  default:
+    return false;
+  }
+  *frame_size = (*sample_size) * channels;
+  return true;
+}
+
+// 软件音量(Gecko 在 SetVolume 时设置)。OH_AudioRenderer_SetVolume 自 API12
+// 可用,但为兼容性与避免设备音量被影响,这里仍做软件音量缩放,保持与
+// aaudio 后端一致的行为。
+static void
+apply_volume(cubeb_stream * stm, void * audio_data, uint32_t num_frames)
+{
+  float volume = stm->volume.load();
+  if (volume == 1.f) {
+    return;
+  }
+  uint32_t samples = num_frames * stm->out_channels;
+  switch (stm->out_format) {
+  case CUBEB_SAMPLE_S16LE:
+  case CUBEB_SAMPLE_S16BE: {
+    int16_t * p = static_cast<int16_t *>(audio_data);
+    for (uint32_t i = 0; i < samples; ++i) {
+      p[i] = static_cast<int16_t>(static_cast<float>(p[i]) * volume);
+    }
+    break;
+  }
+  case CUBEB_SAMPLE_FLOAT32LE:
+  case CUBEB_SAMPLE_FLOAT32BE: {
+    float * p = static_cast<float *>(audio_data);
+    for (uint32_t i = 0; i < samples; ++i) {
+      p[i] *= volume;
+    }
+    break;
+  }
+  default:
+    break;
+  }
+}
+
+// ---------------------------------------------------------------------------
+// 系统 audio 回调:OH_AudioRenderer_OnWriteDataCallback (API12)
+// 返回 AUDIO_DATA_CALLBACK_RESULT_VALID / _INVALID。
+// audioDataSize 单位是字节;按帧大小换算为帧数后喂给 resampler。
+// ---------------------------------------------------------------------------
+static OH_AudioData_Callback_Result
+ohaudio_write_data_cb(OH_AudioRenderer * /*renderer*/, void * user_data,
+                      void * audio_data, int32_t audio_data_size)
+{
+  cubeb_stream * stm = static_cast<cubeb_stream *>(user_data);
+  assert(stm && stm->renderer);
+  stm->in_data_callback.store(true);
+  auto release = [&] { stm->in_data_callback.store(false); };
+
+  stream_state st = stm->state.load();
+  if (st == stream_state::ERROR || st == stream_state::SHUTDOWN) {
+    release();
+    std::memset(audio_data, 0, audio_data_size);
+    return AUDIO_DATA_CALLBACK_RESULT_VALID;
+  }
+
+  // 已进入 draining:回填静音,让设备把剩余缓冲播完。
+  if (stm->draining.load()) {
+    release();
+    std::memset(audio_data, 0, audio_data_size);
+    return AUDIO_DATA_CALLBACK_RESULT_VALID;
+  }
+
+  uint32_t num_frames =
+      stm->out_frame_size ? (audio_data_size / stm->out_frame_size) : 0;
+  if (num_frames == 0) {
+    release();
+    return AUDIO_DATA_CALLBACK_RESULT_VALID;
+  }
+
+  long done = cubeb_resampler_fill(stm->resampler, nullptr, nullptr,
+                                   audio_data, num_frames);
+
+  if (done < 0 || done > (long)num_frames) {
+    LOG("ohaudio data cb: resampler error %ld", done);
+    release();
+    std::memset(audio_data, 0, audio_data_size);
+    stm->state.store(stream_state::ERROR);
+    stm->state_callback(stm, stm->user_ptr, CUBEB_STATE_ERROR);
+    return AUDIO_DATA_CALLBACK_RESULT_INVALID;
+  }
+
+  // 数据不足 -> 末尾补零,进入 draining,通知 Gecko DRAINED。
+  if (done < (long)num_frames) {
+    char * begin =
+        static_cast<char *>(audio_data) + done * stm->out_frame_size;
+    std::memset(begin, 0, (num_frames - done) * stm->out_frame_size);
+    stm->draining.store(true);
+    stm->state.store(stream_state::DRAINING);
+    stm->state_callback(stm, stm->user_ptr, CUBEB_STATE_DRAINED);
+  }
+
+  apply_volume(stm, audio_data, (uint32_t)done);
+
+  // 更新位置/时钟辅助量。
+  stm->last_callback_ns.store(now_ns());
+  release();
+  return AUDIO_DATA_CALLBACK_RESULT_VALID;
+}
+
+// 错误回调(API20 单独设置接口;为兼容 API12,这里使用旧的
+// SetRendererCallback 复合回调结构体——OH_AudioRenderer_Callbacks_Struct 自
+// API10 起可用)。错误时把流标记为 ERROR 并通知 Gecko。
+static int32_t
+ohaudio_error_cb(OH_AudioRenderer * /*renderer*/, void * user_data,
+                 OH_AudioStream_Result error)
+{
+  cubeb_stream * stm = static_cast<cubeb_stream *>(user_data);
+  LOG("ohaudio error callback: result=%d", (int)error);
+  OHOS_DiagLog("[cubeb_ohaudio] error callback result=%d", (int)error);
+  stm->state.store(stream_state::ERROR);
+  stm->state_callback(stm, stm->user_ptr, CUBEB_STATE_ERROR);
+  return 0;
+}
+
+static int32_t
+ohaudio_interrupt_cb(OH_AudioRenderer * /*renderer*/, void * /*user_data*/,
+                     OH_AudioInterrupt_ForceType /*type*/,
+                     OH_AudioInterrupt_Hint /*hint*/)
+{
+  // 初版不打断逻辑:收到中断事件忽略。后续可按 hint 暂停/恢复。
+  return 0;
+}
+
+static int32_t
+ohaudio_stream_event_cb(OH_AudioRenderer * /*renderer*/,
+                        void * /*user_data*/, OH_AudioStream_Event /*event*/)
+{
+  return 0;
+}
+
+// 前置声明:ops 表里的 init 字段需要引用 ohaudio_init(定义在文件末尾)。
+extern "C" int ohaudio_init(cubeb ** context, char const * context_name);
+
+// ---------------------------------------------------------------------------
+// ops 实现
+// ---------------------------------------------------------------------------
+static char const *
+ohaudio_get_backend_id(cubeb * /*ctx*/)
+{
+  return "ohaudio";
+}
+
+static int
+ohaudio_get_max_channel_count(cubeb * /*ctx*/, uint32_t * max_channels)
+{
+  assert(max_channels);
+  *max_channels = 2u; // 初版仅支持立体声
+  return CUBEB_OK;
+}
+
+static int
+ohaudio_get_min_latency(cubeb * /*ctx*/, cubeb_stream_params /*params*/,
+                        uint32_t * latency_frames)
+{
+  // 经验值:960 帧 @ 48kHz ~= 20ms,与 aaudio 的 framesPerBurst 量级一致。
+  *latency_frames = 960u;
+  return CUBEB_OK;
+}
+
+static int
+ohaudio_get_preferred_sample_rate(cubeb * /*ctx*/, uint32_t * rate)
+{
+  // OH Audio 默认 48kHz。
+  *rate = 48000u;
+  return CUBEB_OK;
+}
+
+static void
+ohaudio_destroy(cubeb * ctx)
+{
+  assert(ctx);
+  delete ctx;
+}
+
+static int
+ohaudio_stream_init(cubeb * ctx, cubeb_stream ** stream,
+                    char const * /*stream_name*/,
+                    cubeb_devid /*input_device*/,
+                    cubeb_stream_params * /*input_stream_params*/,
+                    cubeb_devid /*output_device*/,
+                    cubeb_stream_params * output_stream_params,
+                    unsigned int latency_frames,
+                    cubeb_data_callback data_callback,
+                    cubeb_state_callback state_callback, void * user_ptr)
+{
+  assert(ctx && stream);
+  if (!output_stream_params) {
+    LOG("ohaudio_stream_init: only output is supported");
+    return CUBEB_ERROR_INVALID_FORMAT;
+  }
+
+  cubeb_sample_format cfmt = output_stream_params->format;
+  // 设备为 little-endian,把 BE 规范化成 LE 内部处理(本后端只生成 LE)。
+  if (cfmt == CUBEB_SAMPLE_S16BE) cfmt = CUBEB_SAMPLE_S16LE;
+  if (cfmt == CUBEB_SAMPLE_FLOAT32BE) cfmt = CUBEB_SAMPLE_FLOAT32LE;
+
+  OH_AudioStream_SampleFormat oh_fmt;
+  uint32_t sample_size, frame_size;
+  if (!ohaudio_format(cfmt, &oh_fmt, &sample_size,
+                      output_stream_params->channels, &frame_size)) {
+    LOG("ohaudio_stream_init: unsupported format %d", cfmt);
+    return CUBEB_ERROR_INVALID_FORMAT;
+  }
+
+  cubeb_stream * stm = new cubeb_stream;
+  stm->context = ctx;
+  stm->user_ptr = user_ptr;
+  stm->data_callback = data_callback;
+  stm->state_callback = state_callback;
+  stm->output_params = *output_stream_params;
+  stm->output_params.format = cfmt;
+  stm->out_format = cfmt;
+  stm->out_channels = output_stream_params->channels;
+  stm->out_frame_size = frame_size;
+  stm->sample_rate = output_stream_params->rate;
+  stm->device_sample_rate = output_stream_params->rate;
+  stm->latency_frames = latency_frames ? latency_frames : 960u;
+  stm->state.store(stream_state::INIT);
+
+  // --- 创建 builder ---
+  OH_AudioStreamBuilder * builder = nullptr;
+  OH_AudioStream_Result r =
+      OH_AudioStreamBuilder_Create(&builder, AUDIOSTREAM_TYPE_RENDERER);
+  if (r != AUDIOSTREAM_SUCCESS || !builder) {
+    LOG("OH_AudioStreamBuilder_Create failed: %d", (int)r);
+    delete stm;
+    return CUBEB_ERROR;
+  }
+
+  struct BuilderGuard {
+    OH_AudioStreamBuilder * b;
+    ~BuilderGuard() { OH_AudioStreamBuilder_Destroy(b); }
+  } guard{builder};
+
+  OH_AudioStreamBuilder_SetSamplingRate(
+      builder, static_cast<int32_t>(stm->device_sample_rate));
+  OH_AudioStreamBuilder_SetChannelCount(
+      builder, static_cast<int32_t>(stm->out_channels));
+  OH_AudioStreamBuilder_SetSampleFormat(builder, oh_fmt);
+  OH_AudioStreamBuilder_SetEncodingType(builder, AUDIOSTREAM_ENCODING_TYPE_RAW);
+  OH_AudioStreamBuilder_SetRendererInfo(builder, AUDIOSTREAM_USAGE_MOVIE);
+  // 低延迟模式优先(视频/媒体场景)。
+  OH_AudioStreamBuilder_SetLatencyMode(builder, AUDIOSTREAM_LATENCY_MODE_FAST);
+
+  // --- 回调(使用 API10 复合回调结构体,API12+ 兼容) ---
+  OH_AudioRenderer_Callbacks callbacks;
+  std::memset(&callbacks, 0, sizeof(callbacks));
+  callbacks.OH_AudioRenderer_OnWriteData = [](OH_AudioRenderer * rnd,
+                                              void * ud, void * buf,
+                                              int32_t len) -> int32_t {
+    return (int32_t)ohaudio_write_data_cb(rnd, ud, buf, len);
+  };
+  callbacks.OH_AudioRenderer_OnStreamEvent = ohaudio_stream_event_cb;
+  callbacks.OH_AudioRenderer_OnInterruptEvent = ohaudio_interrupt_cb;
+  callbacks.OH_AudioRenderer_OnError = ohaudio_error_cb;
+  OH_AudioStreamBuilder_SetRendererCallback(builder, callbacks, stm);
+
+  // --- 生成 renderer ---
+  r = OH_AudioStreamBuilder_GenerateRenderer(builder, &stm->renderer);
+  if (r != AUDIOSTREAM_SUCCESS || !stm->renderer) {
+    LOG("OH_AudioStreamBuilder_GenerateRenderer failed: %d", (int)r);
+    delete stm;
+    return CUBEB_ERROR;
+  }
+
+  // 读取设备实际采样率,据此创建重采样器。
+  int32_t dev_rate = (int32_t)stm->device_sample_rate;
+  OH_AudioRenderer_GetSamplingRate(stm->renderer, &dev_rate);
+  stm->device_sample_rate = (uint32_t)dev_rate;
+
+  cubeb_stream_params resampler_out = stm->output_params;
+  resampler_out.rate = stm->device_sample_rate;
+
+  stm->resampler = cubeb_resampler_create(
+      stm, nullptr, &resampler_out, stm->sample_rate, stm->data_callback,
+      stm->user_ptr, CUBEB_RESAMPLER_QUALITY_DEFAULT,
+      CUBEB_RESAMPLER_RECLOCK_NONE);
+  if (!stm->resampler) {
+    LOG("ohaudio: failed to create resampler");
+    OH_AudioRenderer_Release(stm->renderer);
+    delete stm;
+    return CUBEB_ERROR;
+  }
+
+  stm->state.store(stream_state::STOPPED);
+  OHOS_LOG("[cubeb_ohaudio] stream init ok: rate=%u/%u ch=%u fmt=%d "
+           "frame_size=%u latency=%u",
+           stm->sample_rate, stm->device_sample_rate, stm->out_channels,
+           (int)cfmt, stm->out_frame_size, stm->latency_frames);
+
+  *stream = stm;
+  return CUBEB_OK;
+}
+
+static void
+ohaudio_stream_destroy(cubeb_stream * stm)
+{
+  assert(stm);
+  if (stm->renderer) {
+    OH_AudioStream_State s = AUDIOSTREAM_STATE_INVALID;
+    OH_AudioRenderer_GetCurrentState(stm->renderer, &s);
+    if (s != AUDIOSTREAM_STATE_STOPPED && s != AUDIOSTREAM_STATE_PAUSED &&
+        s != AUDIOSTREAM_STATE_RELEASED) {
+      OH_AudioRenderer_Stop(stm->renderer);
+    }
+    OH_AudioRenderer_Release(stm->renderer);
+    stm->renderer = nullptr;
+  }
+  if (stm->resampler) {
+    cubeb_resampler_destroy(stm->resampler);
+    stm->resampler = nullptr;
+  }
+  stm->state.store(stream_state::SHUTDOWN);
+  delete stm;
+}
+
+static int
+ohaudio_stream_start(cubeb_stream * stm)
+{
+  assert(stm && stm->renderer);
+  stream_state st = stm->state.load();
+  if (st == stream_state::STARTED) {
+    return CUBEB_OK;
+  }
+  if (st == stream_state::ERROR || st == stream_state::SHUTDOWN) {
+    return CUBEB_ERROR;
+  }
+  stm->draining.store(false);
+  OH_AudioStream_Result r = OH_AudioRenderer_Start(stm->renderer);
+  if (r != AUDIOSTREAM_SUCCESS) {
+    LOG("OH_AudioRenderer_Start failed: %d", (int)r);
+    stm->state.store(stream_state::ERROR);
+    return CUBEB_ERROR;
+  }
+  stm->state.store(stream_state::STARTED);
+  stm->last_callback_ns.store(now_ns());
+  stm->state_callback(stm, stm->user_ptr, CUBEB_STATE_STARTED);
+  OHOS_LOG("[cubeb_ohaudio] stream started %p", (void *)stm);
+  return CUBEB_OK;
+}
+
+static int
+ohaudio_stream_stop(cubeb_stream * stm)
+{
+  assert(stm && stm->renderer);
+  stream_state st = stm->state.load();
+  if (st == stream_state::STOPPED || st == stream_state::INIT) {
+    return CUBEB_OK;
+  }
+  if (st == stream_state::ERROR || st == stream_state::SHUTDOWN) {
+    return CUBEB_ERROR;
+  }
+  OH_AudioStream_Result r = OH_AudioRenderer_Pause(stm->renderer);
+  if (r != AUDIOSTREAM_SUCCESS) {
+    // Pause 在某些状态下非法,退化为 Stop。
+    LOG("OH_AudioRenderer_Pause failed (%d), trying Stop", (int)r);
+    r = OH_AudioRenderer_Stop(stm->renderer);
+    if (r != AUDIOSTREAM_SUCCESS) {
+      LOG("OH_AudioRenderer_Stop failed: %d", (int)r);
+    }
+  }
+  stm->state.store(stream_state::STOPPED);
+  stm->state_callback(stm, stm->user_ptr, CUBEB_STATE_STOPPED);
+  OHOS_LOG("[cubeb_ohaudio] stream stopped %p", (void *)stm);
+  return CUBEB_OK;
+}
+
+static int
+ohaudio_stream_get_position(cubeb_stream * stm, uint64_t * position)
+{
+  assert(stm && position);
+  if (!stm->renderer) {
+    *position = 0;
+    return CUBEB_OK;
+  }
+  int64_t frames = 0;
+  OH_AudioStream_Result r =
+      OH_AudioRenderer_GetFramesWritten(stm->renderer, &frames);
+  if (r != AUDIOSTREAM_SUCCESS || frames < 0) {
+    *position = stm->previous_clock.load();
+    return CUBEB_OK;
+  }
+  stm->last_written_frames.store(frames);
+  // 设备帧数基于设备采样率,需换算回应用采样率(Gecko 期望的时钟)。
+  uint64_t pos = (uint64_t)frames;
+  if (stm->device_sample_rate && stm->sample_rate &&
+      stm->device_sample_rate != stm->sample_rate) {
+    pos = pos * stm->sample_rate / stm->device_sample_rate;
+  }
+  // 位置必须单调不递减。
+  uint64_t prev = stm->previous_clock.load();
+  if (pos < prev) {
+    pos = prev;
+  } else {
+    stm->previous_clock.store(pos);
+  }
+  *position = pos;
+  return CUBEB_OK;
+}
+
+static int
+ohaudio_stream_get_latency(cubeb_stream * stm, uint32_t * latency)
+{
+  assert(stm && latency);
+  // OH_AudioRenderer_GetLatency 仅 API23 可用,这里返回粗略估计值:
+  // 一个 latency_frames 的缓冲近似为设备侧播放延迟。
+  *latency = stm->latency_frames;
+  return CUBEB_OK;
+}
+
+static int
+ohaudio_stream_set_volume(cubeb_stream * stm, float volume)
+{
+  assert(stm);
+  stm->volume.store(volume);
+  return CUBEB_OK;
+}
+
+const static struct cubeb_ops ohaudio_ops = {
+    /*.init =*/ohaudio_init,
+    /*.get_backend_id =*/ohaudio_get_backend_id,
+    /*.get_max_channel_count =*/ohaudio_get_max_channel_count,
+    /*.get_min_latency =*/ohaudio_get_min_latency,
+    /*.get_preferred_sample_rate =*/ohaudio_get_preferred_sample_rate,
+    /*.get_supported_input_processing_params =*/nullptr,
+    /*.enumerate_devices =*/nullptr,
+    /*.device_collection_destroy =*/nullptr,
+    /*.destroy =*/ohaudio_destroy,
+    /*.stream_init =*/ohaudio_stream_init,
+    /*.stream_destroy =*/ohaudio_stream_destroy,
+    /*.stream_start =*/ohaudio_stream_start,
+    /*.stream_stop =*/ohaudio_stream_stop,
+    /*.stream_get_position =*/ohaudio_stream_get_position,
+    /*.stream_get_latency =*/ohaudio_stream_get_latency,
+    /*.stream_get_input_latency =*/nullptr,
+    /*.stream_set_volume =*/ohaudio_stream_set_volume,
+    /*.stream_set_name =*/nullptr,
+    /*.stream_get_current_device =*/nullptr,
+    /*.stream_set_input_mute =*/nullptr,
+    /*.stream_set_input_processing_params =*/nullptr,
+    /*.stream_device_destroy =*/nullptr,
+    /*.stream_register_device_changed_callback =*/nullptr,
+    /*.register_device_collection_changed =*/nullptr,
+};
+
+extern "C" int
+ohaudio_init(cubeb ** context, char const * /*context_name*/)
+{
+  if (!context) {
+    return CUBEB_ERROR_INVALID_PARAMETER;
+  }
+  cubeb * ctx = new cubeb;
+  ctx->ops = &ohaudio_ops;
+  *context = ctx;
+  OHOS_LOG("[cubeb_ohaudio] ohaudio_init ok (libohaudio backend)");
+  return CUBEB_OK;
+}
