+/* -*- Mode: C++; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// P1: 打印跨 .so 桥(libxul.so ↔ libgeckoview.so ↔ ArkTS)
+//
+// 范式完全照抄 OHOSRevealBridge.cpp 的"函数指针注册 + tsfn"模型
+// (单向通知,fire-and-forget,无回填):
+//   1. libgeckoview.so 启动时调 GeckoBridge_SetPrintCallback,把本 .so 内的
+//      OHOS_PrintNotify(geckoview.cpp 中的 C 函数)注册进来。
+//   2. libxul.so 内 nsDeviceContextSpecOHOS::DoEndDocument 在 PDF 渲染完成后调
+//      OHOSPrintBridge_Notify,经存储的函数指针 gPrintCb 转发到 libgeckoview.so
+//      → napi_threadsafe_function → ArkTS registerPrintCallback,
+//      由 ArkTS 用 print.print 拉起系统打印预览并清理临时 PDF。
+//   3. 与 reveal 同为单向 fire-and-forget:不回填结果。
+//
+// 一个导出符号(visibility default,libxul.symbols 登记):
+//   GeckoBridge_SetPrintCallback   libgeckoview.so → libxul.so(注册回调)
+//
+// path 语义:Gecko 侧 nsIFile 临时 PDF 的绝对沙箱路径,ArkTS 侧经
+// fileUri.getUriFromPath 转 file:// URI 喂给 print.print。
+
+#ifndef widget_openharmony_OHOSPrintBridge_h__
+#define widget_openharmony_OHOSPrintBridge_h__
+
+namespace mozilla {
+namespace widget {
+
+// libxul.so 内部入口:由 nsDeviceContextSpecOHOS::DoEndDocument 在 PDF 渲染完成
+// 后调用,经 gPrintCb 把临时 PDF 路径转发到 libgeckoview.so → ArkTS
+// registerPrintCallback。未注册时记日志并返回(打印为 fire-and-forget,
+// 缺失不影响 Gecko 主线程;PDF 临时文件由析构安全网删除)。
+void OHOSPrintBridge_Notify(const char* aPath);
+
+}  // namespace widget
+}  // namespace mozilla
+
+#endif  // widget_openharmony_OHOSPrintBridge_h__
diff --git a/widget/openharmony/OHOSProgressListener.cpp b/widget/openharmony/OHOSProgressListener.cpp
