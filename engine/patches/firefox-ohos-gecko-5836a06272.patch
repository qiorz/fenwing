+
+// v118: <input type=file> 单文件选择 — 接入 OHOS 系统 Picker
+//
+// 本类持有 parent filepicker 契约(@mozilla.org/parent/filepicker;1),
+// 替代 mobile/shared 的 GeckoView FilePickerDelegate(它依赖 GeckoViewPrompter
+// actor,native 轨道未注册)。Open 异步下发请求到 ArkTS,不阻塞;
+// 回填经 OHOSFilePickerBridge → OnPicked。
+
+#include "OHOSFilePicker.h"
+#include "OHOSFilePickerBridge.h"  // OHOSFilePickerBridge_Request
+
+#include "nsArrayEnumerator.h"  // NS_NewArrayEnumerator(GetFiles 用)
+#include "nsCOMArray.h"         // nsCOMArray<nsIFile>(GetFiles 用)
+#include "nsIFile.h"            // NS_NewLocalFile
+#include "nsIFilePicker.h"      // nsIFilePickerShownCallback / 返回码 / 掩码常量
+#include "nsIWidget.h"          // InitNative 参数
+#include "nsThreadUtils.h"      // NS_DispatchToMainThread
+#include "nsNetUtil.h"          // NS_NewURI
+
+#include "OHOSDebug.h"  // OHOS_LOG
+
+#include <cstdio>  // snprintf
+#include <cstring>
+
+namespace mozilla {
+namespace widget {
+
+// 静态登记表与自增 callbackId(主线程访问,无需锁)
+nsTHashMap<nsUint32HashKey, RefPtr<OHOSFilePicker>> OHOSFilePicker::sPending;
+uint32_t OHOSFilePicker::sNextCallbackId = 1;
+
+NS_IMPL_ISUPPORTS(OHOSFilePicker, nsIFilePicker)
+
+// 工厂构造:供 components.conf 'constructor' 使用。
+// gen_static_components 生成 RefPtr<OHOSFilePicker> inst = Create();,
+// 故返回 already_AddRefed<OHOSFilePicker>(具体类型,满足 is_base_of 校验)。
+already_AddRefed<OHOSFilePicker> OHOSFilePicker::Create() {
+  RefPtr<OHOSFilePicker> picker = new OHOSFilePicker();
+  return picker.forget();
+}
+
+void OHOSFilePicker::InitNative(nsIWidget* aParent, const nsAString& aTitle) {
+  // 存标题供 Open 下发到 ArkTS 作为 Picker 标题
+  mTitle = aTitle;
+}
+
+NS_IMETHODIMP
+OHOSFilePicker::AppendFilter(const nsAString& aTitle, const nsAString& aFilter) {
+  // 系统 Picker 以 MIME 过滤为主,aFilter 形如 "*.jpg;*.png" 的 glob
+  // 不能直接喂给 DocumentSelectOptions.fileMimeTypeFilters,故保留原样入 mFilters
+  // (供调试/日志),同时按 ';' 切分解析出后缀入 mSuffixFilters,下发到 ArkTS。
+  if (!aFilter.IsEmpty()) {
+    mFilters.AppendElement(aFilter);
+    // 按 ';' 切分 glob,每项去 '*' 前缀,得到 ".jpg" 等后缀
+    const NS_ConvertUTF16toUTF8 filterUtf8(aFilter);
+    uint32_t start = 0;
+    for (uint32_t i = 0; i <= filterUtf8.Length(); ++i) {
+      const bool isSep = (i == filterUtf8.Length()) || filterUtf8[i] == ';';
+      if (!isSep) continue;
+      if (i > start) {
+        nsAutoCString token(Substring(filterUtf8, start, i - start));
+        token.StripWhitespace();
+        if (token.Length() >= 2 && token[0] == '*' && token[1] == '.') {
+          // "*.jpg" → ".jpg"
+          mSuffixFilters.AppendElement(Substring(token, 1));
+        } else if (!token.IsEmpty()) {
+          // 非标准 glob(如 "*.jp*"或纯文本),原样存,ArkTS 侧自行判断
+          mSuffixFilters.AppendElement(token);
+        }
+      }
+      start = i + 1;
+    }
+  }
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+OHOSFilePicker::AppendFilters(int32_t aFilterMask) {
+  // 把 nsIFilePicker filter* 掩码转换为 MIME 字符串(入 mFilters,供 ArkTS
+  // DocumentSelectOptions.fileMimeTypeFilters 使用)与后缀列表(入
+  // mSuffixFilters,供 ArkTS 后缀过滤)。掩码位与 nsIFilePicker.idl:34-56 注释
+  // 中的权威后缀列表对齐(避免手抖遗漏)。
+  // 注意:filterAll 表"不限",对应空后缀数组(不下发具体后缀)。
+  if (aFilterMask & filterAll) {
+    mFilters.AppendElement(u"*/*"_ns);
+    // filterAll: 不追加任何后缀(空数组表示不限)
+  }
+  if (aFilterMask & filterHTML) {
+    mFilters.AppendElement(u"text/html"_ns);
+    static const char* const kHtml[] = {".html", ".htm", ".xhtml"};
+    for (const char* s : kHtml) mSuffixFilters.AppendElement(nsCString(s));
+  }
+  if (aFilterMask & filterText) {
+    mFilters.AppendElement(u"text/plain"_ns);
+    static const char* const kText[] = {".txt", ".text"};
+    for (const char* s : kText) mSuffixFilters.AppendElement(nsCString(s));
+  }
+  if (aFilterMask & filterImages) {
+    mFilters.AppendElement(u"image/*"_ns);
+    // 后缀以 nsIFilePicker.idl:37-41 注释为准
+    static const char* const kImg[] = {
+        ".jpe", ".jpg",  ".jpeg", ".gif",  ".png",  ".bmp",  ".ico",
+        ".svg", ".svgz", ".tif",  ".tiff", ".ai",   ".drw",  ".pct",
+        ".psp", ".xcf",  ".psd",  ".raw",  ".webp", ".heic"};
+    for (const char* s : kImg) mSuffixFilters.AppendElement(nsCString(s));
+  }
+  if (aFilterMask & filterXML) {
+    mFilters.AppendElement(u"application/xml"_ns);
+    mFilters.AppendElement(u"text/xml"_ns);
+    static const char* const kXml[] = {".xml"};
+    for (const char* s : kXml) mSuffixFilters.AppendElement(nsCString(s));
+  }
+  if (aFilterMask & filterXUL) {
+    // XUL 为 Mozilla 内部格式,无标准 MIME;仅登记后缀
+    static const char* const kXul[] = {".xul"};
+    for (const char* s : kXul) mSuffixFilters.AppendElement(nsCString(s));
+  }
+  if (aFilterMask & filterAudio) {
+    mFilters.AppendElement(u"audio/*"_ns);
+    // 后缀以 nsIFilePicker.idl:46-50 注释为准
+    static const char* const kAud[] = {
+        ".aac", ".aif", ".flac", ".iff", ".m4a", ".m4b", ".mid",
+        ".midi", ".mp3", ".mpa",  ".mpc", ".oga", ".ogg", ".ra",
+        ".ram", ".snd", ".wav",  ".wma"};
+    for (const char* s : kAud) mSuffixFilters.AppendElement(nsCString(s));
+  }
+  if (aFilterMask & filterVideo) {
+    mFilters.AppendElement(u"video/*"_ns);
+    // 后缀以 nsIFilePicker.idl:51-55 注释为准
+    static const char* const kVid[] = {
+        ".avi",  ".divx", ".flv", ".m4v", ".mkv", ".mov",
+        ".mp4",  ".mpeg", ".mpg", ".ogm", ".ogv", ".ogx",
+        ".rm",   ".rmvb", ".smil", ".webm", ".wmv", ".xvid"};
+    for (const char* s : kVid) mSuffixFilters.AppendElement(nsCString(s));
+  }
+  if (aFilterMask & filterPDF) {
+    mFilters.AppendElement(u"application/pdf"_ns);
+    static const char* const kPdf[] = {".pdf"};
+    for (const char* s : kPdf) mSuffixFilters.AppendElement(nsCString(s));
+  }
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+OHOSFilePicker::Open(nsIFilePickerShownCallback* aCallback) {
+  // 企业策略可能要求阻塞文件选择器(对齐 widget/gtk/nsFilePicker.cpp)。
+  // MaybeBlockFilePicker 在被阻塞时自行回调 returnCancel,保留此调用。
+  if (MaybeBlockFilePicker(aCallback)) {
+    return NS_OK;
+  }
+
+  // 存回调,等待 OnPicked 回填(异步)
+  mCallback = aCallback;
+
+  // 分配 callbackId 并登记到 sPending,供静态 OnPicked 定位实例
+  uint32_t callbackId = sNextCallbackId++;
+  sPending.InsertOrUpdate(callbackId, RefPtr<OHOSFilePicker>(this));
+
+  // 确定 mode 字符串:P1 起支持 single / multiple / folder 三种。
+  // ArkTS 侧 DocumentViewPicker 按 mode 选择 Picker 并决定 max/select 语义。
+  const char* modeStr = "single";
+  if (mMode == modeOpenMultiple) {
+    modeStr = "multiple";
+  } else if (mMode == modeGetFolder) {
+    modeStr = "folder";
+  }
+
+  // 构造 JSON 请求:
+  //   {"id":N,"mode":"single|multiple|folder","title":"...",
+  //    "mimeTypes":["image/*",...],"suffixes":[".jpg",...]}
+  // 手写字符串拼接(项目内无 JSON 库依赖;title 做最小转义)。suffixes 为空数组
+  // 表示不限(filterAll 或无 filter)。
+  nsCString json;
+  json.AppendLiteral("{\"id\":");
+  json.AppendInt(static_cast<int64_t>(callbackId));
+  json.AppendLiteral(",\"mode\":\"");
+  json.Append(modeStr);
+  json.AppendLiteral("\",\"title\":\"");
+  // 标题转义:仅处理双引号与反斜杠,避免破坏 JSON
+  const NS_ConvertUTF16toUTF8 titleUtf8(mTitle);
+  for (uint32_t i = 0; i < titleUtf8.Length(); ++i) {
+    const char c = titleUtf8[i];
+    if (c == '"' || c == '\\') {
+      json.Append('\\');
+    }
+    json.Append(c);
+  }
+  json.AppendLiteral("\",\"mimeTypes\":[");
+  for (uint32_t i = 0; i < mFilters.Length(); ++i) {
+    if (i > 0) {
+      json.Append(',');
+    }
+    json.Append('"');
+    const NS_ConvertUTF16toUTF8 mime(mFilters[i]);
+    json.Append(mime);
+    json.Append('"');
+  }
+  // suffixes 字段:后缀过滤列表(在 mimeTypes 之后)。空数组表示不限。
+  // 后缀均为 ASCII(".jpg" 等),无需转义。
+  json.AppendLiteral("],\"suffixes\":[");
+  for (uint32_t i = 0; i < mSuffixFilters.Length(); ++i) {
+    if (i > 0) {
+      json.Append(',');
+    }
+    json.Append('"');
+    json.Append(mSuffixFilters[i]);
+    json.Append('"');
+  }
+  json.AppendLiteral("]}");
+
+  OHOS_LOG("[FilePicker] Open 派发请求 id=%d mode=%s json=%s\n",
+           (int)callbackId, modeStr, json.get());
+
+  // 经桥转发到 libgeckoview.so → ArkTS。桥内部处理"未注册"情况(自动 cancel)。
+  OHOSFilePickerBridge_Request(json.get(), static_cast<int32_t>(callbackId));
+
+  // 立即返回 NS_OK,不阻塞调用方;回填走 OnPicked
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+OHOSFilePicker::GetFile(nsIFile** aFile) {
+  // OnPickedInternal 写入 mSelectedPath 后,nsBaseFilePicker 通过此方法取结果
+  NS_ENSURE_ARG_POINTER(aFile);
+  *aFile = nullptr;
+  if (mSelectedPath.IsEmpty()) {
+    return NS_OK;
+  }
+  // ArkTS 下发的是沙箱真实路径(复制后的 picked_* 文件);
+  // NS_NewLocalFile 经临时 nsCOMPtr 取出后 forget 给裸指针参数。
+  nsCOMPtr<nsIFile> localFile;
+  nsresult rv = NS_NewLocalFile(mSelectedPath, getter_AddRefs(localFile));
+  if (NS_FAILED(rv)) {
+    OHOS_LOG("[FilePicker] GetFile NS_NewLocalFile 失败 rv=0x%x path=%s\n",
+             (unsigned)rv,
+             NS_ConvertUTF16toUTF8(mSelectedPath).get());
+    return rv;
+  }
+  localFile.forget(aFile);
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+OHOSFilePicker::GetFiles(nsISimpleEnumerator** aFiles) {
+  // 多文件结果枚举(照抄 widget/gtk/nsFilePicker.cpp:391-400 模式)。
+  // DOM multiple 走 nsBaseFilePicker::GetDomFileOrDirectoryEnumerator
+  //   → 基类 GetFiles(本方法,nsBaseFilePicker.cpp:460-479)。
+  // 遍历 OnPickedInternal 写入的 mSelectedPaths,逐个 NS_NewLocalFile 入
+  // nsCOMArray<nsIFile>,再 NS_NewArrayEnumerator 包装。
+  // 空数组也返回合法空枚举器(不返回失败,避免破坏 DOM 迭代)。
+  NS_ENSURE_ARG_POINTER(aFiles);
+  *aFiles = nullptr;
+  nsCOMArray<nsIFile> files;
+  for (const nsString& p : mSelectedPaths) {
+    if (p.IsEmpty()) continue;
+    nsCOMPtr<nsIFile> localFile;
+    nsresult rv = NS_NewLocalFile(p, getter_AddRefs(localFile));
+    if (NS_FAILED(rv)) {
+      OHOS_LOG("[FilePicker] GetFiles NS_NewLocalFile 失败 rv=0x%x path=%s\n",
+               (unsigned)rv, NS_ConvertUTF16toUTF8(p).get());
+      continue;  // 跳过单项失败,尽量返回有效结果
+    }
+    files.AppendObject(localFile);
+  }
+  return NS_NewArrayEnumerator(aFiles, files, NS_GET_IID(nsIFile));
+}
+
+NS_IMETHODIMP
+OHOSFilePicker::GetFileURL(nsIURI** aFileURL) {
+  // P0 极简实现:把选中路径拼成 file:// URL 后 NS_NewURI。
+  // HTMLInputElement 主流程走 GetDomFileOrDirectory → GetFile(不经本方法),
+  // 此处为完整性兜底(nsIFilePicker 纯虚)。
+  NS_ENSURE_ARG_POINTER(aFileURL);
+  *aFileURL = nullptr;
+  if (mSelectedPath.IsEmpty()) {
+    return NS_OK;
+  }
+  nsAutoCString urlSpec;
+  urlSpec.AssignLiteral("file://");
+  AppendUTF16toUTF8(mSelectedPath, urlSpec);
+  return NS_NewURI(aFileURL, urlSpec);
+}
+
+NS_IMETHODIMP
+OHOSFilePicker::GetDefaultString(nsAString& aDefaultString) {
+  aDefaultString = mDefaultString;
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+OHOSFilePicker::SetDefaultString(const nsAString& aDefaultString) {
+  mDefaultString = aDefaultString;
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+OHOSFilePicker::GetDefaultExtension(nsAString& aDefaultExtension) {
+  aDefaultExtension = mDefaultExtension;
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+OHOSFilePicker::SetDefaultExtension(const nsAString& aDefaultExtension) {
+  mDefaultExtension = aDefaultExtension;
+  return NS_OK;
+}
+
+// 静态:由 OHOSFilePickerBridge 在主线程调用(经 runnable 派发)
+void OHOSFilePicker::OnPicked(int32_t aCallbackId, int32_t aResult,
+                              const char* aPathUtf8) {
+  RefPtr<OHOSFilePicker> inst;
+  if (!sPending.Remove(aCallbackId, &inst) || !inst) {
+    OHOS_LOG("[FilePicker] OnPicked 找不到实例 id=%d(可能已回填或未注册)\n",
+             (int)aCallbackId);
+    return;
+  }
+  nsCString path(aPathUtf8 ? aPathUtf8 : "");
+  inst->OnPickedInternal(aResult, path);
+}
+
+// 实例:在主线程回填选中结果并触发回调。按 mMode 分支:
+//   - modeOpen / modeGetFolder:path 为裸路径,写入 mSelectedPath
+//   - modeOpenMultiple:path 为 JSON 数组字符串(由 ArkTS 拼装),解析写入 mSelectedPaths
+void OHOSFilePicker::OnPickedInternal(int32_t aResult, const nsCString& aPath) {
+  OHOS_LOG("[FilePicker] OnPickedInternal result=%d mode=%d path=%s\n",
+           (int)aResult, (int)mMode, aPath.get());
+
+  nsIFilePicker::ResultCode retVal = nsIFilePicker::returnCancel;
+  if (aResult == 0 && !aPath.IsEmpty()) {
+    if (mMode == modeOpenMultiple) {
+      // 多文件:aPath 形如 ["/a/picked_x","/b/picked_y"]。
+      // 手写极简解析:逐字符扫描找 "..." 项,处理 \" 与 \\ 转义。
+      // 本工程路径由 ArkTS 自生成(picked_ 前缀的沙箱复制文件),
+      // 不含奇异字符,保持简单但注释说明转义处理已覆盖通用情形。
+      const nsCString& s = aPath;
+      const uint32_t n = s.Length();
+      for (uint32_t i = 0; i < n; ++i) {
+        if (s[i] != '"') continue;  // 跳到下一个字符串起始引号
+        nsCString item;
+        item.SetCapacity(16);
+        bool closed = false;
+        for (uint32_t j = i + 1; j < n; ++j) {
+          const char c = s[j];
+          if (c == '\\' && j + 1 < n) {
+            const char next = s[j + 1];
+            if (next == '"' || next == '\\') {
+              item.Append(next);  // 转义: \" → ", \\ → \
+              ++j;
+              continue;
+            }
+            // 其他 \x 原样保留(路径中罕见)
+            item.Append(c);
+            continue;
+          }
+          if (c == '"') {
+            closed = true;
+            i = j;  // 推进外层游标到闭合引号,避免引号内再次触发
+            break;
+          }
+          item.Append(c);
+        }
+        if (closed && !item.IsEmpty()) {
+          nsString wide;
+          CopyUTF8toUTF16(item, wide);
+          mSelectedPaths.AppendElement(std::move(wide));
+        }
+      }
+      if (mSelectedPaths.IsEmpty()) {
+        // 解析为空/失败:按取消处理(避免返回 returnOK 但无结果)
+        OHOS_LOG("[FilePicker] OnPickedInternal multiple 解析为空 path=%s\n",
+                 aPath.get());
+        retVal = nsIFilePicker::returnCancel;
+      } else {
+        retVal = nsIFilePicker::returnOK;
+      }
+    } else {
+      // modeOpen / modeGetFolder:裸路径
+      CopyUTF8toUTF16(aPath, mSelectedPath);
+      retVal = nsIFilePicker::returnOK;
+    }
+  }
+
+  if (mCallback) {
+    mCallback->Done(retVal);
+  }
+  // 清理:防止重复回填
+  mCallback = nullptr;
+}
+
+}  // namespace widget
+}  // namespace mozilla
diff --git a/widget/openharmony/OHOSFilePicker.h b/widget/openharmony/OHOSFilePicker.h
new file mode 100644
index 0000000000..743de55614
--- /dev/null
+++ b/widget/openharmony/OHOSFilePicker.h
@@ -0,0 +1,114 @@
+/* -*- Mode: C++; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef widget_openharmony_OHOSFilePicker_h__
+#define widget_openharmony_OHOSFilePicker_h__
+
+#include "nsBaseFilePicker.h"
+#include "nsIFile.h"
+#include "nsCOMPtr.h"
+#include "nsString.h"
+#include "nsTArray.h"
+#include "nsTHashMap.h"
+#include "nsHashKeys.h"  // nsUint32HashKey(nsIntegralHashKey<uint32_t>)
+#include "mozilla/RefPtr.h"
+
+class nsIURI;
+
+namespace mozilla {
+namespace widget {
+
+/**
+ * OpenHarmony 文件选择器(v118: 接入系统 Picker)。
+ *
+ * 数据流(P1 已支持 single / multiple / folder 三种模式):
+ *   <input type=file> → nsBaseFilePicker::Open → 本类 Open
+ *     → 构造 JSON 请求 → OHOSFilePickerBridge_Request
+ *     → gFilePickerRequestCb(libgeckoview.so 注册的函数指针)
+ *     → OHOS_FilePickerRequestNotify → napi_threadsafe_function
+ *     → ArkTS FirefoxBridge filePickerCallback
+ *     → picker.DocumentViewPicker.select → resolveFilePicker(callbackId, 0, path)
+ *     → GeckoBridge_ResolveFilePicker(libxul.so 导出)
+ *     → NS_DispatchToMainThread → OnPicked → OnPickedInternal
+ *     → nsLocalFile InitWithNativePath → mCallback->Done(returnOK)
+ *
+ * 回填路径契约(NAPI 签名零改动):
+ *   - single(modeOpen)/folder(modeGetFolder):path 为裸路径字符串,
+ *     OnPickedInternal 写入 mSelectedPath,GetFile 读出。
+ *   - multiple(modeOpenMultiple):path 为 JSON 数组字符串,
+ *     形如 ["/path/picked_a","/path/picked_b"](由 ArkTS 侧拼装),
+ *     OnPickedInternal 逐项解析写入 mSelectedPaths,GetFiles 枚举读出
+ *     (DOM multiple 走 GetDomFileOrDirectoryEnumerator→基类→GetFiles)。
+ *
+ * 回填路径被桥调用 GeckoBridge_ResolveFilePicker 时可能不在主线程,
+ *   故内部用 NS_DispatchToMainThread 派发(见 OHOSFilePickerBridge.cpp)。
+ *   OnPicked 由派发的 runnable 在主线程调用,保证 mCallback->Done 在主线程。
+ */
+class OHOSFilePicker final : public nsBaseFilePicker {
+ public:
+  NS_DECL_ISUPPORTS
+
+  OHOSFilePicker() = default;
+
+  // 工厂构造(供 components.conf 的 'constructor' 使用,XPCOM 注册入口)
+  // 返回 already_AddRefed<OHOSFilePicker>(非 nsIFilePicker),匹配
+  // gen_static_components 的 static_assert(is_base_of<type, T>) 校验。
+  static already_AddRefed<OHOSFilePicker> Create();
+
+  // nsIFilePicker(未被 nsBaseFilePicker 实现的纯虚方法)
+  NS_IMETHOD AppendFilter(const nsAString& aTitle,
+                          const nsAString& aFilter) override;
+  NS_IMETHOD AppendFilters(int32_t aFilterMask) override;
+  NS_IMETHOD Open(nsIFilePickerShownCallback* aCallback) override;
+  NS_IMETHOD GetFile(nsIFile** aFile) override;
+  NS_IMETHOD GetFiles(nsISimpleEnumerator** aFiles) override;
+  NS_IMETHOD GetFileURL(nsIURI** aFileURL) override;
+  NS_IMETHOD GetDefaultString(nsAString& aDefaultString) override;
+  NS_IMETHOD SetDefaultString(const nsAString& aDefaultString) override;
+  NS_IMETHOD GetDefaultExtension(nsAString& aDefaultExtension) override;
+  NS_IMETHOD SetDefaultExtension(const nsAString& aDefaultExtension) override;
+
+  // 由 OHOSFilePickerBridge(经 runnable)在主线程调用,完成回调回填。
+  // aResult: 0=用户确认选中, 非 0=取消/失败。
+  // aPathUtf8: 选中文件的路径/URI(UTF-8);取消时可为空。
+  static void OnPicked(int32_t aCallbackId, int32_t aResult,
+                       const char* aPathUtf8);
+
+ protected:
+  virtual ~OHOSFilePicker() = default;
+
+  // nsBaseFilePicker
+  void InitNative(nsIWidget* aParent, const nsAString& aTitle) override;
+
+ private:
+  // 主线程处理选中结果(由静态 OnPicked 转发到实例)
+  void OnPickedInternal(int32_t aResult, const nsCString& aPath);
+
+  // 当前 pending 回调(Open 时存,OnPickedInternal 后清空)
+  nsCOMPtr<nsIFilePickerShownCallback> mCallback;
+  // 单文件/文件夹选中结果(OnPickedInternal 写入,GetFile 读出),UTF-16 路径
+  nsString mSelectedPath;
+  // 多文件选中结果(OnPickedInternal 写入,GetFiles 枚举读出),UTF-16 路径数组
+  nsTArray<nsString> mSelectedPaths;
+  // 默认文件名/扩展名存根(对齐 GTK nsFilePicker 的存根语义)
+  nsString mDefaultString;
+  nsString mDefaultExtension;
+  // 对话框标题(InitNative 存)
+  nsString mTitle;
+  // filter 掩码转换后的 MIME 字符串(image/* 等),下发到 ArkTS
+  nsTArray<nsString> mFilters;
+  // filter 后缀映射(image→.jpg/.png... 或 glob "*.jpg;*.png" 解析后),
+  // 形如 ".jpg";下发到 ArkTS 作为后缀过滤(空数组=不限)。
+  nsTArray<nsCString> mSuffixFilters;
+
+  // 静态回调登记表:callbackId → 实例(Open 时插入,OnPicked 时移除)
+  static nsTHashMap<nsUint32HashKey, RefPtr<OHOSFilePicker>> sPending;
+  static uint32_t sNextCallbackId;
+};
+
+}  // namespace widget
+}  // namespace mozilla
+
+#endif  // widget_openharmony_OHOSFilePicker_h__
diff --git a/widget/openharmony/OHOSFilePickerBridge.cpp b/widget/openharmony/OHOSFilePickerBridge.cpp
new file mode 100644
index 0000000000..e9063e0938
--- /dev/null
+++ b/widget/openharmony/OHOSFilePickerBridge.cpp
@@ -0,0 +1,110 @@
+/* -*- Mode: C++; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// v118: 文件选择器跨 .so 桥实现(libxul.so 导出端)
+//
+// 三个导出符号(均 visibility("default"),libxul.symbols 中登记):
+//   GeckoBridge_SetFilePickerCallback   libgeckoview.so → libxul.so(注册请求回调)
+//   GeckoBridge_ResolveFilePicker       libgeckoview.so → libxul.so(ArkTS 回填结果)
+// 内部转发函数:
+//   OHOSFilePickerBridge_Request        libxul.so 内部 → gFilePickerRequestCb
+//
+// GeckoBridge_ResolveFilePicker 的 aPathUtf8 语义(P1 起):
+//   桥本身不解释 aPathUtf8 内容,只做深拷贝并派发到主线程交给
+//   OHOSFilePicker::OnPicked/OnPickedInternal。具体语义由 picker 实例的 mMode 决定:
+//     - modeOpen/modeGetFolder:裸路径字符串
+//     - modeOpenMultiple:JSON 数组字符串 ["/a","/b"](由 ArkTS 拼装)
+//   NAPI 侧 resolveFilePicker(id, result, path) 签名不变。
+
+#include "OHOSFilePickerBridge.h"
+#include "OHOSFilePicker.h"
+
+#include "nsString.h"        // nsCString
+#include "nsThreadUtils.h"   // NS_DispatchToMainThread / mozilla::Runnable
+
+#include "OHOSDebug.h"  // OHOS_LOG
+
+namespace mozilla {
+namespace widget {
+
+// 请求回调函数指针(由 libgeckoview.so 通过 GeckoBridge_SetFilePickerCallback 注册)
+// 签名:(请求 JSON, callbackId)。libgeckoview.so 内部再 tsfn 投递到 ArkTS。
+static void (*gFilePickerRequestCb)(const char* aJson, int32_t aCallbackId) =
+    nullptr;
+
+// libxul.so 内部入口:OHOSFilePicker::Open 调用,转发请求到 libgeckoview.so
+void OHOSFilePickerBridge_Request(const char* aJson, int32_t aCallbackId) {
+  if (!gFilePickerRequestCb) {
+    // 桥未注册(ArkTS 层尚未 initFirefox 或 libgeckoview.so 未注册回调)。
+    // 直接回 cancel 防止 Open 的回调永久挂起(<input file> 进入"用户取消")。
+    OHOS_LOG("[FilePicker] 请求桥未注册,id=%d 自动取消\n", (int)aCallbackId);
+    OHOSFilePicker::OnPicked(aCallbackId, 1, "");
+    return;
+  }
+  gFilePickerRequestCb(aJson, aCallbackId);
+}
+
+}  // namespace widget
+}  // namespace mozilla
+
+// ============================================================================
+// 导出符号(visibility default,在 libxul.symbols 登记,供 libgeckoview.so 调用)
+// ============================================================================
+
+// libgeckoview.so 启动时调:RegisterURLCallback 等价物,登记请求回调函数指针
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_SetFilePickerCallback(
+    void (*cb)(const char* aJson, int32_t aCallbackId)) {
+  mozilla::widget::gFilePickerRequestCb = cb;
+  OHOS_LOG("[FilePicker] GeckoBridge_SetFilePickerCallback 已注册 cb=%p\n",
+           (void*)cb);
+}
+
+// 主线程 runnable:承载深拷贝的 path 字符串,在主线程调 OHOSFilePicker::OnPicked。
+// 注意:aPathUtf8 来自 libgeckoview.so 的 NAPI 字符串,生命周期仅限本调用帧,
+// 必须在此深拷贝进 runnable,跨线程派发后才能安全使用。
+class ResolveFilePickerRunnable final : public mozilla::Runnable {
+ public:
+  ResolveFilePickerRunnable(int32_t aCallbackId, int32_t aResult,
+                            const nsCString& aPath)
+      : mozilla::Runnable("ResolveFilePickerRunnable"),
+        mCallbackId(aCallbackId),
+        mResult(aResult),
+        mPath(aPath) {}
+
+  NS_IMETHOD Run() override {
+    mozilla::widget::OHOSFilePicker::OnPicked(mCallbackId, mResult,
+                                               mPath.get());
+    return NS_OK;
+  }
+
+ private:
+  int32_t mCallbackId;
+  int32_t mResult;
+  nsCString mPath;  // 深拷贝,跨线程安全
+};
+
+// libgeckoview.so 调用(ArkTS resolveFilePicker → NAPI):回填选择结果。
+// 可能在 ArkTS 主线程外的线程被调用,故 NS_DispatchToMainThread 保证
+// OHOSFilePicker::OnPicked 在 Gecko 主线程执行(mCallback->Done 须主线程)。
+// aPathUtf8 内容语义见文件头注释:由 picker 实例的 mMode 解释
+//   (single/folder=裸路径;multiple=JSON 数组字符串)。
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_ResolveFilePicker(int32_t aCallbackId,
+                                              int32_t aResult,
+                                              const char* aPathUtf8) {
+  nsCString path(aPathUtf8 ? aPathUtf8 : "");
+  OHOS_LOG("[FilePicker] GeckoBridge_ResolveFilePicker id=%d result=%d path=%s\n",
+           (int)aCallbackId, (int)aResult, path.get());
+  nsresult rv = NS_DispatchToMainThread(
+      mozilla::MakeAndAddRef<ResolveFilePickerRunnable>(aCallbackId, aResult,
+                                                        path));
+  if (NS_FAILED(rv)) {
+    OHOS_LOG("[FilePicker] ResolveFilePicker 派发主线程失败 rv=0x%x\n",
+             (unsigned)rv);
+    // 兜底:派发失败时(主线程已退出等)直接调用,虽非主线程但避免悬挂
+    mozilla::widget::OHOSFilePicker::OnPicked(aCallbackId, aResult, path.get());
+  }
+}
