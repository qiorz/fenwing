+void nsWindow::OnMouseEvent(int32_t aAction, float aX, float aY,
+                            int32_t aButton, int64_t aTime,
+                            bool aRoutedToPopup) {
+  // OHOS 鼠标事件转发:将 OHOS action(1=PRESS,2=RELEASE,3=MOVE,4=HOVER)
+  // 和 button(0=左,1=中,2=右) 转换为 Gecko WidgetMouseEvent 并分发到 content。
+  // v222 起滚轮走 DispatchInputEvent(mAPZC 门控切入 APZ,见 OnWheelEvent);
+  // 本函数鼠标键路由同 OnTouchEvent(v221 注释史见彼处,v245 更正)。
+  EventMessage msg;
+  switch (aAction) {
+    case 1: msg = eMouseDown; break;
+    case 2: msg = eMouseUp; break;
+    case 3: msg = eMouseMove; break;  // MOVE(带按键移动)
+    case 4: msg = eMouseMove; break;  // HOVER(无按键移动)
+    default: return;
+  }
+
+  MouseButton btn;
+  switch (aButton) {
+    case 0: btn = MouseButton::ePrimary; break;    // 左键
+    case 1: btn = MouseButton::eMiddle; break;     // 中键
+    case 2: btn = MouseButton::eSecondary; break;  // 右键
+    default: btn = MouseButton::ePrimary; break;
+  }
+
+  LayoutDeviceIntPoint mousePoint(static_cast<int32_t>(aX),
+                                  static_cast<int32_t>(aY));
+
+  // v159: pan 激活期间丢弃全部鼠标事件 —— OHOS 系统"触摸→合成鼠标"通道
+  // 会把手指拖动合成为 mouse MOVE/UP(触发拖选文字/幻影点击),与 pan 滚动
+  // 叠加成"边滚边选"。物理鼠标与触摸 pan 物理上互斥,不受影响;fling 期间
+  // 不抑制(手指已离开,残留合成 UP 需放行以配对系统侧 PRESS 状态)。
+  if (mPanActive) {
+    return;
+  }
+
+  // v155: tap 合成去重 —— 主键 mouse down 到达即证明系统"触摸→合成鼠标"
+  // 通道存活(或物理左键点击,tap 期间物理点击与合成互斥,统一不合成),
+  // 取消本 tap 的 Gecko 侧合成判定。须在 CheckForRollup 之前:无论该 down
+  // 是否被 rollup 消费,系统已接管本 tap 的 click 生成。
+  if (msg == eMouseDown && btn == MouseButton::ePrimary) {
+    // v172 临时诊断([OHOSMENU_DIAG]):系统合成 mouse 流到达取证,定位后移除。
+    OHOS_DiagLog("[OHOSMENU_DIAG] 系统mouse down 到达 pos=(%.0f,%.0f)", aX, aY);
+    if (!mTapSynthSawSystemMouse) {
+      mTapSynthSawSystemMouse = true;
+      CancelTapSynthTimer();
+    }
+  }
+
+  // v111: popup 打开时,mousedown 先 CheckForRollup —— 点击 popup 外则
+  // Rollup 关闭菜单并消费事件(修复 ≡ 菜单点外部无法关闭)。
+  // v158: 路由进 popup 的事件跳过(同 OnTouchEvent 的 aRoutedToPopup 语义)。
+  if (!aRoutedToPopup && msg == eMouseDown &&
+      CheckForRollup(mousePoint.x, mousePoint.y)) {
+    return;
+  }
+
+  WidgetMouseEvent event(true, msg, this, WidgetMouseEvent::eReal);
+  event.mRefPoint = mousePoint;
+  event.mButton = btn;
+  // mClickCount: down/up 为 1(单击),move 为 0
+  event.mClickCount = (msg == eMouseDown || msg == eMouseUp) ? 1 : 0;
+
+  // v103 根因修复(百度"百度一下"按钮点击概率性无反应):
+  //
+  // 背景:OHOS XComponent 对物理触摸同时派发两条事件流到 Gecko:
+  //   流 A (mouse): DispatchMouseEvent C 回调 → OnMouseEvent → eMouseDown/eMouseUp
+  //   流 B (touch): DispatchTouchEvent C 回调 → OnTouchEvent → eTouchStart/eTouchEnd
+  //
+  // Gecko 的 click target 计算依赖 mInputSource 区分真实鼠标与触摸合成鼠标:
+  //   PointerEventHandler::ShouldDispatchClickEventOnCapturingElement() 在
+  //   dispatch_click_on_pointer_capturing_element=true(默认)且
+  //   except_touch=true(默认,对齐 Chrome 136)时,只有当 eMouseUp 的
+  //   mInputSource == MOZ_SOURCE_TOUCH 才会跳过"重定向 click target 到
+  //   pointerCapturingElementAtLastPointerUp"这一步。
+  //
+  // 此前 OnMouseEvent 未设置 mInputSource,WidgetMouseEventBase 构造函数
+  // 把它默认为 MOZ_SOURCE_MOUSE(=1,见 widget/MouseEvents.h:139)。
+  // 后果:Gecko 认为 eMouseUp 来自真实鼠标 → ShouldDispatch... 返回 true →
+  //   click target 被重定向到 eTouchEnd→ePointerUp 路径设置的
+  //   pointerCapturingElementAtLastPointerUp(往往是 touchstart 命中的
+  //   外层 <div>/<span> 容器,而非 <input type=submit>)。
+  //   → DispatchClickEvents 的 aClickTarget=div/span,无 activationTarget,
+  //     HTMLButtonElement::GetEventTargetParent 的 mWantsActivationBehavior
+  //     未设置 → ActivationBehavior 不触发 → 表单 DoSubmit 不执行。
+  //   → 表现为"百度一下"按钮点击概率性无反应(touchstart 命中容器 vs
+  //     按钮的时机决定是否触发)。
+  //
+  // 修复:把 OnMouseEvent 发出的所有 WidgetMouseEvent 的 mInputSource 标记为
+  //   MOZ_SOURCE_TOUCH。OHOS 触屏设备上,XComponent 的 MouseEvent_Callback
+  //   本质就是触摸合成(物理鼠标输入极少,且即使有,标记为 TOUCH 仅影响
+  //   click target 重定向与 :active 伪类,不影响 click 派发本身)。
+  //   这让 except_touch 豁免生效,click target 不再被 touch 通道的 capture
+  //   element 篡夺,回到 mousedown/mouseup 共同祖先(即真实命中的 submit button)。
+  //
+  // 副作用评估:
+  //   1. EventStateManager::NeedsActiveContentChange 对 TOUCH 来源跳过
+  //      :active 伪类设置(注释说"由 APZ 处理")。OHOS stage2 跳过 APZ,
+  //      故触屏点击时按钮无 :active 视觉反馈(按下高亮)。功能不受影响,
+  //      视觉细节可后续单独修复(如直接在 nsWindow 合成 :active)。
+  //   2. NotifyTargetUserActivation 对非 MOUSE 来源改在 ePointerUp 触发
+  //      (而非 ePointerDown),用户激活仍会发生,仅时机略晚,无功能影响。
+  //   3. SetFocus 增加 FLAG_BYTOUCH,语义正确(触屏驱动焦点),无副作用。
+  // v114 修正:中/右键不可能由触摸合成(触摸合成鼠标流只产主键事件),
+  // 收到非主键即铁证为物理鼠标(2in1 触控板/键鼠),恢复 MOZ_SOURCE_MOUSE
+  // 语义 —— 影响 :active 伪类、user-activation 时机与下方 eContextMenu 派发。
+  // 主键仍按 v103 标记 TOUCH(触摸为主输入,物理左键标记 TOUCH 无副作用:
+  // 鼠标路径不产生 pointerCapturingElement,无 click target 重定向)。
+  const bool isPhysicalMouseButton = (btn != MouseButton::ePrimary);
+  event.mInputSource = isPhysicalMouseButton
+      ? mozilla::dom::MouseEvent_Binding::MOZ_SOURCE_MOUSE
+      : mozilla::dom::MouseEvent_Binding::MOZ_SOURCE_TOUCH;
+
+  // v103 诊断:记录 mInputSource 标记,便于设备验证 click target 解析路径
+  // 输入流畅性:MOVE(拖拽/悬停高频)不再写 OHOS_DiagLog(同步文件 IO);
+  //   DOWN/UP 低频,保留诊断。
+  if (msg != eMouseMove) {
+    OHOS_DiagLog("[XRE_CLICK] OnMouseEvent in msg=%d pos=(%d,%d) btn=%d "
+            "inputSource=%s(%d) action=%d",
+            (int)msg, mousePoint.x, mousePoint.y, (int)aButton,
+            isPhysicalMouseButton ? "MOUSE" : "TOUCH",
+            (int)event.mInputSource, (int)aAction);
+  }
+
+  // v56 诊断:记录事件坐标、窗口类型、派发前后 status,定位"点击不生效"根因
+  nsEventStatus status = DispatchEvent(&event);
+  if (msg == eMouseDown || msg == eMouseUp) {
+    OHOS_DiagLog("[XRE] OnMouseEvent msg=%d pos=(%d,%d) btn=%d this=%p type=%d "
+            "mBounds=(%d,%d,%dx%d) status=%d listener=%p attached=%p",
+            (int)msg, mousePoint.x, mousePoint.y, (int)aButton, (void*)this,
+            (int)mWindowType, mBounds.X(), mBounds.Y(),
+            mBounds.Width(), mBounds.Height(), (int)status,
+            (void*)mWidgetListener, (void*)mAttachedWidgetListener);
+  }
+
+  // v114: 右键按下补发 eContextMenu(GTK 惯例 widget/gtk/nsWindow.cpp:
+  //   DispatchContextMenuEventFromMouseEvent,press 触发,
+  //   ui_context_menus_after_mouseup 默认 false)。
+  // 此前 widget/openharmony 全目录零 eContextMenu,物理右键只发
+  // eMouseDown/eMouseUp,ESM 无从产生 DOM contextmenu 事件,
+  // browser.xhtml 的 contentAreaContextMenu 因此永不弹出。
+  // stage2 跳 APZ:与主事件同走 DispatchEvent。v111 CheckForRollup 已在上方
+  // 拦截"点 popup 外"场景并消费,到达此处即无 Rollup 冲突。
+  // 触屏长按 → NotifyLongTap 的等价物留待后续(需 touch 路径按住计时器,
+  // 中等工作量);OH_NativeXComponent_MouseEvent 无 sourceType/deviceId
+  // 字段,C 层无法直接区分物理/合成,故以"非主键"为物理鼠标判据。
+  if (msg == eMouseDown && btn == MouseButton::eSecondary) {
+    WidgetMouseEvent contextMenuEvent(true, eContextMenu, this,
+                                      WidgetMouseEvent::eReal);
+    contextMenuEvent.mRefPoint = mousePoint;
+    contextMenuEvent.mButton = MouseButton::eSecondary;
+    contextMenuEvent.mClickCount = 1;
+    contextMenuEvent.mInputSource =
+        mozilla::dom::MouseEvent_Binding::MOZ_SOURCE_MOUSE;
+    DispatchEvent(&contextMenuEvent);
+    OHOS_DiagLog("[XRE] OnMouseEvent 右键按下,补发 eContextMenu pos=(%d,%d)",
+            mousePoint.x, mousePoint.y);
+  }
+}
