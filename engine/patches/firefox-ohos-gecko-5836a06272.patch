+// ============================================================================
+// OHOS 硬件 vsync 源:用 OH_NativeVSync 驱动 Gecko 渲染管线
+// ============================================================================
+// 参考 servo 的 VsyncRefreshDriver:用 OH_NativeVSync_RequestFrame 驱动渲染。
+// OHOS 的 XComponent surface 内容只有和 RenderService 的 vsync 同步才会被合成上屏。
+// libxul.so 用 -fvisibility=hidden 编译,无法直接链接 libnative_vsync.so 的符号,
+// 用 dlopen + dlsym 在运行时加载。
+#include <dlfcn.h>
+#include <time.h>  // v218: vsync 硬件时间戳重建 clock_gettime
+#include <atomic>  // v222: 帧节奏仪表 vsync 锚点
+
+// v222: 帧节奏仪表(FRAME_STATS)的 vsync 侧锚点。写点在 vsync 回调线程,
+// 读点在 RenderThread(RenderCompositorEGL::EndFrame),统计用途 relaxed 足够。
+// 存的是 OH_NativeVSync 回调的 timestamp 参数本身(硬件 vsync 时刻,
+// monotonic boot 时钟 ns 域,与 CLOCK_MONOTONIC 同域,v218 已实证)。
+// libxul 内部符号(-fvisibility=hidden 下同 DSO 链接可通,GeckoBridge_AnyPopupOpen 同模式)。
+static std::atomic<long long> gLastVsyncMonoNs{0};
+extern "C" long long OHOS_LastVsyncMonoNs() {
+  return gLastVsyncMonoNs.load(std::memory_order_relaxed);
+}
+// v226: vsync 线程 QoS 助手(RenderThread.cpp 定义,default visibility)。
+extern "C" void OHOS_ApplyThreadQoS(int aQoS, const char* aThreadName);
+
+// OH_NativeVSync 函数指针类型
+typedef struct OH_NativeVSync OH_NativeVSync;
+typedef void (*OH_NativeVSync_FrameCallback)(long long timestamp, void* data);
+typedef OH_NativeVSync* (*OH_NativeVSync_Create_t)(const char* name, unsigned int length);
+typedef void (*OH_NativeVSync_Destroy_t)(OH_NativeVSync* nativeVsync);
+typedef int (*OH_NativeVSync_RequestFrame_t)(OH_NativeVSync* nativeVsync,
+                                              OH_NativeVSync_FrameCallback callback, void* data);
+// v214: 查询真实 vsync 周期(ns)—— OH_NativeVSync_GetPeriod
+typedef int (*OH_NativeVSync_GetPeriod_t)(OH_NativeVSync* nativeVsync,
+                                          long long* period);
+// v231: 声明期望回调帧率范围(ABI 同 native_vsync.h 的
+// OH_NativeVSync_ExpectedRateRange{int32_t min,max,expected})
+typedef struct { int32_t min; int32_t max; int32_t expected; } OHOS_RateRange;
+typedef int (*OH_NativeVSync_SetExpectedFrameRateRange_t)(
+    OH_NativeVSync* nativeVsync, OHOS_RateRange* range);
+
+class OHOSVsyncSource : public mozilla::gfx::VsyncSource {
+ public:
+  OHOSVsyncSource() : mEnabled(false), mVsync(nullptr), mRateMS(-1.0) {
+    // dlopen libnative_vsync.so
+    mHandle = dlopen("libnative_vsync.so", RTLD_LAZY | RTLD_GLOBAL);
+    if (mHandle) {
+      mCreate = (OH_NativeVSync_Create_t)dlsym(mHandle, "OH_NativeVSync_Create");
+      mDestroy = (OH_NativeVSync_Destroy_t)dlsym(mHandle, "OH_NativeVSync_Destroy");
+      mRequestFrame = (OH_NativeVSync_RequestFrame_t)dlsym(mHandle, "OH_NativeVSync_RequestFrame");
+      mGetPeriod = (OH_NativeVSync_GetPeriod_t)dlsym(mHandle, "OH_NativeVSync_GetPeriod");
+      mSetRateRange =
+          (OH_NativeVSync_SetExpectedFrameRateRange_t)dlsym(
+              mHandle, "OH_NativeVSync_SetExpectedFrameRateRange");
+      fprintf(stderr, "[OHOS_VSYNC] dlopen libnative_vsync.so 成功 mCreate=%p mRequestFrame=%p mGetPeriod=%p mSetRateRange=%p\n",
+              (void*)mCreate, (void*)mRequestFrame, (void*)mGetPeriod, (void*)mSetRateRange);
+    } else {
+      fprintf(stderr, "[OHOS_VSYNC] dlopen libnative_vsync.so 失败: %s\n", dlerror());
+    }
+    mVsyncThread = new base::Thread("OHOSVsyncThread");
+    MOZ_RELEASE_ASSERT(mVsyncThread->Start());
+  }
+
+  ~OHOSVsyncSource() override {
+    DisableVsync();
+    if (mVsync && mDestroy) { mDestroy(mVsync); mVsync = nullptr; }
+    if (mVsyncThread) { mVsyncThread->Stop(); delete mVsyncThread; }
+    if (mHandle) dlclose(mHandle);
+  }
+
+  void EnableVsync() override {
+    if (mEnabled) return;
+    mEnabled = true;
+    mVsyncThread->message_loop()->PostTask(
+        NewRunnableMethod("OHOSVsyncSource::EnableVsyncInternal", this,
+                          &OHOSVsyncSource::EnableVsyncInternal));
+  }
+
+  void DisableVsync() override { mEnabled = false; }
+  bool IsVsyncEnabled() override { return mEnabled; }
+  // v214: 查询真实 vsync 周期而非硬编码 60Hz —— RefreshDriver 用该值计算
+  // 帧预算/动画目标合成时间(outputTime = now + rate),60Hz 硬编码在 120Hz
+  // 屏上会让调度器以为有 16.7ms 预算而实际只有 8.3ms,产生迟到帧。
+  // GetPeriod 返回 ns;查询失败回退 120Hz(主流高刷平板)。缓存一次性结果。
+  TimeDuration GetVsyncRate() override {
+    if (mRateMS <= 0.0) {
+      long long periodNs = 0;
+      if (mGetPeriod && mVsync &&
+          mGetPeriod(mVsync, &periodNs) == 0 && periodNs > 0) {
+        double queried = (double)periodNs / 1000000.0;
+        mRateMS = queried;
+        // v231: 查询值与实测偏差 >25% 采信实测(GetPeriod 可能返回面板能力值
+        // 而非 LTPO 当前态)
+        if (mTsSamples >= 8) {
+          double measured = mTsIvEMA / 1e6;
+          if (measured > 1.0 && measured < 100.0 &&
+              (queried < measured * 0.75 || queried > measured * 1.25)) {
+            mRateMS = measured;
+            fprintf(stderr,
+                    "[OHOS_VSYNC] GetPeriod=%.3fms 与实测 %.3fms 偏差>25%%,采信实测\n",
+                    queried, measured);
+          }
+        }
+        fprintf(stderr, "[OHOS_VSYNC] GetPeriod=%lldns (%.3fms ≈ %.1fHz)\n",
+                periodNs, mRateMS, 1000.0 / mRateMS);
+      } else if (mTsSamples >= 8 && mTsIvEMA > 1e6 && mTsIvEMA < 100e6) {
+        // v231: GetPeriod 不可用但已有实测样本——用实测,不再盲回退 120Hz
+        // (Pura X 实证:回退假设失真,面板实际 ~33Hz)
+        mRateMS = mTsIvEMA / 1e6;
+        fprintf(stderr,
+                "[OHOS_VSYNC] GetPeriod 不可用,实测周期 %.3fms ≈ %.1fHz (样本%d)\n",
+                mRateMS, 1000.0 / mRateMS, mTsSamples);
+      } else {
+        mRateMS = 1000.0 / 120.0;
+        fprintf(stderr, "[OHOS_VSYNC] GetPeriod 不可用且无实测样本,回退 120Hz\n");
+      }
+    }
+    return TimeDuration::FromMilliseconds(mRateMS);
+  }
+  void Shutdown() override {
+    DisableVsync();
+    if (mVsyncThread) { mVsyncThread->Stop(); delete mVsyncThread; mVsyncThread = nullptr; }
+  }
+
+ private:
+  void EnableVsyncInternal() {
+    if (!mCreate) { fprintf(stderr, "[OHOS_VSYNC] mCreate=nullptr, 无法创建 vsync\n"); return; }
+    // v226(审计C4): vsync 线程打 QoS(USER_INITIATED=3)。HM 调度器大小核
+    // 选核只看线程 QoS 属性,无标线程 futex 唤醒有 ~64ms 桶合并(TimerThread
+    // 教训)——帧节奏源头线程必须在大核。(助手定义于 RenderThread.cpp,
+    // default visibility 导出,libxul 内部链接)
+    OHOS_ApplyThreadQoS(3, "OHOSVsyncThread");
+    if (!mVsync) {
+      mVsync = mCreate("GeckoVsync", strlen("GeckoVsync"));
+      fprintf(stderr, "[OHOS_VSYNC] OH_NativeVSync_Create 返回 %p\n", (void*)mVsync);
+    }
+    // v231: 声明期望回调帧率范围。Pura X 实证:不声明时(expectedRefreshRate=-1)
+    // LTPO 自适应只给 vsync 通道 ~39Hz,滚动流畅度上限被钉死(面板支持
+    // 120/90/72/60/45)。min=30 保留静态页降频省电,max/expected=120 表达
+    // 活动期高刷意图。API 20+,dlsym 失败(旧系统)静默跳过。
+    if (mSetRateRange && mVsync) {
+      OHOS_RateRange range = {30, 120, 120};
+      int rc = mSetRateRange(mVsync, &range);
+      fprintf(stderr,
+              "[OHOS_VSYNC] SetExpectedFrameRateRange(30,120,120) rc=%d(%s)\n",
+              rc, rc == 0 ? "OK" : "FAIL");
+    }
+    RequestFrame();
+  }
+
+  void RequestFrame() {
+    if (!mVsync || !mRequestFrame || !mEnabled) return;
+    mRequestFrame(mVsync, OnVsyncCallback, this);
+  }
+
+  static void OnVsyncCallback(long long timestamp, void* data) {
+    OHOSVsyncSource* self = static_cast<OHOSVsyncSource*>(data);
+    if (!self || !self->mEnabled) return;
+    // v49: vsync 已验证正常(v48 确认 500+ 回调),降低日志频率避免冲刷诊断日志
+    static int sVsyncCount = 0;
+    if (sVsyncCount++ < 3 || sVsyncCount % 1000 == 0) {
+      fprintf(stderr, "[OHOS_VSYNC] OnVsyncCallback #%d ts=%lld\n", sVsyncCount, timestamp);
+    }
+    // v231: 回调时间戳间隔 EMA 实测周期(GetPeriod 失效设备的帧预算真值源)。
+    // 仅纳 1-100ms 合理间隔(跳过回调断流后的首差),EMA 平滑 LTPO 抖动。
+    // 写点仅本回调线程;与 mRateMS 同款 double 对齐读写约定(见下 C5 注释)。
+    {
+      const long long ivNs = timestamp - self->mLastVsyncTsNs;
+      self->mLastVsyncTsNs = timestamp;
+      if (ivNs > 1000000LL && ivNs < 100000000LL) {
+        if (self->mTsSamples == 0) {
+          self->mTsIvEMA = (double)ivNs;
+        } else {
+          self->mTsIvEMA += ((double)ivNs - self->mTsIvEMA) * 0.1;
+        }
+        self->mTsSamples++;
+      }
+    }
+    // v222: 帧节奏仪表锚点 — 记录硬件 vsync 时刻(RenderThread 的 EndFrame 读取)。
+    gLastVsyncMonoNs.store(timestamp, std::memory_order_relaxed);
+    // v226(审计C5): 周期重查——mRateMS 原为一次性缓存,LTPO 变频
+    // (120↔90↔60↔1Hz)后帧预算/outputTime 系统性失真且永不自愈。
+    // v243(P2-3): 重查间隔 1200(~10s)→120(~1s@120Hz),LTPO 变频后失真窗口
+    // 缩短 10 倍;改为内联直查 GetPeriod 且仅周期值显著变化(>10%)才更新+
+    // 打日志(高频重查下值稳定静默,防刷屏;EMA 择优逻辑保留在首查
+    // GetVsyncRate 不变)。写点仅本回调线程;double 对齐读写 arm64 实际原子。
+    if ((sVsyncCount % 120) == 0 && sVsyncCount > 0) {
+      long long requeryNs = 0;
+      if (self->mGetPeriod && self->mVsync &&
+          self->mGetPeriod(self->mVsync, &requeryNs) == 0 && requeryNs > 0) {
+        const double requeryMS = (double)requeryNs / 1000000.0;
+        if (self->mRateMS <= 0.0 || requeryMS < self->mRateMS * 0.9 ||
+            requeryMS > self->mRateMS * 1.1) {
+          fprintf(stderr, "[OHOS_VSYNC] 周期重查更新 %.3fms→%.3fms (回调#%d)\n",
+                  self->mRateMS, requeryMS, sVsyncCount);
+          self->mRateMS = requeryMS;
+        }
+      }
+    }
+    // v218: 用硬件 vsync 时间戳重建相位(此前恒 TimeStamp::Now(),回调
+    // 到达滞后真实 vsync 若干 ms 且抖动,RefreshDriver 的动画起算/
+    // outputTime 估计系统性偏晚)。timestamp 单位 ns、基准 monotonic boot
+    // 时钟,与 Gecko TimeStamp(CLOCK_MONOTONIC)同域;latency=now−ts 还原
+    // 真实 vsync 时刻,域失配(latency 越界,如挂起后时基漂移)兜底回 Now()。
+    TimeStamp now = TimeStamp::Now();
+    TimeStamp vsyncTime = now;
+    {
+      struct timespec ts;
+      clock_gettime(CLOCK_MONOTONIC, &ts);
+      const double nowMonoNs = ts.tv_sec * 1e9 + (double)ts.tv_nsec;
+      const double latencyNs = nowMonoNs - (double)timestamp;
+      if (latencyNs >= 0.0 && latencyNs <= 100e6 /* 100ms */) {
+        vsyncTime = now - TimeDuration::FromMilliseconds(latencyNs / 1e6);
+      }
+    }
+    TimeStamp outputTime = vsyncTime + self->GetVsyncRate();
+    self->mozilla::gfx::VsyncSource::NotifyVsync(vsyncTime, outputTime);
+    self->RequestFrame();
+  }
+
+  bool mEnabled;
+  // v231: 回调时间戳间隔 EMA 实测周期(ns)与样本数/上次时间戳(见 OnVsyncCallback)
+  long long mLastVsyncTsNs = 0;
+  double mTsIvEMA = 0.0;
+  int mTsSamples = 0;
+  void* mHandle = nullptr;
+  OH_NativeVSync* mVsync;
+  OH_NativeVSync_Create_t mCreate = nullptr;
+  OH_NativeVSync_Destroy_t mDestroy = nullptr;
+  OH_NativeVSync_SetExpectedFrameRateRange_t mSetRateRange = nullptr;
+  OH_NativeVSync_RequestFrame_t mRequestFrame = nullptr;
+  OH_NativeVSync_GetPeriod_t mGetPeriod = nullptr;
+  double mRateMS = -1.0;  // v214: 缓存的真实 vsync 周期(ms)
+  base::Thread* mVsyncThread;
+};
+
+already_AddRefed<VsyncSource>
+gfxOHosPlatform::CreateGlobalHardwareVsyncSource() {
+  return MakeAndAddRef<OHOSVsyncSource>();
+}
