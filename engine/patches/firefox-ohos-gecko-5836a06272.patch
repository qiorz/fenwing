+// 通用原生菜单:回填执行命令(ArkTS → Gecko,经 libxul 导出符号)
+// 参数:menuId:number, itemId:number, modifiers?:number
+// libxul 的 GeckoBridge_RunMenuCommand 查句柄表 → nsContentUtils::DispatchXULCommand
+// 触发 oncommand;命中即关闭(清理句柄表)。
+napi_value ResolveMenuCommand(napi_env env, napi_callback_info info) {
+    size_t argc = 3;
+    napi_value args[3];
+    napi_value thisArg;
+    napi_get_cb_info(env, info, &argc, args, &thisArg, nullptr);
+    if (argc < 2) {
+        OH_LOG_ERROR(LOG_APP, "ResolveMenuCommand 参数缺失(期望 menuId, itemId)");
+        napi_throw_type_error(env, nullptr, "参数缺失,期望 (menuId, itemId[, modifiers])");
+        return nullptr;
+    }
+    int32_t menuId = 0;
+    int32_t itemId = 0;
+    int32_t modifiers = 0;
+    napi_get_value_int32(env, args[0], &menuId);
+    napi_get_value_int32(env, args[1], &itemId);
+    if (argc >= 3) {
+        napi_get_value_int32(env, args[2], &modifiers);
+    }
+    GeckoBridge_RunMenuCommand(menuId, itemId, modifiers);
+    napi_value result;
+    napi_get_null(env, &result);
+    return result;
+}
