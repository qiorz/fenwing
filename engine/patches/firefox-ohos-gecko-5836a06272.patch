+
+// v219: 纵向 pan 抑制 DOM touchmove 的 pref 开关(默认开)。见
+// OnTouchEvent 内注释。一次性缓存,避免 120Hz 热路径哈希查表。
+static bool PanSuppressTouchmovePref() {
+  static bool sInited = false;
+  static bool sSuppress = true;
+  if (!sInited) {
+    sInited = true;
+    sSuppress = mozilla::Preferences::GetBool("ohos.pan.suppress-touchmove",
+                                              true);
+    OHOS_DiagLog("[XRE_PAN] suppress-touchmove pref=%d", (int)sSuppress);
+  }
+  return sSuppress;
+}
+
+// v214c: vsync 驱动 fling 的主线程观察者。嵌套类可访问 nsWindow 的
+// protected OnPanFlingTick。生命周期:AddMainThreadObserver 时 dispatcher
+// 持本观察者 RefPtr;本观察者持窗口裸指针 —— 与窗口同线程(主线程),
+// CancelPanFling(所有退出路径:fling 自然结束/新手势/窗口 Destroy)对称
+// RemoveMainThreadObserver + Detach,不存在跨线程悬垂。
+class nsWindow::PanFlingVsyncObserver final
+    : public mozilla::VsyncObserver {
+ public:
+  NS_INLINE_DECL_THREADSAFE_REFCOUNTING(PanFlingVsyncObserver, override)
+
+  explicit PanFlingVsyncObserver(nsWindow* aWindow) : mWindow(aWindow) {}
+
+  // AddMainThreadObserver 契约:主线程回调,直接驱动 fling tick。
+  void NotifyVsync(const mozilla::VsyncEvent& aVsync) override {
+    if (mWindow) {
+      mWindow->OnPanFlingTick();
+    }
+  }
+
+  void Detach() { mWindow = nullptr; }
+
+ private:
+  virtual ~PanFlingVsyncObserver() = default;
+  nsWindow* mWindow = nullptr;
+};
+
+void nsWindow::OnTouchEvent(int32_t aAction, float aX, float aY,
+                            int64_t aTime, bool aRoutedToPopup) {
+  // OHOS 触摸事件转发:将 OHOS action(0=down,1=up,2=move,3=cancel)
+  // 转换为 Gecko WidgetTouchEvent 并分发到 content。
+  // v221 起 TopLevel 窗口持有 mAPZC,触摸走基类标准路由 DispatchInputEvent
+  // (APZ 合成器线程滚动);mAPZC 为空时回退自研 pan→wheel 层(kill-switch
+  // 形态,v245 已退役)。旧"stage2 不使用 APZ/DispatchEvent 跳过 APZ"注释
+  // 为 v221 之前的历史,已更正(v245 清理)。
+  EventMessage msg;
+  switch (aAction) {
+    case 0: msg = eTouchStart; break;
+    case 1: msg = eTouchEnd; break;
+    case 2: msg = eTouchMove; break;
+    case 3: msg = eTouchCancel; break;
+    default: return;
+  }
+
+  // v175: 输入事件重置 idle 计时。nsUserIdleServiceOHOS 的
+  // PollIdleTime 返回 false(无系统级 idle 查询),GetIdleTime 回退用
+  // time since mLastUserInteraction —— 本钩子是唯一喂数处,不调则 idle
+  // 自服务构造起单调增(交互中也被判 idle)。DOWN/UP/CANCEL 重置即可,
+  // MOVE 流(60-120Hz)省去每次 do_GetService。
+  if (msg != eTouchMove) {
+    mozilla::widget::nsUserIdleServiceOHOS::NoteUserInput();
+  }
+
+  LayoutDeviceIntPoint touchPoint(static_cast<int32_t>(aX),
+                                  static_cast<int32_t>(aY));
+
+  // v111: popup 打开时,touchstart 先 CheckForRollup —— 点击 popup 外则
+  // Rollup 关闭菜单并消费事件(修复 ≡ 菜单点外部无法关闭)。
+  // v158: 由桥接层命中测试路由进 popup 的事件(aRoutedToPopup)坐标已是
+  // popup 局部,且"点在 popup 内"由路由层判定过,此处再查会误判 rollup。
+  if (!aRoutedToPopup && msg == eTouchStart &&
+      CheckForRollup(touchPoint.x, touchPoint.y)) {
+    return;
+  }
+
+  // v221(M0): APZ 通道。gfxPlatform::AsyncPanZoomEnabled 的 OHOS 豁免生效后,
+  // TopLevel 窗口持有 mAPZC,触摸事件改走基类标准路由 DispatchInputEvent:
+  // APZ 在 controller 线程做手势识别(pan/fling/tap/长按/双指缩放均为 APZ
+  // 原生实现),未消费的事件经 ProcessUntransformedAPZEvent 派发 DOM(touch-action
+  // /SetAllowedTouchBehavior/ContentReceivedInputBlock 均由基类处理,与 GTK
+  // 同款样板)。滚动位移由 APZ 采样进合成器帧,不再依赖主线程吞吐。
+  // 下方自研手势层(pan→wheel 状态机/fling 物理/tap 合成/长按定时器/
+  // touchmove 抑制/pan 期鼠标抑制)仅在 mAPZC 为空时运行 —— kill-switch
+  // layers.async-pan-zoom.enabled=false 回退 v219 行为;popup 窗口默认
+  // 不启用 APZ(UseAPZ 的 popup 分支需 apz.popup pref),走原路径。
+  // 双通道零重叠,不并存不叠加。
+  if (mAPZC) {
+    RefPtr<mozilla::dom::Touch> apzTouch =
+        new mozilla::dom::Touch(0, touchPoint, LayoutDeviceIntPoint(1, 1),
+                                0.0f, 0.0f);
+    WidgetTouchEvent apzEvent(true, msg, this);
+    apzEvent.mRefPoint = touchPoint;
+    apzEvent.mTouches.AppendElement(apzTouch);
+    // v218 同款:桥接层时间戳重建(主线程积压时 DOM touchmove.timeStamp
+    // 不系统性偏晚);域失配兜底 Now()(构造函数默认)。
+    {
+      struct timespec ts;
+      clock_gettime(CLOCK_MONOTONIC, &ts);
+      const double nowMonoMs = ts.tv_sec * 1000.0 + ts.tv_nsec / 1e6;
+      const double latencyMs = nowMonoMs - (double)aTime;
+      if (latencyMs >= 0.0 && latencyMs <= 500.0) {
+        apzEvent.mTimeStamp =
+            TimeStamp::Now() - TimeDuration::FromMilliseconds(latencyMs);
+      }
+    }
+    nsIWidget::ContentAndAPZEventStatus apzStatus = DispatchInputEvent(&apzEvent);
+    // 热路径静默:MOVE(120Hz)不写日志,DOWN/UP/CANCEL 低频保留接线证据。
+    if (msg != eTouchMove) {
+      OHOS_DiagLog("[APZ_OHOS] DispatchInputEvent msg=%d pos=(%d,%d) apzStatus=%d contentStatus=%d",
+              (int)msg, touchPoint.x, touchPoint.y,
+              (int)apzStatus.mApzStatus, (int)apzStatus.mContentStatus);
+    }
+    return;
+  }
+
+  // v116: 长按手势检测(Android Gesture:LongPress → ESM::NotifyLongTap 的
+  // OHOS 等价物)。touchstart 起 500ms 定时器;move 超 slop/end/cancel 取消;
+  // 超时在按下点补发 eContextMenu(见 OnLongPressTimeout)。
+  // v155: tap 合成兜底状态与长按手势并行维护(见 nsWindow.h 成员注释):
+  //   slop 判定改为对整个 tap 持续累计(不依赖 mLongPressPending,长按定时器
+  //   可能已超时/取消,但手势位移仍需抑制合成)。
+  // 全部在 Gecko 主线程(OnTouchEvent 经 Runnable 派发于此),无线程安全问题。
+  if (msg == eTouchStart) {
+    CancelLongPressTimer();
+    // v213: 连点吞点击修复——若上一个 tap 的合成仍在 30ms 宽限期等待(主线程
+    //   忙碌使定时器尚未触发),立即冲刷补发而非丢弃。原实现直接 Cancel,快速
+    //   连点时每次新按下都吃掉上一击的合成,真机实证 12 个触摸事件仅 1 次 DOM
+    //   click(导入级联期连点几乎全灭,审核判卡死的合理来源)。
+    //   OnTapSynthTimeout 自带条件判定(systemMouse/moved/longPress)与定时器
+    //   清理,直接调用等价于定时器触发;此时点必然晚于原定 30ms 宽限,不破坏
+    //   系统通道去重(通道存活时 mTapSynthSawSystemMouse 为真,自动跳过合成)。
+    if (mTapSynthTimer) {
+      OHOS_DiagLog("[XRE_TAPSYNTH] 新 touchstart 冲刷未决合成(连点吞点击修复 v213)");
+      OnTapSynthTimeout();
+    }
+    mLongPressPoint = touchPoint;
+    mLongPressPending = true;
+    NS_NewTimerWithCallback(getter_AddRefs(mLongPressTimer),
+                            [this](nsITimer*) { OnLongPressTimeout(); },
+                            500, nsITimer::TYPE_ONE_SHOT,
+                            "nsWindow::OnLongPressTimeout");
+    // v155: 新 tap 开始,复位合成判定状态。
+    mTapSynthArmed = true;
+    mTapSynthSawSystemMouse = false;
+    mTapSynthMoved = false;
+    mTapSynthLongPressFired = false;
+    mTapSynthStart = touchPoint;
+  } else if (msg == eTouchMove) {
+    // slop 16px(v214:24→16,≈8.5 CSS px,对齐 Android 8dp touchSlop 的等效值;
+    // 原 24px 约为其 1.5 倍,pan 起步死区感明显)。平方比较避免开方。
+    // 同时供 tap 合成抑制(超此值不合成点击,与 pan 激活同阈值,保持
+    // "轻扫既不滚也不点"的互斥语义)。
+    const int32_t dx = touchPoint.x - mTapSynthStart.x;
+    const int32_t dy = touchPoint.y - mTapSynthStart.y;
+    if (dx * dx + dy * dy > 16 * 16) {
+      mTapSynthMoved = true;
+      if (mLongPressPending) {
+        CancelLongPressTimer();
+      }
+    }
+  } else if (msg == eTouchEnd || msg == eTouchCancel) {
+    if (mLongPressPending) {
+      CancelLongPressTimer();
+    }
+  }
+
+  // 单点触控:固定 id=0,半径 (1,1),旋转 0,压力 0
+  RefPtr<mozilla::dom::Touch> touch =
+      new mozilla::dom::Touch(0, touchPoint, LayoutDeviceIntPoint(1, 1),
+                              0.0f, 0.0f);
+
+  WidgetTouchEvent event(true, msg, this);
+  event.mRefPoint = touchPoint;
+  event.mTouches.AppendElement(touch);
+  // v218: 用桥接层事件时间重建 mTimeStamp(此前恒 TimeStamp::Now(),
+  // 主线程积压时 DOM touchmove.timeStamp 系统性偏晚)。aTime 源自 XComponent
+  // TouchPoint.timeStamp(纳秒,桥接层已归一化 ms),基准为 monotonic boot
+  // 时钟,与 Gecko TimeStamp(CLOCK_MONOTONIC)同域;now−latency 还原事件
+  // 真实时刻,域失配(latency 越界)兜底回 Now()。
+  {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    const double nowMonoMs = ts.tv_sec * 1000.0 + ts.tv_nsec / 1e6;
+    const double latencyMs = nowMonoMs - (double)aTime;
+    if (latencyMs >= 0.0 && latencyMs <= 500.0) {
+      event.mTimeStamp =
+          TimeStamp::Now() - TimeDuration::FromMilliseconds(latencyMs);
+    }
+  }
+
+  // v103 诊断:记录 touch 事件派发,与 OnMouseEvent 的 mouse 事件时序对照,
+  // 验证流 A(mouse)/流 B(touch)的到达顺序与 click target 计算的关联。
+  // 不改变事件 status(不抑制 touch),保持 touchstart/touchend DOM 事件正常派发。
+  // 输入流畅性:MOVE(滚动/拖拽高频)不再写 OHOS_DiagLog(同步文件 IO);
+  //   DOWN/UP/CANCEL 低频,保留诊断。
+  if (msg != eTouchMove) {
+    OHOS_DiagLog("[XRE_CLICK] OnTouchEvent in msg=%d pos=(%d,%d) action=%d",
+            (int)msg, touchPoint.x, touchPoint.y, (int)aAction);
+  }
+
+  nsEventStatus status = nsEventStatus_eIgnore;
+  // v219b: 纵向 pan 激活后抑制 DOM touchmove 派发(砍滚动热路径 JS 开销),
+  // 但带两道豁免(真机实证:百度首页 JS 手势状态机依赖 touchmove,收不到
+  // 后会把后续 wheel preventDefault 吞掉且不滚——一刀切抑制有毒):
+  //   ① 宽限:pan 激活后前 3 个 move 照常派发,让页面手势状态机启动,
+  //      有机会 preventDefault 表明"我自管";
+  //   ② 一旦某 move 被页面消费(eConsumeNoDefault),本手势全程不再抑制
+  //      (轮播/自滚动组件语义保留)。
+  // 纯内容页(绝大多数 move 不被消费):3 个宽限后全部抑制,每帧省一次
+  // DOM 派发+JS 监听器执行。横向 pan 不抑制(v217 语义);touchstart/
+  // touchend 永不抑制。pref:ohos.pan.suppress-touchmove。
+  const bool suppressThisMove =
+      msg == eTouchMove && mPanActive && mPanAxis == 1 &&
+      mPanMovesSinceActivate >= 3 && !mPanSawTouchmoveConsumed &&
+      PanSuppressTouchmovePref();
+  if (!suppressThisMove) {
+    status = DispatchEvent(&event);
+    if (msg == eTouchMove) {
+      if (mPanActive) {
+        mPanMovesSinceActivate++;
+      }
+      if (status == nsEventStatus_eConsumeNoDefault) {
+        mPanSawTouchmoveConsumed = true;
+      }
+    }
+  }
+
+  // v159→v217: 触摸 pan→wheel 转换(见 nsWindow.h 成员块注释)。
+  // v217 关键语义修正(v217b 定稿):触摸事件被 content preventDefault
+  // 不再杀死 pan;wheel 被消费同样不杀(实证仅轮播边缘偶发消费 1 次)。
+  // 根因:中文门户页的卡片轮播/视频卡对 touchmove preventDefault(防页面
+  // 滚动干扰横滑),但并不接管纵向滚动 —— 旧逻辑此时杀 pan,内容滚到
+  // 轮播到达手指下就停(真机实测:快甩 800px 只滚 542px 且无 fling =
+  // 用户"滑半屏才动一点")。改为以 wheel preventDefault 为权威"页面自管"
+  // 信号:轮播吞触摸(偶发吞 wheel)→ 页面继续滚;
+  // 地图在 touchstart 即吞 → 不进 pan。
+  // touchstart 即被消费(JS 地图)仍整体不 pan(下方保留)。
+
+  if (msg == eTouchStart && status == nsEventStatus_eConsumeNoDefault) {
+    OHOS_DiagLog("[XRE_PAN_DBG] touchstart consumed pos=(%d,%d)",
+            touchPoint.x, touchPoint.y);
+  }
+  if (msg == eTouchStart) {
+    // 新手势:复位 pan 状态;若 touchstart 即被消费(常见于 JS 地图),
+    // mPanTouchConsumed 已置位,本手势不进入 pan。
+    // v217:移到 touchmove 的消费判定删除(见上方 v217 注释),仅保留
+    // touchstart 消费门控;move 段消费不再影响 pan。
+    mPanActive = false;
+    mPanTouchConsumed = (status == nsEventStatus_eConsumeNoDefault);
+    mPanAxis = 0;
+    mPanLast = touchPoint;
+    mPanVelX = 0.0;
+    mPanVelY = 0.0;
+    mPanLastMoveTime = aTime;
+    mPanVelCount = 0;
+    mPanVelHead = 0;
+    mFlingAccumX = 0.0;
+    mFlingAccumY = 0.0;
+    CancelPanFling();  // 用户按住屏幕 = 掐断进行中的 fling
+  } else if (msg == eTouchMove) {
+    if (!mPanTouchConsumed) {
+      if (!mPanActive && mTapSynthMoved) {
+        // 激活:主位移轴锁定(|d|>1.3×另一轴才锁,否则双向)。
+        const int32_t tdx = touchPoint.x - mTapSynthStart.x;
+        const int32_t tdy = touchPoint.y - mTapSynthStart.y;
+        if (tdx * tdx > tdy * tdy * 169 / 100) {
+          mPanAxis = 2;  // 横向
+        } else if (tdy * tdy > tdx * tdx * 169 / 100) {
+          mPanAxis = 1;  // 纵向
+        } else {
+          mPanAxis = 3;  // 双向
+        }
+        mPanActive = true;
+        mPanLast = touchPoint;
+        mPanLastMoveTime = aTime;
+        // v219b: 抑制豁免状态复位(见 DispatchEvent 前注释)。
+        mPanMovesSinceActivate = 0;
+        mPanSawTouchmoveConsumed = false;
+        OHOS_DiagLog("[XRE_PAN] pan 激活 start=(%d,%d) axis=%d",
+                mTapSynthStart.x, mTapSynthStart.y, (int)mPanAxis);
+      }
+      if (mPanActive) {
+        const float scale = (float)GetDefaultScaleInternal();
+        float dx = (float)(touchPoint.x - mPanLast.x);
+        float dy = (float)(touchPoint.y - mPanLast.y);
+        if (mPanAxis == 1) {
+          dx = 0.0f;
+        } else if (mPanAxis == 2) {
+          dy = 0.0f;
+        }
+        if (dx != 0.0f || dy != 0.0f) {
+          // 自然滚动方向:内容跟随手指 → wheel 增量取反(手上移→dy<0→
+          // wheel deltaY>0=向下滚,露出下方内容)。CSS px = 设备px/scale。
+          // v217b:wheel 被消费不停 pan —— 真机实证整场手势仅 1 个 wheel
+          // 被轮播边缘消费,一次即杀等于把可滚页面判死。页面消费 wheel 时
+          // 默认滚动不执行,但页面自身的 JS 滚动接管,内容仍会动;真正
+          // 自管触摸的面(地图)在 touchstart 即被消费,根本不会进 pan。
+          SynthPanWheel(-dx / scale, -dy / scale, touchPoint);
+          // v214: 推入速度采样窗(松手时最小二乘回归出 fling 初速度,
+          // 替代 v159 EMA —— EMA 0.7/0.3 在 120Hz 输入下仍滞后 ~30ms,
+          // 轻扫初速被系统性低估,fling 起步"发钝")。滚动位置取 CSS px,
+          // 与 fling 物理同单位。
+          mPanVelBufT[mPanVelHead] = (double)aTime;
+          mPanVelBufX[mPanVelHead] = (double)(-dx / scale) +
+                                     (mPanVelCount > 0
+                                          ? mPanVelBufX[(mPanVelHead + kPanVelSamples - 1) % kPanVelSamples]
+                                          : 0.0);
+          mPanVelBufY[mPanVelHead] = (double)(-dy / scale) +
+                                     (mPanVelCount > 0
+                                          ? mPanVelBufY[(mPanVelHead + kPanVelSamples - 1) % kPanVelSamples]
+                                          : 0.0);
+          mPanVelHead = (mPanVelHead + 1) % kPanVelSamples;
+          if (mPanVelCount < kPanVelSamples) {
+            mPanVelCount++;
+          }
+          mPanLast = touchPoint;
+          mPanLastMoveTime = aTime;
+        }
+      }
+    }
+  } else if (msg == eTouchEnd || msg == eTouchCancel) {
+    if (mPanActive) {
+      mPanActive = false;
+      if (msg == eTouchEnd) {
+        // 松手前停顿 >160ms 不 fling(手指悬停后抬起无初速;
+        // v214d: 120→160,容忍输入流抖动使末 move 迟到)。
+        const int64_t sinceLastMove = aTime - mPanLastMoveTime;
+        if (sinceLastMove < 160) {
+          ComputePanVelocityFromSamples();
+          // v216: 初速增益 ×1.15 —— 移动端惯性惯例(滑脱感),回归速度
+          // 是"末段平均",直接用会略低于松手瞬时速度,增益补偿。
+          mPanVelX *= 1.15;
+          mPanVelY *= 1.15;
+          const double speed = sqrt(mPanVelX * mPanVelX + mPanVelY * mPanVelY);
+          if (speed > 0.10) {  // CSS px/ms 阈值(100px/s)
+            mPanFlingTicks = 0;
+            mFlingAccumX = 0.0;
+            mFlingAccumY = 0.0;
+            // v214c: fling 锚点 = 手势起点(见 nsWindow.h mPanFlingRef 注释)。
+            mPanFlingRef = mTapSynthStart;
+            CancelPanFling();
+            // v214c: 首选用硬件 vsync 主线程观察者驱动 tick —— 显示帧节拍
+            // (60/120Hz 由 RenderService 保证),不受 OHOS 定时器合并/抖动
+            // 影响(mini 实测 nsITimer REPEATING_PRECISE 16ms 实际 46-116ms)。
+            // dt 积分对任意 tick 节奏都正确,vsync 只是把更新率抬到帧率。
+            RefPtr<mozilla::VsyncDispatcher> disp =
+                gfxPlatform::GetPlatform()
+                    ? gfxPlatform::GetPlatform()->GetGlobalVsyncDispatcher()
+                    : nullptr;
+            if (disp) {
+              mFlingLastTickMs =
+                  (double)PR_IntervalToMilliseconds(PR_IntervalNow());
+              mPanFlingVsyncObserver = new PanFlingVsyncObserver(this);
+              disp->AddMainThreadObserver(mPanFlingVsyncObserver);
+              OHOS_DiagLog("[XRE_PAN] fling 启动(vsync) v=(%.2f,%.2f) css px/ms",
+                      mPanVelX, mPanVelY);
+            } else {
+              // v214 回退:8ms 定步进 nsITimer(dispatcher 不可用,理论不达)。
+              mFlingLastTickMs = 0.0;  // 首 tick 用实际 dt 初始化
+              NS_NewTimerWithCallback(
+                  getter_AddRefs(mPanFlingTimer),
+                  [this](nsITimer*) { OnPanFlingTick(); }, 8,
+                  nsITimer::TYPE_REPEATING_PRECISE,
+                  "nsWindow::OnPanFlingTick");
+              OHOS_DiagLog("[XRE_PAN] fling 启动(timer) v=(%.2f,%.2f) css px/ms",
+                      mPanVelX, mPanVelY);
+            }
+          }
+        }
+      }
+    }
+  }
+
+  // v102: 移除 v73 的 touchend→mouse 三连合成。
+  //
+  // 历史:v73 时 stage2 跳过 APZ,真实触摸的 click 合成唯一入口是 APZ 的
+  // GenerateSingleTap→FireSingleTapEvent。跳过 APZ 后没有 mouse 事件,
+  // EventStateManager 无法从 eMouseUp 合成 click,按钮/超链接点不动。
+  // 故在 touchend 后补发 eMouseMove/eMouseDown/eMouseUp 三连事件。
+  //
+  // 现状(日志 PID 3169 已证):OHOS XComponent 的 C 原生 MouseEvent_Callback
+  // (geckoview.cpp:1333, v56 引入)已对触摸合成 mouse PRESS/RELEASE。
+  // 单次触摸实际触发:
+  //   touchstart → native mouseDown(.345) → [ESM] mLastMouseDownContent set
+  //   touchend   → native mouseUp(.462)   → [ESM] click result=1 ✓ 已生成
+  //              → v73 synth mouseUp(.468) → mLastMouseDownContent=0 ❌ 清除!
+  //
+  // v73 合成与 native 回调重复,且 synth mouseUp 在真实 click 之后触发,
+  // 把 mLastMouseDownContent 清零(EventStateManager::PrepareForFollowingClickEvent
+  // 在 eMouseUp 且 mButtons=eNoButtons 时清 mLastMouseDownContent),
+  // 导致:
+  //   1. 百度一下按钮 click 虽生成(result=1)但随后的 synth mouseUp 干扰表单
+  //      默认动作,DoSubmit 不触发(日志 [OHOS_IL] DoSubmit 0 次)
+  //   2. 圈选文字时 synth mouseDown 折叠刚选中的 selection(v101 试图用
+  //      eConsumeNoDefault 守卫,但根因是 synth 本身多余)
+  //
+  // v155(回归修复):v102 的前提"系统合成恒存活"被真机证伪 —— 系统通道可在
+  // 启动数秒后永久关闭(inputSource=TOUCH 的 mouse 流为零,触摸点击全灭,
+  // 感知为"无法触控/点标签假死")。恢复合成,但带双层去重(见 nsWindow.h
+  // mTapSynth* 注释):tap 窗口内见系统主键 down 即放弃;touchend 后再等
+  // 30ms 宽限期。合成事件与系统合成流同构(MOZ_SOURCE_TOUCH 三连),
+  // 不会重现 v73/v102 的双流冲突。
+  if (msg == eTouchEnd) {
+    if (mTapSynthArmed && !mTapSynthMoved && !mTapSynthLongPressFired &&
+        !mTapSynthSawSystemMouse) {
+      mTapSynthEnd = touchPoint;
+      CancelTapSynthTimer();
+      NS_NewTimerWithCallback(getter_AddRefs(mTapSynthTimer),
+                              [this](nsITimer*) { OnTapSynthTimeout(); },
+                              30, nsITimer::TYPE_ONE_SHOT,
+                              "nsWindow::OnTapSynthTimeout");
+      OHOS_DiagLog("[XRE_TAPSYNTH] touchend,30ms 宽限期后合成判定 pos=(%d,%d)",
+              touchPoint.x, touchPoint.y);
+    } else {
+      mTapSynthArmed = false;
+      CancelTapSynthTimer();
+    }
+  } else if (msg == eTouchCancel) {
+    mTapSynthArmed = false;
+    CancelTapSynthTimer();
+  }
+}
+
+// v270: 多指触摸批事件 —— 双指捏合根修的真实输入入口。
+// 背景:OnTouchEvent(单点)自 v56 起只承载 XComponent 回调的首触点,
+// 第二指被丢弃 → APZ 手势识别器(GestureEventListener)永远只见单触点,
+// 双指捏合在全 Gecko 内容(网页+about:preferences 等 UI 页)上从未生效
+// (v242 synth-pinch 直接注入双触点 WidgetTouchEvent 可缩放,证明卡点
+// 仅在输入转发段)。本方法接收桥接层按 Android 批语义构建的整批触点。
+// 与 OnTouchEvent 的关系:单指手势(numPoints==1 且多指态未激活)完全不
+// 经过本方法 —— 点击/滚动/长按/IME 等既有行为零改动;多指态激活期间
+// (含末指抬起前的单点尾段)整批走本方法。
+void nsWindow::OnMultiTouchEvent(
+    int32_t aAction, const nsTArray<int32_t>& aIds,
+    const nsTArray<mozilla::LayoutDeviceIntPoint>& aPoints, int64_t aTime,
+    bool aRoutedToPopup) {
+  if (aIds.IsEmpty() || aPoints.IsEmpty() ||
+      aIds.Length() != aPoints.Length()) {
+    return;
+  }
+  EventMessage msg;
+  switch (aAction) {
+    case 0: msg = eTouchStart; break;
+    case 1: msg = eTouchEnd; break;
+    case 2: msg = eTouchMove; break;
+    case 3: msg = eTouchCancel; break;
+    default: return;
+  }
+  if (msg != eTouchMove) {
+    mozilla::widget::nsUserIdleServiceOHOS::NoteUserInput();
+  }
+  const mozilla::LayoutDeviceIntPoint& primary = aPoints[0];
+  // 主指 start 的 popup rollup 判定(与 OnTouchEvent 同语义;aRoutedToPopup
+  // 时坐标已是 popup 局部,跳过)。
+  if (!aRoutedToPopup && msg == eTouchStart &&
+      CheckForRollup(primary.x, primary.y)) {
+    return;
+  }
+  if (mAPZC) {
+    WidgetTouchEvent apzEvent(true, msg, this);
+    apzEvent.mRefPoint = primary;
+    for (uint32_t i = 0; i < aPoints.Length(); ++i) {
+      apzEvent.mTouches.AppendElement(new mozilla::dom::Touch(
+          aIds[i], aPoints[i], mozilla::LayoutDeviceIntPoint(1, 1), 0.0f,
+          0.0f));
+    }
+    // v218 同款:桥接层时间戳重建(主线程积压时 DOM timeStamp 不系统性偏晚)。
+    {
+      struct timespec ts;
+      clock_gettime(CLOCK_MONOTONIC, &ts);
+      const double nowMonoMs = ts.tv_sec * 1000.0 + ts.tv_nsec / 1e6;
+      const double latencyMs = nowMonoMs - (double)aTime;
+      if (latencyMs >= 0.0 && latencyMs <= 500.0) {
+        apzEvent.mTimeStamp =
+            TimeStamp::Now() - TimeDuration::FromMilliseconds(latencyMs);
+      }
+    }
+    nsIWidget::ContentAndAPZEventStatus apzStatus = DispatchInputEvent(&apzEvent);
+    if (msg != eTouchMove) {
+      OHOS_DiagLog("[APZ_OHOS] MultiTouch msg=%d n=%u primary=(%d,%d) apzStatus=%d",
+              (int)msg, (unsigned)aPoints.Length(), primary.x, primary.y,
+              (int)apzStatus.mApzStatus);
+    }
+    return;
+  }
+  // 无 APZ 窗口(popup 等):回退主指走 OnTouchEvent 既有自研层
+  // (popup 无捏合语义,单点行为不变)。
+  OnTouchEvent(aAction, (float)primary.x, (float)primary.y, aTime,
+               aRoutedToPopup);
+}
