new file mode 100644
index 0000000000..0819e48a42
--- /dev/null
+++ b/media/ffvpx/libavcodec/mpeg4audio.h
@@ -0,0 +1,121 @@
+/*
+ * MPEG-4 Audio common header
+ * Copyright (c) 2008 Baptiste Coudurier <baptiste.coudurier@free.fr>
