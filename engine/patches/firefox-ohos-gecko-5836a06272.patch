diff --git a/ipc/chromium/src/base/message_pump_ohos.cc b/ipc/chromium/src/base/message_pump_ohos.cc
new file mode 100644
index 0000000000..3071d11f20
--- /dev/null
+++ b/ipc/chromium/src/base/message_pump_ohos.cc
@@ -0,0 +1,125 @@
+/* -*- Mode: C++; tab-width: 8; indent-tabs-mode: nil; c-basic-offset: 2 -*- */
+/* vim: set ts=8 sts=2 et sw=2 tw=80: */
+// Copyright (c) 2010 The Chromium Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "base/message_pump_ohos.h"
+
+#include <fcntl.h>
+#include <math.h>
+#include <stdio.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "base/eintr_wrapper.h"
+#include "base/logging.h"
+#include "base/platform_thread.h"
+
+// OHOS 诊断(v33):记录 MessagePumpForUI::Run/Quit 调用,
+// 定位 appStartup->Run 过早退出的根因(谁调用了 Quit)。
+// 注意:不使用 backtrace(),因为 OHOS musl libc 可能不支持 unwind table。
+static void ohosDiagPump(const char* tag, const char* msg) {
+  FILE* fp = fopen("/data/storage/el2/base/haps/entry/files/gecko_xre_diag.log", "a");
+  if (fp) {
+    struct timespec ts;
+    clock_gettime(CLOCK_REALTIME, &ts);
+    fprintf(fp, "%ld.%03ld [Pump:%s] %s\n", ts.tv_sec, ts.tv_nsec / 1000000, tag, msg);
+    fflush(fp);
+    fclose(fp);
+  }
+  // 同时通过 stderr 输出到 hilog
+  fprintf(stderr, "[Pump:%s] %s\n", tag, msg);
+  fflush(stderr);
+}
+
+// OpenHarmony MessagePumpForUI 实现。
+//
+// 移植自 message_pump_android:OpenHarmony 为单进程模型,无原生 UI 消息循环,
+// 通过 mozilla::ProcessNextEvent() 驱动 Gecko 主事件循环,与 Android 完全一致。
+
+namespace mozilla {
+bool ProcessNextEvent();
+void NotifyEvent();
+}  // namespace mozilla
+
+namespace base {
+
+MessagePumpForUI::MessagePumpForUI() : state_(NULL) {}
+
+MessagePumpForUI::~MessagePumpForUI() {}
+
+void MessagePumpForUI::Run(Delegate* delegate) {
+  ohosDiagPump("Run", "进入 MessagePumpForUI::Run");
+  RunState state;
+  state.delegate = delegate;
+  state.should_quit = false;
+  state.run_depth = state_ ? state_->run_depth + 1 : 1;
+  // 每轮循环只处理单个任务;若处理了则假定还有更多任务,避免过早阻塞。
+  // 同时初始置 true 以保证 RunAllPending() 首轮不阻塞。
+  state.more_work_is_plausible = true;
+
+  RunState* previous_state = state_;
+  state_ = &state;
+
+  int loopIter = 0;
+  while (!state_->should_quit) {
+    loopIter++;
+    if (loopIter <= 5 || loopIter % 100 == 0) {
+      char buf[64];
+      snprintf(buf, sizeof(buf), "循环第 %d 次,即将 ProcessNextEvent", loopIter);
+      ohosDiagPump("Run", buf);
+    }
+    mozilla::ProcessNextEvent();
+    if (work_scheduled) {
+      work_scheduled = false;
+      HandleDispatch();
+    }
+  }
+
+  ohosDiagPump("Run", "退出 MessagePumpForUI::Run(should_quit=true)");
+  state_ = previous_state;
+}
+
+void MessagePumpForUI::HandleDispatch() {
+  if (state_->should_quit) return;
+
+  state_->more_work_is_plausible = false;
+
+  if (state_->delegate->DoWork()) state_->more_work_is_plausible = true;
+
+  if (state_->should_quit) return;
+
+  if (state_->delegate->DoDelayedWork(&delayed_work_time_))
+    state_->more_work_is_plausible = true;
+  if (state_->should_quit) return;
+
+  // 若还有更重要的工作,则不做 idle work。
+  if (state_->more_work_is_plausible) return;
+
+  if (state_->delegate->DoIdleWork()) state_->more_work_is_plausible = true;
+  if (state_->should_quit) return;
+}
+
+void MessagePumpForUI::Quit() {
+  ohosDiagPump("Quit", "MessagePumpForUI::Quit 被调用(设置 should_quit=true)");
+  if (state_) {
+    state_->should_quit = true;
+  } else {
+    NOTREACHED() << "Quit called outside Run!";
+  }
+}
+
+void MessagePumpForUI::ScheduleWork() {
+  // 可在任意线程调用,不触碰状态变量(避免加锁)。唤醒可能在 poll 中睡眠的循环。
+  work_scheduled = true;
+  mozilla::NotifyEvent();
+}
+
+void MessagePumpForUI::ScheduleDelayedWork(const TimeTicks& delayed_work_time) {
+  // 需要唤醒循环以调整 poll 超时。这会触发一次 DoWork 尝试,无副作用。
+  delayed_work_time_ = delayed_work_time;
+  ScheduleWork();
+}
+
+}  // namespace base
