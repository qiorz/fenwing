+// 全局状态
+// ============================================================================
+
+// Gecko Bootstrap 实例,由 XRE_GetBootstrap 获取,用于启动 XRE_main
+static mozilla::Bootstrap::UniquePtr gBootstrap;
+
+// Gecko 内核是否已完成初始化(就绪标志)
+static std::atomic<bool> gGeckoReady{false};
+
+// ArkTS 层注册的回调集合(URL 变化/终止/Prompt)
