+// (OHOSNativeWindowBridge.cpp,自由多窗拖拽改变应用窗口尺寸)也需要触发,
+// 否则 nsIScreen rect 停留在旧 Surface 尺寸,popup 约束边界随之失真。
+// 调用方必须在 Gecko 主线程(非主线程请 NS_DispatchToMainThread 投放)。
+void RefreshScreenList();
+
+}  // namespace mozilla::widget
+
+#endif  // mozilla_widget_OHOSScreenHelper_h
