+#ifndef GFX_PLATFORM_OHOS_H
+#define GFX_PLATFORM_OHOS_H
+
+// OpenHarmony 图形平台(stage1)。
+//
+// OpenHarmony 与 Android 同为 Linux + musl/bionic + freetype 体系,字体
+// 枚举路径(FT2)可直接复用;但 gfxAndroidPlatform 的 manufacturer / 硬件
+// vsync / HardwareBuffer 等强依赖 JNI,无法在 OHOS 编译。故 stage1 提供一个
+// 最小平台类,实现 gfxPlatform 的纯虚接口并复用 gfxFT2FontList。
+//
+// stage2(XComponent+EGL)阶段会在此补充 OH_Vsync 与 EGL 相关初始化。
+
+#include "gfxPlatform.h"
+#include "gfxUserFontSet.h"
+#include "nsTArray.h"
+
+class gfxOHosPlatform final : public gfxPlatform {
+ public:
+  gfxOHosPlatform();
+  virtual ~gfxOHosPlatform();
+
