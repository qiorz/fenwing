diff --git a/media/ffvpx/libavcodec/vvc.h b/media/ffvpx/libavcodec/vvc.h
new file mode 100644
index 0000000000..7d165cdb86
--- /dev/null
+++ b/media/ffvpx/libavcodec/vvc.h
@@ -0,0 +1,156 @@
+/*
+ * H.266 / VVC shared code
+ *
