+
+// v88: 多 session 监听器表 — 每个 sessionId 对应一个独立 OHOSProgressListener
+// 持有 RefPtr 保持监听器生命周期。session 关闭时从表移除(见 GeckoBridge_UnregisterProgressListener)。
+#include <unordered_map>
+#include <unordered_set>  // v249b: 存活窗口集合(ABA 清理)
+#include <string>
+static std::unordered_map<std::string, RefPtr<OHOSProgressListener>> gSessionListeners;
+
+// 注册监听器到指定窗口的 content docShell
+// v88: 改为按 sessionId + browserIndex 注册。多 browser 架构下,chrome docShell 有
+//   多个 typeContent 子 docShell(每个 browser 一个),按索引选取。
+// aWindow: geckoview 窗口
+// aSessionId: 标签标识
+// aBrowserIndex: content docShell 在 chrome 子列表中的下标(0-based)
+// 返回值:true 成功;false 失败(窗口/docShell 未就绪,可稍后重试)
+bool OHOSProgressListener::RegisterForSession(mozIDOMWindowProxy* aWindow,
+                                              const nsCString& aSessionId,
+                                              int32_t aBrowserIndex) {
+  // 已注册则跳过
+  if (gSessionListeners.count(aSessionId.get()) > 0) {
+    return true;
+  }
+
+  nsCOMPtr<nsPIDOMWindowOuter> piWindow = do_QueryInterface(aWindow);
+  if (!piWindow) {
+    OHOS_LOG( "[XRE] OHOSProgressListener do_QueryInterface 失败\n");
+    return false;
+  }
+
+  nsCOMPtr<nsIDocShell> chromeDocShell = piWindow->GetDocShell();
+  if (!chromeDocShell) {
+    OHOS_LOG( "[XRE] OHOSProgressListener GetDocShell 失败\n");
+    return false;
+  }
+
+  // 遍历子 docShell 找第 aBrowserIndex 个 typeContent
+  nsCOMPtr<nsIDocShellTreeItem> chromeTreeItem = chromeDocShell;
+  if (!chromeTreeItem) {
+    return false;
+  }
+
+  int32_t childCount = 0;
+  chromeTreeItem->GetInProcessChildCount(&childCount);
+  nsCOMPtr<nsIDocShellTreeItem> contentTreeItem;
+  int32_t contentIndex = 0;
+  for (int32_t i = 0; i < childCount; ++i) {
+    nsCOMPtr<nsIDocShellTreeItem> child;
+    chromeTreeItem->GetInProcessChildAt(i, getter_AddRefs(child));
+    if (!child) continue;
+    int32_t itemType = 0;
+    child->GetItemType(&itemType);
+    if (itemType == nsIDocShellTreeItem::typeContent) {
+      if (contentIndex == aBrowserIndex) {
+        contentTreeItem = child;
+        break;
+      }
+      contentIndex++;
+    }
+  }
+
+  if (!contentTreeItem) {
+    // browser 元素尚未创建(content docShell 不存在),返回 false 允许稍后重试
+    OHOS_LOG( "[XRE] OHOSProgressListener[%s] 找不到 content docShell index=%d(稍后重试)\n",
+            aSessionId.get(), aBrowserIndex);
+    return false;
+  }
+
+  nsCOMPtr<nsIWebProgress> webProgress = do_GetInterface(contentTreeItem);
+  if (!webProgress) {
+    OHOS_LOG( "[XRE] OHOSProgressListener[%s] do_GetInterface webProgress 失败\n",
+            aSessionId.get());
+    return false;
+  }
+
+  RefPtr<OHOSProgressListener> listener = new OHOSProgressListener(aSessionId);
+  nsresult rv = webProgress->AddProgressListener(
+      listener, nsIWebProgress::NOTIFY_ALL);
+  if (NS_FAILED(rv)) {
+    OHOS_LOG( "[XRE] OHOSProgressListener[%s] AddProgressListener 失败 rv=0x%x\n",
+            aSessionId.get(), (unsigned)rv);
+    return false;
+  }
+
+  gSessionListeners[aSessionId.get()] = listener;
+  OHOS_LOG( "[XRE] OHOSProgressListener[%s] 已注册到 content docShell index=%d\n",
+          aSessionId.get(), aBrowserIndex);
+  // v136 诊断埋点:listener 注册结果(含 content window 指针,供 OnLocationChange
+  //   诊断行交叉比对 listenerWin)。
+  mozIDOMWindowProxy* regContentWin = contentTreeItem->GetWindow();
+  OHOS_DiagLog(
+      "[XRE_URL] OHOSProgressListener[%s] 已注册 index=%d "
+      "chromeWin=%p contentWin=%p",
+      aSessionId.get(), aBrowserIndex, (void*)aWindow,
+      (void*)regContentWin);
+  return true;
+}
+
+// v136: 自动补挂监听器的 content DOMWindow 指针表(去重键)。
+//   ArkTS native 轨道新建标签走 gBrowser.addTab,NAPI 未暴露 createSession,
+//   RegisterForSession 不会对新标签调用。RegisterForAllContentDocShells 用
+//   本表去重:同一 content DOMWindow 只补挂一次 listener。
+//   键为 content DOMWindow 指针(mozIDOMWindowProxy*),值为 listener。
+static std::unordered_map<void*, RefPtr<OHOSProgressListener>>
+    gAutoListenersByWin;
+
+// v136: 遍历 chrome 窗口所有 typeContent 子 docShell,为每个尚未注册 listener
+//   的 content docShell 自动补挂 OHOSProgressListener。
+//   返回本次新注册的数量(0 = 无新标签或窗口未就绪)。
+//   自由函数(前向声明于文件顶部),供 OHOSStartupObserver /
+//   InitProgressListenerRunnable / 周期重扫定时器 / RegisterSessionProgressRunnable
+//   调用,避免类静态成员的声明顺序约束。
+int32_t OHOS_RegisterAllTabsListeners(mozIDOMWindowProxy* aWindow) {
+  // v250: 惰性注册 airweb-tab-state 观察者(OHOSChromeBridge.cpp,
+  //   chrome JS → ArkTS 标签状态推送通道)。本函数首次由
+  //   browser-delayed-startup-finished 链触发(XPCOM 已就绪,注册安全),
+  //   内部幂等。
+  OHOS_EnsureTabStateObserver();
+  if (!aWindow) return 0;
+  nsCOMPtr<nsPIDOMWindowOuter> piWindow = do_QueryInterface(aWindow);
+  if (!piWindow) return 0;
+  nsCOMPtr<nsIDocShell> chromeDocShell = piWindow->GetDocShell();
+  nsCOMPtr<nsIDocShellTreeItem> chromeTreeItem = chromeDocShell;
+  if (!chromeTreeItem) return 0;
+
+  int32_t childCount = 0;
+  chromeTreeItem->GetInProcessChildCount(&childCount);
+  int32_t newCount = 0;
+  int32_t contentIdx = 0;
+
+  // v249b: 先过一遍收集当前存活的 content DOMWindow，清掉映射表里的
+  //   死条目（已关闭标签）。否则关过的窗口指针被分配器复用给新标签时，
+  //   旧条目造成 ABA 误判"已补挂"→ 新标签永远无 listener。
+  //   （本函数枚举的是该 chrome 窗口全部标签的 docShell，未枚举到的
+  //   contentWin 必属已关闭标签。）
+  std::unordered_set<void*> aliveWins;
+  for (int32_t i = 0; i < childCount; ++i) {
+    nsCOMPtr<nsIDocShellTreeItem> child;
+    chromeTreeItem->GetInProcessChildAt(i, getter_AddRefs(child));
+    if (!child) continue;
+    int32_t itemType = 0;
+    child->GetItemType(&itemType);
+    if (itemType != nsIDocShellTreeItem::typeContent) continue;
+    if (mozIDOMWindowProxy* w = child->GetWindow()) {
+      aliveWins.insert((void*)w);
+    }
+  }
+  for (auto it = gAutoListenersByWin.begin(); it != gAutoListenersByWin.end();) {
+    if (aliveWins.count(it->first) == 0) {
+      it = gAutoListenersByWin.erase(it);
+    } else {
+      ++it;
+    }
+  }
+
+  for (int32_t i = 0; i < childCount; ++i) {
+    nsCOMPtr<nsIDocShellTreeItem> child;
+    chromeTreeItem->GetInProcessChildAt(i, getter_AddRefs(child));
+    if (!child) continue;
+    int32_t itemType = 0;
+    child->GetItemType(&itemType);
+    if (itemType != nsIDocShellTreeItem::typeContent) continue;
+
+    mozIDOMWindowProxy* contentWin = child->GetWindow();
+    if (!contentWin) {
+      contentIdx++;
+      continue;
+    }
+    // 已补挂则跳过(去重)
+    if (gAutoListenersByWin.count((void*)contentWin) > 0) {
+      contentIdx++;
+      continue;
+    }
+    nsCOMPtr<nsIWebProgress> webProgress = do_GetInterface(child);
+    if (!webProgress) {
+      contentIdx++;
+      continue;
+    }
+    // 自动补挂:sessionId 用 "auto-<idx>",仅用于回调标识与诊断。
+    nsCString autoId("auto-"_ns);
+    autoId.AppendInt(contentIdx);
+    RefPtr<OHOSProgressListener> listener = new OHOSProgressListener(autoId);
+    nsresult rv = webProgress->AddProgressListener(
+        listener, nsIWebProgress::NOTIFY_ALL);
+    if (NS_SUCCEEDED(rv)) {
+      gAutoListenersByWin[(void*)contentWin] = listener;
+      newCount++;
+      OHOS_DiagLog(
+          "[XRE_URL] 自动补挂 OHOSProgressListener[%s] → contentWin=%p idx=%d",
+          autoId.get(), (void*)contentWin, contentIdx);
+    } else {
+      OHOS_DiagLog(
+          "[XRE_URL] 自动补挂失败[%s] rv=0x%x contentWin=%p idx=%d",
+          autoId.get(), (unsigned)rv, (void*)contentWin, contentIdx);
+    }
+    contentIdx++;
+  }
+  if (newCount > 0) {
+    OHOS_DiagLog(
+        "[XRE_URL] RegisterForAllContentDocShells 本次新补挂 %d 个 listener "
+        "(childCount=%d autoTotal=%zu)",
+        newCount, childCount, gAutoListenersByWin.size());
+  }
+  return newCount;
+}
+
+// ============================================================================
+// 导出:为 geckoview 窗口的指定标签注册进度监听器
+// ============================================================================
+
+__attribute__((visibility("default")))
+extern "C" bool GeckoBridge_RegisterProgressListenerForSession(
+    mozIDOMWindowProxy* aWindow, const char* aSessionId, int32_t aBrowserIndex) {
+  if (!aSessionId) return false;
+  nsCString sessionId(aSessionId);
+  return OHOSProgressListener::RegisterForSession(aWindow, sessionId, aBrowserIndex);
+}
+
+// ============================================================================
+// v98: 自动窗口查找 + 重试的 session 进度监听器注册
+// ============================================================================
+// 供 geckoview.cpp NAPI 层 CreateSession 调用(该层无法访问 XPCOM API)。
+// 本函数在 libxul.so 内部执行,可通过 nsIWindowMediator 查找窗口。
+// createBrowserForSession 在 Gecko 主线程异步执行(JS event loop 下一 tick),
+// 调用本函数时 content docShell 可能尚未创建,需延迟重试。
+//
+// 策略:派发 RegisterSessionProgressRunnable 到主线程,内部:
+//   1. OHOSFindChromeWindow() 双轨查找顶层 chrome 窗口(v110)
+//   2. RegisterForSession(window, sessionId, browserIndex) 注册
+//   3. 若返回 false(docShell 未就绪),延迟重试(最多 20 次,递增间隔)
+class RegisterSessionProgressRunnable final : public mozilla::Runnable {
+ public:
+  RegisterSessionProgressRunnable(const nsCString& aSessionId, int32_t aBrowserIndex)
+      : mozilla::Runnable("RegisterSessionProgressRunnable"),
+        mSessionId(aSessionId), mBrowserIndex(aBrowserIndex), mRetryCount(0) {}
+
+  NS_IMETHOD Run() override {
+    // v110: 双轨窗口查找(native 轨道 windowtype=navigator:browser)
+    nsCOMPtr<mozIDOMWindowProxy> recentWindow = OHOSFindChromeWindow();
+    if (!recentWindow) {
+      RetryIfNeeded();
+      return NS_OK;
+    }
+    bool ok = OHOSProgressListener::RegisterForSession(
+        recentWindow, mSessionId, mBrowserIndex);
+    // v136: 无论本 session 是否注册成功,都顺带为所有 content docShell 补挂
+    //   listener(新标签兜底,幂等去重)。
+    OHOS_RegisterAllTabsListeners(recentWindow);
+    if (ok) {
+      OHOS_LOG( "[XRE] RegisterSessionProgress[%s] 成功 index=%d\n",
+              mSessionId.get(), mBrowserIndex);
+      return NS_OK;
+    }
+    // docShell 未就绪,重试
+    RetryIfNeeded();
+    return NS_OK;
+  }
+
+ private:
+  void RetryIfNeeded() {
+    if (mRetryCount >= 20) {
+      OHOS_LOG( "[XRE] RegisterSessionProgress[%s] 重试 20 次仍失败,放弃\n",
+              mSessionId.get());
+      return;
+    }
+    mRetryCount++;
+    // 递增延迟:前 5 次 50ms,之后 200ms(总等待约 3s)
+    uint32_t delay = mRetryCount <= 5 ? 50 : 200;
+    // 重新派发自身到主线程(RefPtr 增加 self 引用,forget 转为 already_AddRefed)
+    // MessageLoop::PostDelayedTask 接收 already_AddRefed<nsIRunnable>,RefPtr<T>.forget() 可隐式转换
+    RefPtr<RegisterSessionProgressRunnable> self(this);
+    MessageLoop::current()->PostDelayedTask(self.forget(), delay);
+    if (mRetryCount == 1) {
+      OHOS_LOG( "[XRE] RegisterSessionProgress[%s] 首次重试(共20次)\n",
+              mSessionId.get());
+    }
+  }
+
+  nsCString mSessionId;
+  int32_t mBrowserIndex;
+  uint32_t mRetryCount;
+};
+
+// v98: NAPI 层调用的入口(无需窗口参数,内部自动查找 + 重试)
+// aBrowserIndex: 该 session 在 chrome docShell content 子列表中的位置下标
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_RegisterSessionProgress(const char* aSessionId,
+                                                     int32_t aBrowserIndex) {
+  if (!aSessionId) return;
+  nsCString sessionId(aSessionId);
+  OHOS_LOG( "[XRE] GeckoBridge_RegisterSessionProgress session=%s index=%d\n",
+          aSessionId, aBrowserIndex);
+  nsresult rv = NS_DispatchToMainThread(
+      mozilla::MakeAndAddRef<RegisterSessionProgressRunnable>(sessionId, aBrowserIndex));
+  if (NS_FAILED(rv)) {
+    OHOS_LOG( "[XRE] GeckoBridge_RegisterSessionProgress 派发失败 rv=0x%x\n",
+            (unsigned)rv);
+  }
+}
+
+// v88: 注销指定标签的进度监听器(session 关闭时调用)
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_UnregisterProgressListener(const char* aSessionId) {
+  if (!aSessionId) return;
+  gSessionListeners.erase(aSessionId);
+  OHOS_LOG( "[XRE] GeckoBridge_UnregisterProgressListener session=%s\n", aSessionId);
+}
+
+// v88: 兼容旧接口(首标签 session="0",index=0)
+// v98: sessionId 从 "default" 改为 "0",与 geckoview.js 首标签 createBrowserForSession("0") 对齐
+// 仅供 nsWindow::Create 首次启动时为首标签注册
+__attribute__((visibility("default")))
+extern "C" bool GeckoBridge_RegisterProgressListener(mozIDOMWindowProxy* aWindow) {
+  return OHOSProgressListener::RegisterForSession(aWindow, nsCString("0"), 0);
+}
+
+// ============================================================================
+// 导出:初始化进度监听器(在 Gecko 主线程就绪后调用)
+// ============================================================================
+// 由 nsWindow::Create 调用(此时 Gecko 主线程已就绪,XPCOM 已初始化)。
+// 通过 NS_DispatchToMainThread 异步派发 InitProgressListenerRunnable:
+//   - 若窗口已创建且 browser 元素就绪,直接注册进度监听器
+//   - 否则注册 OHOSStartupObserver 监听 browser-delayed-startup-finished 通知
+//     (geckoview.js startup() 第 931 行发送),通知到达时再注册
+//
+// 根因修复:原先在 GeckoBridge_SetURLChangeCallback 中派发,但该函数在
+// ArkTS 主线程调用时 XPCOM 未初始化(XRE_main 尚未启动),NS_DispatchToMainThread
+// 失败,导致初始 URL 加载时进度监听器未注册,URL/PageLoad 回调无法触发。
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_InitProgressListener() {
+  OHOS_LOG( "[XRE] GeckoBridge_InitProgressListener 派发 InitProgressListenerRunnable\n");
+  nsresult rv =
+      NS_DispatchToMainThread(mozilla::MakeAndAddRef<InitProgressListenerRunnable>());
+  if (NS_FAILED(rv)) {
+    OHOS_LOG( "[XRE] GeckoBridge_InitProgressListener 派发失败 rv=0x%x\n",
+            (unsigned)rv);
+  }
+  // v136: 启动周期重扫定时器(3s 周期),为 native 轨道新建标签补挂 listener。
+  //   ArkTS native 轨道新建标签走 gBrowser.addTab(无 C++ 回调),NAPI 未暴露
+  //   createSession → GeckoBridge_RegisterSessionProgress 不被调用 → 新标签
+  //   content docShell 上无 listener → 地址栏不刷新。周期重扫兜底补挂。
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "InitRescanTimer",
+      []() {
+        // 静态持有避免 timer 被回收(进程生命周期常驻)。延迟 3s 首次触发,
+        // 避开启动期高频 docShell 变化;之后每 3s 重扫一次。
+        static nsCOMPtr<nsITimer> sRescanTimer;
+        nsresult rv2 = NS_NewTimerWithCallback(
+            getter_AddRefs(sRescanTimer),
+            [](nsITimer* aTimer) { RescanTabsForListeners(aTimer); }, 3000,
+            nsITimer::TYPE_REPEATING_SLACK, "OHOSRescanTabs");
+        if (NS_SUCCEEDED(rv2)) {
+          OHOS_DiagLog("[XRE_URL] 周期重扫定时器已启动(3s 首次及周期)");
+        } else {
+          OHOS_DiagLog("[XRE_URL] 周期重扫定时器启动失败 rv=0x%x", (unsigned)rv2);
+        }
+      }));
+}
