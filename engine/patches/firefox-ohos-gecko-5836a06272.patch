+/* -*- Mode: c++; c-basic-offset: 4; tab-width: 20; indent-tabs-mode: nil; -*-
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// OpenHarmony NAPI 模块入口声明
+// 产出 libgeckoview.so,由 ArkTS 层 import('libgeckoview.so') 调用
+// 接口形态参考 servo/support/openharmony,但调用 Gecko API 替代 Servo
+
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+#include <node_api.h>
+
+#include "mozilla/RefPtr.h"
+
+// 注意:stage2 不声明 GetActiveDOMWindow / GetDOMWindows 等返回 nsIDOMWindow 的接口。
+// 原因:RefPtr<nsIDOMWindow> 的析构需要 nsIDOMWindow 完整类型,而 nsIDOMWindow.h
+// 会传递引入 mozilla/mozalloc.h → cxxalloc.h → 重定义 operator new → 调用 moz_xmalloc。
+// 为提供 moz_xmalloc 需静态链接 mozglue,但 mozglue 含 TimeStampInitialization
+// 全局构造函数,在 dlopen 时执行 TimeStamp::Startup()/InitializeUptime() 会因
+// Gecko 运行时未就绪而 SIGSEGV。stage3 实现真实窗口后再恢复 nsIDOMWindow 接口。
+
+// GeckoView 回调集合,由 ArkTS 层通过 register*Callback 注册
+// Gecko 内核触发事件时,通过 napi_threadsafe_function 跨线程回调到 ArkTS 主线程
+struct GeckoViewCallbacks {
+    // URL 变化回调(参数:新 URL)
+    napi_threadsafe_function urlCallback = nullptr;
+    // 内核终止回调
+    napi_threadsafe_function terminateCallback = nullptr;
+    // prompt/toast 回调(参数:消息内容)
+    napi_threadsafe_function promptToastCallback = nullptr;
+    // 页面加载状态回调(参数:"start" 或 "stop")
+    napi_threadsafe_function pageLoadCallback = nullptr;
+    // IME 显示键盘回调(参数:"show" 或 "hide")
+    // v64:设备不支持 IME NDK C API(libohinputmethod.so 为空实现 stub),
+    //      改用 ArkTS 层 TextInput 组件桥接软键盘。Gecko 检测到文本框获得焦点时
+    //      通过此回调通知 ArkTS 层显示软键盘,失去焦点时通知隐藏。
+    napi_threadsafe_function imeCallback = nullptr;
+    // v77: 页面加载进度回调(参数:0-100 百分比)
+    napi_threadsafe_function progressCallback = nullptr;
+    // v118: 文件选择器请求回调(参数:requestJson, callbackId)
+    // Gecko <input type=file> → OHOSFilePicker::Open → OHOSFilePickerBridge_Request
+    // → 此 tsfn → ArkTS FirefoxBridge filePickerCallback → 系统 Picker
+    napi_threadsafe_function filePickerCallback = nullptr;
+    // v118: 下载进度回调(参数:事件 JSON 字符串)
+    // Gecko nsExternalAppHandler → OHOSDownloadBridge_Notify
+    // → 此 tsfn → ArkTS FirefoxBridge downloadCallback
+    // 事件 JSON: start/progress/complete/failed(字段见 OHOSDownloadBridge.h)
+    napi_threadsafe_function downloadCallback = nullptr;
+    // P1: 文件 reveal 回调(参数:文件绝对路径字符串,fire-and-forget)
+    // Gecko nsLocalFile::Reveal → GeckoBridge_RevealFile → OHOSRevealBridge_Request
+    // → 此 tsfn → ArkTS FirefoxBridge registerRevealCallback → 系统文件管理器
+    napi_threadsafe_function revealCallback = nullptr;
+    // P1: 打印回调(参数:临时 PDF 沙箱绝对路径字符串,fire-and-forget)
+    // Gecko nsDeviceContextSpecOHOS::DoEndDocument → OHOSPrintBridge_Notify
+    // → 此 tsfn → ArkTS FirefoxBridge registerPrintCallback
+    // → print.print 拉起系统打印预览 + 清理临时 PDF
+    napi_threadsafe_function printCallback = nullptr;
+    // v150: 鼠标光标样式回调(参数:windowId:int32, pointerStyle:int32)
+    // 真机 libohinput.so 为 SDK stub,OH_Input_SetPointerStyle 不生效,
+    // 改由 Gecko 样式变化 → OHOS_ApplyPointerStyle(libxul)→ gPointerStyleNotify
+    // → OHOS_PointerStyleNotify(本 .so)→ 此 tsfn → ArkTS pointer.setPointerStyleSync。
+    napi_threadsafe_function pointerStyleCallback = nullptr;
+    // DOM fullscreen 状态回调(参数:true=网页进入全屏,false=退出)。
+    // nsWindow::MakeFullScreen → OHOSNativeWindowBridge → 本 .so tsfn → ArkTS
+    // 切换 HarmonyOS 系统栏/窗口布局,使 HTML5 video 获得真实窗口全屏。
+    napi_threadsafe_function fullscreenCallback = nullptr;
+    // 通用原生菜单回调(参数:菜单 JSON 字符串,含整棵菜单树 + 锚点 rect)。
+    // Gecko nsXULPopupManager::ShowMenu/ShowPopup(OHOS 拦截)→ OHOSMenuBridge_Show
+    // → gMenuCb → OHOS_MenuNotify(本 .so)→ 此 tsfn → ArkTS registerMenuCallback
+    // → OHOSMenuBridge.showFromJson → NativeMenuOverlay 渲染。
+    // 命令回填走 resolveMenuCommand / closeNativeMenu(无 tsfn,直接调 libxul 导出)。
+    napi_threadsafe_function menuCallback = nullptr;
+    // v250: 标签状态推送回调(参数:标签列表 JSON 字符串)。
+    // chrome JS(ohos-chrome-bridge.js)TabOpen/Close/Select/AttrModified →
+    // Services.obs "airweb-tab-state" → libxul OHOSTabStateObserver →
+    // GeckoBridge_SetTabStateCallback 注册的 OHOS_TabStateNotify → 此 tsfn
+    // → ArkTS registerTabStateCallback(驱动 ArkTS 底栏计数/切换器/2in1 标签条)
+    napi_threadsafe_function tabStateCallback = nullptr;
+    // v251: 扩展安装进度回调(参数:JSON 字符串 {phase,name,progress,maxProgress,error})。
+    // chrome JS AddonManager InstallListener → Services.obs "airweb-addon-install"
+    // → libxul OHOSTabStateObserver → GeckoBridge_SetAddonInstallCallback 注册的
+    // OHOS_AddonInstallNotify → 此 tsfn → ArkTS registerAddonInstallCallback
+    // (AMO 慢下载进度横幅)。
+    napi_threadsafe_function addonInstallCallback = nullptr;
+    // v243: 首帧合成完成回调(无参数,fire-and-forget,一次性)。
+    // Renderer 线程首次成功 SwapBuffers(真有像素上屏)→ GeckoBridge_NotifyFirstComposite
+    // → OHOS_FirstCompositeNotify(本 .so)→ 此 tsfn → ArkTS registerFirstCompositeCallback
+    // → NativeShellPage 撤 Splash。替代 pageLoad stop 作撤除信号(stop 是网络/解析
+    // 层事件,no-JIT 手机上可能早于合成器首帧 → 白→黑→内容闪序)。
+    napi_threadsafe_function firstCompositeCallback = nullptr;
+};
+
+// 初始化火狐内核,加载 Gecko 内核并启动主线程
+// options: { url: string, resourceDir: string, commandlineArgs: string }
+napi_value InitFirefox(napi_env env, napi_callback_info info);
+
+// 在当前活跃 webview 加载 URL
+// url: string
+napi_value LoadURL(napi_env env, napi_callback_info info);
+
+// 当前活跃 webview 后退
+napi_value GoBack(napi_env env, napi_callback_info info);
+
+// 当前活跃 webview 前进
+napi_value GoForward(napi_env env, napi_callback_info info);
+
+// v76: 在 session history 中跳转到指定 index(利用 bfcache 恢复页面,避免重新加载)
+// index: number
+napi_value GoToIndex(napi_env env, napi_callback_info info);
+
+// 注册 URL 变化回调
+// callback: (url: string) => void
+napi_value RegisterURLCallback(napi_env env, napi_callback_info info);
+
+// 注册内核终止回调
+// callback: () => void
+napi_value RegisterTerminateCallback(napi_env env, napi_callback_info info);
+
+// 注册 prompt/toast 回调
+// callback: (msg: string) => void
+napi_value RegisterPromptToastCallback(napi_env env, napi_callback_info info);
+
+// 注册页面加载状态回调
+// callback: (state: string) => void, state="start"|"stop"
+napi_value RegisterPageLoadCallback(napi_env env, napi_callback_info info);
+
+// v77: 注册页面加载进度回调
+// callback: (progress: number) => void, progress=0-100 百分比
+napi_value RegisterProgressCallback(napi_env env, napi_callback_info info);
+
+// 注册 IME 状态回调(v64:ArkTS 层 TextInput 桥接软键盘)
+// callback: (state: string) => void, state="show"|"hide"
+napi_value RegisterIMECallback(napi_env env, napi_callback_info info);
+
+// v118: 注册文件选择器请求回调(Gecko → ArkTS)
+// callback: (requestJson: string, callbackId: number) => void
+// Gecko <input type=file> 触发,ArkTS 拉起系统 Picker 并通过 resolveFilePicker 回填。
+napi_value RegisterFilePickerCallback(napi_env env, napi_callback_info info);
+
+// v118: 回填文件选择结果(ArkTS → Gecko)
+// callbackId: number, result: number(0=确认/非0=取消), path: string(选中文件 URI)
+napi_value ResolveFilePicker(napi_env env, napi_callback_info info);
+
+// v118: 注册下载进度回调(Gecko → ArkTS,单向通知)
+// callback: (json: string) => void
+// 事件 json: start/progress/complete/failed(字段见 OHOSDownloadBridge.h)
+// Gecko nsExternalAppHandler 在下载生命周期各点通过 OHOSDownloadBridge_Notify 触发。
+napi_value RegisterDownloadCallback(napi_env env, napi_callback_info info);
+
+// P1: 注册文件 reveal 回调(Gecko → ArkTS,单向通知 fire-and-forget)
+// callback: (path: string) => void
+// path 为 Gecko 侧 nsIFile 绝对路径(可能是沙箱临时路径,ArkTS 侧自行映射)。
+// Gecko nsLocalFile::Reveal → GeckoBridge_RevealFile → OHOSRevealBridge_Request
+// → 此 tsfn → ArkTS registerRevealCallback → 拉起系统文件管理器。
+napi_value RegisterRevealCallback(napi_env env, napi_callback_info info);
+
+// P1: 注册打印回调(Gecko → ArkTS,单向通知 fire-and-forget)
+// callback: (path: string) => void
+// path 为 Gecko 侧 nsDeviceContextSpecOHOS 渲染出的临时 PDF 沙箱绝对路径。
+// nsDeviceContextSpecOHOS::DoEndDocument → OHOSPrintBridge_Notify → 此 tsfn
+// → ArkTS registerPrintCallback → fileUri.getUriFromPath + print.print 系统打印预览。
+napi_value RegisterPrintCallback(napi_env env, napi_callback_info info);
+
+// 通用原生菜单:注册菜单回调(Gecko → ArkTS,菜单 JSON 下发,fire-and-forget)
+// callback: (json: string) => void
+// json 为 OHOSMenuBridge 序列化的完整菜单树 + 锚点 rect。
+// Gecko nsXULPopupManager(OHOS 拦截)→ OHOSMenuBridge_Show → 此 tsfn
+// → ArkTS registerMenuCallback → OHOSMenuBridge.showFromJson → NativeMenuOverlay。
+napi_value RegisterMenuCallback(napi_env env, napi_callback_info info);
+
+// 通用原生菜单:回填执行命令(ArkTS → Gecko)
+// menuId: number, itemId: number, modifiers?: number
+// libxul GeckoBridge_RunMenuCommand 查句柄表 → DispatchXULCommand 触发 oncommand。
+napi_value ResolveMenuCommand(napi_env env, napi_callback_info info);
+
+// 通用原生菜单:回填关闭(ArkTS → Gecko)
+// menuId: number。libxul GeckoBridge_CloseNativeMenu 清理本次句柄表(无命令派发)。
+napi_value CloseNativeMenu(napi_env env, napi_callback_info info);
+
+// v150: 注册鼠标光标样式回调(Gecko → ArkTS)
+// callback: (windowId: number, pointerStyle: number) => void
+// Gecko nsWindow::SetCursor(去重后)→ OHOS_ApplyPointerStyle(libxul)
+// → gPointerStyleNotify → OHOS_PointerStyleNotify(本 .so)→ 此 tsfn
+// → ArkTS pointer.setPointerStyleSync(windowId, pointerStyle)。
+// pointerStyle 为 Input_PointerStyle 枚举值,与 ArkTS PointerStyle 数值一致。
+napi_value RegisterPointerStyleCallback(napi_env env, napi_callback_info info);
+
+// 注册导航委托回调(阶段1:Gecko → ArkTS 事件派发)
+// callback: (event: string, data: string, callbackId: number) => void
+// GeckoViewNavigation/LoadURIDelegate 等模块通过此回调将
+// GeckoView:OnLoadRequest / GeckoView:OnNewSession 等事件派发到 ArkTS。
+// ArkTS 处理后调用 resolveNavigationEvent(callbackId, ...) 回传决策。
+napi_value RegisterNavigationCallback(napi_env env, napi_callback_info info);
+
+// 回传导航决策结果(阶段1:ArkTS → Gecko Promise 解析)
+// callbackId: number, success: number(1=允许/0=拒绝), result: string(可选)
+// 在 Gecko 主线程解析 sendRequestForResult 的 Promise,解除 spinEventLoopUntil 阻塞。
+napi_value ResolveNavigationEvent(napi_env env, napi_callback_info info);
+
+// 向 Gecko 插入文本(v64:由 ArkTS 层 TextInput onChange 调用)
+// text: string
+napi_value InsertText(napi_env env, napi_callback_info info);
+
+// 向 Gecko 删除文本(v64:由 ArkTS 层 TextInput 退格调用)
+// length: number
+napi_value DeleteText(napi_env env, napi_callback_info info);
+
+// 切换活跃 webview
+// index: number, arkts_ids: number[]
+napi_value FocusWebview(napi_env env, napi_callback_info info);
+
+// 删除指定下标 webview
+// index: number, arkts_ids: number[]
+napi_value DeleteWebview(napi_env env, napi_callback_info info);
+
+// 申请新的 window id
+// arkts_id: number
+napi_value NextWindowId(napi_env env, napi_callback_info info);
+
+// 鼠标移动事件
+// x: number, y: number
+napi_value MouseMove(napi_env env, napi_callback_info info);
+
+// 鼠标按下事件
+// x: number, y: number, button: number(0=左键,1=右键,2=中键)
+napi_value MouseDown(napi_env env, napi_callback_info info);
+
+// 鼠标释放事件
+// x: number, y: number, button: number
+napi_value MouseUp(napi_env env, napi_callback_info info);
+
+// 滚轮事件
+// dx: number, dy: number, x: number, y: number
+napi_value Scroll(napi_env env, napi_callback_info info);
+
+// NAPI 模块注册入口在 geckoview.cpp 中实现(geckoview 业务模块 + geckoxcomp XComponent 模块)
+// 两个模块共享同一个 libgeckoview.so,通过 nm_modname 区分,无需在头文件暴露
+
+// GeckoView 全局状态访问(供 XComponentRenderer/InputEventForwarder 使用)
+namespace geckoview {
+// 已注册的 ArkTS 回调集合
+GeckoViewCallbacks& GetCallbacks();
+
+// 当前活跃 webview 在窗口列表中的下标
+uint32_t GetActiveIndex();
+
+// 设置活跃 webview 下标
+void SetActiveIndex(uint32_t aIndex);
+}  // namespace geckoview
diff --git a/ports/ohos/moz.build b/ports/ohos/moz.build
new file mode 100644
index 0000000000..0e6d842360
--- /dev/null
+++ b/ports/ohos/moz.build
@@ -0,0 +1,58 @@
+# -*- Mode: python; indent-tabs-mode: nil; tab-width: 40 -*-
+# vim: set filetype=python:
+# OpenHarmony NAPI 桥接层构建配置
+# 产出 libgeckoview.so(NAPI 模块,包装 libxul.so)
+
+# GeckoView NAPI 入口模块(注意:SOURCES 必须按字母顺序排序)
+SOURCES += [
+    "geckoview.cpp",
+    "InputEventForwarder.cpp",
+    "XComponentRenderer.cpp",
+]
+
+# NAPI 头文件路径(注意:LOCAL_INCLUDES 必须按字母顺序排序)
+# "!/build" 指向 objdir/build/(application.ini.h 生成在此)
+# "/path" 指向源码目录 path/
+LOCAL_INCLUDES += [
+    "!/build",  # application.ini.h(sAppData 静态常量,生成在 objdir/build/)
+    "/ipc/chromium/src",
+    "/widget/openharmony",
+    "/xpcom/glue",
+]
+
+# 动态链接 libxul.so(Gecko 内核本体)。
+# 注意:不能用 USE_LIBS += ["xul"],那会引用静态库 xul_s(包含 Gecko 全部 .o),
+# 这些 .o 引用 libxul.so 的 hidden 内部符号(MOZ_Z_*、encoding_mem_*、
+# nsstring_fallible_append_* 等),触发 "undefined hidden symbol" 链接错误。
+# USE_LIBS += ["xul-real"] 引用 toolkit/library/build/moz.build 中定义的
+# SharedLibrary "xul-real"(产出 libxul.so),让 build system 自动通过
+# -L dist/bin -lxul 动态链接,仅引用 libxul.symbols 中导出的符号
+# (当前只有 XRE_GetBootstrap)。
+# libxul.so 的内部 XPCOM API(nsIWindowWatcher/NS_DispatchToMainThread 等)
+# 在 libxul 中是 hidden 符号,无法被 libgeckoview.so 直接调用,
+# 因此本模块的 NAPI 接口仅通过 Bootstrap 公开虚函数(XRE_main 等)与 Gecko 交互。
+USE_LIBS += [
+    "xul-real",
+]
+
+# 产出为共享库 libgeckoview.so
+SharedLibrary("geckoview")
+
+# MOZILLA_INTERNAL_API: 允许外部模块使用 XPCOM 字符串等内部 API
+# 不定义此宏会导致 nsTSubstring.h 报错 "Using XPCOM strings is limited to code linked into libxul"
+DEFINES["MOZILLA_INTERNAL_API"] = True
+
+# OpenHarmony NDK 库链接
+# 注意:OHOS NDK 的库文件名带 .z 中缀(如 libace_napi.z.so),
+# 不能用 OS_LIBS 简写(会被查找为 libace_napi.so,不存在),
+# 必须用 LDFLAGS + "-l:" 语法指定完整文件名。
+# XComponent 接口在 libace_ndk.z.so 中(native_interface_xcomponent.h 注释:@library libace_ndk.z.so)。
+LDFLAGS += [
+    "-l:libace_napi.z.so",   # NAPI 运行时
+    "-l:libace_ndk.z.so",    # ArkUI NDK(含 OH_NativeXComponent)
+    "-l:libhilog_ndk.z.so",  # hilog 日志
+    "-lnative_display_manager",  # OHOS DisplayManager(获取真实 DPI)
+    "-lEGL",                 # EGL 渲染
+    "-lGLESv3",              # OpenGL ES 3
+    "-lohinputmethod",       # OHOS IME NDK(v57:软键盘控制 + 文本输入回调)
+]
