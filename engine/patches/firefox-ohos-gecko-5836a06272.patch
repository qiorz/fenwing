+                fputs("user_pref(\"toolkit.defaultChromeURI\", \"chrome://browser/content/browser.xhtml\");\n", fw);
+                OH_LOG_INFO(LOG_APP, "prefs.js 已写入 dom.disable_beforeunload=true + browser.xhtml(native)");
+                WriteLogFile("[UI] uiMode=native, toolkit.defaultChromeURI=browser.xhtml; beforeunload disabled");
+            } else {
