+    if (argc < 1) {
+        napi_throw_type_error(env, nullptr, "参数缺失,期望 method 字符串");
+        return nullptr;
+    }
+    char methodBuf[128] = {0};
+    if (!NapiGetString(env, args[0], methodBuf, sizeof(methodBuf))) {
+        napi_throw_type_error(env, nullptr, "method 参数解析失败");
+        return nullptr;
