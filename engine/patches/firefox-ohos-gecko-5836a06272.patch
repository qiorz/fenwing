+    margin-bottom: calc(58px + var(--phone-bottom-inset));
+  }
+  #phone-toast {
+    bottom: calc(58px + var(--phone-bottom-inset) + 12px);
+  }
+}
+
+/* ======================================================================
+ * 暗色模式 token 覆盖(应用当前强制浅色,此块为后续跟随系统预留)
+ * ==================================================================== */
+@media (-moz-pref("ohos.form.factor", "phone")) and (prefers-color-scheme: dark) {
+  :root {
+    --phone-accent: #00ddff;
+    --phone-accent-pressed: #80ebff;
+    --phone-bg: #1c1b22;
+    --phone-toolbar-bg: #2b2a33;
+    --phone-capsule-bg: #1c1b22;
+    --phone-text-primary: #fbfbfe;
+    --phone-text-secondary: #bfbfc9;
+    --phone-separator: rgba(255, 255, 255, 0.08);
+    --phone-pressed-overlay: rgba(255, 255, 255, 0.12);
+    --phone-icon: #fbfbfe;
+    --phone-icon-disabled: rgba(251, 251, 254, 0.35);
+  }
+  #phone-toast {
+    background: #e8e8eb;
+    color: #15141a;
+  }
+}
+
+/* ======================================================================
+ * reduced-motion 降级(禁 JIT 模式 ui.prefersReducedMotion 自动置 1,
+ * 本块即手机默认生效形态:一切位移/缩放动画退化为纯 opacity 或直接切换)
+ * ==================================================================== */
+@media (-moz-pref("ohos.form.factor", "phone")) and (prefers-reduced-motion: reduce) {
+  #phone-progress,
+  #phone-progress-fill {
+    transition: none;
+  }
+  #phone-tab-switcher {
+    transform: none;
+    transition: opacity 100ms linear, visibility 100ms;
+  }
+  .phone-tab-card {
+    transition: none;
+  }
+  .phone-tab-card[closing] {
+    transform: none;
+    opacity: 0;
+  }
+  #phone-toast {
+    transform: translate(-50%, 0);
+    transition: opacity 100ms linear, visibility 100ms;
+  }
+  .phone-bar-btn,
+  .phone-switcher-btn {
+    transition: none;
+  }
+}
+
+/* ======================================================================
+ * [OHOS v250] ArkTS 接管块
+ *
+ * 手机底栏六键/全屏标签切换器/加载进度条改由 ArkTS 系统组件绘制
+ * (PhoneBottomBar/PhoneTabSwitcher/NativeShellPage,禁 JIT 手机零解释器税);
+ * XUL 三件套幽灵化:visibility:hidden 保留布局 frame(#phone-bottom-bar 为
+ * fixed 不占布局,但 phone-chrome.js 的接线/状态机仍以元素存在为前提,
+ * display:none 会重复 v241b urlbar 尺寸链死教训),命中与视觉全让位 ArkTS。
+ * #browser 的 margin-bottom 让位规则保持不变(ArkTS 底栏同高 68/58px)。
+ * #phone-progress 无布局依赖(2px 覆盖条),直接 display:none。
+ * ==================================================================== */
+@media (-moz-pref("ohos.form.factor", "phone")) {
+  #phone-bottom-bar,
+  #phone-tab-switcher {
+    visibility: hidden !important;
+    pointer-events: none !important;
+  }
+  #phone-progress {
+    display: none !important;
+  }
+}
+
+/* 2in1(MateBook)形态:XUL 标签条+导航条幽灵化,ArkTS DesktopChrome 标签条
+ * 叠上层 + DesktopNavBar 导航行叠上层(v252 P2)。
+ * #TabsToolbar/#nav-bar 均 visibility:hidden 保留布局 frame 与高度
+ * (v241b 教训:严禁 display:none——urlbar 初始化 JS 依赖测量;
+ * #urlbar-container frame=identity-box doorhanger 锚点,
+ * #PanelUI-button frame 保留 nav-bar 右端原位=≡ 菜单序列化锚点)。
+ * v253: 对齐 另一浏览器移植线 Chrome 范式收窄——#TabsToolbar 显式钉 36px
+ * (其自然高 40px 由子元素撑出,须 max-height+overflow 强钳),
+ * #nav-bar 48→44px,与 ArkTS DesktopChrome 36vp / DesktopNavBar 44vp
+ * 严格对齐(vp==CSSpx,v250 同源实证);内容区起始位置由 XUL 布局决定,
+ * 幽灵化零位移。 */
+@media (-moz-pref("ohos.form.factor", "2in1")) {
+  #TabsToolbar {
+    visibility: hidden !important;
+    height: 36px !important;
+    min-height: 36px !important;
+    max-height: 36px !important;
+    overflow: hidden !important;
+  }
+  #nav-bar {
+    visibility: hidden !important;
+    height: 44px !important;
+    min-height: 44px !important;
+    max-height: 44px !important;
+  }
+}
