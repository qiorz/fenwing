+// IME 请求获取 TextConfig(输入类型/EnterKey 类型/选区等)
+// 在 Attach 调用线程执行(OnSurfaceCreated → 主线程)
+static void OHOS_OnGetTextConfig(InputMethod_TextEditorProxy* proxy,
+                                 InputMethod_TextConfig* config) {
+    if (!config) return;
+    int32_t inputType = gIMEInputType.load(std::memory_order_relaxed);
+    OH_TextConfig_SetInputType(config, (InputMethod_TextInputType)inputType);
+    OH_TextConfig_SetEnterKeyType(config, IME_ENTER_KEY_UNSPECIFIED);
