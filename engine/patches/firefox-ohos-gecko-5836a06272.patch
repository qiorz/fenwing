+    // 根因:geckoview.js 的 dump() 写到 stdout(fd 1),C++ 诊断写到 stderr(fd 2),
+    // EntryAbility 只读取 gecko_xre_diag.txt 文件,不捕获 stdout/stderr。
+    // 用 dup2 把 stdout 和 stderr 都重定向到 gecko_xre_diag.txt,
+    // 这样所有 printf/fprintf/dump 输出都会被 EntryAbility 读取。
+    {
+        int diagFd = open("/data/storage/el2/base/haps/entry/files/gecko_xre_diag.txt",
+                          O_WRONLY | O_APPEND | O_CREAT, 0666);
