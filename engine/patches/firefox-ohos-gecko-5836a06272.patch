+    // 写标记文件:确认 XRE_main 已返回
+    // 注意:标记文件写在沙箱根目录(与日志搬运器检查路径一致)
+    {
+        std::string afterMarker = "/data/storage/el2/base/haps/entry/files/after_xre_main";
+        FILE* fp = fopen(afterMarker.c_str(), "w");
