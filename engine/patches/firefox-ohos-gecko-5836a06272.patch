+                    }
+                }
+                fclose(fr);
+            }
+        }
+        FILE* fw = fopen(prefsPath.c_str(), "w");
+        if (fw) {
+            if (!kept.empty()) {
+                fputs(kept.c_str(), fw);
+            }
+            // 关标签卡死 R1:放行 beforeunload。OHOS 上 PermitUnload/beforeunload 弹
+            // nsIPrompt 确认框会阻塞内核主线程(单 EGL Surface 死区→软卡死)。
+            // dom.disable_beforeunload 被 nsDocumentViewer::PermitUnload 与
+            // WindowGlobalParent 的 beforeunload 派发路径实际检查
+            // (StaticPrefList.yaml,mirror:always),置 true 直接跳过弹框,
+            // beforeunload 不再阻塞标签关闭。该 pref 须在所有 uiMode 下生效。
+            fputs("user_pref(\"dom.disable_beforeunload\", true);\n", fw);
+            // v154:强制关闭 display-list 全量 dump。v144 popup 排障时曾在设备
+            // profile 持久化 gfx.webrender.debug.dl.dump-parent=true;该残留会让
