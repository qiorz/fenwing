+/**
+ * OHOS aarch64 H.264 video decoding
+ * config_unix_aarch64.h was originally designed for audio-only builds,
+ * so H.264 component configs are all 0. Enable them here for full video decoding.
+ *
+ * Note: CONFIG_ERROR_RESILIENCE and CONFIG_MPEG_ER are kept at 0 because
+ * the full error_resilience.c and mpeg_er.c from FFmpeg 6.1 are incompatible
+ * with ffvpx's FFmpeg 7.x base. error_resilience.c provides a stub no-op
+ * implementation of ff_er_frame_start/ff_er_frame_end/ff_er_add_slice so
+ * the H.264 decoder (which calls them unconditionally) links cleanly.
+ * Error concealment is an optional feature; streaming H.264 works without it.
+ **/
+#if !defined(MOZ_FFVPX_AUDIOONLY) && defined(__aarch64__)
+  #undef CONFIG_CABAC
+  #undef CONFIG_GOLOMB
+  #undef CONFIG_H264CHROMA
+  #undef CONFIG_H264DSP
