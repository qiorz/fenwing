+// 表面尺寸变化时(窗口放大/缩小)触发 nsWindow::Resize,同步 Gecko 的
+// mBounds / LayerManager / CompositorBridgeParent / EGL swapchain。
+// 根因修复:OnSurfaceChanged 原先只更新全局尺寸记录,从不通知已创建的
+// nsWindow,导致拖拽缩放窗口时页面渲染不跟随。
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_ResizeSurface(int32_t aWidth, int32_t aHeight);
+
+// v136: GeckoBridge_SetSafeAreaInsets 由 widget/openharmony/OHOSNativeWindowBridge.cpp
+// 实现(也可放 OHOSScreenHelper.cpp)。ArkTS 把四向安全区(px)下发到 Gecko,
+// OHOSScreenHelper 用其收紧 nsIScreen availRect,使 nsMenuPopupFrame
+// GetConstraintRect 拿到受限工作区 → popup 高度受限 → 菜单滚动。
+// 参数单位:物理 px(与 DisplayManager 返回的 width/height 同坐标系)。
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_SetSafeAreaInsets(int top, int right, int bottom, int left);
+
+// v137: OHOS_SetMainWindowId 由 widget/openharmony/OHOSNativeWindowBridge.cpp 实现。
+// 注入 OHOS 主窗口 windowId,供 OH_Input_SetPointerStyle 定位目标窗口。
+// ArkTS EntryAbility 在 onWindowStageCreate 拿到主窗口 windowId 后调用。
+__attribute__((visibility("default")))
+extern "C" void OHOS_SetMainWindowId(int32_t id);
+
+// GeckoBridge_WaitNativeWindow 由 widget/openharmony/OHOSNativeWindowBridge.cpp
+// 实现,在 libxul.symbols 中导出。GeckoMainThread 在调用 XRE_main 之前调用此函数
+// 阻塞等待 OnSurfaceCreated 注入 OHNativeWindow。
+//
+// 关键设计:同步原语(mutex + condition_variable)必须位于 libxul.so 内。
+// 原因:libgeckoview.so 与 libgeckoxcomp.so 是同一份 geckoview.cpp 代码的两个
+// 文件副本(build-id 不同),dlopen 后是两个独立的内存映像,本 .so 内的
+// static 全局变量在两个副本中各有一份独立实例。若把 CV 放在 geckoview.cpp 中,
+// OnSurfaceCreated(在 libgeckoxcomp.so 副本中)notify 的 CV 与
+// GeckoMainThread(在 libgeckoview.so 副本中)wait 的 CV 是不同实例,notify 永远
+// 唤醒不了等待线程,导致 wait_for 必然超时。
+// 把同步原语放到 libxul.so(内存中只有一份)中,从根本解决跨 .so 副本同步问题。
+// 返回值:非 nullptr 表示已就绪,nullptr 表示超时
+__attribute__((visibility("default")))
+extern "C" void* GeckoBridge_WaitNativeWindow(int aTimeoutMs);
+
+// GeckoBridge_LoadURL 由 widget/openharmony/OHOSURILoader.cpp 实现,
+// 在 libxul.symbols 中导出。NAPI LoadURL 接口通过此符号将 URL 传递到
+// libxul.so 内部,通过 NS_DispatchToMainThread 异步派发 OHOSLoadURLEvent,
+// 由 nsIWindowWatcher::openWindow 创建 geckoview 窗口并加载 URL。
+//
+// 设计原理:OHOS 平台 mobile/ohos/app.mozbuild 未包含 /browser 目录,
+// BrowserContentHandler 未构建,-url 命令行参数被静默忽略。参考 Android
+// GeckoView 架构,通过 NAPI 接口主动加载 URL,而非依赖命令行参数。
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_LoadURL(const char* aUrl);
+
+// ============================================================================
+// URL 变化/页面加载状态回调桥接(libxul.so -> libgeckoview.so)
+// ============================================================================
+// GeckoBridge_SetURLChangeCallback / GeckoBridge_SetPageLoadCallback 由
+// widget/openharmony/OHOSProgressListener.cpp 实现,在 libxul.symbols 中导出。
+//
+// 设计原理:libgeckoview.so 的 napi_threadsafe_function 存储在本 .so 全局状态,
+// libxul.so 无法直接访问。采用"函数指针注册"模式:
+//   1. libgeckoview.so RegisterURLCallback 创建 threadsafe_function 后,
+//      将一个 C 函数指针(OHOS_URLChangeNotify)注册到 libxul.so
+//   2. libxul.so 的 OHOSProgressListener 检测到 URL 变化时,
+//      通过 GeckoBridge_NotifyURLChange 调用该函数指针
+//   3. C 函数(OHOS_URLChangeNotify)调用 napi_call_threadsafe_function
+//      回调到 ArkTS 主线程
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_SetURLChangeCallback(
+    void (*cb)(const char* sessionId, const char* url));
+
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_SetPageLoadCallback(
+    void (*cb)(const char* sessionId, const char* state));
+
+// v77: 由 widget/openharmony/OHOSProgressListener.cpp 实现
+// 注册页面加载进度回调函数指针(progress: 0-100 百分比)
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_SetProgressCallback(
+    void (*cb)(const char* sessionId, int32_t progress));
+
+// v243: 由 widget/openharmony/OHOSProgressListener.cpp 实现
+// 注册首帧合成完成回调函数指针(无参数,一次性)
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_SetFirstCompositeCallback(void (*cb)());
+
+// ============================================================================
+// moz_xmalloc 本地实现
+// ============================================================================
+// cxxalloc.h(经 mozilla/mozalloc.h 传递引入)重定义了全局 operator new,
+// 内部调用 moz_xmalloc。libxul.so 中 moz_xmalloc 是 hidden 符号
+// (libxul.symbols 只导出 XRE_GetBootstrap),不能静态链接 mozglue
+// (其 TimeStampInitialization 全局构造函数在 dlopen 时崩溃)。
+// 在此提供 moz_xmalloc 本地实现,直接转发到标准 malloc。
+// moz_xmalloc 与 malloc 签名相同,差异仅是 OOM 处理(stage2 stub 可接受)。
+extern "C" void* moz_xmalloc(size_t size) {
+    return malloc(size);
+}
+
+// 注意:OH_LOG_INFO 宏需要 LOG_DOMAIN 和 LOG_TAG 定义(无 OH_ 前缀)
+// hilog/log.h 默认把 LOG_DOMAIN 定义为 0、LOG_TAG 定义为 NULL,
+// 这里 #undef 后重新定义为本模块的日志域与标签,避免 -Wmacro-redefined 警告。
+#undef LOG_DOMAIN
+#undef LOG_TAG
+#define LOG_DOMAIN 0x0001
+#define LOG_TAG "FirefoxBridge"
