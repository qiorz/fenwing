+// ============================================================================
+// 导航委托双向桥(阶段1:EventDispatcher)
+// ============================================================================
+// Gecko → ArkTS 方向:OHOSView::Dispatch(libxul.so)→ GeckoBridge_DispatchToArkTS
+//   → OHOS_DispatchToArkTS(本文件)→ napi_call_threadsafe_function(gNavigationCallback)
+//   → ArkTS FirefoxBridge navigationCallback(event, data, callbackId)
+//
+// ArkTS → Gecko 方向:ArkTS resolveNavigationEvent(callbackId, success, result)
+//   → ResolveNavigationEvent(本 NAPI 函数)→ GeckoBridge_ResolveNavigationEvent(libxul.so)
+//   → ResolveNavigationEventRunnable(Gecko 主线程)→ callback->onSuccess/onError
+//   → Messaging.sys.mjs Promise resolve/reject → spinEventLoopUntil 解除阻塞
+
+// 导航事件数据载体(Gecko → ArkTS,堆分配,CallJs 中 delete)
+struct NavigationEventData {
+    std::string event;
+    std::string data;
+    int32_t callbackId;
+};
+
+// 全局 navigationCallback threadsafe_function
+static napi_threadsafe_function gNavigationCallback = nullptr;
+
+// CallJs:在 ArkTS 主线程调用 JS 回调 navigationCallback(event, data, callbackId)
+static void CallJsNavigation(napi_env env, napi_value js_cb, void* context,
+                             void* data) {
+    if (!env || !js_cb) {
+        delete static_cast<NavigationEventData*>(data);
+        return;
+    }
+    auto* d = static_cast<NavigationEventData*>(data);
+    napi_value undefined;
+    napi_get_undefined(env, &undefined);
+
+    napi_value args[3];
+    napi_create_string_utf8(env, d->event.c_str(), d->event.length(), &args[0]);
+    napi_create_string_utf8(env, d->data.c_str(), d->data.length(), &args[1]);
+    napi_create_int32(env, d->callbackId, &args[2]);
+
+    napi_call_function(env, undefined, js_cb, 3, args, nullptr);
+    delete d;
+}
+
+// C 函数:由 libxul.so 的 OHOSView::Dispatch 通过 GeckoBridge_DispatchToArkTS 调用。
+// 转发到 ArkTS threadsafe_function。
+// 注意:此函数可能在 Gecko 主线程执行(spinEventLoopUntil 自旋期间),
+// napi_call_threadsafe_function(nonblocking)将任务投递到 ArkTS 事件队列异步执行。
+static int OHOS_DispatchToArkTS(const char* aEvent, const char* aData,
+                                int32_t aCallbackId) {
+    if (!gNavigationCallback) {
+        OH_LOG_ERROR(LOG_APP, "[NAV] OHOS_DispatchToArkTS 桥未注册(event=%{public}s)",
+                     aEvent ? aEvent : "(null)");
+        return -1;
+    }
+    auto* d = new NavigationEventData();
+    d->event = aEvent ? aEvent : "";
+    d->data = aData ? aData : "";
+    d->callbackId = aCallbackId;
+    napi_status st = napi_call_threadsafe_function(
+        gNavigationCallback, d, napi_tsfn_nonblocking);
+    if (st != napi_ok) {
+        OH_LOG_ERROR(LOG_APP, "[NAV] napi_call_threadsafe_function 失败 st=%{public}d event=%{public}s",
+                     (int)st, d->event.c_str());
+        delete d;
+        return -1;
+    }
+    return 0;
+}
+
+// 注册导航回调(Gecko → ArkTS)
+// 参数:callback: (event: string, data: string, callbackId: number) => void
+// ArkTS 收到后处理 OnLoadRequest / OnNewSession 等事件,
+// 处理完毕调用 resolveNavigationEvent(callbackId, success, result) 回传决策。
+napi_value RegisterNavigationCallback(napi_env env, napi_callback_info info) {
+    size_t argc = 1;
+    napi_value args[1];
+    napi_value thisArg;
+    napi_get_cb_info(env, info, &argc, args, &thisArg, nullptr);
+    if (argc < 1) {
+        OH_LOG_ERROR(LOG_APP, "RegisterNavigationCallback 参数缺失");
+        napi_throw_type_error(env, nullptr, "参数缺失,期望 callback 函数");
+        return nullptr;
+    }
+
+    napi_value workName;
+    napi_create_string_utf8(env, "GeckoViewNavigationCallback", NAPI_AUTO_LENGTH,
+                            &workName);
+    napi_threadsafe_function tsfn;
+    napi_status status = napi_create_threadsafe_function(
+        env, args[0], nullptr, workName, 0, 1, nullptr, nullptr,
+        nullptr, CallJsNavigation, &tsfn);
+    if (status != napi_ok) {
+        OH_LOG_ERROR(LOG_APP, "RegisterNavigationCallback 创建 threadsafe_function 失败: %{public}d",
+                     status);
+        napi_throw_error(env, nullptr, "创建 threadsafe_function 失败");
+        return nullptr;
+    }
+
+    gNavigationCallback = tsfn;
+    // 将 C 函数指针注册到 libxul.so,使 OHOSView::Dispatch 能回调到 ArkTS
+    GeckoBridge_SetDispatchCallback(OHOS_DispatchToArkTS);
+    OH_LOG_INFO(LOG_APP, "RegisterNavigationCallback 注册成功并已桥接到 libxul.so");
+
+    napi_value result;
+    napi_get_null(env, &result);
+    return result;
+}
+
+// 回传导航决策结果(ArkTS → Gecko)
+// 参数:callbackId: number, success: number(1=允许/0=拒绝), result: string
+// 调用 GeckoBridge_ResolveNavigationEvent(libxul.so),在 Gecko 主线程解析 Promise。
+napi_value ResolveNavigationEvent(napi_env env, napi_callback_info info) {
+    size_t argc = 3;
+    napi_value args[3];
+    napi_value thisArg;
+    napi_get_cb_info(env, info, &argc, args, &thisArg, nullptr);
+    if (argc < 2) {
+        OH_LOG_ERROR(LOG_APP, "ResolveNavigationEvent 参数缺失(期望 callbackId, success[, result])");
+        napi_throw_type_error(env, nullptr, "参数缺失");
+        return nullptr;
+    }
+
+    int32_t callbackId = 0;
+    napi_get_value_int32(env, args[0], &callbackId);
+    int32_t successInt = 0;
+    napi_get_value_int32(env, args[1], &successInt);
+
+    // result 可选,默认空字符串
+    std::string result;
+    if (argc >= 3) {
+        size_t len = 0;
+        napi_get_value_string_utf8(env, args[2], nullptr, 0, &len);
+        result.resize(len);
+        napi_get_value_string_utf8(env, args[2], &result[0], len + 1, &len);
+    }
+
+    OH_LOG_INFO(LOG_APP, "[NAV] ResolveNavigationEvent callbackId=%{public}d success=%{public}d",
+                callbackId, successInt);
+
+    // 派发到 Gecko 主线程,解析 sendRequestForResult 的 Promise
+    GeckoBridge_ResolveNavigationEvent(callbackId, successInt != 0, result.c_str());
+
+    napi_value res;
+    napi_get_null(env, &res);
+    return res;
+}
