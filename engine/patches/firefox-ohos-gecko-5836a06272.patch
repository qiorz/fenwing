+//
+// 与 OHOSDownloadBridge 的区别:
+//   - 多一个 GeckoBridge_RevealFile 导出入口,供 xpcom/io 跨模块调用
+//     (nsLocalFile::Reveal 经本地 extern "C" 声明调用,无需 include widget 头文件)。
+//   - 同为单向 fire-and-forget:未注册时不兜底,仅记日志后返回。
+//     GeckoBridge_RevealFile 对外仍正常返回,nsLocalFile::Reveal 返回 NS_OK。
+
+#include "OHOSRevealBridge.h"
+
+#include "OHOSDebug.h"  // OHOS_LOG / OHOS_DiagLog
+
+namespace mozilla {
+namespace widget {
+
+// reveal 回调函数指针(由 libgeckoview.so 通过 GeckoBridge_SetRevealCallback 注册)
+// 签名:(文件绝对路径)。libgeckoview.so 内部再 tsfn 投递到 ArkTS registerRevealCallback。
+// set-once-before-use:libgeckoview.so 在 GeckoMainThread 启动早期注册,
+// nsLocalFile::Reveal 仅在用户交互(下载列表"打开所在文件夹")时触发,时序安全。
+static void (*gRevealCb)(const char* aPath) = nullptr;
+
+// libxul.so 内部入口:由 GeckoBridge_RevealFile 调用,转发文件路径到 libgeckoview.so
+void OHOSRevealBridge_Request(const char* aPath) {
+  if (!gRevealCb) {
+    // 桥未注册(ArkTS 层尚未 initFirefox 或 libgeckoview.so 未注册回调)。
+    // reveal 是 fire-and-forget,直接返回即可;nsLocalFile::Reveal 仍返回 NS_OK。
+    OHOS_LOG("[Reveal] 回调桥未注册,丢弃 reveal 请求: %s\n",
+             aPath ? aPath : "(null)");
+    return;
+  }
+  gRevealCb(aPath);
+}
+
+}  // namespace widget
+}  // namespace mozilla
+
+// ============================================================================
+// 导出符号(visibility default,在 libxul.symbols 登记)
+// ============================================================================
+
+// libgeckoview.so 启动时调:RegisterRevealCallback 等价物,登记回调函数指针
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_SetRevealCallback(void (*cb)(const char* aPath)) {
+  mozilla::widget::gRevealCb = cb;
+  OHOS_LOG("[Reveal] GeckoBridge_SetRevealCallback 已注册 cb=%p\n", (void*)cb);
+}
+
+// libxul.so 内 nsLocalFile::Reveal(xpcom/io)调用的跨模块入口。
+// extern "C" + visibility default + libxul.symbols 登记,使 xpcom 无需 include
+// widget 头文件即可经本地 extern 声明调用。fire-and-forget,绝不阻塞 Gecko 主线程。
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_RevealFile(const char* aPath) {
+  mozilla::widget::OHOSRevealBridge_Request(aPath);
+}
diff --git a/widget/openharmony/OHOSRevealBridge.h b/widget/openharmony/OHOSRevealBridge.h
new file mode 100644
index 0000000000..c1da0823cf
--- /dev/null
+++ b/widget/openharmony/OHOSRevealBridge.h
@@ -0,0 +1,40 @@
+/* -*- Mode: C++; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// P1: 文件 reveal 跨 .so 桥(libxul.so ↔ libgeckoview.so ↔ ArkTS)
+//
+// 范式完全照抄 OHOSDownloadBridge.cpp 的"函数指针注册 + tsfn"模型
+// (单向通知,fire-and-forget,无回填):
+//   1. libgeckoview.so 启动时调 GeckoBridge_SetRevealCallback,把本 .so 内的
+//      OHOS_RevealNotify(geckoview.cpp 中的 C 函数)注册进来。
+//   2. libxul.so 内 nsLocalFile::Reveal(xpcom/io)调 GeckoBridge_RevealFile,
+//      经本转发函数 OHOSRevealBridge_Request 与存储的函数指针 gRevealCb 转发到
+//      libgeckoview.so → napi_threadsafe_function → ArkTS registerRevealCallback,
+//      由 ArkTS 拉起系统文件管理器。
+//   3. 与下载同为单向 fire-and-forget:reveal 不需要回填结果,故无 Resolve 等价物。
+//
+// 两个导出符号(visibility default,libxul.symbols 登记):
+//   GeckoBridge_SetRevealCallback   libgeckoview.so → libxul.so(注册回调)
+//   GeckoBridge_RevealFile          libxul.so 内部(nsLocalFile::Reveal,跨模块
+//                                   xpcom/io → widget/openharmony)→ gRevealCb
+//
+// path 语义:Gecko 侧 nsIFile 的绝对路径(可能是沙箱临时路径),ArkTS 侧自行映射。
+
+#ifndef widget_openharmony_OHOSRevealBridge_h__
+#define widget_openharmony_OHOSRevealBridge_h__
+
+namespace mozilla {
+namespace widget {
+
+// libxul.so 内部入口:由 GeckoBridge_RevealFile(extern "C" 导出)调用,
+// 经 gRevealCb 把文件路径转发到 libgeckoview.so → ArkTS registerRevealCallback。
+// 未注册时记日志并返回(reveal 为 fire-and-forget,缺失不影响 Gecko 主线程;
+// nsLocalFile::Reveal 仍返回 NS_OK,前端 showDownloadedFile 的 try 不进 catch)。
+void OHOSRevealBridge_Request(const char* aPath);
+
+}  // namespace widget
+}  // namespace mozilla
+
+#endif  // widget_openharmony_OHOSRevealBridge_h__
diff --git a/widget/openharmony/OHOSScreenHelper.cpp b/widget/openharmony/OHOSScreenHelper.cpp
new file mode 100644
index 0000000000..c462911f47
--- /dev/null
+++ b/widget/openharmony/OHOSScreenHelper.cpp
@@ -0,0 +1,174 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "OHOSScreenHelper.h"
+
+#include <atomic>
+
+#include "mozilla/RefPtr.h"
+#include "nsTArray.h"
+#include "nsThreadUtils.h"
+
+// OHOS NDK 头文件声明未带 visibility 属性,libxul 默认 hidden visibility
+// 会导致符号在链接时被隐藏,用 pragma push(default) 强制导出引用符号
+// (与 stage2_xcomponent/nsWindow.cpp 的 oh_display_manager.h 处理方式一致)。
+#pragma GCC visibility push(default)
+#include <oh_display_manager.h>
+#pragma GCC visibility pop
+
+// 由 OHOSNativeWindowBridge.cpp 实现:XComponent OnSurfaceChanged 注入的
+// 表面尺寸(物理 px),作为 DisplayManager 不可用时的回退。
+extern "C" void OHOS_GetSurfaceSize(int* aWidth, int* aHeight);
+// 诊断日志(写文件,EntryAbility 搬运到 hilog),实现见 OHOSNativeWindowBridge.cpp。
+extern "C" void OHOS_DiagLog(const char* fmt, ...);
+
+// v136: ArkTS 下发的四向安全区 inset(物理 px),收紧 nsIScreen availRect。
+// 默认全 0(等价旧行为:availRect = 整屏)。setWindowDecorVisible(false) 下,
+// OHOS 系统三键/状态栏/导航条不出现在任何 AvoidAreaType,ArkTS 侧(2in1 兜底
+// 120vp)计算后通过 NAPI SetSafeAreaInsets → GeckoBridge_SetSafeAreaInsets 写入本变量。
+// 线程安全:NAPI 下发发生在 ArkTS UI 线程(非 Gecko 主线程),读方
+//   RefreshScreenList 只在 Gecko 主线程运行(构造或主线程 runnable),
+//   std::atomic 保证跨线程可见性。
+static std::atomic<int> gSafeInsetTop{0};
+static std::atomic<int> gSafeInsetRight{0};
+static std::atomic<int> gSafeInsetBottom{0};
+static std::atomic<int> gSafeInsetLeft{0};
+
+namespace mozilla::widget {
+
+// v136: 构建并刷新 Screen 列表到 ScreenManager。
+//   rect   = 完整屏幕;
+//   availRect = 扣除当前安全区 inset 后的可用工作区。
+// 抽出共用:OHOSScreenHelper 构造时调一次(可能 inset 尚未下发,availRect=整屏);
+//   GeckoBridge_SetSafeAreaInsets 下发新 inset 后再调一次,使后续打开的 popup
+//   拿到收紧的 availRect。getRect/getAvailRect 由 nsMenuPopupFrame::
+//   GetConstraintRect 在每次 popup 定位时从 ScreenManager 读取。
+// v149 根治(popup 溢出应用窗口被硬裁切):nsIScreen 上报值改为应用窗口
+// (=XComponent Surface)尺寸优先,物理全屏仅作回退。Gecko 在 OHOS 的屏幕
+// 坐标系原点 = 应用窗口左上角(nsWindow::GetScreenBounds 返回
+// (0,0,surfaceW,surfaceH)),可视范围 = EGL Surface;自由多窗下物理屏大于
+// 应用窗口,上报全屏会让 nsMenuPopupFrame::GetConstraintRect 允许 popup
+// 定位到窗口之外,像素在 SwapBuffers 时被 Surface 渲染目标硬裁切(桌面
+// Firefox 无此问题:其 nsIScreen 即桌面显示器,翻回屏内=翻回可渲染区)。
+// 全屏场景 surface==display 尺寸,行为与旧完全一致,无回归。
+// 由 static 改为头文件导出:GeckoBridge_SetSurfaceSize(OHOSNativeWindowBridge.cpp)
+// 在窗口尺寸变化时也需要触发本刷新,否则屏 rect 停留在旧值。
+void RefreshScreenList() {
+  // v241: last-good 缓存——surface 尚未注入(XComponent 早期)且
+  // display-manager 查询失败/异常时,旧逻辑回退 1366x768 假值并被
+  // ScreenManager 消费(browser-init.js 曾读到 availWidth=500 类错误
+  // 基准,v238c 绕过)。改为复用上次成功值;进程内从未成功过才用硬编码
+  // 兜底。insets 下发/Surface 变化都会重刷,缓存不会陈旧。
+  static int sLastGoodW = 0;
+  static int sLastGoodH = 0;
+  int32_t width = 0, height = 0;
+  NativeDisplayManager_ErrorCode rcW = DISPLAY_MANAGER_OK;
+  NativeDisplayManager_ErrorCode rcH = DISPLAY_MANAGER_OK;
+
+  // 首选:应用窗口 Surface 尺寸(见函数头 v149 注释)。启动早期 XComponent
+  // 尚未注入时返回 (0,0),回退 display-manager 保持旧行为。
+  OHOS_GetSurfaceSize(&width, &height);
+  const char* source = "surface-size";
+  if (width <= 0 || height <= 0) {
+    rcW = OH_NativeDisplayManager_GetDefaultDisplayWidth(&width);
+    rcH = OH_NativeDisplayManager_GetDefaultDisplayHeight(&height);
+    source = "display-manager";
+  }
+  if (rcW != DISPLAY_MANAGER_OK || rcH != DISPLAY_MANAGER_OK || width <= 0 ||
+      height <= 0) {
+    if (sLastGoodW > 0 && sLastGoodH > 0) {
+      width = sLastGoodW;
+      height = sLastGoodH;
+      source = "last-good-cache";
+    } else {
+      width = 1366;
+      height = 768;
+      source = "fallback-1366x768";
+    }
+  }
+  sLastGoodW = width;
+  sLastGoodH = height;
+
+  float density = 0.0f;
+  NativeDisplayManager_ErrorCode rcD =
+      OH_NativeDisplayManager_GetDefaultDisplayDensityPixels(&density);
+  const float cssScale =
+      (rcD == DISPLAY_MANAGER_OK && density > 0.0f) ? density : 1.0f;
+
+  const int insetTop = gSafeInsetTop.load(std::memory_order_relaxed);
+  const int insetRight = gSafeInsetRight.load(std::memory_order_relaxed);
+  const int insetBottom = gSafeInsetBottom.load(std::memory_order_relaxed);
+  const int insetLeft = gSafeInsetLeft.load(std::memory_order_relaxed);
+  LayoutDeviceIntRect rect(0, 0, width, height);
+  // 防御:inset 超过屏幕尺寸时夹紧,避免 availRect 出现负宽高。
+  const int availX = insetLeft > width ? width : insetLeft;
+  const int availY = insetTop > height ? height : insetTop;
+  const int availW =
+      (insetLeft + insetRight) > width ? 0 : (width - insetLeft - insetRight);
+  const int availH =
+      (insetTop + insetBottom) > height ? 0 : (height - insetTop - insetBottom);
+  LayoutDeviceIntRect availRect(availX, availY, availW, availH);
+  AutoTArray<RefPtr<Screen>, 1> screenList;
+  screenList.AppendElement(MakeRefPtr<Screen>(
+      rect, availRect, 24, 24, 0, DesktopToLayoutDeviceScale(1.0f),
+      CSSToLayoutDeviceScale(cssScale), cssScale * 96.0f,
+      Screen::IsPseudoDisplay::No, Screen::IsHDR::No));
+  ScreenManager::Refresh(std::move(screenList));
+
+  OHOS_DiagLog(
+      "[XRE_SCREEN] RefreshScreenList rect=%dx%d availRect=(%d,%d %dx%d) "
+      "insets=(t%d r%d b%d l%d) cssScale=%.2f dpi=%.1f source=%s "
+      "(rcW=%d rcH=%d rcD=%d)",
+      width, height, availX, availY, availW, availH, insetTop, insetRight,
+      insetBottom, insetLeft, cssScale, cssScale * 96.0f, source, (int)rcW,
+      (int)rcH, (int)rcD);
+}
+
+}  // namespace mozilla::widget
+
+// v136: ArkTS NAPI 桥入口。由 ports/ohos/geckoview.cpp 的 SetSafeAreaInsets
+// NAPI 函数(经 extern 声明)调用。
+// 线程注意(v137 崩溃修复):NAPI 调用发生在 ArkTS UI 线程,而 ScreenManager::
+// Refresh 内部锁/单例只允许在 Gecko 主线程访问(真机实测 UI 线程直调 →
+// pthread_mutex_lock 空指针 SIGSEGV)。因此此处只写原子 inset,刷新动作经
+// NS_DispatchToMainThread 投放到 Gecko 主线程执行;若 Gecko 主线程尚未就绪
+// (冷启动早期),dispatch 失败也无妨——OHOSScreenHelper 构造(Gecko 线程)会
+// 读取已存的原子 inset,且 NativeShellPage 在 avoidAreaChange 时会再次下发。
+// 本符号必须在 libxul.symbols 导出(链接进 libxul.so)。放本文件避免新增编译单元。
+extern "C" __attribute__((visibility("default"))) void
+GeckoBridge_SetSafeAreaInsets(int top, int right, int bottom, int left) {
+  gSafeInsetTop.store(top, std::memory_order_relaxed);
+  gSafeInsetRight.store(right, std::memory_order_relaxed);
+  gSafeInsetBottom.store(bottom, std::memory_order_relaxed);
+  gSafeInsetLeft.store(left, std::memory_order_relaxed);
+  OHOS_DiagLog(
+      "[SAFE_AREA] GeckoBridge_SetSafeAreaInsets top=%d right=%d bottom=%d "
+      "left=%d → dispatch refresh to gecko main thread",
+      top, right, bottom, left);
+  nsresult rv = NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "OHOSSafeAreaRefresh",
+      []() { mozilla::widget::RefreshScreenList(); }));
+  if (NS_FAILED(rv)) {
+    OHOS_DiagLog(
+        "[SAFE_AREA] dispatch RefreshScreenList failed rv=0x%08x (gecko main "
+        "thread not ready? insets stored, later constructor/push will refresh)",
+        (unsigned int)rv);
+  }
+}
+
+namespace mozilla::widget {
+
+OHOSScreenHelper::OHOSScreenHelper() {
+  // 坐标系说明:popup 定位约束(nsMenuPopupFrame::GetConstraintRect)使用
+  // nsIScreen 的 LayoutDeviceIntRect,与 nsWindow::mBounds 同为物理 px
+  // (densityPixels 只作用于 CSS px ↔ 设备 px 缩放)。DisplayManager 返回的
+  // 显示宽高同为物理 px,坐标系一致。
+  //
+  // v136: 构造期通常早于 ArkTS NAPI 下发 inset,RefreshScreenList 此时读到的
+  //   inset 全为默认 0(availRect=整屏,等价旧行为)。ArkTS 下发后
+  //   GeckoBridge_SetSafeAreaInsets 会再次 RefreshScreenList 收紧 availRect。
+  RefreshScreenList();
+}
+
+}  // namespace mozilla::widget
