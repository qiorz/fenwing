+    // 应用重启后文件保留上次运行内容,scheduleGeckoLogDump 会读到旧日志导致混淆
+    // OHOS 诊断(v33):同时 chmod 0666 确保 hdc shell 可读(umask 可能被沙箱覆盖)
+    {
+        FILE* fp = fopen("/data/storage/el2/base/haps/entry/files/gecko_xre_diag.txt", "w");
+        if (fp) { fchmod(fileno(fp), 0666); fclose(fp); }
+        fp = fopen(gLogFilePath.c_str(), "w");
+        if (fp) { fchmod(fileno(fp), 0666); fclose(fp); }
+        // 同时设置目录权限
+        chmod("/data/storage/el2/base/haps/entry/files", 0777);
+    }
