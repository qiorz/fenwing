+void nsWindow::OnWheelEvent(float aDeltaX, float aDeltaY, float aX, float aY,
+                            int64_t aTime) {
+  // v62:滚轮事件转发,将 OHOS AxisEvent 滚轮增量转为 Gecko WidgetWheelEvent。
+  // stage2 不使用 APZ:直接 DispatchEvent 跳过 APZ,与 OnTouchEvent/OnMouseEvent 同模式。
+  //
+  // 坐标系:aX/aY 已由 ArkTS vpToSurface() 转为 Gecko 内容坐标 px,
+  // 与 OnMouseEvent 的 mousePoint 同坐标系(LayoutDeviceIntPoint)。
+  //
+  // 滚轮增量:OHOS AxisEvent 的 getVerticalAxisValue/getHorizontalAxisValue
+  // 返回 vp 单位增量(正值向下/右,负值向上/左),直接作为 deltaLine 传入。
+  // Gecko WidgetWheelEvent 的 mDeltaX/mDeltaY 以"行"为单位(1.0=滚动一行),
+  // OHOS 滚轮增量通常在 ±0.1~±1.0 范围,直接使用即可。
+  WidgetWheelEvent event(true, eWheel, this);
+  event.mRefPoint = LayoutDeviceIntPoint(static_cast<int32_t>(aX),
+                                         static_cast<int32_t>(aY));
+  event.mDeltaX = aDeltaX;
+  event.mDeltaY = aDeltaY;
+  // mDeltaZ: 3D 滚轮(OHOS 无),设 0
+  event.mDeltaZ = 0.0;
+  // mLineOrPageDeltaX/Y:整数行/页增量,用于快捷大步滚动
+  // 若 |delta| >= 1,取 trunc;否则 0(由 Gecko 内部累积小增量)
+  event.mLineOrPageDeltaX = (aDeltaX >= 1.0f) ? (int32_t)aDeltaX :
+                             (aDeltaX <= -1.0f) ? (int32_t)aDeltaX : 0;
+  event.mLineOrPageDeltaY = (aDeltaY >= 1.0f) ? (int32_t)aDeltaY :
+                             (aDeltaY <= -1.0f) ? (int32_t)aDeltaY : 0;
+  // mDeltaMode:DOM_DELTA_LINE(1)=按行滚动(最常见)
+  event.mDeltaMode = dom::WheelEvent_Binding::DOM_DELTA_LINE;
+  // mIsNoLineOrPageDelta: false 表示 mLineOrPageDeltaX/Y 有效
+  event.mIsNoLineOrPageDelta = false;
+  // mTimeStamp 由 WidgetEventTime 默认构造设为 TimeStamp::Now(),无需显式赋值
+  (void)aTime;
+
+  // v222: 物理滚轮切入 APZ。mAPZC 非空时走基类标准路由 DispatchInputEvent
+  // (WidgetWheelEvent→ScrollWheelInput→APZ controller 线程,nsBaseWidget
+  // :1334 起),滚轮平滑滚动动画由 APZ 在合成器侧执行——与桌面/Mac 同轨,
+  // 不再逐格等待主线程 wheel 消费。kill-switch(mAPZC 空,如
+  // layers.async-pan-zoom.enabled=false 回退)保留 v62 直投主线程行为。
+  if (mAPZC) {
+    OHOS_DiagLog("[APZ_OHOS] wheel DispatchInputEvent delta=(%.2f,%.2f) pos=(%.0f,%.0f)",
+                 aDeltaX, aDeltaY, aX, aY);
+    DispatchInputEvent(&event);
+    return;
+  }
+  DispatchEvent(&event);
+}
