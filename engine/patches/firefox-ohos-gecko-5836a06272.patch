+// A2: ForceRepaintWithCallback — 带完成回调的强制重绘
+// 替代 ArkTS 层 setTimeout(forceRepaint, 50) 竞态补丁。
+// 实现:把 ArkTS callback 包成 threadsafe_function,存到 gForceRepaintCallback,
+//   GeckoBridge_ForceRepaintWithCallback 的 C 回调在 Gecko 主线程触发时,
+//   通过 tsfn 中转回 ArkTS 线程调用 callback(无参)。
+//   一次调用一次回调(每次调用覆盖前一次的 tsfn,符合单 webview 单次切换语义)。
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_ForceRepaintWithCallback(void (*cb)());
+
+// 全局 tsfn:供 ForceRepaintWithCallback 的 C 回调中转调用 ArkTS 回调
+static napi_threadsafe_function gForceRepaintCallback = nullptr;
+
+// C 回调入口(Gecko 主线程调用)→ 通过 tsfn 中转到 ArkTS 线程
+static void OHOS_ForceRepaintCompleteNotify() {
+    if (gForceRepaintCallback) {
+        napi_status status = napi_call_threadsafe_function(gForceRepaintCallback, nullptr, napi_tsfn_nonblocking);
+        OH_LOG_INFO(LOG_APP, "OHOS_ForceRepaintCompleteNotify napi_call_threadsafe_function status=%{public}d", (int)status);
+    }
+}
+
+// tsfn 的 call-js trampoline:无参回调
+static void CallJsNoArg(napi_env env, napi_value cb, void* /*context*/, void* /*data*/) {
+    if (env && cb) {
+        napi_value undefined;
+        napi_get_undefined(env, &undefined);
+        napi_value result;
+        napi_call_function(env, undefined, cb, 0, nullptr, &result);
+    }
+}
+
+napi_value ForceRepaintWithCallback(napi_env env, napi_callback_info info) {
+    size_t argc = 1;
+    napi_value args[1];
+    napi_value thisArg;
+    napi_get_cb_info(env, info, &argc, args, &thisArg, nullptr);
+    if (argc < 1) {
+        OH_LOG_ERROR(LOG_APP, "ForceRepaintWithCallback 参数缺失");
+        napi_throw_type_error(env, nullptr, "参数缺失,期望 callback 函数");
+        return nullptr;
+    }
+
+    napi_value workName;
+    napi_create_string_utf8(env, "GeckoViewForceRepaintCallback", NAPI_AUTO_LENGTH, &workName);
+    napi_threadsafe_function tsfn;
+    napi_status status = napi_create_threadsafe_function(
+        env, args[0], nullptr, workName, 0, 1, nullptr, nullptr,
+        nullptr, CallJsNoArg, &tsfn);
+    if (status != napi_ok) {
+        OH_LOG_ERROR(LOG_APP, "ForceRepaintWithCallback 创建 tsfn 失败: %{public}d", (int)status);
+        napi_throw_error(env, nullptr, "创建 threadsafe_function 失败");
+        return nullptr;
+    }
+    gForceRepaintCallback = tsfn;
+    GeckoBridge_ForceRepaintWithCallback(OHOS_ForceRepaintCompleteNotify);
+    OH_LOG_INFO(LOG_APP, "ForceRepaintWithCallback 已派发到 Gecko 主线程,完成后回调 ArkTS");
+
+    napi_value result;
+    napi_get_null(env, &result);
+    return result;
+}
