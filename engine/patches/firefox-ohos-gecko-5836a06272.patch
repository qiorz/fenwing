+constexpr inline const RenderReasons RenderReasons::SCENE = RenderReasons{ /* ._0 = */ (uint32_t)(1 << 0) };
+constexpr inline const RenderReasons RenderReasons::ANIMATED_PROPERTY = RenderReasons{ /* ._0 = */ (uint32_t)(1 << 1) };
