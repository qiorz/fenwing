+#include "mozilla/Bootstrap.h"
+#include "mozilla/XREAppData.h"
+#include "mozilla/RefPtr.h"
+
+// application.ini.h 包含 sAppData 静态常量
+// 该文件由构建系统生成在 objdir/build/application.ini.h
+// moz.build 中会添加 LOCAL_INCLUDES "/build"
+#include "application.ini.h"
+
+// OHOS NDK 头文件默认无 visibility 标记,而本模块编译启用 -fvisibility=hidden,
+// 直接 #include 会导致引用的 OH_LOG_Print / OH_NativeXComponent_RegisterCallback
+// 等符号被标记为 hidden,链接时出现 "undefined hidden symbol" 错误。
+// 用 #pragma GCC visibility push(default) 包裹这些头文件,确保函数声明以
+// default visibility 进入编译单元,链接器能正确从对应 .z.so 解析符号。
+#pragma GCC visibility push(default)
+#include <node_api.h>
+#include <ace/xcomponent/native_interface_xcomponent.h>
+#include <hilog/log.h>
