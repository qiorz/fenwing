+    OH_LOG_INFO(LOG_APP, "调用 XRE_main 启动 Gecko 内核主循环, argc=%{public}d", argc);
+
+    // 初始 URL 加载由 geckoview.js 的 startup() 从 OHOS_INITIAL_URL 环境变量读取,
