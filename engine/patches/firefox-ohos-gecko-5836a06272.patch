+constexpr int32_t OH_KEY_NUMPAD_ENTER = 2119;
+constexpr int32_t OH_KEY_NUMPAD_EQUALS = 2120;
+// 修饰键位掩码(SDK ArkUI_ModifierKeyName):CTRL=1, SHIFT=2, ALT=4, FN=8
+constexpr uint32_t OH_MOD_CTRL = 1 << 0;
+constexpr uint32_t OH_MOD_SHIFT = 1 << 1;
+constexpr uint32_t OH_MOD_ALT = 1 << 2;
+constexpr uint32_t OH_MOD_FN = 1 << 3;
+
+// OHOS keycode → Gecko DOM keyCode (NS_VK_*)。
+// 对照 widget/android/GeckoEditableSupport.cpp:46 ConvertAndroidKeyCodeToDOMKeyCode,
+// 但以 OHOS 枚举值为键。返回 0 表示无对应 DOM keyCode(忽略该键的 keyCode 字段)。
+uint32_t ConvertOHOSKeyCodeToDOMKeyCode(int32_t aKeyCode) {
+  if (aKeyCode >= OH_KEY_A && aKeyCode <= OH_KEY_Z) {
+    return aKeyCode - OH_KEY_A + NS_VK_A;
+  }
+  if (aKeyCode >= OH_KEY_0 && aKeyCode <= OH_KEY_9) {
+    return aKeyCode - OH_KEY_0 + NS_VK_0;
+  }
+  switch (aKeyCode) {
+    case OH_KEY_COMMA:        return NS_VK_COMMA;
+    case OH_KEY_PERIOD:       return NS_VK_PERIOD;
+    case OH_KEY_ALT_LEFT:
+    case OH_KEY_ALT_RIGHT:    return NS_VK_ALT;
+    case OH_KEY_SHIFT_LEFT:
+    case OH_KEY_SHIFT_RIGHT:  return NS_VK_SHIFT;
+    case OH_KEY_TAB:          return NS_VK_TAB;
+    case OH_KEY_SPACE:        return NS_VK_SPACE;
+    case OH_KEY_ENTER:        return NS_VK_RETURN;
+    case OH_KEY_DEL:          return NS_VK_BACK;       // Backspace
+    case OH_KEY_GRAVE:        return NS_VK_BACK_QUOTE;
+    case OH_KEY_MINUS:        return NS_VK_SUBTRACT;   // '-' (无专用 VK,用 SUBTRACT 近似)
+    case OH_KEY_EQUALS:       return NS_VK_EQUALS;
+    case OH_KEY_LEFT_BRACKET: return NS_VK_OPEN_BRACKET;
+    case OH_KEY_RIGHT_BRACKET:return NS_VK_CLOSE_BRACKET;
+    case OH_KEY_BACKSLASH:    return NS_VK_BACK_SLASH;
+    case OH_KEY_SEMICOLON:    return NS_VK_SEMICOLON;
+    case OH_KEY_APOSTROPHE:   return NS_VK_QUOTE;
+    case OH_KEY_SLASH:        return NS_VK_SLASH;
+    case OH_KEY_AT:           return NS_VK_AT;          // '@' (NS_VK_AT=0x91,Dom Level 3)
+    case OH_KEY_PLUS:         return NS_VK_ADD;         // '+' (用 ADD 近似)
+    case OH_KEY_PAGE_UP:      return NS_VK_PAGE_UP;
+    case OH_KEY_PAGE_DOWN:    return NS_VK_PAGE_DOWN;
+    case OH_KEY_ESCAPE:       return NS_VK_ESCAPE;
+    case OH_KEY_FORWARD_DEL:  return NS_VK_DELETE;      // Delete
+    case OH_KEY_CTRL_LEFT:
+    case OH_KEY_CTRL_RIGHT:   return NS_VK_CONTROL;
+    case OH_KEY_CAPS_LOCK:    return NS_VK_CAPS_LOCK;
+    case OH_KEY_SCROLL_LOCK:  return NS_VK_SCROLL_LOCK;
+    case OH_KEY_META_LEFT:
+    case OH_KEY_META_RIGHT:   return NS_VK_META;
+    case OH_KEY_SYSRQ:        return NS_VK_PRINTSCREEN;
+    case OH_KEY_BREAK:        return NS_VK_PAUSE;
+    case OH_KEY_MOVE_HOME:    return NS_VK_HOME;
+    case OH_KEY_MOVE_END:     return NS_VK_END;
+    case OH_KEY_INSERT:       return NS_VK_INSERT;
+    case OH_KEY_DPAD_UP:      return NS_VK_UP;
+    case OH_KEY_DPAD_DOWN:    return NS_VK_DOWN;
+    case OH_KEY_DPAD_LEFT:    return NS_VK_LEFT;
+    case OH_KEY_DPAD_RIGHT:   return NS_VK_RIGHT;
+    case OH_KEY_DPAD_CENTER:  return NS_VK_RETURN;
+    case OH_KEY_NUM_LOCK:     return NS_VK_NUM_LOCK;
+    default:
+      if (aKeyCode >= OH_KEY_F1 && aKeyCode <= OH_KEY_F12) {
+        return aKeyCode - OH_KEY_F1 + NS_VK_F1;
+      }
+      if (aKeyCode >= OH_KEY_NUMPAD_0 && aKeyCode <= OH_KEY_NUMPAD_9) {
+        return aKeyCode - OH_KEY_NUMPAD_0 + NS_VK_NUMPAD0;
+      }
+      switch (aKeyCode) {
+        case OH_KEY_NUMPAD_DIVIDE:    return NS_VK_DIVIDE;
+        case OH_KEY_NUMPAD_MULTIPLY:  return NS_VK_MULTIPLY;
+        case OH_KEY_NUMPAD_SUBTRACT:  return NS_VK_SUBTRACT;
+        case OH_KEY_NUMPAD_ADD:       return NS_VK_ADD;
+        case OH_KEY_NUMPAD_DOT:       return NS_VK_DECIMAL;
+        case OH_KEY_NUMPAD_ENTER:     return NS_VK_RETURN;
+        case OH_KEY_NUMPAD_EQUALS:    return NS_VK_EQUALS;
+      }
+      return 0;
+  }
+}
+
+// OHOS keycode → Gecko KeyNameIndex。
+// 对照 widget/android/GeckoEditableSupport.cpp:245 ConvertAndroidKeyCodeToKeyNameIndex。
+// 可打印字符(字母/数字/标点/空格)统一返回 KEY_NAME_INDEX_USE_STRING
+// (mKeyValue 由调用方按 Shift 状态推导字符)。
+mozilla::KeyNameIndex ConvertOHOSKeyCodeToKeyNameIndex(int32_t aKeyCode) {
+  if (aKeyCode >= OH_KEY_A && aKeyCode <= OH_KEY_Z) {
+    return KEY_NAME_INDEX_USE_STRING;
+  }
+  if (aKeyCode >= OH_KEY_0 && aKeyCode <= OH_KEY_9) {
+    return KEY_NAME_INDEX_USE_STRING;
+  }
+  switch (aKeyCode) {
+    case OH_KEY_COMMA:
+    case OH_KEY_PERIOD:
+    case OH_KEY_SPACE:
+    case OH_KEY_GRAVE:
+    case OH_KEY_MINUS:
+    case OH_KEY_EQUALS:
+    case OH_KEY_LEFT_BRACKET:
+    case OH_KEY_RIGHT_BRACKET:
+    case OH_KEY_BACKSLASH:
+    case OH_KEY_SEMICOLON:
+    case OH_KEY_APOSTROPHE:
+    case OH_KEY_SLASH:
+    case OH_KEY_AT:
+    case OH_KEY_PLUS:
+    case OH_KEY_NUMPAD_0: case OH_KEY_NUMPAD_1: case OH_KEY_NUMPAD_2:
+    case OH_KEY_NUMPAD_3: case OH_KEY_NUMPAD_4: case OH_KEY_NUMPAD_5:
+    case OH_KEY_NUMPAD_6: case OH_KEY_NUMPAD_7: case OH_KEY_NUMPAD_8:
+    case OH_KEY_NUMPAD_9:
+    case OH_KEY_NUMPAD_DIVIDE: case OH_KEY_NUMPAD_MULTIPLY:
+    case OH_KEY_NUMPAD_SUBTRACT: case OH_KEY_NUMPAD_ADD:
+    case OH_KEY_NUMPAD_DOT: case OH_KEY_NUMPAD_EQUALS:
+      return KEY_NAME_INDEX_USE_STRING;
+    case OH_KEY_ALT_LEFT:
+    case OH_KEY_ALT_RIGHT:   return mozilla::KEY_NAME_INDEX_Alt;
+    case OH_KEY_SHIFT_LEFT:
+    case OH_KEY_SHIFT_RIGHT: return mozilla::KEY_NAME_INDEX_Shift;
+    case OH_KEY_CTRL_LEFT:
+    case OH_KEY_CTRL_RIGHT:  return mozilla::KEY_NAME_INDEX_Control;
+    case OH_KEY_META_LEFT:
+    case OH_KEY_META_RIGHT:  return mozilla::KEY_NAME_INDEX_Meta;
+    case OH_KEY_TAB:         return mozilla::KEY_NAME_INDEX_Tab;
+    case OH_KEY_ENTER:
+    case OH_KEY_DPAD_CENTER:
+    case OH_KEY_NUMPAD_ENTER:return mozilla::KEY_NAME_INDEX_Enter;
+    case OH_KEY_DEL:         return mozilla::KEY_NAME_INDEX_Backspace;
+    case OH_KEY_FORWARD_DEL: return mozilla::KEY_NAME_INDEX_Delete;
+    case OH_KEY_ESCAPE:      return mozilla::KEY_NAME_INDEX_Escape;
+    case OH_KEY_PAGE_UP:     return mozilla::KEY_NAME_INDEX_PageUp;
+    case OH_KEY_PAGE_DOWN:   return mozilla::KEY_NAME_INDEX_PageDown;
+    case OH_KEY_DPAD_UP:     return mozilla::KEY_NAME_INDEX_ArrowUp;
+    case OH_KEY_DPAD_DOWN:   return mozilla::KEY_NAME_INDEX_ArrowDown;
+    case OH_KEY_DPAD_LEFT:   return mozilla::KEY_NAME_INDEX_ArrowLeft;
+    case OH_KEY_DPAD_RIGHT:  return mozilla::KEY_NAME_INDEX_ArrowRight;
+    case OH_KEY_MOVE_HOME:   return mozilla::KEY_NAME_INDEX_Home;
+    case OH_KEY_MOVE_END:    return mozilla::KEY_NAME_INDEX_End;
+    case OH_KEY_INSERT:      return mozilla::KEY_NAME_INDEX_Insert;
+    case OH_KEY_CAPS_LOCK:   return mozilla::KEY_NAME_INDEX_CapsLock;
+    case OH_KEY_SCROLL_LOCK: return mozilla::KEY_NAME_INDEX_ScrollLock;
+    case OH_KEY_NUM_LOCK:    return mozilla::KEY_NAME_INDEX_NumLock;
+    case OH_KEY_SYSRQ:       return mozilla::KEY_NAME_INDEX_PrintScreen;
+    case OH_KEY_BREAK:       return mozilla::KEY_NAME_INDEX_Pause;
+    case OH_KEY_F1:          return mozilla::KEY_NAME_INDEX_F1;
+    case OH_KEY_F2:          return mozilla::KEY_NAME_INDEX_F2;
+    case OH_KEY_F3:          return mozilla::KEY_NAME_INDEX_F3;
+    case OH_KEY_F4:          return mozilla::KEY_NAME_INDEX_F4;
+    case OH_KEY_F5:          return mozilla::KEY_NAME_INDEX_F5;
+    case OH_KEY_F6:          return mozilla::KEY_NAME_INDEX_F6;
+    case OH_KEY_F7:          return mozilla::KEY_NAME_INDEX_F7;
+    case OH_KEY_F8:          return mozilla::KEY_NAME_INDEX_F8;
+    case OH_KEY_F9:          return mozilla::KEY_NAME_INDEX_F9;
+    case OH_KEY_F10:         return mozilla::KEY_NAME_INDEX_F10;
+    case OH_KEY_F11:         return mozilla::KEY_NAME_INDEX_F11;
+    case OH_KEY_F12:         return mozilla::KEY_NAME_INDEX_F12;
+    default:                 return mozilla::KEY_NAME_INDEX_Unidentified;
+  }
+}
