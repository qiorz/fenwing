+// IME Attach:在 OnSurfaceCreated 中调用一次
+// v64:设备不支持 IME NDK C API(libohinputmethod.so 为空实现 stub,
+//      所有函数只有 ret 指令),设备系统也不提供实际实现。
+//      改为直接注册 GeckoBridge_SetIMECallbacks,通过 ArkTS 层 TextInput 桥接软键盘。
+//      OHOS_ShowKeyboard/OHOS_HideKeyboard 通过 threadsafe_function 通知 ArkTS 层,
+//      ArkTS 层控制隐藏的 TextInput 获得焦点(弹出软键盘)/失去焦点(关闭软键盘)。
+//      用户输入的文本通过 InsertText NAPI 接口 → GeckoBridge_InsertText → Gecko。
+// ----------------------------------------------------------------------------
+static void OHOS_IME_Attach() {
+    if (gIMEAttached.exchange(true)) {
+        printf("[IME] OHOS_IME_Attach 已Attach,跳过\n"); fflush(stdout);
+        return;  // 已 Attach
+    }
+
+    printf("[IME] OHOS_IME_Attach 开始(v64 ArkTS TextInput 桥接模式)\n"); fflush(stdout);
+    OH_LOG_INFO(LOG_APP, "[IME] OHOS_IME_Attach 开始(v64 ArkTS TextInput 桥接模式)");
+
+    // 直接将 Show/Hide 函数注册到 libxul.so(供 nsWindow::SetInputContext 调用)
+    // 不再依赖 libohinputmethod.so 的 IME API(stub 库空实现)
+    GeckoBridge_SetIMECallbacks(OHOS_ShowKeyboard, OHOS_HideKeyboard);
+    printf("[IME] GeckoBridge_SetIMECallbacks 已注册(ArkTS桥接模式)\n"); fflush(stdout);
+    OH_LOG_INFO(LOG_APP, "[IME] GeckoBridge_SetIMECallbacks 已注册(ArkTS桥接模式)");
+}
