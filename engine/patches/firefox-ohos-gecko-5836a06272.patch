+nsresult nsWindow::MakeFullScreen(bool aFullScreen) {
+  // nsBaseWidget 负责保存/恢复原窗口几何并调用平台 Resize。OHOS 顶层
+  // 窗口与唯一 XComponent Surface 一一对应,不能只改 mSizeMode,否则 DOM
+  // fullscreen 会进入 Gecko 状态但窗口尺寸和系统栏完全不变。
+  nsresult rv = nsBaseWidget::MakeFullScreen(aFullScreen);
+  if (NS_FAILED(rv)) {
+    OHOS_DiagLog("[XRE_FULLSCREEN] base MakeFullScreen failed state=%d rv=0x%08x",
+                 (int)aFullScreen, (unsigned)rv);
+    return rv;
+  }
+  mSizeMode = aFullScreen ? nsSizeMode_Fullscreen : nsSizeMode_Normal;
+  if (mWidgetListener) {
+    mWidgetListener->SizeModeChanged(mSizeMode);
+  }
+  GeckoBridge_NotifyFullscreen(aFullScreen);
+  OHOS_DiagLog("[XRE_FULLSCREEN] MakeFullScreen state=%d bounds=%dx%d",
+               (int)aFullScreen, mBounds.Width(), mBounds.Height());
+  return NS_OK;
+}
