+/**
+ * OHOS 2in1 chrome right-inset (v137 首版 / v138 修正).
+ *
+ * 背景:2in1 设备(如 HUAWEI MateBook Pro)右上角系统三键(最小化/最大化/关闭)由
+ * OHOS 系统绘制并悬浮在 Gecko 内容之上,不属于任何 Gecko/窗口装饰机制。需为顶部
+ * 工具栏右端留出空间,使最右端元素不被系统三键遮挡;网页视口保持全宽不受影响。
+ *
+ * 避让范围(仅 #TabsToolbar 标签栏行):
+ *   - 系统三键只悬浮覆盖标签栏那一行的右端,不下探到 #nav-bar 地址栏行;
+ *     地址栏行不加避让(用户明确要求:只避让标签栏,避免无谓收窄地址栏)。
+ *   - 标签占满时,标签条右端的"列出所有标签页"按钮(alltabs-button,向下箭头)
+ *     会出现在标签条最右端,必须确保其停在 inset 左侧,不入侵三键区域。
+ *
+ * 机制:纯 CSS 动态(-moz-pref 媒体查询,无需 JS)。
+ *   - pref 值必须在启动期即确定(关键!):EntryAbility 在 initFirefox 前把
+ *     user_pref("ohos.chrome.right_inset_px", "120") 写入 profile/user.js
+ *     (仅 2in1),Gecko 启动读 user.js → 首次 chrome 布局即匹配,不依赖
+ *     运行时推送 + 媒体查询重算(崩溃会导致运行时 user pref 不落盘,
+ *     冷启动 pref 恒为默认 "0",避让可能整会话不生效)。
+ *   - ArkTS 侧(NativeShellPage.ets)运行时 setCharPref 推送保留作动态后备;
+ *     Gecko GeckoBindings.cpp Gecko_EvalMozPrefFeature 会 RegisterCallback
+ *     监听 pref 变化,pref 写入即触发 LookAndFeel::NotifyChangedAllWindows
+ *     (MediaQueriesOnly),所有 chrome 文档的 -moz-pref 媒体查询自动重算。
+ *   - 值约定:Gecko CSS px 数值上 = ArkTS vp(density 已在 CSSToLayoutDeviceScale 换算),
+ *     所以 CSS 里写 120px 即 120vp,与 pref 字符串 '120' 对应。
+ *
+ * 机制:v139 桶位制(取代 v138 单值精确匹配——OHOS 系统三键宽度经
+ *   window.getTitleButtonRect() API 实测约 116-130vp,单一 '120' 字面值不够,
+ *   且运行时推送值漂移会让精确匹配静默失配)。
+ *   ArkTS 侧把 API 实测宽度向上取整到 10 的倍数(桶位),限定 [120,180];
+ *   下方每个桶位媒体查询匹配时把 --ohos-chrome-right-inset 设为对应字宽,
+ *   padding/裁剪规则无条件引用该 var(无桶匹配时 var 未定义,fallback 0px 无避让)。
+ *   值链:EntryAbility 启动期 user.js 写缓存桶位(上次 NativeShellPage 实测落盘,
+ *   首次默认 '140' 安全上界) → Gecko 首次 chrome 布局即匹配;
+ *   NativeShellPage 内核就绪后按 getTitleButtonRect() 实测值重发并落盘缓存。
+ */
+:root {
+  /* 桶位默认:任何媒体查询都不匹配时,var 存在且为 0 → 无避让(非 2in1/异常兜底)。*/
+  --ohos-chrome-right-inset: 0px;
+}
+@media (-moz-pref("ohos.chrome.right_inset_px", "120")) { :root { --ohos-chrome-right-inset: 120px; } }
+@media (-moz-pref("ohos.chrome.right_inset_px", "130")) { :root { --ohos-chrome-right-inset: 130px; } }
+@media (-moz-pref("ohos.chrome.right_inset_px", "140")) { :root { --ohos-chrome-right-inset: 140px; } }
+@media (-moz-pref("ohos.chrome.right_inset_px", "150")) { :root { --ohos-chrome-right-inset: 150px; } }
+@media (-moz-pref("ohos.chrome.right_inset_px", "160")) { :root { --ohos-chrome-right-inset: 160px; } }
+@media (-moz-pref("ohos.chrome.right_inset_px", "170")) { :root { --ohos-chrome-right-inset: 170px; } }
+@media (-moz-pref("ohos.chrome.right_inset_px", "180")) { :root { --ohos-chrome-right-inset: 180px; } }
+
+/* 标签栏右端避让(padding-inline-end 随 locale dir 自适应左右)。
+   v139 布局根因修复:padding 必须加在 #TabsToolbar-customization-target
+   (直接容纳 #alltabs-button ▾ / #new-tab-button + 的 hbox)上,而非 #TabsToolbar。
+   原加在 #TabsToolbar 时,XUL -moz-box 在标签溢出态把 alltabs 推过 toolbar 的
+   padding 边界(overflow:hidden 只裁剪绘制不重排,按钮被切半或不可用,视觉=没避让)。
+   加在 customization-target 上时,缩小的是直接定位 alltabs 的盒子的内容盒,
+   #tabbrowser-tabs(flex+可滚动 scroll frame,min-width:1px)自动收缩让位,
+   alltabs 稳定停在 inset 左侧。只避让标签栏行;#nav-bar 地址栏行不避让(用户要求)。*/
+#TabsToolbar-customization-target {
+  padding-inline-end: var(--ohos-chrome-right-inset);
+  overflow: hidden;
+}
+
+/* v188(OHOS 沉浸式): 顶部 chrome 让位系统状态栏。
+   ArkTS 侧 NativeShellPage 取消 surface 的 top/bottom 安全区 padding
+   (XComponent 全出血铺满,Surface 延伸到状态栏/导航条之下),状态栏悬浮在
+   toolbox 背景之上。顶部 chrome(标签栏+工具栏)的让位走本规则:
+   ArkTS 把状态栏高度(vp=CSSpx)桶位化(ceil 到 10,限 [20,100],无状态栏 '0')
+   写入 ohos.chrome.top_inset_px —— EntryAbility 启动期 user.js 播种
+   (上次实测落盘缓存,首帧即正确) + NativeShellPage 运行时推送+落盘,
+   Gecko_EvalMozPrefFeature 监听变化触发全 chrome 文档媒体查询重算
+   (机制与 --ohos-chrome-right-inset v137-v139 完全同构)。
+   #navigator-toolbox padding-top 把标签栏+工具栏整体下垫到状态栏之下;
+   底部无 chrome,网页内容直接滚动到导航条之下(标准沉浸形态)。 */
+:root {
+  --ohos-chrome-top-inset: 0px;
+}
+@media (-moz-pref("ohos.chrome.top_inset_px", "20")) { :root { --ohos-chrome-top-inset: 20px; } }
+@media (-moz-pref("ohos.chrome.top_inset_px", "30")) { :root { --ohos-chrome-top-inset: 30px; } }
+@media (-moz-pref("ohos.chrome.top_inset_px", "40")) { :root { --ohos-chrome-top-inset: 40px; } }
+@media (-moz-pref("ohos.chrome.top_inset_px", "50")) { :root { --ohos-chrome-top-inset: 50px; } }
+@media (-moz-pref("ohos.chrome.top_inset_px", "60")) { :root { --ohos-chrome-top-inset: 60px; } }
+@media (-moz-pref("ohos.chrome.top_inset_px", "70")) { :root { --ohos-chrome-top-inset: 70px; } }
+@media (-moz-pref("ohos.chrome.top_inset_px", "80")) { :root { --ohos-chrome-top-inset: 80px; } }
+@media (-moz-pref("ohos.chrome.top_inset_px", "90")) { :root { --ohos-chrome-top-inset: 90px; } }
+@media (-moz-pref("ohos.chrome.top_inset_px", "100")) { :root { --ohos-chrome-top-inset: 100px; } }
+
+#navigator-toolbox {
+  padding-top: var(--ohos-chrome-top-inset);
+}
+
 /* Menu bar */
 
 #toolbar-menubar {
