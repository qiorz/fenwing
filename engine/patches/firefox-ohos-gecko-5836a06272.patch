+
+#include "nsWidgetFactory.h"
+
+#include "mozilla/WidgetUtils.h"
+#include "nsAppShell.h"
+#include "nsAppShellSingleton.h"
+#include "nsIWidget.h"
+
+// stage2:使用 widget/openharmony/stage2_xcomponent/nsWindow 作为
+// nsIWidget::CreateChildWindow/CreateTopLevelWindow 的实现。
+// nsWindow 持有 per-window OHNativeWindow,支持完整的 chrome window 创建链路。
+#include "stage2_xcomponent/nsWindow.h"
+
+// OpenHarmony widget 模块构造/析构。
+//
+// stage1(headless 基底)阶段只注册 AppShell,窗口/剪贴板/外观等组件
+// 复用 widget/components.conf 中通过 overridable 机制选定的通用实现
+// 或 widget/headless 的 Headless* 实现。屏幕 Helper 在 nsAppShell::Init
+// 中注入(由 nsAppShellInit 调用)。
+
+nsresult nsWidgetOHosModuleCtor() {
+  // nsAppShellInit 内部会调用 nsAppShell::Init(),后者注入屏幕 Helper。
+  return nsAppShellInit();
+}
+
+void nsWidgetOHosModuleDtor() {
+  mozilla::widget::WidgetUtils::Shutdown();
+  nsAppShellShutdown();
+}
+
+// nsIWidget::CreateChildWindow 是 nsIWidget 的 static 工厂方法,需要每个
+// widget 平台子类实现(参见 widget/gtk/nsWindow.cpp:9593)。
+// stage2:使用 nsWindow,支持 XComponent 注入的 OHNativeWindow。
+already_AddRefed<nsIWidget> nsIWidget::CreateChildWindow() {
+  nsCOMPtr<nsIWidget> window = new nsWindow();
+  return window.forget();
+}
+
+// nsIWidget::CreateTopLevelWindow 同为 static 工厂方法(参见
+// widget/android/nsWindow.cpp:3378)。
+// stage2:使用 nsWindow,Create() 时会等待 OHNativeWindow 注入。
+already_AddRefed<nsIWidget> nsIWidget::CreateTopLevelWindow() {
+  nsCOMPtr<nsIWidget> window = new nsWindow();
+  return window.forget();
+}
