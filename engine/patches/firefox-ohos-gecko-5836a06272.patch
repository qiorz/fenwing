diff --git a/mobile/ohos/moz.build b/mobile/ohos/moz.build
new file mode 100644
index 0000000000..76e242c2f3
--- /dev/null
+++ b/mobile/ohos/moz.build
@@ -0,0 +1,58 @@
+# -*- Mode: python; indent-tabs-mode: nil; tab-width: 40 -*-
+# vim: set filetype=python:
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can get one at http://mozilla.org/mozilla.org/MPL/2.0/.
+
+with Files("**"):
+    BUG_COMPONENT = ("GeckoView", "General")
+    SCHEDULES.exclusive = ["ohos"]
+
+# OpenHarmony 项目构建配置
+#
+# 与 mobile/android 不同,OpenHarmony 没有 Java/Gradle 层:
+#   - 内核核心(Gecko)由 toolkit/app.mozbuild 统一编译进 libxul.so
+#   - NAPI 桥接(GeckoView 模块入口)在 ports/ohos/ 单独产出 libgeckoview.so
+#   - HAP 打包由外部 hvigorw(OhosWeb 项目)完成
+# 因此本 moz.build 不再 include geckoview/src/main 或 modules/themes。
+
+config_keys = (
+    "MOZ_OHOS_CONTENT_SERVICE_COUNT",
+)
+
+# mobile/shared 提供 GeckoView 共享组件(GeckoViewHistory、GeckoViewNavigation 等),
+# 其中 GeckoViewHistory 注册了 components::History,docshell 等模块依赖它。
+# 不包含会导致 components::History 缺失而编译失败。
+DIRS += [
+    "/mobile/shared",
+]
+
+# OpenHarmony 平台偏好设置。
+# 关键:00-geckoview-prefs.js 设置 toolkit.defaultChromeURI,让 DefaultCLH.sys.mjs
+# 在 cmdLine->Run 时创建第一个 chrome 窗口(geckoview.xhtml)。不打包此文件会导致
+# DefaultCLH 因 pref 缺失静默跳过 OpenWindow,无窗口、无渲染。
+# 参照 mobile/android/app/moz.build:22-24 的 Android 写法。
+#
+# v36:geckoview-prefs.js 已扩展为完整版(移植自 mobile/android/app/geckoview-prefs.js),
+# 含 #filter dumbComments emptyLines substitution 预处理指令,故改用 PP_FILES。
+# 不加 DEFINES,因为文件内无 @APP_NAME@ 等替换符(已移除所有 Android 专属 pref)。
+#
+# v140:更名 00- 前缀——libpref 逆字母序加载 defaults/pref/*.js(小者后加载生效),
+# 原名 g>f 被 firefox.js 后加载覆盖,平台覆盖项全失效;00- 前缀最小,最后加载。
+FINAL_TARGET_PP_FILES.defaults.pref += [
+    "00-geckoview-prefs.js",
+]
+
+# GeckoView 平台层资源(CSS 主题 / JS 模块 / 本地化)。
+# 移植自 mobile/android/{themes,modules,locales}/geckoview,移除 JNI 依赖。
+# - themes/geckoview:chrome://geckoview/skin/ 主题(config.css + 7 个 SVG 图标)
+# - modules/geckoview:AndroidLog.sys.mjs(封装 __android_log_write 为 Log.sys.mjs appender)
+# - locales:l10n 清单(jar.mn / l10n.toml / all-locales / filter.py / en-US/*.ftl)
+# - components/geckoview:GeckoView 平台 XPCOM 组件(OHOS stub 版,见该目录 moz.build)
+DIRS += [
+    "components/geckoview",
+    "modules/geckoview",
+    "themes/geckoview",
+    "locales",
+]
+
diff --git a/mobile/ohos/moz.configure b/mobile/ohos/moz.configure
new file mode 100644
index 0000000000..d2aedfe6ff
--- /dev/null
+++ b/mobile/ohos/moz.configure
@@ -0,0 +1,81 @@
+# -*- Mode: python; indent-tabs-mode: nil; tab-width: 40 -*-
+# vim: set filetype=python:
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at http://mozilla.org/mozilla.org/MPL/2.0/.
+
+# OpenHarmony 项目级 moz.configure
+# 参考 mobile/android/moz.configure,移除 Android SDK / Gradle / Java 依赖。
+#
+# 关键:必须 include("../../toolkit/moz.configure"),否则 IPDL_ROOT /
+# WEBIDL_ROOT / XPCOM_ROOT 等不会被 set_config,后端 emitter 在处理
+# IPDL_SOURCES 时会因 ipdl_root 为 None 而崩溃。
+
+project_flag(
+    "MOZ_OHOS_EXCLUDE_FONTS",
+    help="Whether to exclude font files from the build",
+    default=True,
+)
+
+# OpenHarmony 单进程模型,不需要多内容进程服务。
+option(
+    "--num-content-services",
+    default="1",
+    help="The number of content process services (OHOS uses single process)",
+)
+
+
+@depends("--num-content-services")
+def num_content_services(value):
+    strValue = value[0]
+    intValue = int(strValue)
+    return strValue
+
+
+set_config("MOZ_OHOS_CONTENT_SERVICE_COUNT", num_content_services)
+set_define("MOZ_OHOS_CONTENT_SERVICE_COUNT", num_content_services)
+
+# OpenHarmony 使用 NAPI 而非 JNI。
+set_config("MOZ_NAPI", True)
+set_define("MOZ_NAPI", True)
+
+# stage1:用完整 Places(MOZ_PLACES)而非 GeckoViewHistory。GeckoViewHistory 依赖
+# Android widget 的 EventDispatcher 等(尚未移植到 OHOS);Places 的
+# mozilla::places::History 同样注册了 components::History,满足 docshell 依赖,
+# 且无需 Android widget 基础设施。
+imply_option("MOZ_PLACES", True)
+
+imply_option("MOZ_APP_UA_NAME", "Firefox")
+imply_option("MOZ_APP_VENDOR", "Mozilla")
+imply_option("MOZ_APP_ID", "{aa3c5121-dab2-40e2-81ca-7ea25febc110}")
+
+# v36:补全 imply_option,对齐 mobile/android/moz.configure:114-121。
+# - MOZ_NORMANDY=False:OHOS 无 Normandy 远程配置服务。
+# - MOZ_SERVICES_HEALTHREPORT=False:OHOS 无 HealthReport 实现(GeckoViewHealthReporter
+#   依赖 Android JNI,尚未移植)。
+# - MOZ_SERVICES_SYNC=False:OHOS 无 Sync 实现(Sync 依赖 desktop profile/UI,未移植)。
+#   显式 imply 防止 browser/ 被拉进构建后默认开启 Sync 报错。
+# - BROWSER_CHROME_URL:设置默认 chrome 窗口 URI 的编译期 DEFINE。
+#   stage2 native UI 移植:OHOS 加载 chrome://browser/content/browser.xhtml 作为
+#   top-level chrome 文档(复用 DefaultCLH.sys.mjs 的 toolkit.defaultChromeURI 流程)。
+#   运行时实际打开哪个 chrome 文档由 geckoview-prefs.js 的 toolkit.defaultChromeURI
+#   决定,这里的 DEFINE 仅作 chrome 资源注册与兜底。
+imply_option("MOZ_NORMANDY", False)
+imply_option("MOZ_SERVICES_HEALTHREPORT", False)
+imply_option("MOZ_SERVICES_SYNC", False)
+imply_option("BROWSER_CHROME_URL", "chrome://browser/content/browser.xhtml")
+
+
+@depends(target)
+def check_target(target):
+    if target.os != "OHOS":
+        die(
+            "You must specify --target=aarch64-unknown-linux-ohos (or some "
+            "other valid OpenHarmony target) when building mobile/ohos."
+        )
+
+
+include("../shared/moz.configure")
+# toolkit/moz.configure 提供 IPDL_ROOT / WEBIDL_ROOT / XPCOM_ROOT 以及大量
+# Gecko 选项,缺失会导致后端生成崩溃。必须包含。
+include("../../toolkit/moz.configure")
diff --git a/mobile/ohos/themes/geckoview/config.css b/mobile/ohos/themes/geckoview/config.css
new file mode 100644
index 0000000000..e065243dd1
--- /dev/null
+++ b/mobile/ohos/themes/geckoview/config.css
@@ -0,0 +1,374 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+:root {
+  --background-color: #fff;
+  --text-color: #0c0c0d;
+  --border-color: #e1e1e2;
+
+  --toolbar-background-color: #f9f9fa;
+  --searchbar-background-color: #ededf0;
+  --searchbar-focused-background-color: #fff;
+
+  --deemphasized-border-color: rgba(0, 0, 0, 0.05);
+  --deemphasized-text-color: rgba(0, 0, 0, 0.5);
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --background-color: #292833;
+    --text-color: #f9f9fa;
+    --border-color: rgba(255, 255, 255, 0.15);
+
+    --toolbar-background-color: #1c1b22;
+    --searchbar-background-color: #3f3e46;
+    --searchbar-focused-background-color: #4c4a54;
+
+    --deemphasized-border-color: rgba(249, 249, 250, 0.05);
+    --deemphasized-text-color: rgba(249, 249, 250, 0.5);
+  }
+}
+
+html,
+body {
+  margin: 0;
+  padding: 0;
+  user-select: none;
+  font-family: sans-serif;
+  -moz-text-size-adjust: none;
+  background-color: var(--background-color);
+  color: var(--text-color);
+}
+
+.toolbar {
+  width: 100%;
+  min-height: 3em;
+  display: flow-root;
+  position: sticky;
+  top: 0;
+  left: 0;
+  z-index: 10;
+  background-color: var(--toolbar-background-color);
+  font-weight: bold;
+  box-shadow: 0 2px 7px rgba(0, 0, 0, 0.25);
+}
+
+.toolbar-container {
+  max-width: 40em;
+  margin-inline: auto;
+}
+
+#filter-container {
+  margin: 0.375em;
+  height: 2em;
+  background-color: var(--searchbar-background-color);
+  border-radius: 0.25em;
+  border: 1px solid transparent;
+  overflow: hidden;
+  display: flex;
+  float: inline-end;
+}
+
+#filter-container:focus-within {
+  background-color: var(--searchbar-focused-background-color);
+  box-shadow: 0 1px 6px rgba(0, 0, 0, 0.1);
+}
+
+#filter-input {
+  border: none;
+  background: none;
+  color: inherit;
+  flex-grow: 1;
+  height: 100%;
+  box-sizing: border-box;
+  opacity: 0.75;
+}
+
+#new-pref-toggle-button {
+  background-image: url("chrome://geckoview/skin/images/add.svg");
+  background-size: 1.25em;
+  background-position: center;
+  background-repeat: no-repeat;
+  height: 3em;
+  width: 3em;
+  outline: none;
+  float: inline-start;
+  -moz-context-properties: fill, fill-opacity;
+  fill: currentColor;
+  fill-opacity: 0.8;
+}
+
+#filter-search-button {
+  background-size: 1em;
+  background-position: center;
+  background-repeat: no-repeat;
+  height: 2em;
+  width: 2em;
+  outline: none;
+  display: inline-block;
+  -moz-context-properties: fill, fill-opacity;
+  fill: currentColor;
+  fill-opacity: 0.8;
+}
+
+#filter-search-button {
+  background-image: url("chrome://geckoview/skin/images/search.svg");
+}
+
+#filter-search-button:dir(rtl) {
+  scale: -1 1;
+}
+
+.toolbar-item {
+  display: inline-block;
+  height: 3em;
+  min-width: 3em;
+  float: right;
+}
+
+#content {
+  position: relative;
+  margin: 0 auto;
+  padding-inline: 0;
+  min-height: 100%;
+  max-width: 40em;
+}
+
+#prefs-container {
+  list-style: none;
+  min-height: 100%;
+  width: 100%;
+  margin: 0;
+  padding: 0;
+  box-sizing: border-box;
+  overflow-x: hidden;
+}
+
+#prefs-container li {
+  border-bottom: 1px solid var(--border-color);
+  cursor: pointer;
+}
+
+#new-pref-container {
+  width: 100%;
+  margin: 0;
+  background-color: var(--background-color);
+  box-shadow: 0 5px 18px rgba(0, 0, 0, 0.2);
+  box-sizing: border-box;
+  overflow-x: hidden;
+  max-width: 40em;
+  max-height: 100%;
+  position: fixed;
+  top: 3em;
+  left: auto;
+  display: none;
+  z-index: 5;
+}
+
+#new-pref-container input,
+#new-pref-container select {
+  border: none;
+  background: none;
+}
+
+#new-pref-container.show {
+  display: block;
+}
+
+#new-pref-line-boolean,
+#new-pref-value-string,
+#new-pref-value-int {
+  display: none;
+}
+#new-pref-item[typestyle="boolean"] #new-pref-line-boolean,
+#new-pref-item[typestyle="string"] #new-pref-value-string,
+#new-pref-item[typestyle="int"] #new-pref-value-int {
+  display: flex;
+}
+#new-pref-item[typestyle="boolean"] #new-pref-line-input {
+  border-top: none;
+}
+
+.pref-name,
+.pref-value {
+  padding: 15px 10px;
+  text-align: match-parent;
+  text-overflow: ellipsis;
+  overflow: hidden;
+  background: none;
+  color: inherit;
+  direction: ltr;
+}
+
+.pref-value {
+  flex: 1 1 auto;
+  border: none;
+  unicode-bidi: plaintext;
+}
+
+.pref-name[locked] {
+  -moz-context-properties: fill, fill-opacity;
+  fill: currentColor;
+  fill-opacity: 0.8;
+  background-image: url("chrome://geckoview/skin/images/lock.svg");
+  background-repeat: no-repeat;
+  background-position-y: center;
+  background-size: 1em;
+}
+
+:dir(ltr) > .pref-name[locked] {
+  background-position-x: right 10px;
+  padding-right: 30px;
+}
+
+:dir(rtl) > .pref-name[locked] {
+  background-position-x: 10px;
+  padding-left: 30px;
+}
+
+#new-pref-name {
+  width: 30em;
+}
+
+#new-pref-type {
+  appearance: none;
+  color: inherit;
+  border-inline-start: 1px solid var(--deemphasized-border-color) !important;
+  text-align: center;
+  width: 9em;
+  padding-inline: 8px;
+}
+
+.pref-item-line {
+  border-top: 1px solid var(--deemphasized-border-color);
+  color: var(--deemphasized-text-color);
+  display: flex;
+}
+
+#new-pref-value-boolean {
+  flex: 1 1 auto;
+}
+
+#new-pref-container .pref-button.toggle {
+  display: flex;
+  opacity: 1;
+  flex: 0 1 auto;
+  float: right;
+}
+
+#new-pref-container .pref-button.cancel,
+#new-pref-container .pref-button.create {
+  display: inline-block;
+  opacity: 1;
+  flex: 1 1 auto;
+}
+
+.pref-item-line {
+  pointer-events: none;
+}
+
+#new-pref-container .pref-item-line,
+.pref-item.selected .pref-item-line,
+.pref-item:not(.selected) .pref-button.reset {
+  pointer-events: auto;
+}
+
+#new-pref-container .pref-button.create[disabled] {
+  opacity: 0.5;
+}
+
+.pref-item.selected {
+  background-color: hsla(0, 0%, 60%, 0.2);
+}
+
+.pref-button {
+  display: inline-flex;
+  box-sizing: border-box;
+  align-items: center;
+  text-align: center;
+  padding: 10px 1em;
+  border-inline-start: 1px solid var(--deemphasized-border-color);
+  opacity: 0;
+  transition-property: opacity;
+  transition-duration: 500ms;
+}
+
+.pref-item.selected .pref-item-line .pref-button {
+  opacity: 1;
+}
+
+.pref-item:not(.selected) .pref-item-line .pref-button:not(.reset) {
+  display: none;
+}
+
+.pref-item:not(.selected) .pref-button.reset {
+  opacity: 1;
+}
+
+.pref-button:active,
+#new-pref-type:active {
+  background-color: hsla(0, 0%, 60%, 0.4);
+}
+
+.pref-button[disabled] {
+  display: none;
+}
+
+.pref-button.up,
+.pref-button.down {
+  -moz-context-properties: fill, fill-opacity;
+  fill: var(--text-color);
+  fill-opacity: 0.8;
+  background-size: 1em;
+  background-position: center;
+  background-repeat: no-repeat;
+}
+
+.pref-button.up {
+  background-image: url("chrome://geckoview/skin/images/arrow-up.svg");
+}
+
+.pref-button.down {
+  background-image: url("chrome://geckoview/skin/images/arrow-down.svg");
+}
+
+#prefs-shield {
+  width: 100%;
+  height: 100%;
+  background-color: rgba(0, 0, 0, 0.45);
+  position: fixed;
+  top: 0;
+  left: 0;
+  opacity: 0;
+  transition-property: opacity;
+  transition-duration: 500ms;
+  display: none;
+}
+
+#prefs-shield[shown] {
+  display: block;
+  opacity: 1;
+}
+
+#loading-container::before {
+  content: "";
+  display: block;
+  width: 1.25em;
+  height: 1.25em;
+  border: 0.15em solid currentColor;
+  margin: 1em auto;
+  border-right-color: transparent;
+  border-radius: 100%;
+  opacity: 0.8;
+  animation: 1.1s linear infinite spin;
+}
+
+@keyframes spin {
+  from {
+    transform: none;
+  }
+  to {
+    transform: rotate(360deg);
+  }
+}
