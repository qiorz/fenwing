+// v137: 设置 OHOS 主窗口 windowId,供鼠标光标样式 API(OH_Input_SetPointerStyle)
+// 定位目标窗口。ArkTS EntryAbility 在 onWindowStageCreate 拿到主窗口 windowId 后调用。
+// 参数:windowId(OHOS windowId,>=0)
+napi_value SetMainWindowId(napi_env env, napi_callback_info info) {
+    size_t argc = 1;
+    napi_value args[1];
+    napi_value thisArg;
+    napi_get_cb_info(env, info, &argc, args, &thisArg, nullptr);
+    int32_t windowId = -1;
+    if (argc >= 1) {
+        napi_get_value_int32(env, args[0], &windowId);
+    }
+    OH_LOG_INFO(LOG_APP, "SetMainWindowId windowId=%{public}d", windowId);
+    OHOS_SetMainWindowId(windowId);
+    napi_value result;
+    napi_get_null(env, &result);
+    return result;
+}
+
+// ============================================================================
+// GeckoView 全局状态访问(namespace geckoview)
+// ============================================================================
+
+namespace geckoview {
+
+// 已注册的 ArkTS 回调集合
+GeckoViewCallbacks& GetCallbacks() {
+    return gCallbacks;
+}
+
+// 当前活跃 webview 在窗口列表中的下标
+uint32_t GetActiveIndex() {
+    return gActiveIndex;
+}
+
+// 设置活跃 webview 下标
+void SetActiveIndex(uint32_t aIndex) {
+    gActiveIndex = aIndex;
+}
+
+}  // namespace geckoview
+
+// ============================================================================
+// NAPI 模块注册
+// ============================================================================
+//
+// 根因分析与修复(2026-07-03):
+//   之前 libgeckoview.so 只注册一个 NAPI 模块 'geckoview',同时承担两个职责:
+//     1. 由 FirefoxBridge.ets 顶层 `import geckoview from 'libgeckoview.so'` 触发加载,
+//        导出 initFirefox/loadURL 等业务接口
+//     2. 由 FirefoxWebView.ets 中 XComponent libraryname='geckoview' 触发加载,
+//        期望框架在 exports 中注入 OH_NATIVE_XCOMPONENT_OBJ,以注册 Surface 回调
+//   矛盾:NAPI 模块按 nm_modname 去重,NapiRegisterModule 只调用一次。
+//   import 是静态加载,在 EntryAbility.onCreate 阶段即触发,此时 BrowserPage 与
+//   XComponent 尚未创建,exports 中没有 OH_NATIVE_XCOMPONENT_OBJ。后续 XComponent
+//   创建时,'geckoview' 模块已注册,NapiRegisterModule 不会再次调用,
+//   OnSurfaceCreated 回调从未注册,gNativeWindow 永远为 nullptr,渲染黑屏。
+//
+// 修复方案:在同一个 libgeckoview.so 中注册两个 NAPI 模块:
+//   - 'geckoview' 模块:由 import 触发,只导出业务接口(initFirefox 等)
+//   - 'geckoxcomp' 模块:由 XComponent libraryname='geckoxcomp' 触发,
+//     此时框架已在 exports 中注入 OH_NATIVE_XCOMPONENT_OBJ,注册 Surface 回调
+//   两个模块共享同一个 .so,通过 nm_modname 区分,各自有独立的 NapiRegisterModule。
+
+// 'geckoview' 模块注册入口:由 FirefoxBridge.ets 顶层 import 触发
+// 只负责导出业务 NAPI 接口,不处理 XComponent(import 触发时 XComponent 尚未创建)
+napi_value NapiRegisterModuleGeckoview(napi_env env, napi_value exports) {
+    OH_LOG_INFO(LOG_APP, "NapiRegisterModuleGeckoview: geckoview 业务模块注册开始");
+
+    // 导出所有业务 NAPI 接口
+    auto ExportFunction = [env, exports](const char* name, napi_callback cb) {
+        napi_value fn;
+        napi_create_function(env, name, NAPI_AUTO_LENGTH, cb, nullptr, &fn);
+        napi_set_named_property(env, exports, name, fn);
+    };
+
+    ExportFunction("initFirefox", InitFirefox);
+    ExportFunction("loadURL", LoadURL);
+    ExportFunction("goBack", GoBack);
+    ExportFunction("goForward", GoForward);
+    ExportFunction("goToIndex", GoToIndex);
+    ExportFunction("forceRepaint", ForceRepaint);
+    ExportFunction("resizeSurface", ResizeSurface);
+    ExportFunction("reload", Reload);
+    ExportFunction("stop", Stop);
+    ExportFunction("toggleDesktopMode", ToggleDesktopMode);
+    ExportFunction("findInPage", FindInPage);
+    ExportFunction("setBoolPref", SetBoolPref);
+    ExportFunction("setCharPref", SetCharPref);
+    ExportFunction("setIntPref", SetIntPref);
+    // v240: 通用 Pref 读取(设置页回显;旧 .so 无符号时 ArkTS try/catch 回退)
+    ExportFunction("getBoolPref", GetBoolPref);
+    ExportFunction("getIntPref", GetIntPref);
+    ExportFunction("getCharPref", GetCharPref);
+    // v241: 历史查询(地址框本地建议)
+    ExportFunction("queryHistory", QueryHistory);
+    ExportFunction("registerURLcallback", RegisterURLCallback);
+    ExportFunction("registerTerminateCallback", RegisterTerminateCallback);
+    ExportFunction("registerPromptToastCallback", RegisterPromptToastCallback);
+    ExportFunction("registerPageLoadCallback", RegisterPageLoadCallback);
+    ExportFunction("registerFirstCompositeCallback", RegisterFirstCompositeCallback);
+    ExportFunction("registerProgressCallback", RegisterProgressCallback);
+    ExportFunction("registerIMECallback", RegisterIMECallback);
+    ExportFunction("registerFullscreenCallback", RegisterFullscreenCallback);
+    // v150: 鼠标光标样式回调(Gecko 样式变化 → ArkTS pointer.setPointerStyleSync)
+    ExportFunction("registerPointerStyleCallback", RegisterPointerStyleCallback);
+    // v118: 文件选择器(<input type=file> 单文件)
+    ExportFunction("registerFilePickerCallback", RegisterFilePickerCallback);
+    ExportFunction("resolveFilePicker", ResolveFilePicker);
+    // v118: 下载进度回调(start/progress/complete/failed,单向通知)
+    ExportFunction("registerDownloadCallback", RegisterDownloadCallback);
+    // P1: 文件 reveal 回调(下载列表"打开所在文件夹",fire-and-forget)
+    ExportFunction("registerRevealCallback", RegisterRevealCallback);
+    // P1: 打印回调(Gecko 静默 Save-to-PDF 完成后投递临时 PDF 路径,fire-and-forget)
+    ExportFunction("registerPrintCallback", RegisterPrintCallback);
+    // 通用原生菜单:菜单 JSON 下发(Gecko→ArkTS)+ 命令/关闭回填(ArkTS→Gecko)
+    ExportFunction("registerMenuCallback", RegisterMenuCallback);
+    // v250: 标签状态推送(chrome JS → ArkTS) + chrome JS 同步调用(ArkTS → chrome JS)
+    ExportFunction("registerTabStateCallback", RegisterTabStateCallback);
+    // v251: 扩展安装进度推送(chrome JS → ArkTS,AMO 慢下载进度横幅)
+    ExportFunction("registerAddonInstallCallback", RegisterAddonInstallCallback);
+    ExportFunction("chromeJSCall", ChromeJSCall);
+    ExportFunction("chromeJSCallAsync", ChromeJSCallAsync);
+    ExportFunction("resolveMenuCommand", ResolveMenuCommand);
+    ExportFunction("closeNativeMenu", CloseNativeMenu);
+    ExportFunction("exitFullscreen", ExitFullscreen);
+    ExportFunction("registerNavigationCallback", RegisterNavigationCallback);
+    ExportFunction("resolveNavigationEvent", ResolveNavigationEvent);
+    ExportFunction("insertText", InsertText);
+    ExportFunction("deleteText", DeleteText);
+    ExportFunction("focusWebview", FocusWebview);
+    ExportFunction("deleteWebview", DeleteWebview);
+    ExportFunction("nextWindowId", NextWindowId);
+    // v88: 多 session 管理 + per-session 导航 + Enter 键
+    ExportFunction("createSession", CreateSession);
+    ExportFunction("switchToSession", SwitchToSession);
+    ExportFunction("closeSession", CloseSession);
+    ExportFunction("loadURLForSession", LoadURLForSession);
+    ExportFunction("reloadForSession", ReloadForSession);
+    ExportFunction("stopForSession", StopForSession);
+    ExportFunction("goBackForSession", GoBackForSession);
+    ExportFunction("goForwardForSession", GoForwardForSession);
+    ExportFunction("goToIndexForSession", GoToIndexForSession);
+    ExportFunction("sendEnterKey", SendEnterKey);
+    // v129: 物理键盘 ArkTS 转发通道(IME TextInput 持焦导致 XComponent 收不到键事件的兜底)
+    ExportFunction("dispatchKeyEvent", DispatchKeyEventNapi);
+    ExportFunction("mouseMove", MouseMove);
+    ExportFunction("mouseDown", MouseDown);
+    ExportFunction("mouseUp", MouseUp);
+    ExportFunction("scroll", Scroll);
+    ExportFunction("touchEvent", TouchEvent);
+    ExportFunction("synthTouchSwipe", SynthTouchSwipe);
+    ExportFunction("synthTouchPinch", SynthTouchPinch);
+    ExportFunction("getSurfaceSize", GetSurfaceSize);
+    // v136: 四向安全区下发(收紧 nsIScreen availRect,修菜单滚动)
+    ExportFunction("setSafeAreaInsets", SetSafeAreaInsets);
+    // v137: 主窗口 windowId 下发(供鼠标光标 API 定位目标窗口)
+    ExportFunction("setMainWindowId", SetMainWindowId);
+    // A1/A2/A3 优化新增接口
+    ExportFunction("setFullZoom", SetFullZoom);
+    ExportFunction("forceRepaintWithCallback", ForceRepaintWithCallback);
+    ExportFunction("getSessionHistory", GetSessionHistory);
+
+    OH_LOG_INFO(LOG_APP, "libgeckoview.so geckoview 业务模块注册完成");
+    return exports;
+}
+
+// 'geckoxcomp' 模块注册入口:由 XComponent libraryname='geckoxcomp' 触发
+// XComponent 创建时,框架在 exports 中注入 OH_NATIVE_XCOMPONENT_OBJ 属性,
+// 此处通过 napi_unwrap 获取 OH_NativeXComponent 指针并注册 Surface 回调
+napi_value NapiRegisterModuleGeckoXComp(napi_env env, napi_value exports) {
+    OH_LOG_INFO(LOG_APP, "NapiRegisterModuleGeckoXComp: geckoxcomp XComponent 模块注册开始");
+
+    // 检查框架是否注入了 OH_NATIVE_XCOMPONENT_OBJ
+    bool hasXComponent = false;
+    napi_has_named_property(env, exports, OH_NATIVE_XCOMPONENT_OBJ, &hasXComponent);
+    OH_LOG_INFO(LOG_APP, "NapiRegisterModuleGeckoXComp: 检查 OH_NATIVE_XCOMPONENT_OBJ 属性: %{public}s",
+                hasXComponent ? "存在" : "不存在");
+
+    if (!hasXComponent) {
+        // 异常情况:XComponent 触发的加载应该会注入此属性
+        // 若仍不存在,说明加载时机异常,记录警告但继续(依赖懒加载兜底)
+        OH_LOG_WARN(LOG_APP, "NapiRegisterModuleGeckoXComp: OH_NATIVE_XCOMPONENT_OBJ 不存在,加载时机异常");
+        return exports;
+    }
+
+    napi_value exportInstance;
+    napi_get_named_property(env, exports, OH_NATIVE_XCOMPONENT_OBJ, &exportInstance);
+    napi_valuetype valType;
+    napi_typeof(env, exportInstance, &valType);
+    OH_LOG_INFO(LOG_APP, "NapiRegisterModuleGeckoXComp: OH_NATIVE_XCOMPONENT_OBJ 类型: %{public}d", (int)valType);
+
+    if (valType != napi_object) {
+        OH_LOG_ERROR(LOG_APP, "NapiRegisterModuleGeckoXComp: OH_NATIVE_XCOMPONENT_OBJ 类型不是 object");
+        return exports;
+    }
+
+    OH_NativeXComponent* xcomp = nullptr;
+    napi_status unwrapStatus = napi_unwrap(env, exportInstance, (void**)&xcomp);
+    OH_LOG_INFO(LOG_APP, "NapiRegisterModuleGeckoXComp: napi_unwrap 状态: %{public}d, xcomp=%{public}p",
+                (int)unwrapStatus, xcomp);
+    if (!xcomp) {
+        OH_LOG_ERROR(LOG_APP, "NapiRegisterModuleGeckoXComp: napi_unwrap 返回空 xcomp");
+        return exports;
+    }
+
+    gNativeXComponent = xcomp;
+    // 注册 Surface 回调(OnSurfaceCreated/OnSurfaceChanged/OnSurfaceDestroyed/DispatchTouchEvent)
+    static OH_NativeXComponent_Callback cb;
+    cb.OnSurfaceCreated = OnSurfaceCreated;
+    cb.OnSurfaceChanged = OnSurfaceChanged;
+    cb.OnSurfaceDestroyed = OnSurfaceDestroyed;
+    cb.DispatchTouchEvent = DispatchTouchEvent;
+    int32_t regStatus = OH_NativeXComponent_RegisterCallback(gNativeXComponent, &cb);
+    OH_LOG_INFO(LOG_APP, "NapiRegisterModuleGeckoXComp: OH_NativeXComponent 回调注册%{public}s, 状态=%{public}d, xcomp=%{public}p",
+                regStatus == 0 ? "成功" : "失败", regStatus, xcomp);
+
+    // v56:注册鼠标事件回调(C 原生层)
+    // 根因:ArkTS 层 Stack.onMouse 收不到鼠标 PRESS/RELEASE(XComponent SURFACE 消费),
+    // 改用 C 原生 OH_NativeXComponent_MouseEvent_Callback,与触摸同路径捕获鼠标事件。
+    static OH_NativeXComponent_MouseEvent_Callback mouseCb;
+    mouseCb.DispatchMouseEvent = DispatchMouseEvent;
+    mouseCb.DispatchHoverEvent = DispatchHoverEvent;
+    int32_t mouseRegStatus = OH_NativeXComponent_RegisterMouseEventCallback(gNativeXComponent, &mouseCb);
+    OH_LOG_INFO(LOG_APP, "NapiRegisterModuleGeckoXComp: 鼠标事件回调注册%{public}s, 状态=%{public}d",
+                mouseRegStatus == 0 ? "成功" : "失败", mouseRegStatus);
+
+    // 物理键盘事件回调(与触摸/鼠标同路径,C 原生层捕获)。
+    // 修复:XComponent 回调注册此前缺键盘,物理键盘事件在 native 层被吞,
+    // chrome mainKeyset(Ctrl+T/W/L/F5/Alt+← 等)无法触发。
+    int32_t keyRegStatus = OH_NativeXComponent_RegisterKeyEventCallback(
+        gNativeXComponent, DispatchKeyEvent);
+    OH_LOG_INFO(LOG_APP, "NapiRegisterModuleGeckoXComp: 键盘事件回调注册%{public}s, 状态=%{public}d",
+                keyRegStatus == 0 ? "成功" : "失败", keyRegStatus);
+
+    return exports;
+}
+
+// 'geckoview' NAPI 模块结构(由 import 'libgeckoview.so' 触发,导出业务接口)
+static napi_module geckoview_module = {
+    .nm_version = 1,
+    .nm_flags = 0,
+    .nm_filename = nullptr,
+    .nm_register_func = NapiRegisterModuleGeckoview,
+    .nm_modname = "geckoview",
+    .nm_priv = nullptr,
+    .reserved = {0},
+};
+
+// 'geckoxcomp' NAPI 模块结构(由 XComponent libraryname='geckoxcomp' 触发,处理 Surface 回调)
+static napi_module geckoxcomp_module = {
+    .nm_version = 1,
+    .nm_flags = 0,
+    .nm_filename = nullptr,
+    .nm_register_func = NapiRegisterModuleGeckoXComp,
+    .nm_modname = "geckoxcomp",
+    .nm_priv = nullptr,
+    .reserved = {0},
+};
+
+// 模块自动注册(constructor 属性确保 dlopen 时自动执行)
+//
+// 关键设计:libgeckoview.so 与 libgeckoxcomp.so 是同一份代码的两个文件副本。
+// 通过 dladdr 在运行时检测当前 .so 的文件名,只注册与文件名匹配的单个 NAPI 模块。
+//
+// 原因:NAPI Module Manager(NMM)在 import 'libgeckoview.so' 时,会调用该 .so 中
+// 所有已注册模块的 nm_register_func。若同一 .so 同时注册 geckoview + geckoxcomp
+// 两个模块,import 时会错误触发 NapiRegisterModuleGeckoXComp,而此时 exports 中
+// 没有 OH_NATIVE_XCOMPONENT_OBJ(XComponent 尚未创建),导致模块加载异常。
+//
+// 通过文件名区分后:
+//   - import 'libgeckoview.so' → dlopen libgeckoview.so → 只注册 geckoview 模块
+//     → NapiRegisterModuleGeckoview 被调用,导出业务接口
+//   - XComponent libraryname='geckoxcomp' → dlopen libgeckoxcomp.so → 只注册 geckoxcomp 模块
+//     → NapiRegisterModuleGeckoXComp 被调用,exports 中含 OH_NATIVE_XCOMPONENT_OBJ
+extern "C" __attribute__((constructor)) void RegisterGeckoviewModule() {
+    // 默认按 libgeckoview.so 处理(dladdr 失败时的兜底)
+    const char* soPath = "libgeckoview.so";
+    Dl_info info;
+    if (dladdr(reinterpret_cast<void*>(&RegisterGeckoviewModule), &info) &&
+        info.dli_fname != nullptr) {
+        soPath = info.dli_fname;
+    }
+
+    // 取文件 basename(路径可能为 /data/.../libgeckoxcomp.so)
+    const char* base = strrchr(soPath, '/');
+    base = (base != nullptr) ? base + 1 : soPath;
+
+    if (strcmp(base, "libgeckoxcomp.so") == 0) {
+        // libgeckoxcomp.so 副本:只注册 geckoxcomp 模块(由 XComponent 触发)
+        napi_module_register(&geckoxcomp_module);
+    } else {
+        // libgeckoview.so(默认):只注册 geckoview 模块(由 import 触发)
+        napi_module_register(&geckoview_module);
+    }
+}
