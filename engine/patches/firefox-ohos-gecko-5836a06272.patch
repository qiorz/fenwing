diff --git a/media/ffvpx/libavcodec/ac3_parser_internal.h b/media/ffvpx/libavcodec/ac3_parser_internal.h
new file mode 100644
index 0000000000..46814bfb1f
--- /dev/null
+++ b/media/ffvpx/libavcodec/ac3_parser_internal.h
@@ -0,0 +1,91 @@
+/*
+ * AC-3 parser internal code
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
