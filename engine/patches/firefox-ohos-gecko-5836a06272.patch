+// v88: 按 action 派发 session 导航操作的辅助函数
+static napi_value CallSessionNav(napi_env env, napi_callback_info info,
+                                  const char* action) {
+    size_t argc = 1;
+    napi_value args[1];
+    napi_value thisArg;
+    napi_get_cb_info(env, info, &argc, args, &thisArg, nullptr);
+    int32_t sessionId = 0;
+    if (argc >= 1) {
+        napi_get_value_int32(env, args[0], &sessionId);
+    }
+    char sessionIdStr[32];
+    snprintf(sessionIdStr, sizeof(sessionIdStr), "%d", sessionId);
+    if (strcmp(action, "reload") == 0) {
+        GeckoBridge_ReloadForSession(sessionIdStr);
+    } else if (strcmp(action, "stop") == 0) {
+        GeckoBridge_StopForSession(sessionIdStr);
+    } else if (strcmp(action, "back") == 0) {
+        GeckoBridge_GoBackForSession(sessionIdStr);
+    } else if (strcmp(action, "forward") == 0) {
+        GeckoBridge_GoForwardForSession(sessionIdStr);
+    }
+    napi_value result;
+    napi_get_null(env, &result);
+    return result;
+}
