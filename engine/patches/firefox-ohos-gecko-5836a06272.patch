+// 在当前活跃 webview 加载 URL
+// 通过 GeckoBridge_LoadURL(libxul.so 导出符号)将 URL 传递到 Gecko 内核,
+// 由 OHOSLoadURLEvent 在主线程异步创建/复用 geckoview 窗口并加载 URL。
+napi_value LoadURL(napi_env env, napi_callback_info info) {
+    size_t argc = 1;
+    napi_value args[1];
+    napi_value thisArg;
+    napi_get_cb_info(env, info, &argc, args, &thisArg, nullptr);
+    if (argc < 1) {
+        OH_LOG_ERROR(LOG_APP, "LoadURL 参数缺失,期望 url 字符串");
+        napi_throw_type_error(env, nullptr, "参数缺失,期望 url 字符串");
+        return nullptr;
+    }
+
+    char urlBuf[2048] = {0};
+    if (!NapiGetString(env, args[0], urlBuf, sizeof(urlBuf))) {
+        OH_LOG_ERROR(LOG_APP, "LoadURL url 参数解析失败");
+        napi_throw_type_error(env, nullptr, "url 参数解析失败");
+        return nullptr;
+    }
+
+    OH_LOG_INFO(LOG_APP, "LoadURL 调用 GeckoBridge_LoadURL: %{public}s", urlBuf);
+    GeckoBridge_LoadURL(urlBuf);
+
+    napi_value result;
+    napi_get_null(env, &result);
+    return result;
+}
