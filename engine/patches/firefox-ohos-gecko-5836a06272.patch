+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// OpenHarmony 平台 nsWindow 实现 (stage2)
+//
+// 替代 stage1 的 HeadlessWidget 兜底,提供完整的 nsIWidget 实现:
+//   - 每窗口持 own OHNativeWindow 指针(由 XComponent SetNativeWindow 注入)
+//   - GetNativeData(NS_NATIVE_WINDOW) 优先返回 mNativeWindow,
+//     未注入时回退到全局 OHOS_GetNativeWindow() 桥接
+//   - 完整 Show/Hide/SetFocus/DispatchEvent 窗口管理
+//   - 触摸/鼠标事件转发(由 NAPI 层调用 OnTouchEvent/OnMouseEvent)
+//
+// 参考实现:
+//   - widget/headless/HeadlessWidget.cpp (窗口管理基础)
+//   - widget/android/nsWindow.cpp (OpenHarmony 平台模式)
+//   - widget/gtk/nsWindow.cpp (nsIWidget 完整实现参考)
+//
+// 与 HeadlessWidget 的关键差异:
+//   1. HeadlessWidget.GetNativeData(NS_NATIVE_WINDOW) 始终走全局桥接,
+//      不区分窗口实例;nsWindow 优先用 mNativeWindow,确保多窗口场景
+//      各窗口的 EGL surface 绑定到各自的原生窗口。
+//   2. HeadlessWidget.Create 不初始化任何原生资源;nsWindow.Create
+//      会同步等待 XComponent 注入 OHNativeWindow(通过 GeckoBridge_WaitNativeWindow),
+//      确保 OpenWindow 链路后续访问 GetNativeData 时窗口已就绪。
+//   3. HeadlessWidget 不重写 SetParent/Raise;nsWindow 通过 BringToFront
+//      + sActiveWindows 列表实现窗口激活/停用事件分发。
+
+#include "nsWindow.h"
+
+#include <cmath>
+#include <algorithm>
+#include <dlfcn.h>  // v258d: v108 Resize 调用者 dladdr 解析
+// v214: fling tick 的 dt 基准(PR_IntervalToMilliseconds/PR_IntervalNow)
+#include "prinrval.h"
+#include <time.h>  // v218: 触摸事件时间戳重建 clock_gettime
+// v214c: vsync 驱动 fling(AddMainThreadObserver)
+#include "gfxPlatform.h"
+#include "VsyncDispatcher.h"
+
+#include "ErrorList.h"
+#include "HeadlessCompositorWidget.h"
+#include "BasicEvents.h"
+#include "ContentEvents.h"
+#include "MiscEvents.h"
+#include "MouseEvents.h"
+#include "TouchEvents.h"
+#include "nsITimer.h"
+#include "mozilla/ClearOnShutdown.h"
+#include "mozilla/NativeKeyBindingsType.h"
+#include "mozilla/Preferences.h"
+#include "mozilla/TextEventDispatcher.h"
+#include "mozilla/TextEvents.h"
+#include "mozilla/dom/MouseEventBinding.h"
+#include "mozilla/dom/Touch.h"
+#include "mozilla/WritingModes.h"
+#include "mozilla/widget/HeadlessWidgetTypes.h"
+#include "mozilla/widget/PlatformWidgetTypes.h"
+#include "mozilla/widget/Screen.h"
+#include "mozilla/widget/nsUserIdleServiceOHOS.h"
+#include "nsIScreen.h"
+// v110 临时诊断(验证后移除):OnSendEnterKey 焦点探针
+#include "nsIFocusManager.h"
+#include "mozilla/dom/Document.h"
+#include "mozilla/dom/Element.h"
+#include "mozilla/dom/NodeInfo.h"
+
+// OHOS IME 桥接:由 OHOSNativeWindowBridge.cpp 实现,通知 IME 状态变化
+// 在 libxul.symbols 中导出,供 nsWindow::SetInputContext 调用
+// aEnabled: true=显示软键盘,false=隐藏软键盘
+// aInputType: IME_TEXT_INPUT_TYPE_* 枚举值
+// v107 修复:声明必须带 visibility("default"),否则 gcc_hidden.h 的
+// #pragma GCC visibility push(hidden) 使本 TU 的 UND 引用为 HIDDEN,
+// lld 取所有引用/定义的最小可见性,导致 libxul.so 中定义被 localize,
+// libgeckoview.so 链接时报 undefined symbol(与 OH_AudioStreamBuilder 同款陷阱)
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_NotifyIMEState(bool aEnabled, int32_t aInputType);
+
+// OHOS 渲染管线诊断:用 printf 输出到 stdout(EntryAbility 搬运不捕获 stderr)
+#define NSWINDOW_LOG(fmt, ...) printf("[nsWindow] " fmt "\n", ##__VA_ARGS__)
+
+// OHOS DisplayManager:获取真实屏幕 DPI/密度(手机端启用时使用)。
+// 注意:OHOS NDK 头文件声明未带 visibility 属性,libxul 默认 hidden visibility
+// 会导致符号在链接时被隐藏,用 pragma push(default) 强制导出引用符号。
+// 当前桌面优先模式(v56)固定 DPI=96 不读取,保留 include 备手机端恢复。
+#pragma GCC visibility push(default)
+#include <oh_display_manager.h>
+#include <oh_display_info.h>
+#include <multimodalinput/oh_input_manager.h>
+#include <multimodalinput/oh_pointer_style.h>
+#pragma GCC visibility pop
+
+// OpenHarmony 原生窗口桥接:由 widget/openharmony/OHOSNativeWindowBridge.cpp 实现
+// 提供全局 OHNativeWindow 指针的获取与等待接口
+extern "C" void* OHOS_GetNativeWindow();
+__attribute__((visibility("default"))) // 同上:防 UND HIDDEN 引用 localize libxul 定义
+extern "C" void* GeckoBridge_WaitNativeWindow(int aTimeoutMs);
+// 由 OHOSNativeWindowBridge.cpp 实现,获取 XComponent 表面尺寸
+extern "C" void OHOS_GetSurfaceSize(int* aWidth, int* aHeight);
+// 由 OHOSNativeWindowBridge.cpp 实现的诊断日志函数(直接写入文件,不依赖 dup2)
+extern "C" void OHOS_DiagLog(const char* fmt, ...);
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_NotifyFullscreen(bool aFullScreen);
+// v150: 鼠标光标样式桥接(OHOSNativeWindowBridge.cpp 实现)。
+// 把 nsCursor 映射出的 Input_PointerStyle 应用到主窗口。
+// 同 GeckoBridge_NotifyIMEState:visibility("default") 防 UND HIDDEN 引用 localize
+__attribute__((visibility("default")))
+extern "C" void OHOS_ApplyPointerStyle(int32_t style);
+// v133/v134: popup 计数桥接(OHOSNativeWindowBridge.cpp 实现,libxul.symbols 导出)
+// 在 nsWindow::Show 的 popup 窗口真实可见性转换时调用;
+// v134 scene-merge:传入 popup widget 指针登记注册表,驱动主场景 iframe 引用注入
+// v155: 声明补 visibility("default") —— libxul -fvisibility=hidden 下,裸 extern
+// 声明的默认 hidden 与定义处的 default 在链接期合并取最严,符号被拖成 HIDDEN,
+// libxul.symbols(version script)救不回(v151 nsLocalFileUnix 同款陷阱;实证
+// 8/14 构建产物 .dynsym 缺此两符号)。
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_PopupShown(nsIWidget* aPopup);
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_PopupHidden(nsIWidget* aPopup);
+// 由 OHOSProgressListener.cpp 实现,初始化页面加载进度监听器
+// 在 nsWindow::Create(Gecko 主线程,XPCOM 已初始化)中调用,
+// 通过 NS_DispatchToMainThread 异步派发注册任务
+__attribute__((visibility("default"))) // 同上:防 UND HIDDEN 引用 localize libxul 定义
+extern "C" void GeckoBridge_InitProgressListener();
+
+using namespace mozilla;
+using namespace mozilla::gfx;
+using namespace mozilla::layers;
+using namespace mozilla::widget;
+
+// OpenHarmony 平台不需要 HeadlessWidget 的 CreateHeadlessWidget 工厂
+// (nsIWidget::CreateChildWindow/CreateTopLevelWindow 在 nsWidgetFactory.cpp 中实现)
+
+StaticAutoPtr<nsTArray<nsWindow*>> nsWindow::sActiveWindows;
+
+nsWindow::nsWindow()
+    : mSizeMode(nsSizeMode_Normal),
+      mIsVisible(false),
+      mEnabled(true),
+      mNeedsPaint(true),
+      mDestroyed(false),
+      mNativeWindow(nullptr),
+      mDestroyMutex("nsWindow::mDestroyMutex") {
+  // v40:从 Headless 切换到 Native,启用 CompositorBridge 渲染管线
+  // (Headless 模式不创建 CompositorBridge/EGL/WebRender,页面内容不显示)
+  mWidgetType = WidgetType::Native;
+
+  if (!sActiveWindows) {
+    sActiveWindows = new nsTArray<nsWindow*>();
+    ClearOnShutdown(&sActiveWindows);
+  }
+}
+
+nsWindow::~nsWindow() {
+  Destroy();
+}
+
+void nsWindow::Destroy() {
+  if (mDestroyed) {
+    return;
+  }
+  mDestroyed = true;
+
+  // v159: 掐断 pan fling 定时器(菜单 popup 可在手势中被销毁,
+  // 定时器回调裸持 this,不取消会 use-after-destroy)。
+  CancelPanFling();
+  // v218: 掐断 popup 楔死守卫定时器(同款 use-after-destroy 防御)。
+  if (mPopupWedgeGuardTimer) {
+    mPopupWedgeGuardTimer->Cancel();
+    mPopupWedgeGuardTimer = nullptr;
+  }
+
+  // v133: popup 销毁时若仍计入全局计数(未经 Show(false) 直接 Destroy),
+  // 在此回退,避免主窗口呈显被永久抑制。
+  if (mPopupCounted) {
+    GeckoBridge_PopupHidden(this);
+    mPopupCounted = false;
+  }
+
+  if (sActiveWindows) {
+    int32_t index = sActiveWindows->IndexOf(this);
+    if (index != -1) {
+      // 记录当前活跃窗口(被销毁的可能是活跃窗口)
+      nsWindow* activeWindow =
+          sActiveWindows->IsEmpty()
+              ? nullptr
+              : sActiveWindows->ElementAt(sActiveWindows->Length() - 1);
+      sActiveWindows->RemoveElementAt(index);
+      // 如果销毁的是当前活跃窗口,且有其他窗口,激活最后一个
+      if (this == activeWindow && !sActiveWindows->IsEmpty()) {
+        nsWindow* newActive = sActiveWindows->ElementAt(sActiveWindows->Length() - 1);
+        if (newActive && newActive->mWidgetListener) {
+          newActive->mWidgetListener->WindowActivated();
+        }
+      }
+    }
+  }
+
+  nsBaseWidget::OnDestroy();
+  nsBaseWidget::Destroy();
+}
+
+//*****************************************************************************
+// nsWindow::nsIWidget
+//*****************************************************************************
+
+nsresult nsWindow::Create(nsIWidget* aParent, const LayoutDeviceIntRect& aRect,
+                          InitData* aInitData) {
+  // BaseCreate 会设置 mParent/mWidgetListener/mAttachedWidgetListener 等
+  BaseCreate(aParent, aInitData);
+
+  // 根因修复:GeckoView 窗口由 nsIWindowWatcher::OpenWindow 创建,
+  // geckoview.xhtml 未指定 width/height 属性,传入的 aRect 为 0x0 或 1x1(最小默认)。
+  // CompositorBridgeParent 以 surfaceSize=(0,0) 或 (1,1) 创建时,WebRender 不会
+  // 初始化 RenderCompositorEGL,导致渲染黑屏。
+  // 修复:TopLevel/Dialog 窗口若 aRect 尺寸过小(<=1),使用 XComponent 表面尺寸。
+  LayoutDeviceIntRect actualRect = aRect;
+  if ((mWindowType == WindowType::TopLevel ||
+       mWindowType == WindowType::Dialog) &&
+      (aRect.Width() <= 1 || aRect.Height() <= 1)) {
+    int surfaceW = 0, surfaceH = 0;
+    OHOS_GetSurfaceSize(&surfaceW, &surfaceH);
+    if (surfaceW > 0 && surfaceH > 0) {
+      actualRect.SetWidth(surfaceW);
+      actualRect.SetHeight(surfaceH);
+      OHOS_DiagLog("[XRE] nsWindow::Create 使用 XComponent 表面尺寸: %dx%d (原 aRect=%dx%d)",
+              surfaceW, surfaceH, aRect.Width(), aRect.Height());
+    } else {
+      OHOS_DiagLog("[XRE] nsWindow::Create 警告:XComponent 表面尺寸未就绪(%dx%d),使用默认 1080x1920",
+              surfaceW, surfaceH);
+      actualRect.SetWidth(1080);
+      actualRect.SetHeight(1920);
+    }
+  }
+
+  mBounds = actualRect;
+  mScreenBounds = LayoutDeviceIntPoint(actualRect.X(), actualRect.Y());
+
+  // v45 关键诊断:输出 this 指针,用于确认 Create 和 GetWindowRenderer
+  // 是否操作同一 widget 实例(若不同实例,说明 Gecko 创建了多个 nsWindow,
+  // Create 时设置正确尺寸的那个被丢弃,GetWindowRenderer 在 0x0 实例上调用)
+  OHOS_DiagLog("[XRE] nsWindow::Create this=%p type=%d mBounds=%dx%d (设置后)",
+          (void*)this, (int)mWindowType,
+          mBounds.Width(), mBounds.Height());
+
+  // v123 popup 全链诊断:Create 阶段记录 popup 的初始 mBounds(含位置),
+  // 验证 ≡ 菜单点击打开时 popup 是否拿到合理小尺寸(而非全屏)。
+  if (mWindowType == WindowType::Popup) {
+    OHOS_DiagLog("[XRE_POPUP] Create this=%p parent=%p aRect=(%d,%d %dx%d) "
+            "-> mBounds=(%d,%d %dx%d)",
+            (void*)this, (void*)aParent, aRect.X(), aRect.Y(),
+            aRect.Width(), aRect.Height(),
+            mBounds.X(), mBounds.Y(), mBounds.Width(), mBounds.Height());
+    // v218: popup 楔死自愈守卫(v162 Bug2 定性:导航 chrome 特权页后
+    // PanelMultiView 主视图塌缩 0 宽,每次点击 ≡ 都建 aRect=(x,y 0x1)
+    // 的 1px 壳窗口,死壳累积)。正常 popup 的 Resize(真实尺寸)在 Create
+    // 后一两个事件循环内到达;若 750ms 后 bounds 仍为退化值(宽或高≤1),
+    // 判定楔死态,主动 Rollup 清掉全部 popup,把"每次点击泄漏一个死壳"
+    // 转化为"每次失败尝试被清理",浏览器其余功能保持可用(v162 实证
+    // 楔死态下标签条/下载面板/地址导航/页面交互全正常)。
+    if (aRect.Width() <= 1 || aRect.Height() <= 1) {
+      OHOS_DiagLog("[XRE_POPUP_GUARD] popup 以退化尺寸 %dx%d 创建,布防 750ms 楔死校验",
+              aRect.Width(), aRect.Height());
+      NS_NewTimerWithCallback(
+          getter_AddRefs(mPopupWedgeGuardTimer),
+          [self = RefPtr<nsWindow>(this)](nsITimer*) {
+            self->OnPopupWedgeGuardTimeout();
+          },
+          750, nsITimer::TYPE_ONE_SHOT,
+          "nsWindow::OnPopupWedgeGuardTimeout");
+    }
+  }
+
+  // 顶层窗口创建时,同步等待 XComponent 注入 OHNativeWindow
+  // 确保 OpenWindow 链路后续 GetNativeData(NS_NATIVE_WINDOW) 能拿到有效窗口
+  // 超时 3000ms(OnSurfaceCreated 通常在 Create 之前已触发,见 geckoview.cpp 日志)
+  //
+  // OHOS 多窗口:只有第一个 TopLevel 窗口绑定 XComponent 的 OHNativeWindow。
+  // 第二个窗口(由 OnNewSession 的 OpenWindow 创建)不绑定 native window
+  // (mNativeWindow 保持 null),因为 OHNativeWindow 是全局单实例,
+  // 两个 EGLSurface 绑定同一个 OHNativeWindow 会导致 EGL 冲突崩溃。
+  // 第二窗口通过 docShellIsActive=false 保持不活跃,不参与 EGL 渲染。
+  bool isFirstTopLevel = sActiveWindows == nullptr || sActiveWindows->IsEmpty();
+  if ((mWindowType == WindowType::TopLevel ||
+       mWindowType == WindowType::Dialog) &&
+      isFirstTopLevel) {
+    void* nativeWin = GeckoBridge_WaitNativeWindow(3000);
+    if (nativeWin) {
+      mNativeWindow = static_cast<OHNativeWindow*>(nativeWin);
+      OHOS_DiagLog("[XRE] nsWindow::Create this=%p 第一顶层窗口已绑定 mNativeWindow=%p bounds=%dx%d",
+              (void*)this, (void*)mNativeWindow,
+              mBounds.Width(), mBounds.Height());
+    } else {
+      OHOS_DiagLog("[XRE] nsWindow::Create this=%p 警告:等待 OHNativeWindow 超时,将使用全局桥接回退",
+              (void*)this);
+    }
+  } else if (mWindowType == WindowType::TopLevel ||
+             mWindowType == WindowType::Dialog) {
+    OHOS_DiagLog("[XRE] nsWindow::Create this=%p 第二+顶层窗口,不绑定 native window(避免 EGL 冲突)",
+            (void*)this);
+  }
+
+  // 顶层窗口创建时初始化页面加载进度监听器
+  // 此时 Gecko 主线程已就绪,XPCOM 已初始化,NS_DispatchToMainThread 可用
+  // InitProgressListenerRunnable 会尝试注册,若 browser 元素未创建则注册
+  // OHOSStartupObserver 监听 browser-delayed-startup-finished 通知
+  if (mWindowType == WindowType::TopLevel ||
+      mWindowType == WindowType::Dialog) {
+    GeckoBridge_InitProgressListener();
+  }
+
+  return NS_OK;
+}
+
+void nsWindow::Show(bool aState) {
+  mIsVisible = aState;
+
+  // v111/v123 诊断:popup 生命周期跟踪(验证 popup 渲染修复后的行为)
+  // v123: 用 [XRE_POPUP] tag 便于真机日志检索;Show=true 时若 mBounds 仍是
+  // 整个 Surface 尺寸(如 1349x779)说明尺寸链路仍断;若为 501x668 量级则正确。
+  if (mWindowType == WindowType::Popup) {
+    OHOS_DiagLog("[XRE_POPUP] Show=%d this=%p mBounds=(%d,%d %dx%d)",
+            aState ? 1 : 0, (void*)this, mBounds.X(), mBounds.Y(),
+            mBounds.Width(), mBounds.Height());
+  }
+
+  // v133: popup 计数挂接(幂等)。Show 可能重复调用同值(true->true),
+  // 用 mPopupCounted 记录当前是否已计入全局计数,仅在真实转换时 +1/-1。
+  // 驱动 RenderCompositorEGL::EndFrame 在 popup 打开期间抑制主窗口 SwapBuffers。
+  if (mWindowType == WindowType::Popup) {
+    if (aState && !mPopupCounted) {
+      GeckoBridge_PopupShown(this);
+      mPopupCounted = true;
+    } else if (!aState && mPopupCounted) {
+      GeckoBridge_PopupHidden(this);
+      mPopupCounted = false;
+    }
+  }
+
+  if (aState) {
+    // 顶层窗口显示时激活(参考 HeadlessWidget::RaiseWindow)
+    if (mWindowType == WindowType::TopLevel ||
+        mWindowType == WindowType::Dialog) {
+      BringToFront();
+    }
+  }
+}
