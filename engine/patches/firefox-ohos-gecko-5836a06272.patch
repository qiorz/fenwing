@@ -0,0 +1,19 @@
+/*
+ * AArch64 optimization stub for AAC SBR DSP init function.
+ *
+ * FFmpeg 7.x provides NEON-optimized SBR DSP in libavcodec/aarch64/
+ * sbrdsp_init_aarch64.c (+ sbrdsp_neon.S), but these files were not
+ * vendored into ffvpx during the AAC port (v107). This stub provides an
+ * empty implementation so the AAC decoder links cleanly, falling back to
+ * the standard C SBR DSP implementation (correct, just slower than NEON).
+ *
+ * Same pattern as h264_init_aarch64_stub.c (v96) and
+ * aacpsdsp_init_aarch64_stub.c (v107).
+ */
+
+#include "sbrdsp.h"
+
+void ff_sbrdsp_init_aarch64(SBRDSPContext *s)
+{
+    /* no-op: use standard C implementation */
+}
