@@ -0,0 +1,48 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can get one at http://mozilla.org/MPL/2.0/. */
+
+// OpenHarmony 双轨窗口查找辅助
+//
+// v110 根因修复:native 轨道 LocationChange 静默 + 导航桥全失效。
+//   背景:Gecko 顶层 chrome 窗口的 windowtype 随 UI 轨道不同:
+//     - classic 轨道(geckoview.xhtml):windowtype="navigator:geckoview"
+//     - native 轨道(browser.xhtml):  windowtype="navigator:browser"
+//   此前所有窗口查找(GetMostRecentWindow)硬编码 "navigator:geckoview",
+//   native 轨道下永远返回 nullptr,导致:
+//     - OHOSProgressListener 从未 AddProgressListener 到任何 content docShell
+//       (LocationChange / PageLoad / Progress 回调全静默,v109 实测)
+//     - GoBack/GoForward/Reload/Stop/GoToIndex 找不到 webNav,静默 no-op
+//     - GetSessionHistory 永远返回 false(ArkTS 历史计数器无法校准)
+//     - ForceRepaint 找不到 PresShell
+//   修复:统一经 OHOSFindChromeWindow() 查找,先 geckoview 后 browser,双轨兼容。
+//   (browser-delayed-startup-finished 通知在两条轨道都会发射:
+//    classic=geckoview.js,native=browser-init.js,故 observer 唤醒逻辑不变。)
+
+#ifndef OHOSWindowFinder_h
+#define OHOSWindowFinder_h
+
+#include "nsCOMPtr.h"
+#include "nsIWindowMediator.h"
+#include "nsServiceManagerUtils.h"  // do_GetService
+
+// 在 Gecko 主线程查找顶层浏览器 chrome 窗口(双轨兼容)。
+// 优先 navigator:geckoview(classic 轨道),未找到回退 navigator:browser(native 轨道)。
+// 返回 nullptr 表示窗口尚未创建(调用方可延迟重试或等 startup 通知)。
+inline already_AddRefed<mozIDOMWindowProxy> OHOSFindChromeWindow() {
+  nsCOMPtr<nsIWindowMediator> mediator =
+      do_GetService(NS_WINDOWMEDIATOR_CONTRACTID);
+  if (!mediator) {
+    return nullptr;
+  }
+  nsCOMPtr<mozIDOMWindowProxy> window;
+  mediator->GetMostRecentWindow(u"navigator:geckoview", getter_AddRefs(window));
+  if (!window) {
+    // native 轨道:browser.xhtml 的 windowtype 是 navigator:browser
+    mediator->GetMostRecentWindow(u"navigator:browser", getter_AddRefs(window));
+  }
+  return window.forget();
+}
+
+#endif  // OHOSWindowFinder_h
