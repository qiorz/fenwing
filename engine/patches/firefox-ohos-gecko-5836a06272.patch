+/**
+ * @file
+ * Error resilience stub implementation.
+ *
+ * The full error_resilience.c from FFmpeg 6.1 is incompatible with the
+ * ffvpx FFmpeg 7.x base (OutputFormat enum conflicts in mpegvideo.h,
+ * missing function declarations). Since CONFIG_ERROR_RESILIENCE is set
+ * to 0 and error concealment is an optional feature not required for
+ * basic H.264 decoding, this stub provides empty no-op implementations
+ * of the public API so that the H.264 decoder (which unconditionally
+ * calls these functions) links cleanly without modification.
+ *
+ * Streaming H.264 content does not depend on error concealment; corrupt
+ * frames are simply passed through as-is.
+ */
+
+#include "error_resilience.h"
+
+void ff_er_frame_start(ERContext *s)
+{
+    /* no-op: error concealment disabled */
+}
+
+void ff_er_frame_end(ERContext *s, int *decode_error_flags)
+{
+    /* no-op: error concealment disabled */
+}
+
+void ff_er_add_slice(ERContext *s, int startx, int starty, int endx, int endy,
+                     int status)
+{
+    /* no-op: error concealment disabled */
+}
