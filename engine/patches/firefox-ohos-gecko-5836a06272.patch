+    int persistence_flag;        //< HEVC  only
+} H2645SEIFilmGrainCharacteristics;
+
+typedef struct H2645SEIMasteringDisplay {
+    int present;
+    uint16_t display_primaries[3][2];
+    uint16_t white_point[2];
+    uint32_t max_luminance;
