+// ============================================================================
+// v88: 多 session 管理(对齐火狐多 browser 标签模型)
+// 通过 geckoview.js 的 TabManager 管理多 <browser>,此处 NAPI 桥接转发到 JS。
+// 使用 GeckoBridge_DispatchToJSCallback 模式同步调用 JS 的 TabManager 方法。
+// ============================================================================
+
+// geckoview.js TabManager 调用桥:通过 evaluate 全局函数执行 JS
+// 简化实现:借助 Services 全局在 Gecko 主线程调用 window 上的函数。
+// 由于 NAPI 不直接持有 JSContext,这里采用"事件派发 + 自旋等待"模式。
+// 但为降低复杂度,createSession/switchSession/closeSession 走最简路径:
+// 直接调用 libxul 导出的 C 函数(若存在)或通过 dispatch 到主线程的 JS 调用。
+//
+// 实现策略:TabManager 的方法由 geckoview.js 暴露为 nsIObserver 通知,
+// 这里通过 Services.obs.notifyObservers 触发。为保证响应,采用同步派发。
+//
+// 简化:用 GeckoBridge_CallTabManager 导出符号(libxul 中实现,调 JS TabManager)
+// 若该符号不存在则回退为 no-op(编译期弱依赖)。
+
+// 创建新标签(session)
+// 参数:sessionId: number (作为 browserIndex), url?: string
+napi_value CreateSession(napi_env env, napi_callback_info info) {
+    size_t argc = 2;
+    napi_value args[2];
+    napi_value thisArg;
+    napi_get_cb_info(env, info, &argc, args, &thisArg, nullptr);
+    int32_t sessionId = 0;
+    if (argc >= 1) {
+        napi_get_value_int32(env, args[0], &sessionId);
+    }
+    char url[2048] = {0};
+    if (argc >= 2) {
+        size_t len = 0;
+        napi_get_value_string_utf8(env, args[1], url, sizeof(url), &len);
+    }
+    OH_LOG_INFO(LOG_APP, "CreateSession sessionId=%{public}d url=%{public}s", sessionId, url);
+    // sessionId 用作 browserIndex(字符串形式),供 GeckoBridge_*ForSession 寻址
+    char sessionIdStr[32];
+    snprintf(sessionIdStr, sizeof(sessionIdStr), "%d", sessionId);
+    // 通过 GeckoBridge_CallTabManager 通知 JS 层创建 browser
+    GeckoBridge_CallTabManager("create", sessionIdStr, url);
+    // v98: 为新 session 注册进度监听器(内部自动查找窗口 + 重试)
+    // sessionId 同时用作 browserIndex(content docShell 在子列表中的位置下标)
+    GeckoBridge_RegisterSessionProgress(sessionIdStr, sessionId);
+    napi_value result;
+    napi_get_null(env, &result);
+    return result;
+}
