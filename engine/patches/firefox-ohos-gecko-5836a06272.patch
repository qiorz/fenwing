+// v155: Gecko 侧 tap 点击合成(与 v73 三连同构,但仅在系统合成通道死亡时执行)。
+// eMouseMove → eMouseDown → eMouseUp,全部 mInputSource=MOZ_SOURCE_TOUCH
+// (保持 v103 click target 重定向豁免语义),button=ePrimary,down/up clickCount=1。
+// 不走 OnMouseEvent 入口:touchstart 已做过 CheckForRollup(v111),此处无需重复。
+void nsWindow::SynthesizeTapMouseEvents(const LayoutDeviceIntPoint& aPoint) {
+  OHOS_DiagLog("[XRE_TAPSYNTH] 系统合成通道死亡,Gecko 侧合成 tap 点击 pos=(%d,%d)",
+          aPoint.x, aPoint.y);
+  {
+    WidgetMouseEvent move(true, eMouseMove, this, WidgetMouseEvent::eReal);
+    move.mRefPoint = aPoint;
+    move.mButton = MouseButton::ePrimary;
+    move.mClickCount = 0;
+    move.mInputSource = mozilla::dom::MouseEvent_Binding::MOZ_SOURCE_TOUCH;
+    DispatchEvent(&move);
+  }
+  {
+    WidgetMouseEvent down(true, eMouseDown, this, WidgetMouseEvent::eReal);
+    down.mRefPoint = aPoint;
+    down.mButton = MouseButton::ePrimary;
+    down.mClickCount = 1;
+    down.mInputSource = mozilla::dom::MouseEvent_Binding::MOZ_SOURCE_TOUCH;
+    DispatchEvent(&down);
+  }
+  {
+    WidgetMouseEvent up(true, eMouseUp, this, WidgetMouseEvent::eReal);
+    up.mRefPoint = aPoint;
+    up.mButton = MouseButton::ePrimary;
+    up.mClickCount = 1;
+    up.mInputSource = mozilla::dom::MouseEvent_Binding::MOZ_SOURCE_TOUCH;
+    DispatchEvent(&up);
+  }
+}
