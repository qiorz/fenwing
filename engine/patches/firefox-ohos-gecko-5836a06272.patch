+            }
+            fclose(fw);
+        } else {
+            OH_LOG_ERROR(LOG_APP, "v108 写入 %{public}s 失败(errno=%{public}d)",
+                         prefsPath.c_str(), errno);
+        }
+    }
+    std::string urlArg = "-url";
+    std::string urlValue = initialUrl;
+
+    std::vector<char*> argv;
+    argv.push_back(const_cast<char*>(programName.c_str()));
