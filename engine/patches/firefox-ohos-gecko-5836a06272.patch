+// Surface 尺寸变化回调
+static void OnSurfaceChanged(OH_NativeXComponent* component, void* window) {
+  // 表面尺寸变化时同步更新 libxul.so 中的尺寸记录
+  uint64_t width = 0, height = 0;
+    int32_t ret = OH_NativeXComponent_GetXComponentSize(component, window, &width, &height);
+    if (ret == 0 && width > 0 && height > 0) {
+        GeckoBridge_SetSurfaceSize((int)width, (int)height);
+        // v56:本地缓存 Surface 尺寸
+        gSurfaceWidth.store((int)width, std::memory_order_relaxed);
+        gSurfaceHeight.store((int)height, std::memory_order_relaxed);
+        // v56:尺寸变化时触发 nsWindow::Resize,让 Gecko 的合成器/布局/EGL
+        // swapchain 跟随窗口放大/缩小。原先只更新全局记录,已创建的 nsWindow
+        // 不会收到尺寸变化通知,导致页面渲染不跟随窗口缩放。
+        GeckoBridge_ResizeSurface((int32_t)width, (int32_t)height);
+    }
+  OH_LOG_INFO(LOG_APP, "XComponent OnSurfaceChanged, window=%{public}p size=%{public}llux%{public}llu ret=%{public}d",
+              window, (unsigned long long)width, (unsigned long long)height, ret);
+}
+
+// Surface 销毁回调:清空 libxul.so 中的原生窗口引用
+static void OnSurfaceDestroyed(OH_NativeXComponent* component, void* window) {
+    if (gNativeWindow == window) {
+        gNativeWindow = nullptr;
+        // 清空 libxul.so 中的原生窗口引用,避免 EGL 使用已销毁的 Surface
+        GeckoBridge_SetNativeWindow(nullptr);
+    }
+    OH_LOG_INFO(LOG_APP, "XComponent OnSurfaceDestroyed, window=%{public}p", window);
+}
+
+// 触摸事件分发回调:由 XComponent C 层回调触发(SURFACE 类型不触发 ArkTS onTouch)
+// 通过 OH_NativeXComponent_GetTouchEvent 获取触摸点,转发到 GeckoBridge_DispatchTouchEvent
+static void DispatchTouchEvent(OH_NativeXComponent* component, void* window) {
+    OH_NativeXComponent_TouchEvent touchEvent;
+    int32_t ret = OH_NativeXComponent_GetTouchEvent(component, window, &touchEvent);
+    if (ret != OH_NATIVEXCOMPONENT_RESULT_SUCCESS) {
+        OH_LOG_WARN(LOG_APP, "DispatchTouchEvent GetTouchEvent 失败 ret=%{public}d", ret);
+        return;
+    }
+
+    // OH_NativeXComponent_TouchEventType 枚举:
+    //   0=DOWN, 1=UP, 2=MOVE, 3=CANCEL, 4=UNKNOWN
+    // GeckoBridge_DispatchTouchEvent action:
+    //   0=eTouchStart, 1=eTouchEnd, 2=eTouchMove, 3=eTouchCancel
+    int32_t action = -1;
+    switch (touchEvent.type) {
+        case OH_NATIVEXCOMPONENT_DOWN: action = 0; break;
+        case OH_NATIVEXCOMPONENT_UP: action = 1; break;
+        case OH_NATIVEXCOMPONENT_MOVE: action = 2; break;
+        case OH_NATIVEXCOMPONENT_CANCEL: action = 3; break;
+        default: return;
+    }
+
+    // 输入流畅性:MOVE(拖拽/滚动数百次/秒)不再 printf+fflush/OH_LOG,
+    //   消除每事件同步文件 IO;DOWN/UP/CANCEL 低频,保留诊断。
+    //   (原 v61/v65 诊断对 MOVE 无额外价值,仅拖慢主线程)
+    if (action != 2) {
+        OH_LOG_INFO(LOG_APP, "DispatchTouchEvent C回调 type=%{public}d numPoints=%{public}d",
+                    (int)touchEvent.type, (int)touchEvent.numPoints);
+        printf("[TOUCH] DispatchTouchEvent C回调 type=%d numPoints=%d\n",
+               (int)touchEvent.type, (int)touchEvent.numPoints);
+        fflush(stdout);
+    }
+
+    // v270: 多点批转发(双指捏合根修)。路由规则:
+    //   ① numPoints>1 → 多点导出(整批);
+    //   ② numPoints==1 且触点 id!=0 → 多点导出单点批(多指手势仅剩
+    //      非 0 指的尾段,id 语义须连续,不能落回旧单点通道的硬编码 id=0);
+    //   ③ numPoints==1 且 id==0 → 旧单点导出(单指主通路,既有点击/
+    //      滚动/长按行为零改动;多指态期间由 libxul 侧挂钩并入合并器)。
+    if (touchEvent.numPoints > 1 || touchEvent.touchPoints[0].id != 0) {
+        int32_t n = touchEvent.numPoints;
+        if (n > OH_NATIVE_XCOMPONENT_MAX_TOUCH_POINTS_NUMBER) {
+            n = OH_NATIVE_XCOMPONENT_MAX_TOUCH_POINTS_NUMBER;
+        }
+        int32_t ids[OH_NATIVE_XCOMPONENT_MAX_TOUCH_POINTS_NUMBER];
+        float xs[OH_NATIVE_XCOMPONENT_MAX_TOUCH_POINTS_NUMBER];
+        float ys[OH_NATIVE_XCOMPONENT_MAX_TOUCH_POINTS_NUMBER];
+        int32_t types[OH_NATIVE_XCOMPONENT_MAX_TOUCH_POINTS_NUMBER];
+        int32_t pressed[OH_NATIVE_XCOMPONENT_MAX_TOUCH_POINTS_NUMBER];
+        for (int32_t i = 0; i < n; ++i) {
+            const OH_NativeXComponent_TouchPoint* p = &touchEvent.touchPoints[i];
+            ids[i] = p->id;
+            xs[i] = p->x;
+            ys[i] = p->y;
+            types[i] = (int32_t)p->type;
+            pressed[i] = p->isPressed ? 1 : 0;
+        }
+        // 低频取证(DOWN/UP/CANCEL):每指 id/type/pressed 实画像,验证
+        // 框架批形态(UP 批是否含已抬指/type 是否逐指准确)。
+        if (action != 2) {
+            printf("[MTOUCH] C回调 type=%d n=%d", (int)touchEvent.type, n);
+            for (int32_t i = 0; i < n; ++i) {
+                printf(" [%d]id=%d t=%d p=%d(%.0f,%.0f)", i, ids[i], types[i],
+                       pressed[i], xs[i], ys[i]);
+            }
+            printf("\n");
+            fflush(stdout);
+        }
+        GeckoBridge_DispatchMultiTouchEvent(action, n, ids, xs, ys, types,
+                                            pressed, touchEvent.timeStamp);
+        return;
+    }
+
+    // 使用第一个触摸点(单点触控;id==0 主通路)
+    if (touchEvent.numPoints > 0) {
+        OH_NativeXComponent_TouchPoint* p = &touchEvent.touchPoints[0];
+        if (action != 2) {
+            // v258g: DOWN/UP 记录框架当前认知的组件尺寸——键盘白带取证实锤
+            // 触摸坐标被缩放,看框架尺寸是否卡在键盘期收缩值(如 1435x878)。
+            uint64_t xw = 0, xh = 0;
+            int32_t xret = OH_NativeXComponent_GetXComponentSize(component, window, &xw, &xh);
+            printf("[TOUCH] DispatchTouchEvent → GeckoBridge_DispatchTouchEvent action=%d x=%.1f y=%.1f xcomp=%llux%llu ret=%d\n",
+                   action, p->x, p->y, (unsigned long long)xw, (unsigned long long)xh, xret);
+            fflush(stdout);
+        }
+        GeckoBridge_DispatchTouchEvent(action, p->x, p->y, p->timeStamp);
+    }
+}
+
+// 鼠标事件分发回调(C 原生层,与触摸同路径)
+//
+// 根因(v56):鼠标 PRESS/RELEASE 在 ArkTS 层无法可靠收到 ——
+// XComponent SURFACE 类型会消费鼠标按下事件,即使设 HitTestMode.None,
+// ArkUI 也只把 HOVER/MOVE 冒泡到父容器 Stack,PRESS/RELEASE 被 XComponent 吞掉,
+// 导致 Gecko 只收到鼠标移动(HOVER),收不到点击(Down/Up),页面无法点击。
+// 解决:改用 C 原生 OH_NativeXComponent_MouseEvent_Callback,与触摸同路径,
+// 在 C 层直接捕获鼠标按下/释放/移动,转发到 GeckoBridge_DispatchMouseEvent。
+static void DispatchMouseEvent(OH_NativeXComponent* component, void* window) {
+    OH_NativeXComponent_MouseEvent mouseEvent;
+    int32_t ret = OH_NativeXComponent_GetMouseEvent(component, window, &mouseEvent);
+    if (ret != OH_NATIVEXCOMPONENT_RESULT_SUCCESS) {
+        OH_LOG_WARN(LOG_APP, "DispatchMouseEvent GetMouseEvent 失败 ret=%{public}d", ret);
+        return;
+    }
+    // 输入流畅性:MOVE(action=3)高频,不再 printf+fflush/OH_LOG;
+    //   PRESS(1)/RELEASE(2)低频,保留原 v56/v65 诊断。
+    if ((int)mouseEvent.action != 3) {
+        OH_LOG_INFO(LOG_APP, "DispatchMouseEvent C回调 action=%{public}d button=%{public}d pos=(%.1f,%.1f)",
+                    (int)mouseEvent.action, (int)mouseEvent.button, mouseEvent.x, mouseEvent.y);
+        printf("[MOUSE] DispatchMouseEvent C回调 action=%d button=%d pos=(%.1f,%.1f)\n",
+               (int)mouseEvent.action, (int)mouseEvent.button, mouseEvent.x, mouseEvent.y);
+        fflush(stdout);
+    }
+
+    // OH_NativeXComponent_MouseEventAction 枚举:
+    //   0=NONE, 1=PRESS, 2=RELEASE, 3=MOVE, 4=CANCEL
+    // GeckoBridge_DispatchMouseEvent action (OHOS MouseAction):
+    //   1=PRESS, 2=RELEASE, 3=MOVE, 4=HOVER
+    // C 原生 MouseEvent 的 action 与 OHOS MouseAction 数值一致(PRESS=1,RELEASE=2,MOVE=3)
+    int32_t action = static_cast<int32_t>(mouseEvent.action);
+    if (action < 1 || action > 3) {
+        return;  // 跳过 NONE(0) 和 CANCEL(4),HOVER 由 DispatchHoverEvent 处理
+    }
+
+    // OH_NativeXComponent_MouseEventButton → Gecko MouseButton 编号:
+    //   GeckoBridge_DispatchMouseEvent button: 0=ePrimary(左),1=eMiddle(中),2=eSecondary(右)
+    int32_t button = 0;  // 默认左键
+    switch (mouseEvent.button) {
+        case OH_NATIVEXCOMPONENT_LEFT_BUTTON:   button = 0; break;  // 左 → ePrimary
+        case OH_NATIVEXCOMPONENT_MIDDLE_BUTTON: button = 1; break;  // 中 → eMiddle
+        case OH_NATIVEXCOMPONENT_RIGHT_BUTTON:  button = 2; break;  // 右 → eSecondary
+        default: button = 0; break;
+    }
+
+    // mouseEvent.x/y 是相对元素左上角的坐标(物理 px,与 Gecko 设备 px 一致,
+    // 因为 GetDefaultScaleInternal=1.0)。直接转发,无需 vp2px 转换。
+    // 输入流畅性:MOVE(action=3)跳过同步文件日志。
+    if (action != 3) {
+        printf("[MOUSE] DispatchMouseEvent → GeckoBridge_DispatchMouseEvent action=%d x=%.1f y=%.1f btn=%d\n",
+               action, mouseEvent.x, mouseEvent.y, button);
+        fflush(stdout);
+    }
+    GeckoBridge_DispatchMouseEvent(action, mouseEvent.x, mouseEvent.y, button,
+                                   mouseEvent.timestamp);
+}
+
+// 悬停事件回调:鼠标进入/离开 XComponent 区域
+// OHOS MouseAction HOVER(4) 对应 Gecko eMouseMove,这里把 isHover=true 转为
+// 一次 MOVE 让 Gecko 更新光标位置(isHover=false 时不转发,避免冗余)
+static void DispatchHoverEvent(OH_NativeXComponent* component, bool isHover) {
+    if (!isHover) {
+        return;  // 鼠标离开区域,不转发
+    }
+    // 悬停时不带坐标(XComponent Hover 回调无坐标),用上次已知位置即可。
+    // GeckoBridge_DispatchMouseEvent 的 HOVER(4) 会转为 eMouseMove。
+    // 这里简化处理:不单独转发 hover,实际 hover 由 DispatchMouseEvent 的 MOVE 覆盖。
+}
+
+// 物理键盘事件分发回调(C 原生层,与触摸/鼠标同路径)
+//
+// 根因:OH_NativeXComponent 的 XComponent 回调注册此前只有 touch+mouse,
+// 从未调用 OH_NativeXComponent_RegisterKeyEventCallback,导致物理键盘事件
+// 在 native 层被吞掉,chrome 的 mainKeyset(Ctrl+T/W/L/F5/Alt+← 等)无法触发。
+// 本回调在 C 原生层捕获键盘 down/up,转发到 GeckoBridge_DispatchKeyEvent
+// (libxul.so 内,通过 NS_DispatchToMainThread 转入 Gecko 主线程的
+//  nsWindow::OnKeyEvent),与触摸/鼠标同款跨线程模式。
+//
+// 注意:OHOS 的 OH_NativeXComponent_KeyAction 只有 DOWN(0)/UP(1),无 CANCEL。
+//       窗口失焦导致的键丢失由 nsWindow::OnKeyEvent 的修饰键清零兜底。
+static void DispatchKeyEvent(OH_NativeXComponent* component, void* window) {
+    OH_NativeXComponent_KeyEvent* keyEvent = nullptr;
+    int32_t ret = OH_NativeXComponent_GetKeyEvent(component, &keyEvent);
+    if (ret != OH_NATIVEXCOMPONENT_RESULT_SUCCESS || !keyEvent) {
+        OH_LOG_WARN(LOG_APP, "DispatchKeyEvent GetKeyEvent 失败 ret=%{public}d", ret);
+        return;
+    }
+
+    OH_NativeXComponent_KeyAction action = OH_NATIVEXCOMPONENT_KEY_ACTION_UNKNOWN;
+    OH_NativeXComponent_KeyCode code = KEY_UNKNOWN;
+    int64_t deviceId = 0;
+    int64_t timestamp = 0;
+    OH_NativeXComponent_GetKeyEventAction(keyEvent, &action);
+    OH_NativeXComponent_GetKeyEventCode(keyEvent, &code);
+    OH_NativeXComponent_GetKeyEventDeviceId(keyEvent, &deviceId);
+    OH_NativeXComponent_GetKeyEventTimestamp(keyEvent, &timestamp);
+
+    // 修饰键状态:OH_NativeXComponent_GetKeyEventModifierKeyStates 自 API 20 起可用。
+    // 目标 SDK 23,可用。返回位掩码:CTRL=1,SHIFT=2,ALT=4,FN=8
+    // (见 arkui/ui_input_event.h ArkUI_ModifierKeyName)。
+    // nsWindow::OnKeyEvent 同时内部维护修饰键 down/up 跟踪作为兜底
+    // (避免某些设备/旧版本不填充此字段导致 Ctrl+T 的 Ctrl 丢失)。
+    uint64_t modKeys = 0;
+    OH_NativeXComponent_GetKeyEventModifierKeyStates(keyEvent, &modKeys);
+
+    // 输入流畅性:普通键避免每键同步文件日志(printf+fflush 写 gecko_xre_diag.txt),
+    //   保留 hilog(OH_LOG_INFO)与异常(OH_LOG_WARN)供键盘诊断。
+    OH_LOG_INFO(LOG_APP, "DispatchKeyEvent C回调 action=%{public}d code=%{public}d dev=%{public}lld mods=%{public}llu",
+                (int)action, (int)code, (long long)deviceId, (unsigned long long)modKeys);
+
+    GeckoBridge_DispatchKeyEvent(static_cast<int32_t>(action),
+                                 static_cast<int32_t>(code), deviceId,
+                                 timestamp, static_cast<uint32_t>(modKeys));
+}
