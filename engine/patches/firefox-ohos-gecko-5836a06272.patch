+    const char* envNsprLog = getenv("NSPR_LOG_FILE");
+    OH_LOG_INFO(LOG_APP, "环境变量验证: MOZ_LOG=%{public}s, MOZ_LOG_FILE=%{public}s, NSPR_LOG_FILE=%{public}s",
+                envMozLog ? envMozLog : "(null)",
+                envMozLogFile ? envMozLogFile : "(null)",
+                envNsprLog ? envNsprLog : "(null)");
+    WriteLogFile("[STEP6.1] 环境变量: MOZ_LOG=%s, MOZ_LOG_FILE=%s, NSPR_LOG_FILE=%s",
+                 envMozLog ? envMozLog : "(null)",
