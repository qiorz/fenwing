+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 2 -*- */
+/* vim: set sw=2 ts=4 expandtab:
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "nsUserIdleServiceOHOS.h"
+
+#include "nsComponentManagerUtils.h"
+
+namespace mozilla::widget {
+
+bool nsUserIdleServiceOHOS::PollIdleTime(uint32_t* aIdleTime) {
+  // OHOS 无桌面屏保类系统级 idle 查询(对比 GTK 的 XScreenSaver/DBus
+  // Mutter IdleMonitor)。返回 false 走基类回退:
+  // GetIdleTime → time since mLastUserInteraction(NoteUserInput 喂)。
+  return false;
+}
+
+void nsUserIdleServiceOHOS::NoteUserInput() {
+  nsCOMPtr<nsIUserIdleServiceInternal> idleService =
+      do_GetService("@mozilla.org/widget/useridleservice;1");
+  if (!idleService) {
+    return;
+  }
+  idleService->ResetIdleTimeOut(0);
+}
+
+}  // namespace mozilla::widget
diff --git a/widget/openharmony/nsUserIdleServiceOHOS.h b/widget/openharmony/nsUserIdleServiceOHOS.h
