+
+/**
+ * AAC audio decoding (MP4/H.264+AAC playback support).
+ *
+ * The AAC decoder (FFmpeg 7.x aac/ subdirectory) plus its PS/SBR support
+ * pulls in code guarded by these component switches in the upstream Makefile:
+ *   OBJS-$(CONFIG_AAC_DECODER) += aactab.o aacsbr.o aacps_common.o aacps_float.o
+ *                                 kbdwin.o sbrdsp.o aacpsdsp_float.o cbrt_data.o
+ *   OBJS-$(CONFIG_SINEWIN)     += sinewin.o
+ *   OBJS-$(CONFIG_ADTS_HEADER) += adts_header.o mpeg4audio_sample_rates.o
+ *   OBJS-$(CONFIG_MPEG4AUDIO)  += mpeg4audio.o mpeg4audio_sample_rates.o
+ *
+ * config_unix_aarch64.h (an audio-only config base) leaves these at 0, so we
+ * force them on here. The actual file list is driven by moz.build, but these
+ * defines keep any #if CONFIG_... guards inside the vendored sources correct.
+ **/
+#if !defined(MOZ_FFVPX_AUDIOONLY) && defined(__aarch64__)
+  #undef CONFIG_SINEWIN
+  #undef CONFIG_KBDWIN
+  #undef CONFIG_SBRDSP
+  #undef CONFIG_ADTS_HEADER
