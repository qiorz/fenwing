+// ============================================================================
+// 桌面版/移动版切换 Runnable
+// ============================================================================
+// 切换 general.useragent.override pref 在桌面 UA 与移动 UA 之间,
+// 然后 reload 当前页面使新 UA 生效。
+// v93 根因修复:移动版不能再设为空字符串。之前设为空串后,
+// nsHttpHandler::PrefsChanged 读取空串到 mUserAgentOverride(非 void),
+// UserAgent() 返回空字符串,导致 B站等网站判定不支持 HTML5 播放器。
+// 现改为移动版使用有效的移动 Firefox UA。
+// v100:桌面/移动 UA 改为 Chrome 串(与 nsHttpHandler.cpp + geckoview-prefs.js 一致),
+//   B站等站点对非 Chrome UA 的 HTML5 播放器能力检测不友好。
+class OHOSToggleDesktopModeRunnable : public mozilla::Runnable {
+ public:
+  OHOSToggleDesktopModeRunnable(bool aEnableDesktop)
+      : mozilla::Runnable("OHOSToggleDesktopModeRunnable"),
+        mEnableDesktop(aEnableDesktop) {}
+
+  NS_IMETHOD Run() override {
+    // v134: 桌面/移动 UA 改回标准 Firefox 串(与 nsHttpHandler.cpp __OHOS__
+    // 分支 + geckoview-prefs.js 一致),不再伪装 Chrome。
+    // MOZILLA_UAVERSION 由构建系统全局定义(142.0),版本升级自动跟随。
+    static const char kDesktopUA[] =
+        "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:" MOZILLA_UAVERSION
+        ") Gecko/20100101 Firefox/" MOZILLA_UAVERSION;
+    // 移动版用标准 Firefox Android UA 格式
+    static const char kMobileUA[] =
+        "Mozilla/5.0 (Android 14; Mobile; rv:" MOZILLA_UAVERSION
+        ") Gecko/" MOZILLA_UAVERSION " Firefox/" MOZILLA_UAVERSION;
+    if (mEnableDesktop) {
+      // Preferences::SetCString 是 static 方法,接受 const char* 直接赋值
+      // 等价于旧 API SetCharPref,但更符合新版 Preferences 接口规范
+      mozilla::Preferences::SetCString("general.useragent.override", kDesktopUA);
+    } else {
+      mozilla::Preferences::SetCString("general.useragent.override", kMobileUA);
+    }
+    OHOS_LOG("[XRE] OHOSToggleDesktopMode: %s\n",
+            mEnableDesktop ? "桌面版" : "移动版");
+    // 切换后重新加载,使新 UA 生效
+    nsCOMPtr<nsIWebNavigation> webNav = GetContentWebNavigation();
+    if (webNav) {
+      webNav->Reload(nsIWebNavigation::LOAD_FLAGS_NONE);
+    }
+    return NS_OK;
+  }
+
+ private:
+  bool mEnableDesktop;
+};
