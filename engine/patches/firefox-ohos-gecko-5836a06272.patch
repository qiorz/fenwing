+
+void gfxOHosPlatform::InitAcceleration() {
+  gfxPlatform::InitAcceleration();
+  // OpenHarmony 总是使用 EGL 作为 GL context provider(与 Android 一致)。
+  // RenderCompositorEGL::Create() 在 kIsOHOS 分支会检查 gfxVars::UseEGL(),
+  // 若不设置则直接返回 nullptr,导致渲染管线回退到 RenderCompositorOGL
+  // (后者不管理 EGLSurface 生命周期,渲染空白)。因此在父进程初始化时
+  // 显式启用 UseEGL。
+  if (XRE_IsParentProcess()) {
+    gfxVars::SetUseEGL(true);
+  }
+}
