+// ============================================================================
+// v240: 通用 Pref 读取桥(GeckoBridge_GetPref) — ArkTS 设置页回显
+// ============================================================================
+// 与 GeckoBridge_Set* 对称的读通道(设置页开关需要读回当前 pref 真值)。
+// 写走异步派发;读需要返回值,采用 GeckoBridge_GetSessionHistory 同款
+// mutex + condition_variable 同步等待模式(2s 超时防死锁;已在主线程时
+// fast-path 直查)。aKind: 0=bool 1=int 2=char;值以 ASCII/UTF-8 写入
+// aOutBuf(bool 写 "0"/"1",int 写十进制,char 写原值截断)。
+// pref 未设置时按类型默认值返回(bool 0/int 0/char 空串)且算成功——
+// 上层与注入默认一致,无需区分"未设置"。
+#include <mutex>
+#include <condition_variable>
+
+struct OHOSPrefQueryContext {
+  std::mutex mtx;
+  std::condition_variable cv;
+  bool done = false;
+  // v243: 调用方超时放弃所有权标志(mtx 保护)。置位后 ctx 生命周期归
+  // runnable(其 Run 锁内发现即 delete);消除原栈 ctx 超时销毁后 runnable
+  // 迟到执行的 UAF 窗口(主线程卡 >2s 在无 JIT 手机重页可及)。
+  bool abandoned = false;
+  int kind = 0;
+  nsCString name;
+  bool boolVal = false;
+  int32_t intVal = 0;
+  nsCString charVal;
+};
+
+class OHOSGetPrefRunnable : public mozilla::Runnable {
+ public:
+  explicit OHOSGetPrefRunnable(OHOSPrefQueryContext* aCtx)
+      : mozilla::Runnable("OHOSGetPrefRunnable"), mCtx(aCtx) {}
+
+  NS_IMETHOD Run() override {
+    switch (mCtx->kind) {
+      case 0:
+        mCtx->boolVal = mozilla::Preferences::GetBool(mCtx->name.get(), false);
+        break;
+      case 1:
+        mCtx->intVal = mozilla::Preferences::GetInt(mCtx->name.get(), 0);
+        break;
+      case 2:
+        mozilla::Preferences::GetCString(mCtx->name.get(), mCtx->charVal);
+        break;
+      default:
+        break;
+    }
+    // v243: 锁内裁决所有权 —— abandoned(调用方已超时放弃)则本 runnable
+    // 负责 delete(查询结果无人消费,丢弃);否则 done=true 交调用方消费,
+    // 所有权在调用方(其 delete)。两态互斥无泄漏无 UAF。
+    bool orphaned = false;
+    {
+      std::lock_guard<std::mutex> lock(mCtx->mtx);
+      orphaned = mCtx->abandoned;
+      if (!orphaned) {
+        mCtx->done = true;
+        mCtx->cv.notify_one();
+      }
+    }
+    if (orphaned) {
+      delete mCtx;
+    }
+    return NS_OK;
+  }
+
+ private:
+  OHOSPrefQueryContext* mCtx;
+};
+
+__attribute__((visibility("default")))
+extern "C" int GeckoBridge_GetPref(const char* aName, int aKind, char* aOutBuf,
+                                   int aBufLen) {
+  if (!aName || !aOutBuf || aBufLen <= 0) {
+    return 0;
+  }
+  // v243: ctx 堆分配(超时路径所有权移交 runnable,见 OHOSPrefQueryContext)
+  auto* ctx = new OHOSPrefQueryContext();
+  ctx->name.Assign(aName);
+  ctx->kind = aKind;
+  if (NS_IsMainThread()) {
+    // 主线程 fast-path:直查免派发死锁(GetSessionHistory v104 同款)
+    OHOSGetPrefRunnable runnable(ctx);
+    runnable.Run();
+  } else {
+    nsresult rv = NS_DispatchToMainThread(
+        mozilla::MakeAndAddRef<OHOSGetPrefRunnable>(ctx));
+    if (NS_FAILED(rv)) {
+      OHOS_LOG("[XRE] GeckoBridge_GetPref 派发失败 rv=0x%x\n",
+              (unsigned)rv);
+      delete ctx;
+      return 0;
+    }
+    std::unique_lock<std::mutex> lock(ctx->mtx);
+    const bool ok =
+        ctx->cv.wait_for(lock, std::chrono::seconds(2),
+                         [ctx]() { return ctx->done; });
+    if (!ok) {
+      // v243: 超时放弃所有权 —— 锁内置 abandoned(runnable 迟到时锁内
+      // 裁决 delete),本线程不再触碰 ctx。
+      ctx->abandoned = true;
+      lock.unlock();
+      OHOS_LOG("[XRE] GeckoBridge_GetPref 超时 2s pref=%s (所有权移交 runnable)\n",
+              aName);
+      return 0;
+    }
+    lock.unlock();
+  }
+  if (aKind == 0) {
+    snprintf(aOutBuf, aBufLen, "%d", ctx->boolVal ? 1 : 0);
+  } else if (aKind == 1) {
+    snprintf(aOutBuf, aBufLen, "%d", ctx->intVal);
+  } else if (aKind == 2) {
+    snprintf(aOutBuf, aBufLen, "%s", ctx->charVal.get());
+  } else {
+    delete ctx;
+    return 0;
+  }
+  OHOS_LOG("[XRE] GeckoBridge_GetPref %s(kind %d) = %s\n", aName, aKind,
+          aOutBuf);
+  delete ctx;
+  return 1;
+}
+
+// ============================================================================
+// v241: 历史查询桥(GeckoBridge_QueryHistory) — ArkTS 地址框本地建议
+// ============================================================================
+// 地址框 ArkTS 化(v241)的本地建议源:nsINavHistoryService.ExecuteQuery,
+// searchTerms + frecency 降序 + MaxResults(上限 16)。同步等待模式与
+// GetPref 同款(mutex+cv 2s 超时+主线程 fast-path)。输出 JSON 数组
+// [{"u":"url","t":"title"},...] 写入 aOutBuf;空结果输出 []。
+#include "nsINavHistoryService.h"
+
+struct OHOSHistoryQueryContext {
+  std::mutex mtx;
+  std::condition_variable cv;
+  bool done = false;
+  // v243: 超时放弃所有权标志(mtx 保护),协议同 OHOSPrefQueryContext。
+  bool abandoned = false;
+  nsCString term;
+  int limit = 8;
+  nsCString json;
+};
+
+class OHOSQueryHistoryRunnable : public mozilla::Runnable {
+ public:
+  explicit OHOSQueryHistoryRunnable(OHOSHistoryQueryContext* aCtx)
+      : mozilla::Runnable("OHOSQueryHistoryRunnable"), mCtx(aCtx) {}
+
+  NS_IMETHOD Run() override {
+    mCtx->json.Assign("[]");
+    nsCOMPtr<nsINavHistoryService> history =
+        do_GetService("@mozilla.org/browser/nav-history-service;1");
+    if (history) {
+      nsCOMPtr<nsINavHistoryQuery> query;
+      nsCOMPtr<nsINavHistoryQueryOptions> options;
+      nsCOMPtr<nsINavHistoryResult> result;
+      if (NS_SUCCEEDED(history->GetNewQuery(getter_AddRefs(query))) &&
+          NS_SUCCEEDED(history->GetNewQueryOptions(getter_AddRefs(options))) &&
+          query && options) {
+        query->SetSearchTerms(NS_ConvertUTF8toUTF16(mCtx->term));
+        options->SetSortingMode(
+            nsINavHistoryQueryOptions::SORT_BY_FRECENCY_DESCENDING);
+        options->SetMaxResults(
+            mCtx->limit > 0 && mCtx->limit <= 16
+                ? (uint32_t)mCtx->limit
+                : (uint32_t)8);
+        options->SetQueryType(nsINavHistoryQueryOptions::QUERY_TYPE_HISTORY);
+        if (NS_SUCCEEDED(history->ExecuteQuery(query, options,
+                                               getter_AddRefs(result))) &&
+            result) {
+          nsCOMPtr<nsINavHistoryContainerResultNode> root;
+          result->GetRoot(getter_AddRefs(root));
+          if (root) {
+            root->SetContainerOpen(true);
+            uint32_t count = 0;
+            root->GetChildCount(&count);
+            nsCString out("[");
+            uint32_t emitted = 0;
+            for (uint32_t i = 0; i < count && emitted < 16; i++) {
+              nsCOMPtr<nsINavHistoryResultNode> node;
+              if (NS_FAILED(root->GetChild(i, getter_AddRefs(node))) || !node) {
+                continue;
+              }
+              nsAutoCString uri;
+              nsAutoCString title;
+              node->GetUri(uri);
+              node->GetTitle(title);
+              if (uri.IsEmpty()) {
+                continue;
+              }
+              // JSON 转义(引号/反斜杠/控制字符)
+              nsAutoCString escUri, escTitle;
+              for (uint32_t j = 0; j < uri.Length(); j++) {
+                char c = uri.CharAt(j);
+                if (c == '"' || c == '\\') {
+                  escUri.Append('\\');
+                  escUri.Append(c);
+                } else if ((unsigned char)c < 0x20) {
+                  escUri.AppendPrintf("\\u%04x", (unsigned)c);
+                } else {
+                  escUri.Append(c);
+                }
+              }
+              for (uint32_t j = 0; j < title.Length(); j++) {
+                char c = title.CharAt(j);
+                if (c == '"' || c == '\\') {
+                  escTitle.Append('\\');
+                  escTitle.Append(c);
+                } else if ((unsigned char)c < 0x20) {
+                  escTitle.AppendPrintf("\\u%04x", (unsigned)c);
+                } else {
+                  escTitle.Append(c);
+                }
+              }
+              if (emitted > 0) {
+                out.Append(",");
+              }
+              out.AppendPrintf("{\"u\":\"%s\",\"t\":\"%s\"}", escUri.get(),
+                               escTitle.get());
+              emitted++;
+            }
+            out.Append("]");
+            root->SetContainerOpen(false);
+            mCtx->json = out;
+          }
+        }
+      }
+    } else {
+      OHOS_LOG("[XRE] GeckoBridge_QueryHistory: service 不可用\n");
+    }
+    // v243: 锁内裁决所有权(协议同 OHOSGetPrefRunnable)。
+    bool orphaned = false;
+    {
+      std::lock_guard<std::mutex> lock(mCtx->mtx);
+      orphaned = mCtx->abandoned;
+      if (!orphaned) {
+        mCtx->done = true;
+        mCtx->cv.notify_one();
+      }
+    }
+    if (orphaned) {
+      delete mCtx;
+    }
+    return NS_OK;
+  }
+
+ private:
+  OHOSHistoryQueryContext* mCtx;
+};
+
+__attribute__((visibility("default")))
+extern "C" int GeckoBridge_QueryHistory(const char* aTerm, int aLimit,
+                                        char* aOutBuf, int aBufLen) {
+  if (!aTerm || !aOutBuf || aBufLen <= 0) {
+    return 0;
+  }
+  // v243: ctx 堆分配(超时路径所有权移交 runnable,协议同 GeckoBridge_GetPref)
+  auto* ctx = new OHOSHistoryQueryContext();
+  ctx->term.Assign(aTerm);
+  ctx->limit = aLimit;
+  if (NS_IsMainThread()) {
+    OHOSQueryHistoryRunnable runnable(ctx);
+    runnable.Run();
+  } else {
+    nsresult rv = NS_DispatchToMainThread(
+        mozilla::MakeAndAddRef<OHOSQueryHistoryRunnable>(ctx));
+    if (NS_FAILED(rv)) {
+      OHOS_LOG("[XRE] GeckoBridge_QueryHistory 派发失败 rv=0x%x\n",
+              (unsigned)rv);
+      delete ctx;
+      return 0;
+    }
+    std::unique_lock<std::mutex> lock(ctx->mtx);
+    const bool ok =
+        ctx->cv.wait_for(lock, std::chrono::seconds(2),
+                         [ctx]() { return ctx->done; });
+    if (!ok) {
+      ctx->abandoned = true;
+      lock.unlock();
+      OHOS_LOG("[XRE] GeckoBridge_QueryHistory 超时 2s (所有权移交 runnable)\n");
+      return 0;
+    }
+    lock.unlock();
+  }
+  snprintf(aOutBuf, aBufLen, "%s", ctx->json.get());
+  delete ctx;
+  return 1;
+}
