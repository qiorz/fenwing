+// IME 桥接(v57:文本框输入支持)
+// ============================================================================
+// 设计原理(同 gOHOSNativeWindow 跨 .so 副本同步):
+//   libgeckoview.so 与 libgeckoxcomp.so 是 geckoview.cpp 的两个内存副本,
+//   geckoview.cpp 在 libgeckoxcomp.so 副本中调用 GeckoBridge_SetIMECallbacks
+//   注册 Show/Hide 函数指针。若函数指针放在 geckoview.cpp 中,libxul.so 内部
+//   的 GeckoBridge_NotifyIMEState 无法访问到副本中的指针(各副本独立)。
+//   因此把 show/hide 函数指针放在 libxul.so 内(单实例),通过 GeckoBridge_SetIMECallbacks
+//   注册到 libxul.so,GeckoBridge_NotifyIMEState 直接调用本 .so 内的函数指针。
+
+// IME Show/Hide 函数指针类型(与 geckoview.cpp 中一致)
+typedef void (*OHOS_ShowKeyboardFunc)();
+typedef void (*OHOS_HideKeyboardFunc)();
+
+// IME Show/Hide 函数指针(由 geckoview.cpp 通过 GeckoBridge_SetIMECallbacks 注册)
+// 必须在 libxul.so 内单实例,确保 GeckoBridge_NotifyIMEState 能调用到注册方
+static OHOS_ShowKeyboardFunc gShowKeyboardFunc = nullptr;
+static OHOS_HideKeyboardFunc gHideKeyboardFunc = nullptr;
+
+// IME 文本插入 Runnable:在 Gecko 主线程上调用 nsWindow::OnInsertText
+// aText 为堆分配的 char16_t 缓冲,Run() 中 delete[] 释放
+class OHOSInsertTextRunnable : public mozilla::Runnable {
+ public:
+  OHOSInsertTextRunnable(nsWindow* aWin, char16_t* aText, size_t aLength)
+      : mozilla::Runnable("OHOSInsertTextRunnable"),
+        mWin(aWin), mText(aText), mLength(aLength) {}
+
+  NS_IMETHOD Run() override {
+    if (mWin && mText) {
+      mWin->OnInsertText(mText, mLength);
+    }
+    delete[] mText;  // 释放 geckoview.cpp OHOS_OnInsertText 中 new 的缓冲
+    return NS_OK;
+  }
+
+ private:
+  RefPtr<nsWindow> mWin;
+  char16_t* mText;
+  size_t mLength;
+};
