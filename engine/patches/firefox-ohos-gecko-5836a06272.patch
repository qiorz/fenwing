+// v226(审计C1): 热路径诊断日志采样助手。每帧无节流的 OHOS_DiagLog 调用点
+// ([WR_TH]/[EGL_MC]/[WRBP]/[PS] DoReflow/[XRE] GetWindowRenderer 等 ~10 处,
+// 120Hz 下 ≈1000 行/s 写盘+跨线程互斥锁互等)统一改采样输出:每 tag 独立
+// 计数,前 aFirstN 条全打,之后每 aEveryM 条打 1 条。
+// 用法: if (OHOS_DiagLogSampleHit("tag", 20, 200)) OHOS_DiagLog(...);
+// 计数表无锁(定长线性探测,tag 为静态字符串指针键;竞态最多导致采样略偏,
+// 诊断可接受)。libxul 内部符号。
+extern "C" bool OHOS_DiagLogSampleHit(const char* aTag, uint32_t aFirstN,
+                                      uint32_t aEveryM) {
+  struct Slot {
+    const char* tag;
+    uint32_t count;
+  };
+  static Slot slots[24];
+  Slot* freeSlot = nullptr;
+  for (Slot& s : slots) {
+    if (s.tag == aTag) {
+      const uint32_t n = ++s.count;
+      return n <= aFirstN || (n % aEveryM) == 0;
+    }
+    if (!s.tag && !freeSlot) {
+      freeSlot = &s;
+    }
+  }
+  if (freeSlot) {
+    freeSlot->tag = aTag;
+    freeSlot->count = 1;
+    return true;
+  }
+  return false;
+}
