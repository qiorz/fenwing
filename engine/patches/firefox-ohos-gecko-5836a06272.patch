+/* -*- Mode: C++; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// v118: 文件选择器跨 .so 桥(libxul.so ↔ libgeckoview.so ↔ ArkTS)
+//
+// 范式完全照抄 OHOSProgressListener.cpp / OHOSNativeWindowBridge.cpp 的
+// "函数指针注册 + tsfn" 模型:
+//   1. libgeckoview.so 启动时调 GeckoBridge_SetFilePickerCallback,把本 .so 内的
+//      OHOS_FilePickerRequestNotify 等价物(实为 geckoview.cpp 中的 C 函数)注册进来。
+//   2. libxul.so 内 OHOSFilePicker::Open 调 OHOSFilePickerBridge_Request,经存储的
+//      函数指针转发到 libgeckoview.so → napi_threadsafe_function → ArkTS。
+//   3. ArkTS 选完文件调 resolveFilePicker NAPI → GeckoBridge_ResolveFilePicker
+//      → NS_DispatchToMainThread runnable → OHOSFilePicker::OnPicked。
+//
+// resolveFilePicker / GeckoBridge_ResolveFilePicker 的 path 字段语义(P1 起):
+//   - single(modeOpen)/folder(modeGetFolder):path 为裸路径字符串。
+//   - multiple(modeOpenMultiple):path 为 JSON 数组字符串,形如
+//     ["/cache/picked_a","/cache/picked_b"](由 ArkTS 侧拼装)。
+//   NAPI 签名不变(C 侧 aPathUtf8 仍是 const char*),仅由
+//   OHOSFilePicker::OnPickedInternal 按 picker 实例的 mMode 解释内容。
+
+#ifndef widget_openharmony_OHOSFilePickerBridge_h__
+#define widget_openharmony_OHOSFilePickerBridge_h__
+
+namespace mozilla {
+namespace widget {
+
+// 由 libxul.so 内部(OHOSFilePicker::Open)调用:下发请求 JSON。
+// 内部经 gFilePickerRequestCb 转发到 libgeckoview.so。
+// 未注册时记日志并直接 OHOSFilePicker::OnPicked(id, cancel) 防悬挂。
+void OHOSFilePickerBridge_Request(const char* aJson, int32_t aCallbackId);
+
+}  // namespace widget
+}  // namespace mozilla
+
+#endif  // widget_openharmony_OHOSFilePickerBridge_h__
diff --git a/widget/openharmony/OHOSForceRepaint.cpp b/widget/openharmony/OHOSForceRepaint.cpp
new file mode 100644
index 0000000000..bdf5d7e6bb
--- /dev/null
+++ b/widget/openharmony/OHOSForceRepaint.cpp
@@ -0,0 +1,224 @@
+/* -*- Mode: C++; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// OHOS 强制重绘桥接(v100: 标签切换 bfcache 秒切)
+//
+// 背景:
+//   OHOS 单 EGL Surface 架构下,GLContextProviderEGL 的
+//   OHOS_GetNativeWindow() 返回进程级全局单例(gOHOSNativeWindow),
+//   整个进程只有一个渲染目标。v88/v98 的多 browser session 架构
+//   (docShellIsActive 切换)在此约束下不可行(v99 已证回归)。
+//
+//   v90 的 goToIndex bfcache 恢复本身是工作的(StateUpdated +
+//   formdata 恢复),但恢复后没有触发 WebRender 重新合成 ——
+//   v92 注释明确写道"bfcache 恢复只更新 docShell 状态,未触发
+//   WebRender 重新渲染"。缺失的就是一次 SchedulePaint()。
+//
+// 修复:
+//   GeckoBridge_ForceRepaint 在 Gecko 主线程对 content PresShell
+//   执行一次 SetIsActive(false) → SetIsActive(true) toggle。
+//   SetIsActive(true) 内部(PresShell.cpp:12156-12208)会调用
+//   rootFrame->SchedulePaint(),强制 WebRender 重建 display list
+//   并重新合成,把 bfcache 恢复后的 docShell 状态画到唯一的
+//   EGL Surface 上。
+//
+//   用 toggle 而非直接 SchedulePaint():toggle 能绕过 mPaintingSuppressed
+//   /mIsNeverPainting 等短路条件(SetIsActive 路径独立判定),更可靠。
+
+#include <cstdio>
+
+#include "mozilla/PresShell.h"
+#include "mozilla/Unused.h"
+#include "nsCOMPtr.h"
+#include "nsDocShell.h"
+#include "nsIDocShell.h"
+#include "nsIDocShellTreeItem.h"
+// A5: stderr 日志门控
+#include "OHOSDebug.h"
+// v110: 双轨窗口查找(native=navigator:browser / classic=navigator:geckoview)
+#include "OHOSWindowFinder.h"
+#include "nsIWindowMediator.h"
+#include "nsPIDOMWindow.h"
+#include "nsServiceManagerUtils.h"
+#include "nsString.h"
+#include "nsThreadUtils.h"
+
+namespace {
+
+// 在 Gecko 主线程查找顶层 chrome 窗口的 content PresShell(v110: 双轨查找),
+// 对其执行 SetIsActive(false)→(true) toggle 强制重绘。
+// 返回 true 表示成功找到 PresShell 并触发 toggle。
+static bool ForceRepaintOnMainThread() {
+  nsCOMPtr<mozIDOMWindowProxy> recentWindow = OHOSFindChromeWindow();
+  if (!recentWindow) {
+    OHOS_LOG( "[XRE] GeckoBridge_ForceRepaint: 无 chrome 窗口\n");
+    return false;
+  }
+  nsCOMPtr<nsPIDOMWindowOuter> piWindow = do_QueryInterface(recentWindow);
+  if (!piWindow) {
+    return false;
+  }
+  nsCOMPtr<nsIDocShell> chromeDocShell = piWindow->GetDocShell();
+  if (!chromeDocShell) {
+    return false;
+  }
+  nsCOMPtr<nsIDocShellTreeItem> chromeTreeItem = chromeDocShell;
+  if (!chromeTreeItem) {
+    return false;
+  }
+
+  // 遍历 chrome docShell 的子项,优先选择 active 且有 root frame 的 content
+  // PresShell(v152 问题5)。OHOS 单 EGL Surface 架构下只有 active 的
+  // docShell 会合成可见帧;取首个 content 子项可能是后台/bfcache 标签
+  // (IsActive()==false),对其 SchedulePaint 不会产生可见帧。
+  // 故遍历全部 content 子项,记录每个 child index/active/rootFrame,
+  // 选中第一个 active+rootFrame 的;找不到则安全失败(返回 false)。
+  mozilla::PresShell* contentPresShell = nullptr;
+  int32_t selectedChildIndex = -1;
+  int32_t contentChildCount = 0;
+  int32_t childCount = 0;
+  chromeTreeItem->GetInProcessChildCount(&childCount);
+  for (int32_t i = 0; i < childCount; ++i) {
+    nsCOMPtr<nsIDocShellTreeItem> child;
+    chromeTreeItem->GetInProcessChildAt(i, getter_AddRefs(child));
+    if (!child) {
+      continue;
+    }
+    int32_t itemType = 0;
+    child->GetItemType(&itemType);
+    if (itemType != nsIDocShellTreeItem::typeContent) {
+      continue;
+    }
+    ++contentChildCount;
+    nsCOMPtr<nsIDocShell> docShell = do_QueryInterface(child);
+    if (!docShell) {
+      continue;
+    }
+    mozilla::PresShell* presShell = docShell->GetPresShell();
+    if (!presShell) {
+      OHOS_LOG(
+          "[XRE] GeckoBridge_ForceRepaint: content child[%d] 无 PresShell\n",
+          i);
+      continue;
+    }
+    bool isActive = presShell->IsActive();
+    bool hasRoot = presShell->GetRootFrame() != nullptr;
+    OHOS_LOG(
+        "[XRE] GeckoBridge_ForceRepaint: content child[%d] PresShell=%p "
+        "active=%d rootFrame=%d\n",
+        i, (void*)presShell, (int)isActive, (int)hasRoot);
+    if (isActive && hasRoot) {
+      contentPresShell = presShell;
+      selectedChildIndex = i;
+      break;
+    }
+  }
+
+  if (!contentPresShell) {
+    OHOS_LOG(
+        "[XRE] GeckoBridge_ForceRepaint: 无 active+rootFrame 的 content "
+        "PresShell(contentChildren=%d totalChildren=%d)——安全失败不重绘\n",
+        (int)contentChildCount, (int)childCount);
+    return false;
+  }
+
+  // v100: 强制重绘。SetIsActive 是 private 的,改用 public 的 SchedulePaint()。
+  // SchedulePaint() → RefreshDriver()->SchedulePaint() → 完整的 WebRender
+  // display list 重建 + 合成,把 bfcache 恢复后的页面状态画到 EGL Surface。
+  // 选中态已保证 active+rootFrame,SchedulePaint() 必产生可见帧。
+  contentPresShell->SchedulePaint();
+  OHOS_LOG(
+      "[XRE] GeckoBridge_ForceRepaint: 选中 content child[%d] PresShell=%p "
+      "(active=%d) SchedulePaint 完成\n",
+      (int)selectedChildIndex, (void*)contentPresShell,
+      (int)contentPresShell->IsActive());
+  return true;
+}
+
+// 主线程 Runnable:执行 ForceRepaintOnMainThread
+class OHOSForceRepaintRunnable : public mozilla::Runnable {
+ public:
+  OHOSForceRepaintRunnable()
+      : mozilla::Runnable("OHOSForceRepaintRunnable") {}
+
+  NS_IMETHOD Run() override {
+    ForceRepaintOnMainThread();
+    return NS_OK;
+  }
+};
+
+// A2: 带完成回调的 Runnable — SchedulePaint 后调用 aCallback 通知 ArkTS 层。
+// 用于替代 ArkTS 层的 setTimeout(forceRepaint, 50) 竞态补丁。
+// cb 为 C 函数指针,由 geckoview.cpp 的 threadsafe_function 中转调用 ArkTS 回调。
+// 注:SchedulePaint() 同步入队 RefreshDriver 刷新,cb 在该入队之后立即触发,
+// ArkTS 回调到达时 WebRender 已安排下一帧合成,可安全做后续 UI 切换。
+class OHOSForceRepaintWithCallbackRunnable : public mozilla::Runnable {
+ public:
+  typedef void (*CompletionCallback)();
+
+  explicit OHOSForceRepaintWithCallbackRunnable(CompletionCallback aCb)
+      : mozilla::Runnable("OHOSForceRepaintWithCallbackRunnable"),
+        mCb(aCb) {}
+
+  NS_IMETHOD Run() override {
+    ForceRepaintOnMainThread();
+    if (mCb) {
+      mCb();
+    }
+    return NS_OK;
+  }
+
+ private:
+  CompletionCallback mCb;
+};
+
+}  // namespace
+
+// 由 libgeckoview.so / libgeckoxcomp.so 副本调用:强制重绘当前 content 页面。
+// 在 libxul.symbols 中导出,供 NAPI 桥接模块动态链接调用。
+// 用法:goToIndex(bfcache 恢复) 后立即调用,触发渲染层刷新。
+// v258d: 同时武装合成层全绘(OHOS_ArmFullRender)——SchedulePaint 只重建 DL,
+// 布局未变时零 damage 无法修复"画面冻结在中间态"(键盘白带渲染侧,见
+// OHOSNativeWindowBridge.cpp v258d 注释);force_redraw 用当前场景全屏重绘
+// 才能穿透。任意线程可调(原子),与主线程 Runnable 并行无害。
+extern "C" void OHOS_ArmFullRender();
+
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_ForceRepaint() {
+  OHOS_ArmFullRender();
+  OHOS_LOG( "[XRE] GeckoBridge_ForceRepaint 派发到主线程(+全绘武装)\n");
+  nsresult rv = NS_DispatchToMainThread(
+      mozilla::MakeAndAddRef<OHOSForceRepaintRunnable>());
+  if (NS_FAILED(rv)) {
+    OHOS_LOG( "[XRE] GeckoBridge_ForceRepaint 派发失败 rv=0x%x\n",
+            (unsigned)rv);
+  }
+}
+
+// v257d: libxul 内部补帧入口（RendererOGL paint-hold 释放后调用）。
+// 特意不加 visibility("default")、不进 libxul.symbols：lld symvers 链接下
+// 被 libxul 内部引用的版本化导出符号会从动态表剔除（真机构建实证：
+// GeckoBridge_ForceRepaint/WithCallback 一旦被 RendererOGL 引用即丢导出
+// → libgeckoview 链接 undefined）。默认 hidden 可见性下同 DSO 内正常解析，
+// 零导出面。
+void OHOS_RequestForceRepaint() { GeckoBridge_ForceRepaint(); }
+
+// A2: 带完成回调的强制重绘。
+// cb 由调用方(libgeckoview.so 的 NAPI 层)提供,在中转后调用 ArkTS threadsafe
+// function 通知 UI 切换完成。替代原 setTimeout(forceRepaint, 50) 竞态补丁。
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_ForceRepaintWithCallback(void (*cb)()) {
+  OHOS_LOG( "[XRE] GeckoBridge_ForceRepaintWithCallback 派发到主线程 cb=%p\n", (void*)cb);
+  nsresult rv = NS_DispatchToMainThread(
+      mozilla::MakeAndAddRef<OHOSForceRepaintWithCallbackRunnable>(cb));
+  if (NS_FAILED(rv)) {
+    OHOS_LOG( "[XRE] GeckoBridge_ForceRepaintWithCallback 派发失败 rv=0x%x\n",
+            (unsigned)rv);
+    // 派发失败仍回调(避免 ArkTS 层永久等待)
+    if (cb) {
+      cb();
+    }
+  }
+}
