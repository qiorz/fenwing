+    top: 0;
+    bottom: 0;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    background-size: 32px 32px;
+    background-position: center;
+    background-repeat: no-repeat;
+  }
+  .phone-tab-row {
+    display: flex;
+    align-items: center;
+    height: 36px;
+    padding: 0 4px 0 10px;
+    gap: 6px;
+  }
+  .phone-tab-favicon {
+    width: 16px;
+    height: 16px;
+    flex: none;
+    object-fit: contain;
+  }
+  .phone-tab-title {
+    flex: 1;
+    min-width: 0;
+    font-size: 13px;
+    color: var(--phone-text-primary);
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+  }
+  .phone-tab-close {
+    appearance: none;
+    border: none;
+    outline: none;
+    width: 44px;
+    height: 44px;
+    margin: -4px 0;
+    border-radius: 22px;
+    background: transparent;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+  }
+  .phone-tab-close:active {
+    background: var(--phone-pressed-overlay);
+  }
+  .phone-tab-close::after {
+    content: "";
+    width: 14px;
+    height: 14px;
+    mask-image: url("chrome://global/skin/icons/close.svg");
+    mask-repeat: no-repeat;
+    mask-position: center;
+    mask-size: 14px 14px;
+    background-color: var(--phone-text-secondary);
+  }
+
+  /* ---- 轻提示 #phone-toast ---- */
+  #phone-toast {
+    display: block;
+    position: fixed;
+    left: 50%;
+    bottom: calc(68px + var(--phone-bottom-inset) + 12px);
+    transform: translate(-50%, 8px);
+    max-width: 80%;
+    padding: 10px 16px;
+    box-sizing: border-box;
+    border-radius: 8px;
+    background: #323235;
+    color: #fbfbfe;
+    font-size: 13px;
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    opacity: 0;
+    visibility: hidden;
+    pointer-events: none;
+    z-index: 300;
+    transition: opacity 180ms ease-out, transform 180ms ease-out, visibility 180ms;
+  }
+  #phone-toast[shown] {
+    opacity: 1;
+    visibility: visible;
+    transform: translate(-50%, 0);
+  }
+
+  /* ---- 长按会话历史面板(锚定底栏按钮,XUL panel 样式手机化) ---- */
+  #backForwardMenu {
+    min-width: 0 !important;
+  }
+  #backForwardMenu menuitem {
+    min-height: 44px !important;
+    font-size: 14px !important;
+  }
+
+  /* ---- 内容区长按上下文菜单手机化(行高 44,贴触摸点) ---- */
+  #contentAreaContextMenu menuitem,
+  #contentAreaContextMenu menu {
+    min-height: 44px !important;
+    font-size: 15px !important;
+  }
+}
+
+/* ======================================================================
+ * 手机横屏断点(底栏 56→48,图标 24→22,视觉密度收紧)
+ * ==================================================================== */
+@media (-moz-pref("ohos.form.factor", "phone")) and (orientation: landscape) {
+  #phone-bottom-bar {
+    height: calc(58px + var(--phone-bottom-inset));
+    align-items: flex-start;
+  }
+  .phone-bar-btn {
+    min-height: 44px;
+    background-size: 22px 22px;
+    margin-top: 3px;
