+// ============================================================================
+// 触摸/鼠标事件桥接:由 geckoview.so NAPI 层调用,转发到顶层 nsWindow
+// ============================================================================
+// geckoview.so 无法直接调用 nsWindow(libxul 中 hidden 符号),
+// 通过此导出函数桥接。libxul 内只有一份 nsWindow::sActiveWindows,
+// 确保事件转发到正确的窗口实例。
+//
+// 线程根因修复:NAPI 回调(MouseMove/MouseDown/MouseUp/touchEvent)运行在
+// ArkTS 主线程,而 Gecko 主线程是 GeckoMainThread 线程(XRE_main 所在线程)。
+// 静态偏好 getter(如 dom_event_pointer_rawupdate_enabled)通过
+// MOZ_DIAGNOSTIC_ASSERT 断言非原子偏好只能在 Gecko 主线程访问,若直接在
+// ArkTS 主线程调用 OnMouseEvent → DispatchEvent → PresShell::HandleEvent,
+// 会触发断言崩溃(SIGSEGV @0x0)。
+// 修复:用 NS_DispatchToMainThread 将事件派发到 Gecko 主线程执行。
+#include "nsWindow.h"
+// v242: 合成双指 pinch 需要 WidgetTouchEvent 与 dom::Touch(构造双触点
+// 事件直接走 DispatchInputEvent,与 OnTouchEvent APZ 分支同路由)。
+#include "TouchEvents.h"
+#include "mozilla/dom/Touch.h"
+
+// ============================================================================
+// v158: popup 输入事件路由(GTK CaptureRollupEvents → X pointer grab 的 OHOS
+// 等价物;修复"右键菜单可见但全部菜单项点击无反应")
+//
+// 根因:OHOS 单 EGL Surface 下,menupopup 是独立 nsWindow(WindowType::Popup,
+// 有自己的 PresShell 与软件 WebRender 管线,经 v134 合成到主表面,故可见),
+// 但 XComponent 的全部输入事件都被派发给 GetTopActiveWindow()(主窗)。
+// popup widget 永收不到事件 →
+//   1) 触摸/鼠标落在菜单项上 = 打在主窗被菜单遮住的内容上,菜单无任何反应;
+//   2) 键盘(方向键/Enter)进主窗文档,被条目树等焦点元素消费,
+//      而 nsXULPopupManager 的键盘导航监听注册在 popup 自己的文档上
+//      (UpdateKeyboardListeners → popup->GetComposedDoc() 的 capture 监听),
+//      永远收不到键 → 键盘导航同样全灭。
+// GTK 上 popup 打开时 CaptureRollupEvents(true) 做 X pointer grab,系统把
+// 事件直接投递给 popup 窗口;OHOS 无 OS 窗口/无 grab,基类
+// CaptureRollupEvents 是空实现 → 必须在桥接层手动路由。
+//
+// 命中判定:popup mBounds 与输入事件同坐标系(surface 局部 px,主窗原点
+// (0,0)),路由时减去 popup 原点转成 popup 局部坐标。事件经 popup 的
+// DispatchEvent 进入其独立 PresShell,菜单项 hover/click/键盘导航全部恢复
+// 桌面语义。
+//
+// 点在 popup 外:不命中任何 popup → 仍走主窗,由主窗 CheckForRollup
+// (v111/v119)Rollup 关闭并消费,行为不变。
+//
+// 手势捕获:down/start 命中 popup 后,该手势后续 move/up/cancel 一律路由给
+// 同一 popup(桌面"按住拖到目标项松手激活"语义;也保证 down/up 同 PresShell
+// 成对,ESM 才能合成 click)。捕获指针每次使用前校验仍在打开列表中
+// (Show(false) 与事件同线程,先移出列表后销毁,校验通过即非悬垂)。
+//
+// tooltip(ePopupTypeTooltip)不参与路由:它是纯展示,桌面语义下点击穿透到
+// 下方内容;若路由给它反而会吞掉点击。
+// ============================================================================
+
+// 触摸手势当前捕获的 popup(仅 Gecko 主线程访问,与注册表同线程,无需锁)
+static nsWindow* gPopupTouchCapture = nullptr;
+// 鼠标 PRESS→RELEASE 期间捕获的 popup
+static nsWindow* gPopupMouseCapture = nullptr;
+
+// 从顶到底(注册表尾=最后 Show=最顶层)命中测试所有打开的 popup。
+// 命中时把 aX/aY(surface px)改写为 popup 局部坐标并返回该 popup;
+// 未命中返回 nullptr,坐标保持不变。
+static nsWindow* OHOS_HitTestOpenPopups(float& aX, float& aY) {
+  int32_t count = GeckoBridge_GetOpenPopupCount();
+  for (int32_t i = count - 1; i >= 0; --i) {
+    nsWindow* popup = static_cast<nsWindow*>(GeckoBridge_GetOpenPopupWidget(i));
+    if (!popup || popup->IsTooltipPopup()) {
+      continue;
+    }
+    mozilla::LayoutDeviceIntRect bounds = popup->GetBounds();
+    if (bounds.Contains(static_cast<int32_t>(aX), static_cast<int32_t>(aY))) {
+      aX -= bounds.X();
+      aY -= bounds.Y();
+      return popup;
+    }
+  }
+  return nullptr;
+}
+
+// 校验捕获的 popup 仍在打开列表中(手势进行中 popup 可能被 Rollup 关闭)
+static bool OHOS_IsPopupStillOpen(nsWindow* aPopup) {
+  if (!aPopup) return false;
+  int32_t count = GeckoBridge_GetOpenPopupCount();
+  for (int32_t i = 0; i < count; ++i) {
+    if (GeckoBridge_GetOpenPopupWidget(i) == aPopup) return true;
+  }
+  return false;
+}
+
+// 顶层菜单类 popup(键盘路由目标)。仅菜单类:autocomplete 等 panel 的键盘
+// 焦点必须留在主窗文本框(箭头/Enter 由文本框 controller 处理)。
+static nsWindow* OHOS_GetTopMenuPopup() {
+  int32_t count = GeckoBridge_GetOpenPopupCount();
+  for (int32_t i = count - 1; i >= 0; --i) {
+    nsWindow* popup = static_cast<nsWindow*>(GeckoBridge_GetOpenPopupWidget(i));
+    if (popup && popup->IsMenuPopup()) {
+      return popup;
+    }
+  }
+  return nullptr;
+}
+
+// 鼠标事件 Runnable:在 Gecko 主线程上调用 nsWindow::OnMouseEvent
+// v77 根因修复:GetTopActiveWindow() 从 ArkTS/UI 线程移到 Gecko 主线程
+//   原先在 ArkTS/UI 线程调用 GetTopActiveWindow() 读取 sActiveWindows,
+//   与 Gecko 主线程的 Destroy()/BringToFront() 写操作并发,导致 Use-After-Free。
+//   现在在 Run() 中获取窗口,确保与写操作在同一线程,消除数据竞争。
+class OHOSMouseEventRunnable : public mozilla::Runnable {
+ public:
+  OHOSMouseEventRunnable(int32_t aAction, float aX, float aY,
+                         int32_t aButton, int64_t aTime)
+      : mozilla::Runnable("OHOSMouseEventRunnable"),
+        mAction(aAction), mX(aX), mY(aY),
+        mButton(aButton), mTime(aTime) {}
+
+  NS_IMETHOD Run() override {
+    // v158: popup 路由(见文件上方 v158 注释块)。
+    if (mAction == 1) {  // PRESS:命中测试,命中则捕获整段手势
+      float x = mX, y = mY;
+      if (nsWindow* popup = OHOS_HitTestOpenPopups(x, y)) {
+        gPopupMouseCapture = popup;
+        OHOS_DiagLog("[XRE_POPUP] v158 鼠标路由: PRESS → popup=%p local=(%.1f,%.1f)",
+                (void*)popup, x, y);
+        popup->OnMouseEvent(mAction, x, y, mButton, mTime,
+                            /*aRoutedToPopup=*/true);
+        return NS_OK;
+      }
+      gPopupMouseCapture = nullptr;
+    } else if (gPopupMouseCapture) {
+      // PRESS 已捕获:MOVE/RELEASE 跟随同一 popup(按当前 bounds 翻译;
+      // 拖出 popup 边界的坐标可为负/越界,ESM 正常处理,桌面拖选同语义)
+      nsWindow* popup = gPopupMouseCapture;
+      if (mAction == 2) {  // RELEASE 后释放捕获
+        gPopupMouseCapture = nullptr;
+      }
+      if (OHOS_IsPopupStillOpen(popup)) {
+        mozilla::LayoutDeviceIntRect b = popup->GetBounds();
+        popup->OnMouseEvent(mAction, mX - b.X(), mY - b.Y(), mButton, mTime,
+                            true);
+      }
+      // popup 已关闭:丢弃手势尾段(主窗没见过本手势起点,补尾无意义)
+      return NS_OK;
+    } else {
+      // 无捕获的 MOVE/HOVER/RELEASE:逐事件命中测试(hover 高亮菜单项)
+      float x = mX, y = mY;
+      if (nsWindow* popup = OHOS_HitTestOpenPopups(x, y)) {
+        popup->OnMouseEvent(mAction, x, y, mButton, mTime, true);
+        return NS_OK;
+      }
+    }
+    nsWindow* topWin = nsWindow::GetTopActiveWindow();
+    if (topWin) {
+      topWin->OnMouseEvent(mAction, mX, mY, mButton, mTime);
+    }
+    return NS_OK;
+  }
+
+ private:
+  int32_t mAction;
+  float mX;
+  float mY;
+  int32_t mButton;
+  int64_t mTime;
+};
+
+// 触摸事件 Runnable:在 Gecko 主线程上调用 nsWindow::OnTouchEvent
+// v77: 同鼠标事件,GetTopActiveWindow() 移到 Gecko 主线程
+// v215: 触摸路由共享体(定义在本类之后,move 合并路径与本类共用)。
+static void OHOS_RouteTouchEvent(int32_t aAction, float aX, float aY,
+                                 int64_t aTime);
+
+// ---- v270: 多指触摸状态(声明前置;合并/派发实现见 GeckoBridge_ ----
+// ---- DispatchTouchEvent 之后的多指段)                            ----
+// 批输入结构:XComponent 多点回调或合成通道的一帧(所有当前触点)。
+constexpr int32_t kMMaxPoints = 10;  // = OH_NATIVE_XCOMPONENT_MAX_TOUCH_POINTS_NUMBER
+struct OHOSMultiBatch {
+  int32_t mGlobalAction = -1;  // OH 全局 type 0=DOWN 1=UP 2=MOVE 3=CANCEL
+  int32_t mCount = 0;
+  int32_t mIds[kMMaxPoints] = {0};
+  float mXs[kMMaxPoints] = {0.0f};
+  float mYs[kMMaxPoints] = {0.0f};
+  int32_t mTypes[kMMaxPoints] = {-1};   // 每指 type(0-3;未知 -1)
+  int32_t mPressed[kMMaxPoints] = {0};  // 每指 isPressed(0/1)
+  int64_t mTime = 0;                    // ms(入口已归一化)
+};
+// 按压点跟踪(id → 最后位置)。仅 Gecko 主线程访问(导出/合并槽 Runnable
+// 全部落主线程),无锁。gMMultiActive 同线程。
+static std::map<int32_t, mozilla::LayoutDeviceIntPoint> gMTracked;
+static bool gMMultiActive = false;
+
+static bool OHOS_ForwardMultiBatch(const OHOSMultiBatch& aB);
+
+// v270: 多指态期间的旧单点事件并入:包装成单点批走同一合并器。
+// 调用约定:旧单点导出仅在触点 id==0 时使用(geckoview.cpp v270 路由规
+// 则),故此处 id 恒 0 与真实手指 id 对齐。恒返回 true(已消费)。
+static bool OHOS_ForwardSingleDuringMulti(int32_t aAction, float aX, float aY,
+                                          int64_t aTime);
+
+class OHOSTouchEventRunnable : public mozilla::Runnable {
+ public:
+  OHOSTouchEventRunnable(int32_t aAction, float aX, float aY, int64_t aTime)
+      : mozilla::Runnable("OHOSTouchEventRunnable"),
+        mAction(aAction), mX(aX), mY(aY), mTime(aTime) {}
+
+  NS_IMETHOD Run() override {
+    // v215: 路由逻辑抽至 OHOS_RouteTouchEvent(与 move 合并路径共享)。
+    OHOS_RouteTouchEvent(mAction, mX, mY, mTime);
+    return NS_OK;
+  }
+
+ private:
+  int32_t mAction;
+  float mX;
+  float mY;
+  int64_t mTime;
+};
+
+// v215: 触摸路由共享体(popup 捕获 + 顶层窗口派发)。OHOSTouchEventRunnable
+// 与下方 move 合并消费 runnable 共用,保证两条路径行为一致。
+static void OHOS_RouteTouchEvent(int32_t aAction, float aX, float aY,
+                                 int64_t aTime) {
+  // v270: 多指态激活时,旧单点通道的尾段事件(仅剩一指,numPoints==1)
+  // 并入多指合并 —— 保证指 id 语义连续、End 批正确收尾;多指态未激活
+  // 时零影响(单指手势不进多指路径)。
+  if (gMMultiActive && OHOS_ForwardSingleDuringMulti(aAction, aX, aY, aTime)) {
+    return;
+  }
+  if (aAction == 0) {  // touchstart:命中测试,命中则捕获整段手势
+    float x = aX, y = aY;
+    if (nsWindow* popup = OHOS_HitTestOpenPopups(x, y)) {
+      gPopupTouchCapture = popup;
+      OHOS_DiagLog("[XRE_POPUP] v158 触摸路由: start → popup=%p local=(%.1f,%.1f)",
+              (void*)popup, x, y);
+      popup->OnTouchEvent(aAction, x, y, aTime, /*aRoutedToPopup=*/true);
+      return;
+    }
+    gPopupTouchCapture = nullptr;
+  } else if (gPopupTouchCapture) {
+    // move/end/cancel:跟随捕获(保证与 touchstart 同 PresShell 成对)
+    nsWindow* popup = gPopupTouchCapture;
+    if (aAction == 1 || aAction == 3) {  // end/cancel 后释放捕获
+      gPopupTouchCapture = nullptr;
+    }
+    if (OHOS_IsPopupStillOpen(popup)) {
+      mozilla::LayoutDeviceIntRect b = popup->GetBounds();
+      popup->OnTouchEvent(aAction, aX - b.X(), aY - b.Y(), aTime, true);
+    }
+    // popup 已关闭:丢弃手势尾段
+    return;
+  }
+  // 无捕获的 move/end/cancel 不做命中测试:手势起点在主窗(或主窗长按
+  // 开出的菜单下方),尾段必须回主窗保持配对 —— 长按开菜单后抬手的
+  // touchend 即属此列,路由进 popup 反而会折断主窗的触摸序列。
+  nsWindow* topWin = nsWindow::GetTopActiveWindow();
+  if (topWin) {
+    topWin->OnTouchEvent(aAction, aX, aY, aTime);
+  }
+}
+
+// v215: 触摸 move 桥接层合并(keep-latest)。XComponent 回调 ≈120Hz,原实现
+// 把每个 move 各自 NS_DispatchToMainThread 排队;主线程繁忙(重绘/页面 JS)
+// 时队列积压,滚动更新率被压到主线程吞吐、延迟持续累积 = "采集率低"感。
+// 改为槽位:已有 move 待处理时只更新槽内坐标/时间(最新位置),不追加
+// Runnable;主线程每轮事件循环处理一个 move。绝对坐标语义 → 总距离无损;
+// DOWN/UP/CANCEL 不合并(与 move 的 FIFO 顺序保持手势序列正确)。
+namespace {
+struct CoalescedMoveSlot {
+  std::mutex mMutex;
+  float mX = 0.0f;
+  float mY = 0.0f;
+  int64_t mTime = 0;
+  bool mPending = false;
+};
+CoalescedMoveSlot gCoalescedMove;
+}  // namespace
+
+class OHOSCoalescedMoveRunnable : public mozilla::Runnable {
+ public:
+  OHOSCoalescedMoveRunnable()
+      : mozilla::Runnable("OHOSCoalescedMoveRunnable") {}
+
+  NS_IMETHOD Run() override {
+    float x, y;
+    int64_t t;
+    {
+      std::lock_guard<std::mutex> lock(gCoalescedMove.mMutex);
+      if (!gCoalescedMove.mPending) {
+        return NS_OK;  // 防御:槽已被消费(正常不应发生)
+      }
+      x = gCoalescedMove.mX;
+      y = gCoalescedMove.mY;
+      t = gCoalescedMove.mTime;
+      gCoalescedMove.mPending = false;
+    }
+    OHOS_RouteTouchEvent(2, x, y, t);
+    return NS_OK;
+  }
+};
+
+// 滚轮事件 Runnable(v62):在 Gecko 主线程上调用 nsWindow::OnWheelEvent
+// v77: 同鼠标事件,GetTopActiveWindow() 移到 Gecko 主线程
+class OHOSWheelEventRunnable : public mozilla::Runnable {
+ public:
+  OHOSWheelEventRunnable(float aDeltaX, float aDeltaY, float aX,
+                         float aY, int64_t aTime)
+      : mozilla::Runnable("OHOSWheelEventRunnable"),
+        mDeltaX(aDeltaX), mDeltaY(aDeltaY),
+        mX(aX), mY(aY), mTime(aTime) {}
+
+  NS_IMETHOD Run() override {
+    // v158: 滚轮命中路由给 popup(长菜单滚动);popup 外仍走主窗。
+    float x = mX, y = mY;
+    if (nsWindow* popup = OHOS_HitTestOpenPopups(x, y)) {
+      popup->OnWheelEvent(mDeltaX, mDeltaY, x, y, mTime);
+      return NS_OK;
+    }
+    nsWindow* topWin = nsWindow::GetTopActiveWindow();
+    if (topWin) {
+      topWin->OnWheelEvent(mDeltaX, mDeltaY, mX, mY, mTime);
+    }
+    return NS_OK;
+  }
+
+ private:
+  float mDeltaX;
+  float mDeltaY;
+  float mX;
+  float mY;
+  int64_t mTime;
+};
+
+// 物理键盘事件 Runnable:在 Gecko 主线程上调用 nsWindow::OnKeyEvent
+// aAction: 0=DOWN, 1=UP; aKeyCode: OH_NativeXComponent_KeyCode
+class OHOSKeyEventRunnable : public mozilla::Runnable {
+ public:
+  OHOSKeyEventRunnable(int32_t aAction, int32_t aKeyCode,
+                       int64_t aDeviceId, int64_t aTime, uint32_t aModifiers)
+      : mozilla::Runnable("OHOSKeyEventRunnable"),
+        mAction(aAction), mKeyCode(aKeyCode),
+        mDeviceId(aDeviceId), mTime(aTime), mModifiers(aModifiers) {}
+
+  NS_IMETHOD Run() override {
+    // v158: 菜单类 popup 打开时键盘路由给它(GTK grab 等价)——
+    // nsXULPopupManager 的 keydown/keypress/keyup capture 监听注册在
+    // popup 自己的文档上,键进主窗文档永远到不了(方向键被条目树吃掉、
+    // Enter 无法激活菜单项的根因)。panel 类(autocomplete)不接管:
+    // 其键盘焦点语义本就在主窗文本框。
+    if (nsWindow* popup = OHOS_GetTopMenuPopup()) {
+      popup->OnKeyEvent(mAction, mKeyCode, mDeviceId, mTime, mModifiers);
+      return NS_OK;
+    }
+    nsWindow* topWin = nsWindow::GetTopActiveWindow();
+    if (topWin) {
+      topWin->OnKeyEvent(mAction, mKeyCode, mDeviceId, mTime, mModifiers);
+    }
+    return NS_OK;
+  }
+
+ private:
+  int32_t mAction;
+  int32_t mKeyCode;
+  int64_t mDeviceId;
+  int64_t mTime;
+  uint32_t mModifiers;
+};
+
+// 窗口尺寸变化 Runnable:在 Gecko 主线程上调用 nsWindow::Resize
+// v77: 同鼠标事件,GetTopActiveWindow() 移到 Gecko 主线程
+class OHOSResizeRunnable : public mozilla::Runnable {
+ public:
+  OHOSResizeRunnable(int32_t aWidth, int32_t aHeight)
+      : mozilla::Runnable("OHOSResizeRunnable"),
+        mWidth(aWidth), mHeight(aHeight) {}
+
+  NS_IMETHOD Run() override {
+    nsWindow* topWin = nsWindow::GetTopActiveWindow();
+    if (topWin) {
+      topWin->Resize(static_cast<double>(mWidth),
+                     static_cast<double>(mHeight), true);
+    }
+    // v258g: 显式重设 native window buffer geometry——键盘白带取证(v258f)
+    // 实锤 XComponent 框架缓存了键盘期窗口尺寸(触摸坐标被 ×2560/1435 缩放,
+    // OnSurfaceChanged 全程零触发),窗口 resize 双推也不刷新框架缓存。
+    // buffer geometry 是 XComponent surface 尺寸链的底层锚点,显式 SET 会
+    // 触发框架 surface 变化事件 → OnSurfaceChanged → GetXComponentSize
+    // 重取真值 → 触摸换算与显示映射全链重同步。先 GET 记录卡值再 SET。
+    void* rawWin = gOHOSNativeWindow.load(std::memory_order_relaxed);
+    if (rawWin) {
+      OHNativeWindow* nw = static_cast<OHNativeWindow*>(rawWin);
+      int32_t curH = 0, curW = 0;
+      OH_NativeWindow_NativeWindowHandleOpt(
+          nw, GET_BUFFER_GEOMETRY, &curH, &curW);
+      int32_t setRet = OH_NativeWindow_NativeWindowHandleOpt(
+          nw, SET_BUFFER_GEOMETRY, mWidth, mHeight);
+      OHOS_DiagLog(
+          "[XRE] v258g bufferGeometry get=%dx%d set(%dx%d)=%d", curW, curH,
+          mWidth, mHeight, (int)setRet);
+    }
+    return NS_OK;
+  }
+
+ private:
+  int32_t mWidth;
+  int32_t mHeight;
+};
+
+// 窗口尺寸变化桥接:由 geckoview.so OnSurfaceChanged 调用,
+// 转发到 Gecko 主线程执行 nsWindow::Resize。
+// v77: GetTopActiveWindow() 移到 Runnable::Run() 中,消除数据竞争
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_ResizeSurface(int32_t aWidth, int32_t aHeight) {
+  OHOS_DiagLog("[XRE] GeckoBridge_ResizeSurface size=%dx%d", aWidth, aHeight);
+  NS_DispatchToMainThread(
+      mozilla::MakeAndAddRef<OHOSResizeRunnable>(aWidth, aHeight));
+}
+
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_DispatchTouchEvent(int32_t aAction, float aX,
+                                               float aY, int64_t aTime) {
+  // v218: MOVE(滚动/拖拽 120Hz 高频)不再进 OHOS_DiagLog——该函数每次
+  // mutex+clock_gettime+两次 fprintf 格式化,且发生在 ArkUI 主线程(输入
+  // 最前端),与主线程/渲染线程日志争锁。与 geckoview.cpp/nsWindow.cpp 的
+  // 同款静默对齐;DOWN/UP/CANCEL 低频保留诊断。
+  if (aAction != 2) {
+    OHOS_DiagLog("[XRE] GeckoBridge_DispatchTouchEvent action=%d pos=(%.1f,%.1f)",
+            aAction, aX, aY);
+  }
+  // v217c: 时间戳单位归一化。OHOS XComponent 的 TouchPoint.timeStamp 单位
+  // 是纳秒(NDK 文档),而 nsWindow 滚动物理(采样窗 100/停顿判定 160/回退
+  // 界 0.5-300)全部按毫秒;合成通道(SynthSwipeTick)传 PR 毫秒。此前真实
+  // 输入的 ns 值被当 ms 用 → 采样窗把全部样本裁光、停顿判定恒假 →
+  // 真实手势 fling 从未启动(synth 正常,真机实证)。>1e12 视为纳秒。
+  if (aTime > 1000000000000LL) {
+    aTime /= 1000000;
+  }
+  // v215: MOVE 走合并槽(见 CoalescedMoveSlot 注释);DOWN/UP/CANCEL 保持
+  // 每事件一个 Runnable,与已派发 move runnable 的 FIFO 保证手势序列。
+  if (aAction == 2) {
+    bool needDispatch = false;
+    {
+      std::lock_guard<std::mutex> lock(gCoalescedMove.mMutex);
+      gCoalescedMove.mX = aX;
+      gCoalescedMove.mY = aY;
+      gCoalescedMove.mTime = aTime;
+      if (!gCoalescedMove.mPending) {
+        gCoalescedMove.mPending = true;
+        needDispatch = true;
+      }
+    }
+    if (needDispatch) {
+      NS_DispatchToMainThread(
+          mozilla::MakeAndAddRef<OHOSCoalescedMoveRunnable>());
+    }
+    return;
+  }
+  NS_DispatchToMainThread(
+      mozilla::MakeAndAddRef<OHOSTouchEventRunnable>(aAction, aX, aY, aTime));
+}
+
+// ============================================================================
+// v270: 多指触摸转发 —— 双指捏合(APZ pinch)根修。
+//
+// 根因:geckoview.cpp 的 XComponent 触摸回调自 v56 起只转发 touchPoints[0]
+// (单点触控),第二根手指被整批丢弃 → Gecko/APZ 永远收不到双触点批,
+// 捏合手势在全部 Gecko 内容(网页与 about:preferences 等特权 UI 页)上
+// 从未生效(v242 synth-pinch 直注双触点可缩放,证明仅输入段断链)。
+//
+// 数据形态(NDK OH_NativeXComponent_TouchEvent):
+//   每次指针变化触发一次回调,touchPoints[] 为当前全部触点,每点带
+//   id(手指唯一标识)/x/y/type(该指的动作 DOWN/UP/MOVE/CANCEL)/
+//   isPressed(当前是否按下)。
+//
+// 合并策略(本段,Gecko 主线程执行)——"type 优先,isPressed 自愈":
+//   1) 结束指集合 ended:本批内 type∈{UP,CANCEL} 的点;全局 action 为
+//      UP/CANCEL 时,在册(tracked)却不在批内的指也视为结束(兜框架
+//      "UP 批不含已抬指"的形态);全局 CANCEL 结束全部在册指。
+//      MOVE 批缺失的在册指不判死(可能框架只报了变化指,保位置等下批)。
+//   2) 新落指集合 news:批内 type==DOWN;或在册外的仍按下点(down 批
+//      丢失的收养)。两者皆非 → MOVE。
+//   3) 在册表 gMTracked 按仍按下点整体重建(自愈:无论框架含不含已抬
+//      指,在册状态恒与"当前真实按压集"对齐,不会卡死)。
+//   4) Gecko 批 = 当前在册 ∪ 刚结束(结束指取批内终位),与 v242
+//      synth-pinch 被 APZ 接受的序列同构:
+//      Start[f0] → Start[f0,f1] → N×Move[f0,f1] → End[f0,f1] → End[f0]。
+//
+// 多指态 gMMultiActive:某手势在册数 ≥2 后置位,全部抬起才复位。置位期间
+// 旧单点通道的尾段事件也被并入(见 OHOS_RouteTouchEvent 头部挂钩);
+// 未置位时单点事件完全走原路径,既有点击/滚动/长按行为零改动。
+// ============================================================================
+
+// 多指态期间的旧单点事件并入:包装成单点批走同一合并器。
+// 调用约定:旧单点导出仅在触点 id==0 时使用(geckoview.cpp v270 路由规
+// 则),故此处 id 恒 0 与真实手指 id 对齐。恒返回 true(已消费)。
+static bool OHOS_ForwardSingleDuringMulti(int32_t aAction, float aX, float aY,
+                                          int64_t aTime) {
+  OHOSMultiBatch b;
+  b.mGlobalAction = aAction;
+  b.mCount = 1;
+  b.mIds[0] = 0;
+  b.mXs[0] = aX;
+  b.mYs[0] = aY;
+  b.mTypes[0] = aAction;
+  b.mPressed[0] = (aAction == 1 || aAction == 3) ? 0 : 1;
+  b.mTime = aTime;
+  OHOS_ForwardMultiBatch(b);
+  return true;
+}
+
+// 合并 + 路由 + 派发(Gecko 主线程)。返回是否产生并派发了批事件。
+static bool OHOS_ForwardMultiBatch(const OHOSMultiBatch& aB) {
+  const bool globalUp = (aB.mGlobalAction == 1);
+  const bool globalCancel = (aB.mGlobalAction == 3);
+
+  // 1) 解析批内点。
+  std::map<int32_t, mozilla::LayoutDeviceIntPoint> present;
+  std::set<int32_t> presentEnded;  // 批内 type 标记结束的指
+  std::set<int32_t> presentDown;   // 批内 type 标记新落的指
+  std::set<int32_t> presentPressed;
+  for (int32_t i = 0; i < aB.mCount && i < kMMaxPoints; ++i) {
+    const int32_t id = aB.mIds[i];
+    const mozilla::LayoutDeviceIntPoint pos((int32_t)aB.mXs[i],
+                                            (int32_t)aB.mYs[i]);
+    present[id] = pos;
+    const int32_t t = aB.mTypes[i];
+    if (t == 1 || t == 3 || globalCancel ||
+        (globalUp && aB.mPressed[i] == 0)) {
+      presentEnded.insert(id);
+    } else {
+      if (t == 0) {
+        presentDown.insert(id);
+      }
+      if (aB.mPressed[i] != 0 || t == 0) {
+        presentPressed.insert(id);
+      }
+    }
+  }
+
+  // 2) 结束集 = 批内标记结束 ∪ (全局 UP/CANCEL 时在册缺失指)。
+  std::map<int32_t, mozilla::LayoutDeviceIntPoint> endedFinal;
+  for (const int32_t id : presentEnded) {
+    endedFinal[id] = present[id];
+  }
+  if (globalUp || globalCancel) {
+    for (auto& kv : gMTracked) {
+      if (present.find(kv.first) == present.end()) {
+        endedFinal[kv.first] = kv.second;
+      }
+    }
+  }
+
+  // 3) 在册表重建(isPressed 自愈)+ 新指收养。
+  std::map<int32_t, mozilla::LayoutDeviceIntPoint> newTracked;
+  for (const int32_t id : presentPressed) {
+    newTracked[id] = present[id];
+  }
+  std::set<int32_t> news = presentDown;
+  for (auto& kv : newTracked) {
+    if (gMTracked.find(kv.first) == gMTracked.end()) {
+      news.insert(kv.first);  // 无 DOWN 批的在册外按下点 → 视为新落指
+    }
+  }
+
+  // 4) 多指态转移。
+  const bool wasActive = gMMultiActive;
+  gMTracked = newTracked;
+  if (gMTracked.size() >= 2) {
+    gMMultiActive = true;
+  } else if (gMTracked.empty()) {
+    gMMultiActive = false;
+  }
+
+  // 5) 批消息(Cancel > End > Start > Move)。
+  mozilla::EventMessage msg;
+  int32_t action;
+  if (globalCancel) {
+    msg = mozilla::eTouchCancel;
+    action = 3;
+  } else if (!endedFinal.empty()) {
+    msg = mozilla::eTouchEnd;
+    action = 1;
+  } else if (!news.empty()) {
+    msg = mozilla::eTouchStart;
+    action = 0;
+  } else {
+    msg = mozilla::eTouchMove;
+    action = 2;
+  }
+
+  // 6) 批触点 = 当前在册 ∪ 刚结束。
+  nsTArray<int32_t> ids;
+  nsTArray<mozilla::LayoutDeviceIntPoint> pts;
+  for (auto& kv : endedFinal) {
+    ids.AppendElement(kv.first);
+    pts.AppendElement(kv.second);
+  }
+  for (auto& kv : gMTracked) {
+    if (endedFinal.find(kv.first) == endedFinal.end()) {
+      ids.AppendElement(kv.first);
+      pts.AppendElement(kv.second);
+    }
+  }
+  if (ids.IsEmpty()) {
+    return false;
+  }
+
+  // 7) 路由:主指 = 批首点。Start 命中 popup 则整手势捕获(与单点同语义);
+  //    已捕获则尾段跟随捕获窗口(坐标转 popup 局部)。
+  bool routedToPopup = false;
+  nsWindow* target = nullptr;
+  float px = (float)pts[0].x, py = (float)pts[0].y;
+  if (msg == mozilla::eTouchStart && !gPopupTouchCapture) {
+    if (nsWindow* popup = OHOS_HitTestOpenPopups(px, py)) {
+      gPopupTouchCapture = popup;
+      routedToPopup = true;
+      target = popup;
+    }
+  } else if (gPopupTouchCapture) {
+    nsWindow* popup = gPopupTouchCapture;
+    if (action == 1 || action == 3) {
+      gPopupTouchCapture = nullptr;
+    }
+    if (OHOS_IsPopupStillOpen(popup)) {
+      mozilla::LayoutDeviceIntRect b = popup->GetBounds();
+      for (uint32_t i = 0; i < pts.Length(); ++i) {
+        pts[i] = mozilla::LayoutDeviceIntPoint(pts[i].x - b.X(),
+                                               pts[i].y - b.Y());
+      }
+      routedToPopup = true;
+      target = popup;
+    } else {
+      return false;  // popup 已关:手势尾段丢弃(与单点路径同语义)
+    }
+  }
+  if (!target) {
+    target = nsWindow::GetTopActiveWindow();
+  }
+  if (!target) {
+    return false;
+  }
+
+  if (msg != mozilla::eTouchMove) {
+    OHOS_DiagLog(
+        "[MTOUCH] batch action=%d n=%u ids0=%d tracked=%zu ended=%zu multi=%d->%d",
+        action, (unsigned)ids.Length(), ids[0], gMTracked.size(),
+        endedFinal.size(), (int)wasActive, (int)gMMultiActive);
+  }
+  target->OnMultiTouchEvent(action, ids, pts, aB.mTime, routedToPopup);
+  return true;
+}
+
+// 多指 MOVE 合并槽(v215 keep-latest 同款:双指 120Hz×2 段,主线程繁忙时
+// 队列积压会把 pinch 采样率压到主线程吞吐 —— 整批覆盖槽位,最新 span 无损)。
+namespace {
+struct CoalescedMultiMoveSlot {
+  std::mutex mMutex;
+  OHOSMultiBatch mBatch;
+  bool mPending = false;
+};
+CoalescedMultiMoveSlot gMMove;
+}  // namespace
+
+class OHOSCoalescedMultiMoveRunnable : public mozilla::Runnable {
+ public:
+  OHOSCoalescedMultiMoveRunnable()
+      : mozilla::Runnable("OHOSCoalescedMultiMoveRunnable") {}
+  NS_IMETHOD Run() override {
+    OHOSMultiBatch b;
+    {
+      std::lock_guard<std::mutex> lock(gMMove.mMutex);
+      if (!gMMove.mPending) {
+        return NS_OK;
+      }
+      b = gMMove.mBatch;
+      gMMove.mPending = false;
+    }
+    OHOS_ForwardMultiBatch(b);
+    return NS_OK;
+  }
+};
+
+class OHOSMultiTouchEventRunnable : public mozilla::Runnable {
+ public:
+  OHOSMultiTouchEventRunnable(OHOSMultiBatch aBatch)
+      : mozilla::Runnable("OHOSMultiTouchEventRunnable"), mBatch(aBatch) {}
+  NS_IMETHOD Run() override {
+    OHOS_ForwardMultiBatch(mBatch);
+    return NS_OK;
+  }
+
+ private:
+  OHOSMultiBatch mBatch;
+};
+
+// 多点触摸导出:geckoview.cpp XComponent 回调在 numPoints>1 时调用。
+// aTypes/aPressed 可为 nullptr(合成通道简配):type 未知按 -1 处理,
+// 结束判定退化为 isPressed + 全局 action。
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_DispatchMultiTouchEvent(
+    int32_t aGlobalAction, int32_t aCount, const int32_t* aIds,
+    const float* aXs, const float* aYs, const int32_t* aTypes,
+    const int32_t* aPressed, int64_t aTime) {
+  if (aCount <= 0 || !aIds || !aXs || !aYs) {
+    return;
+  }
+  // v217c 同款:ns → ms 归一化。
+  if (aTime > 1000000000000LL) {
+    aTime /= 1000000;
+  }
+  OHOSMultiBatch b;
+  b.mGlobalAction = aGlobalAction;
+  b.mCount = std::min(aCount, kMMaxPoints);
+  for (int32_t i = 0; i < b.mCount; ++i) {
+    b.mIds[i] = aIds[i];
+    b.mXs[i] = aXs[i];
+    b.mYs[i] = aYs[i];
+    b.mTypes[i] = aTypes ? aTypes[i] : -1;
+    b.mPressed[i] = aPressed ? aPressed[i] : 1;
+  }
+  b.mTime = aTime;
+  if (aGlobalAction == 2) {
+    bool needDispatch = false;
+    {
+      std::lock_guard<std::mutex> lock(gMMove.mMutex);
+      gMMove.mBatch = b;
+      if (!gMMove.mPending) {
+        gMMove.mPending = true;
+        needDispatch = true;
+      }
+    }
+    if (needDispatch) {
+      NS_DispatchToMainThread(
+          mozilla::MakeAndAddRef<OHOSCoalescedMultiMoveRunnable>());
+    }
+    return;
+  }
+  NS_DispatchToMainThread(
+      mozilla::MakeAndAddRef<OHOSMultiTouchEventRunnable>(b));
+}
+
+// v159: 合成触摸 swipe —— 触摸滚动回归测试通道。
+// 背景:本机 uitest 注入被多模输入服务拒(29201 operation not permitted)、
+// uinput 虚拟触摸屏事件也不达应用(XComponent C 回调零日志),真机唯一
+// 触摸源是真人手指 → 触摸滚动的自动化验证无通道。
+// 方案:以 16ms 定时步进序列直接驱动 nsWindow::OnTouchEvent(DOWN→N×MOVE
+// →UP,坐标为窗口设备px),与真实 XComponent C 回调→本文件 DispatchTouchEvent
+// →OHOSTouchEventRunnable→OnTouchEvent 完全同入口同线程,仅事件来源不同。
+// 触发:ArkTS EntryAbility 解析 aa start --uri 'airweb-synth-swipe?dx=&dy=&dur='
+// → FirefoxBridge.synthTouchSwipe → NAPI → 本函数。
+namespace {
+struct SynthSwipeState {
+  nsCOMPtr<nsITimer> mTimer;
+  mozilla::LayoutDeviceIntPoint mFrom;   // 设备px
+  float mStepX = 0.0f;          // 每步位移(设备px)
+  float mStepY = 0.0f;
+  int32_t mRemaining = 0;       // 剩余 move 步数
+  bool mActive = false;
+};
+SynthSwipeState gSynthSwipe;
+}  // namespace
+
+static void SynthSwipeTick(nsITimer*, void*) {
+  nsWindow* topWin = nsWindow::GetTopActiveWindow();
+  if (!topWin) {
+    // v159b: REPEATING 定时器必须显式 Cancel 再置空 —— 只置 nullptr 是
+    // 释放引用而非取消,armed 定时器仍会永远 16ms 触发(首版冻结事故根因:
+    // 泄漏定时器以 62Hz 派发 touchend,主线程淹没→采样停→看门狗击杀)。
+    if (gSynthSwipe.mTimer) {
+      gSynthSwipe.mTimer->Cancel();
+      gSynthSwipe.mTimer = nullptr;
+    }
+    gSynthSwipe.mActive = false;
+    return;
+  }
+  const int64_t t = PR_IntervalToMilliseconds(PR_IntervalNow());
+  if (gSynthSwipe.mRemaining > 0) {
+    gSynthSwipe.mFrom.x += (int32_t)gSynthSwipe.mStepX;
+    gSynthSwipe.mFrom.y += (int32_t)gSynthSwipe.mStepY;
+    gSynthSwipe.mRemaining--;
+    topWin->OnTouchEvent(2, (float)gSynthSwipe.mFrom.x,
+                         (float)gSynthSwipe.mFrom.y, t);
+    return;
+  }
+  // 序列末尾:UP + 收尾(必须 Cancel,见上方 v159b 注释)。
+  topWin->OnTouchEvent(1, (float)gSynthSwipe.mFrom.x,
+                       (float)gSynthSwipe.mFrom.y, t);
+  OHOS_DiagLog("[XRE_PAN] 合成 swipe 完成 end=(%d,%d)",
+          gSynthSwipe.mFrom.x, gSynthSwipe.mFrom.y);
+  if (gSynthSwipe.mTimer) {
+    gSynthSwipe.mTimer->Cancel();
+    gSynthSwipe.mTimer = nullptr;
+  }
+  gSynthSwipe.mActive = false;
+}
+
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_SynthTouchSwipe(int32_t aDx, int32_t aDy,
+                                            int32_t aDurationMs) {
+  OHOS_DiagLog("[XRE_PAN] GeckoBridge_SynthTouchSwipe d=(%d,%d) dur=%dms",
+          aDx, aDy, aDurationMs);
+  // 直接在 Gecko 主线程调度(NAPI 调用方为 JS 线程,但本函数只写静态状态并
+  // 派发 Runnable,与 DispatchTouchEvent 同模式)。计时器回调/OnTouchEvent
+  // 全部落在 Gecko 主线程,无锁安全。
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "GeckoBridge_SynthTouchSwipe",
+      [aDx, aDy, aDurationMs]() {
+        nsWindow* topWin = nsWindow::GetTopActiveWindow();
+        if (!topWin) {
+          return;
+        }
+        if (gSynthSwipe.mActive && gSynthSwipe.mTimer) {
+          gSynthSwipe.mTimer->Cancel();
+          gSynthSwipe.mTimer = nullptr;
+          gSynthSwipe.mActive = false;
+        }
+        const mozilla::LayoutDeviceIntRect bounds = topWin->GetBounds();
+        if (bounds.width <= 0 || bounds.height <= 0) {
+          return;
+        }
+        // 起点:水平中心、高度 60%(避开 chrome 工具栏与系统手势区)。
+        gSynthSwipe.mFrom = mozilla::LayoutDeviceIntPoint(
+            bounds.width / 2, (int32_t)(bounds.height * 0.6));
+        const int32_t steps =
+            std::max(4, (aDurationMs > 0 ? aDurationMs : 400) / 16);
+        gSynthSwipe.mStepX = (float)aDx / steps;
+        gSynthSwipe.mStepY = (float)aDy / steps;
+        gSynthSwipe.mRemaining = steps - 1;
+        gSynthSwipe.mActive = true;
+        const int64_t t = PR_IntervalToMilliseconds(PR_IntervalNow());
+        topWin->OnTouchEvent(0, (float)gSynthSwipe.mFrom.x,
+                             (float)gSynthSwipe.mFrom.y, t);
+        NS_NewTimerWithFuncCallback(
+            getter_AddRefs(gSynthSwipe.mTimer), SynthSwipeTick, nullptr, 16,
+            nsITimer::TYPE_REPEATING_PRECISE, "SynthSwipeTick",
+            NS_GetCurrentThread());
+      }));
+}
