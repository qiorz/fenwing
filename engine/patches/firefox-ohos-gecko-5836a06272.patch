+// 信号处理函数:捕获 SIGSEGV/SIGABRT 等致命信号
+// 同时输出到 hilog 和文件,确保崩溃信号能被捕获
+#include <csignal>
+#include <sys/stat.h>  // mkdir,用于创建 profile 目录
+#include <execinfo.h>  // backtrace, backtrace_symbols
+#include <ucontext.h>  // ucontext_t, 获取崩溃时 PC 寄存器
+#include <dlfcn.h>     // dladdr, 解析符号
+static void GeckoSignalHandler(int signum, siginfo_t* info, void* ctx) {
+    // 从 ucontext 获取崩溃时的 PC 寄存器 (aarch64)
+    ucontext_t* uc = (ucontext_t*)ctx;
+    unsigned long pc = 0;
+    if (uc) {
+        pc = uc->uc_mcontext.pc;
+    }
+    OH_LOG_ERROR(LOG_APP, "[FATAL] signal=%{public}d si_addr=%{public}p PC=0x%{public}lx",
+                 signum, info ? info->si_addr : nullptr, pc);
+
+    // 用 dladdr 解析 PC 所属的 .so 和符号偏移
+    Dl_info dlinfo;
+    if (dladdr((void*)pc, &dlinfo)) {
+        unsigned long off = pc - (unsigned long)dlinfo.dli_fbase;
+        OH_LOG_ERROR(LOG_APP, "[FATAL] PC in %{public}s base=%{public}p off=0x%{public}lx sym=%{public}s",
+                     dlinfo.dli_fname ? dlinfo.dli_fname : "?",
+                     dlinfo.dli_fbase, off,
+                     dlinfo.dli_sname ? dlinfo.dli_sname : "?");
+    }
+
+    // backtrace 获取调用栈, 用 dladdr 解析每帧
+    void* bt_buf[32];
+    int bt_n = backtrace(bt_buf, 32);
+    OH_LOG_ERROR(LOG_APP, "[FATAL] backtrace frames=%{public}d", bt_n);
+    for (int i = 0; i < bt_n; i++) {
+        Dl_info di;
+        if (dladdr(bt_buf[i], &di)) {
+            unsigned long off = (unsigned long)bt_buf[i] - (unsigned long)di.dli_fbase;
+            const char* fname = di.dli_fname ? di.dli_fname : "?";
+            // 只取 basename
+            const char* base = strrchr(fname, '/');
+            base = base ? base + 1 : fname;
+            OH_LOG_ERROR(LOG_APP, "[BT] #%{public}d %{public}s+0x%{public}lx sym=%{public}s",
+                         i, base, off, di.dli_sname ? di.dli_sname : "?");
+        } else {
+            OH_LOG_ERROR(LOG_APP, "[BT] #%{public}d %{public}p (dladdr failed)", i, bt_buf[i]);
+        }
+    }
+    // 重置为默认处理并重新发送信号
+    signal(signum, SIG_DFL);
+    raise(signum);
+}
