+    // 在调用 XRE_main 之前写入 gecko_xre_diag.txt,确认 GeckoMainThread 已到达调用位置
+    // 同时验证 gecko_xre_diag.txt 文件可写性(排除 fopen 权限问题)
+    {
+        FILE* diagFp = fopen("/data/storage/el2/base/haps/entry/files/gecko_xre_diag.txt", "a");
+        if (diagFp) {
+            struct timespec diagTs;
