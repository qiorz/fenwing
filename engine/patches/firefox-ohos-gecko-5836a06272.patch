+// v129: 物理键盘事件 ArkTS 转发通道(最后一公里修复)
+// 根因:IME TextInput 常驻持焦,XComponent 无焦点 → XComponent 键回调不触发,
+//       物理键盘事件被 TextInput 吞掉永远到不了 Gecko。
+// 修复:ArkTS 根 Stack 上挂 .onKeyEvent,TextInput 未消费(return:0)的键冒泡到根容器,
+//       转发到本 NAPI → GeckoBridge_DispatchKeyEvent(libxul.so)→ nsWindow::OnKeyEvent。
+// 与 XComponent C 回调并存但不同时触发(XComponent 无焦点),无需去重。
+//
+// 参数:
+//   action:    0=DOWN, 1=UP(由 ArkTS KeyType.Down/Up 翻译,其他类型调用方应自行忽略)
+//   keyCode:   OHOS 键码(ArkUI KeyEvent.keyCode,与 OH_NativeXComponent_KeyCode 同数值空间,
+//              nsWindow::OnKeyEvent 映射表可直接复用)
+//   modifiers: 修饰键位掩码(CTRL=1,SHIFT=2,ALT=4,FN=8)
+//              ArkTS 侧用 event.getModifierKeyState 查询组装;C++ 侧 nsWindow::OnKeyEvent
+//              内部另有 down/up 修饰键跟踪兜底(避免设备不填充此字段)。
+// device/time 传 0(转发路径无法稳定获取,nsWindow 不依赖这两个字段做去重/时序)。
+napi_value DispatchKeyEventNapi(napi_env env, napi_callback_info info) {
+    size_t argc = 3;
+    napi_value args[3];
+    napi_value thisArg;
+    napi_get_cb_info(env, info, &argc, args, &thisArg, nullptr);
+    if (argc < 2) {
+        napi_throw_type_error(env, nullptr, "dispatchKeyEvent requires at least 2 args (action, keyCode)");
+        napi_value result;
+        napi_get_null(env, &result);
+        return result;
+    }
+    int32_t action = 0;
+    int32_t keyCode = 0;
+    int32_t modifiers = 0;
+    napi_get_value_int32(env, args[0], &action);
+    napi_get_value_int32(env, args[1], &keyCode);
+    if (argc >= 3) {
+        napi_get_value_int32(env, args[2], &modifiers);
+    }
+    OH_LOG_INFO(LOG_APP, "[KEY] DispatchKeyEvent(ArkTS) action=%{public}d code=%{public}d mods=%{public}d",
+                action, keyCode, modifiers);
+    GeckoBridge_DispatchKeyEvent(action, keyCode, 0, 0, static_cast<uint32_t>(modifiers));
+    napi_value result;
+    napi_get_null(env, &result);
+    return result;
+}
