+// 由 geckoview.so OnSurfaceCreated/OnSurfaceChanged 调用:设置 XComponent 表面尺寸
+// nsWindow::Create 时若 aRect 为 0x0,使用此尺寸作为初始 bounds
+// 根因修复:GeckoView 窗口由 nsIWindowWatcher::OpenWindow 创建,传入的初始尺寸为 0x0
+// (GeckoView.xhtml 未指定 width/height 属性)。若不修正,CompositorBridgeParent
+// 以 surfaceSize=(0,0) 创建,WebRender 不会初始化 RenderCompositorEGL,导致黑屏。
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_SetSurfaceSize(int aWidth, int aHeight) {
+  const int oldW = gSurfaceWidth.load(std::memory_order_relaxed);
+  const int oldH = gSurfaceHeight.load(std::memory_order_relaxed);
+  gSurfaceWidth.store(aWidth, std::memory_order_relaxed);
+  gSurfaceHeight.store(aHeight, std::memory_order_relaxed);
+  OHOS_DiagLog("[XRE] GeckoBridge_SetSurfaceSize width=%d height=%d tid=%zu",
+          aWidth, aHeight,
+          (size_t)std::hash<std::thread::id>{}(std::this_thread::get_id()));
+  // v149: 尺寸变化时同步刷新 nsIScreen 列表(RefreshScreenList 首选
+  // Surface 尺寸作为屏 rect,见 OHOSScreenHelper.cpp v149 注释)。
+  // 自由多窗拖拽改变窗口大小会走 OnSurfaceChanged → 本函数;不刷新则
+  // nsMenuPopupFrame 拿到的约束边界停留在旧窗口尺寸。
+  // 线程:v137 教训——ScreenManager 只允许 Gecko 主线程访问,本函数由
+  // XComponent 回调线程触发,必须 dispatch;启动早期主线程未就绪时
+  // dispatch 失败无妨(OHOSScreenHelper 构造会再刷一次)。
+  if (aWidth > 0 && aHeight > 0 && (aWidth != oldW || aHeight != oldH)) {
+    nsresult rv = NS_DispatchToMainThread(NS_NewRunnableFunction(
+        "OHOSSurfaceSizeRefresh",
+        []() { mozilla::widget::RefreshScreenList(); }));
+    if (NS_FAILED(rv)) {
+      OHOS_DiagLog(
+          "[XRE_SCREEN] SetSurfaceSize dispatch RefreshScreenList failed "
+          "rv=0x%08x (gecko main thread not ready? constructor will refresh)",
+          (unsigned int)rv);
+    }
+  }
+}
