+// Copyright (c) 2010 The Chromium Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef BASE_MESSAGE_PUMP_OHOS_H_
+#define BASE_MESSAGE_PUMP_OHOS_H_
+
+#include "base/message_pump.h"
+#include "base/time.h"
+
+namespace base {
+
+// MessagePumpForUI for OpenHarmony.
+//
+// 移植说明:OpenHarmony 为单进程模型,无原生 UI 消息循环。本实现参考
+// message_pump_android,通过 mozilla::ProcessNextEvent() 驱动 Gecko 主事件
+// 循环。ScheduleWork 通过唤醒机制触发下一次 ProcessNextEvent 迭代。
+class MessagePumpForUI : public MessagePump {
+ public:
+  MessagePumpForUI();
+  ~MessagePumpForUI();
+
+  virtual void Run(Delegate* delegate);
+  virtual void Quit();
+  virtual void ScheduleWork();
+  virtual void ScheduleDelayedWork(const TimeTicks& delayed_work_time);
+
+  // Run 完成一轮工作后调用,处理排队的任务。
+  void HandleDispatch();
+
+ private:
+  struct RunState {
+    Delegate* delegate;
+    bool should_quit;
+    int run_depth;
+    bool more_work_is_plausible;
+  };
+
+  RunState* state_;
+  TimeTicks delayed_work_time_;
+  bool work_scheduled;
+
+  DISALLOW_COPY_AND_ASSIGN(MessagePumpForUI);
+};
+
+}  // namespace base
+
+#endif  // BASE_MESSAGE_PUMP_OHOS_H_
