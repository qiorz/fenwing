+// stage1:无驱动黑名单,所有特性状态交给 GfxInfoBase 的默认判断。
+const nsTArray<RefPtr<GfxDriverInfo>>& GfxInfo::GetGfxDriverInfo() {
+  static nsTArray<RefPtr<GfxDriverInfo>> sDriverInfo;
+  return sDriverInfo;
+}
+
+nsresult GfxInfo::GetFeatureStatusImpl(
+    int32_t aFeature, int32_t* aStatus, nsAString& aSuggestedDriverVersion,
+    const nsTArray<RefPtr<GfxDriverInfo>>& aDriverInfo, nsACString& aFailureId,
+    OperatingSystem* aOS) {
+  NS_ENSURE_ARG_POINTER(aStatus);
+  aSuggestedDriverVersion.SetIsVoid(true);
+  *aStatus = nsIGfxInfo::FEATURE_STATUS_UNKNOWN;
+  // OHOS 尚未在 GfxInfoOperatingSystemDefs.h 中定义 OperatingSystem::OHOS,
+  // 暂用 Unknown(stage1 无驱动黑名单,OS 标识不影响特性判定)。
+  if (aOS) *aOS = OperatingSystem::Unknown;
+
+  // OHOS 平台特性状态判定。
+  //
+  // 背景:OHOS GfxInfo 的 GetAdapterVendorID/DeviceID/DriverVersion 等 stub
+  // 方法返回 NS_ERROR_FAILURE(stage1 未实现 GPU 适配器探测)。这会导致
+  // GfxInfoBase::GetFeatureStatusImpl 在无法解析适配器信息时,对
+  // OnlyAllowFeatureOnKnownConfig(aFeature)==true 的特性(默认包含
+  // FEATURE_WEBRENDER)直接返回 FEATURE_BLOCKED_DEVICE。
+  //
+  // FEATURE_WEBRENDER 被阻挡后,gfxConfig 中 Feature::WEBRENDER 被禁用,
+  // 进而在 gfxPlatform::InitWebRenderConfig 中:
+  //   hasHardware = gfxConfig::IsEnabled(Feature::WEBRENDER) == false
+  //   gfxVars::SetUseSoftwareWebRender(!hasHardware) == true
+  // 导致 RenderCompositor::Create 走 SWGL 软件渲染分支,绕过
+  // RenderCompositorEGL::Create,无法输出到 EGL Surface。
+  //
+  // 修复:OHOS 平台直接声明 WebRender 硬件渲染可用(无驱动黑名单),
+  // 让 hasHardware=true,UseSoftwareWebRender=false,走 EGL 硬件渲染路径。
+  if (aFeature == nsIGfxInfo::FEATURE_WEBRENDER) {
+    *aStatus = nsIGfxInfo::FEATURE_STATUS_OK;
+    return NS_OK;
+  }
+
+  // OpenGL 层在 OHOS 上从不被阻挡(与 Android 同策略)。
+  if (aFeature == nsIGfxInfo::FEATURE_OPENGL_LAYERS) {
+    *aStatus = nsIGfxInfo::FEATURE_STATUS_OK;
+    return NS_OK;
+  }
+
+  // WebGL 在 OHOS 上始终基于 EGL 原生 GL 上下文(与 iOS UIKit 同策略)。
+  //
+  // 背景:gfxPlatform::InitWebGLConfig() 通过 GetFeatureStatus 查询以下四个
+  // 特性,把结果写入 gfxVars:
+  //   FEATURE_WEBGL_OPENGL          -> gfxVars::WebglAllowWindowsNativeGl
+  //   FEATURE_WEBGL2                -> gfxVars::AllowWebgl2
+  //   FEATURE_WEBGL_ANGLE           -> gfxVars::AllowWebglAccelAngle
+  //   FEATURE_WEBGL_USE_HARDWARE    -> gfxVars::WebglUseHardware
+  //
+  // 若不强制 OK,这些特性走 GfxInfoBase 默认判断会因适配器信息不可用
+  // (GetAdapterVendorID 等返回 NS_ERROR_FAILURE)被归类为
+  // FEATURE_BLOCKED_DEVICE。其中 WebglAllowWindowsNativeGl=false 会直接
+  // 阻断 WebGLContext::CreateAndInitGL 的 tryNativeGL 路径
+  // (WebGLContext.cpp:375-387),导致 WebGL 上下文创建失败。
+  //
+  // 实际影响:B站 bili-sc-sdk.umd.js 等需要 WebGL 的网页脚本无法初始化,
+  // 进而 HTML5 播放器加载失败。
+  //
+  // 修复:OHOS 平台基于 EGL/GLES 原生 GL,无 Windows Native GL/ANGLE 概念,
+  // 直接对所有 WebGL 相关特性返回 OK,跳过适配器探测。
+  if (aFeature == nsIGfxInfo::FEATURE_WEBGL_OPENGL ||
+      aFeature == nsIGfxInfo::FEATURE_WEBGL2 ||
+      aFeature == nsIGfxInfo::FEATURE_WEBGL_ANGLE ||
+      aFeature == nsIGfxInfo::FEATURE_WEBGL_USE_HARDWARE) {
+    *aStatus = nsIGfxInfo::FEATURE_STATUS_OK;
+    return NS_OK;
+  }
+
+  // 其余特性交由基类判断(带作用域限定的非虚调用,不会递归回本方法)。
+  return GfxInfoBase::GetFeatureStatusImpl(
+      aFeature, aStatus, aSuggestedDriverVersion, aDriverInfo, aFailureId, aOS);
+}
+
+}  // namespace widget
+}  // namespace mozilla
