+// v159: pan 位移增量 → DOM_DELTA_PIXEL 的 eWheel(主线程滚动唯一通路,
+// 与 onAxisEvent→OnWheelEvent 轨道/触控板同端)。mRefPoint 用当前触摸点,
+// Gecko 命中测试自然找到手指下的正确滚动容器(嵌套滚动正确)。
+// v214: ①mCustomizedByUserPrefs=true —— 豁免 WheelPrefs::ApplyUserPrefsToDelta
+//   的用户乘数 pref(v135 为物理鼠标滚轮调的
+//   mousewheel.default.delta_multiplier_y=70 会被施加到本合成的每个触摸
+//   wheel 上,内容只走手指距离的 70%,fling 同样打折 = "阻尼感"最大来源;
+//   物理鼠标滚轮走 DOM_DELTA_LINE 轨道,其阻尼 pref 不受影响)。
+// ②fling tick 标记 mIsMomentum —— 合成惯性语义,跳过 wheel 特殊动作
+//   (历史快进等),不参与滚动方向意图判定。
+// v217: 返回 wheel 是否被页面 preventDefault(eConsumeNoDefault)——
+// 作为"页面自管滚动"的权威信号(桌面 Firefox 同语义),见 OnTouchEvent 注释。
+bool nsWindow::SynthPanWheel(float aDeltaCssX, float aDeltaCssY,
+                             const mozilla::LayoutDeviceIntPoint& aPos,
+                             bool aIsFling) {
+  WidgetWheelEvent wheel(true, eWheel, this);
+  wheel.mRefPoint = aPos;
+  wheel.mDeltaX = aDeltaCssX;
+  wheel.mDeltaY = aDeltaCssY;
+  wheel.mDeltaZ = 0.0;
+  // 像素模式:增量即 CSS px,Gecko 直接像素滚动(非行滚动,精度1:1跟手)。
+  wheel.mDeltaMode = dom::WheelEvent_Binding::DOM_DELTA_PIXEL;
+  wheel.mIsNoLineOrPageDelta = true;
+  wheel.mInputSource = mozilla::dom::MouseEvent_Binding::MOZ_SOURCE_TOUCH;
+  wheel.mCustomizedByUserPrefs = true;
+  wheel.mIsMomentum = aIsFling;
+  nsEventStatus st = DispatchEvent(&wheel);
+  // v217 诊断:wheel 消费时机(定位"快甩早停"真凶,验证后移除)
+  if (st == nsEventStatus_eConsumeNoDefault) {
+    OHOS_DiagLog("[XRE_PAN_DBG] wheel consumed pos=(%d,%d) d=(%.1f,%.1f) fling=%d",
+            aPos.x, aPos.y, aDeltaCssX, aDeltaCssY, (int)aIsFling);
+  }
+  return st == nsEventStatus_eConsumeNoDefault;
+}
+
+// v214: 松手时刻速度估计 —— 对采样窗(最近 ~100ms,环形缓冲按时间裁剪)
+// 做最小二乘回归,斜率即初速度。相比 v159 的 EMA(0.7/0.3):
+//   - EMA 是一阶滞后滤波器,120Hz 输入下时间常数 ~27ms,轻扫初速系统性
+//     低估 ~30%,fling 起步明显发钝;
+//   - 回归斜率对匀加速的轻扫动作给出平滑末速,对方向反转自然取净趋势。
+// 样本跨度 <8ms 时回退末两样本差分;不足两样本则保持 0(不 fling)。
+void nsWindow::ComputePanVelocityFromSamples() {
+  mPanVelX = 0.0;
+  mPanVelY = 0.0;
+  if (mPanVelCount < 2) {
+    return;
+  }
+  // 展开环形缓冲为按时间升序的线性数组(裁掉 >100ms 的旧样本)。
+  const size_t oldest = (mPanVelHead + kPanVelSamples - mPanVelCount) %
+                        kPanVelSamples;
+  const double tEnd = mPanVelBufT[(mPanVelHead + kPanVelSamples - 1) %
+                                  kPanVelSamples];
+  double ts[kPanVelSamples], xs[kPanVelSamples], ys[kPanVelSamples];
+  size_t n = 0;
+  for (size_t i = 0; i < mPanVelCount; i++) {
+    const size_t idx = (oldest + i) % kPanVelSamples;
+    if (tEnd - mPanVelBufT[idx] > 100.0) {
+      continue;  // 窗外旧样本
+    }
+    ts[n] = mPanVelBufT[idx];
+    xs[n] = mPanVelBufX[idx];
+    ys[n] = mPanVelBufY[idx];
+    n++;
+  }
+  if (n < 2) {
+    // v214d: 输入流抖动时(如合成通道 tick 间隔 >100ms)窗口可能只剩 1 个
+    // 样本 —— 回退用环形缓冲末两样本差分(不设窗),宁可速度略陈旧也不丢
+    // fling;缓冲满 16 样本,真人手指(120Hz)时跨度 ≤144ms,语义不变。
+    const size_t last = (mPanVelHead + kPanVelSamples - 1) % kPanVelSamples;
+    const size_t prev = (mPanVelHead + kPanVelSamples - 2) % kPanVelSamples;
+    const double dt = mPanVelBufT[last] - mPanVelBufT[prev];
+    if (dt > 0.5 && dt < 300.0) {
+      mPanVelX = (mPanVelBufX[last] - mPanVelBufX[prev]) / dt;
+      mPanVelY = (mPanVelBufY[last] - mPanVelBufY[prev]) / dt;
+    }
+    return;
+  }
+  // t 平移到 0 起算,避免大时间戳下的 catastrophic cancellation。
+  const double t0 = ts[0];
+  double st = 0, stt = 0, sx = 0, stx = 0, sy = 0, sty = 0;
+  for (size_t i = 0; i < n; i++) {
+    const double t = ts[i] - t0;
+    st += t;
+    stt += t * t;
+    sx += xs[i];
+    stx += t * xs[i];
+    sy += ys[i];
+    sty += t * ys[i];
+  }
+  const double denom = (double)n * stt - st * st;
+  if (n >= 3 && (tEnd - t0) >= 8.0 && denom > 1e-9) {
+    mPanVelX = ((double)n * stx - st * sx) / denom;
+    mPanVelY = ((double)n * sty - st * sy) / denom;
+  } else {
+    // 窗太窄:回退末两样本差分(斜率的 2 点退化形式)。
+    const double dt = ts[n - 1] - ts[n - 2];
+    if (dt > 0.5) {
+      mPanVelX = (xs[n - 1] - xs[n - 2]) / dt;
+      mPanVelY = (ys[n - 1] - ys[n - 2]) / dt;
+    }
+  }
+}
+
+// v159→v214: 松手 fling —— dt 积分指数衰减。
+// v214 物理重写(替代 0.95/16ms 固定步衰减):
+//   v(t) = v0·e^(−λt),λ = 0.0022/ms(τ≈455ms;2px/ms 轻扫 ≈1.7s/900CSS px,
+//   对齐 Android OverScroller 的 fling 量级;旧 0.95/tick τ≈312ms 偏钝)。
+//   tick 位移 = ∫₀^dt v dt = (v/λ)(1−e^(−λ·dt)) —— 按实际流逝时间积分,
+//   定时器抖动/主线程忙碌造成的 tick 延迟不损失速度,只延后呈现。
+//   亚像素累积:|Δ|<1 CSS px 不派发(尾部速度 <0.125px/ms 时自动降频到
+//   每 2-3 tick 一发,主线程负载自限)。
+//   停止:|v| < 0.01 px/ms 或 500 tick(≈4s 安全上限)。
+//   新 touchstart 即掐断(CancelPanFling);REPEATING 定时器退出路径必 Cancel。
+void nsWindow::OnPanFlingTick() {
+  const double speed = sqrt(mPanVelX * mPanVelX + mPanVelY * mPanVelY);
+  if (speed < 0.01 || ++mPanFlingTicks > 800 || mDestroyed) {
+    CancelPanFling();
+    return;
+  }
+  const double nowMs =
+      (double)PR_IntervalToMilliseconds(PR_IntervalNow());
+  double dt = 8.0;
+  if (mFlingLastTickMs > 0.0 && nowMs > mFlingLastTickMs) {
+    dt = nowMs - mFlingLastTickMs;
+    if (dt > 250.0) {
+      dt = 250.0;  // v219: 32→250ms。主线程 vsync 观察者是停走式投递
+                   // (VsyncDispatcher::NotifyVsync 只在上个事件被主线程
+                   // 处理完后才投递下一个)——重页面主线程一轮 50-100ms 时
+                   // tick 间隔即 50-100ms,旧 32ms 钳制让每次只积分 32ms
+                   // 位移、却隔 100ms 才呈现:fling 变成 ~3 倍时长的慢动作
+                   // +10Hz 更新率(真机日志实证:tick 间隔 102ms 而 d 仅
+                   // 5.4px)。放宽到 250ms 使积分覆盖真实流逝时间,速度/
+                   // 距离/时长物理正确;上限仍防挂起后恢复的巨跳。
+    }
+  }
+  mFlingLastTickMs = nowMs;
+
+  // v215: fling 衰减调轻 0.0022→0.0013/ms(时间常数 455ms→769ms,速度减半
+  //   周期 315ms→533ms)——11.5 真机反馈"触控滑动阻尼感很强":轻扫总行程
+  //   v/λ 被压缩(1000px/s 初速仅 ~455px),明显偏"粘"。0.0013 下同初速
+  //   行程 ~769px,与主流移动端 fling 手感对齐;停止阈值 0.01px/ms 不变。
+  // v216: 0.0013→0.0010(τ≈1000ms)—— v215 后真机反馈"阻尼感还是太强":
+  // 1.24px/ms 轻扫惯性 0.0013 下 ~954 CSS px(1.1 屏),系统浏览器同速度
+  // 2-3 屏;0.0010 下 1240 CSS px(≈1.5 屏),强滑(2px/ms)≈2.4 屏/5.3s。
+  constexpr double kFlingLambda = 0.0010;  // 1/ms
+  const double decay = exp(-kFlingLambda * dt);
+  const double integral = (1.0 - decay) / kFlingLambda;  // ∫₀^dt e^(−λt) dt
+  mFlingAccumX += mPanVelX * integral;
+  mFlingAccumY += mPanVelY * integral;
+  mPanVelX *= decay;
+  mPanVelY *= decay;
+
+  const double mag = sqrt(mFlingAccumX * mFlingAccumX +
+                          mFlingAccumY * mFlingAccumY);
+  if (mag >= 1.0) {
+    // v214c: 滚动锚点取手势起点(mPanLast 可能已进 chrome 区,见头文件注释)。
+    SynthPanWheel((float)mFlingAccumX, (float)mFlingAccumY, mPanFlingRef,
+                  /* aIsFling */ true);
+    mFlingAccumX = 0.0;
+    mFlingAccumY = 0.0;
+  }
+}
+
+void nsWindow::CancelPanFling() {
+  if (mPanFlingVsyncObserver) {
+    if (gfxPlatform::GetPlatform()) {
+      if (RefPtr<mozilla::VsyncDispatcher> disp =
+              gfxPlatform::GetPlatform()->GetGlobalVsyncDispatcher()) {
+        disp->RemoveMainThreadObserver(mPanFlingVsyncObserver);
+      }
+    }
+    mPanFlingVsyncObserver->Detach();
+    mPanFlingVsyncObserver = nullptr;
+  }
+  if (mPanFlingTimer) {
+    mPanFlingTimer->Cancel();
+    mPanFlingTimer = nullptr;
+  }
+}
+
+// v116: 长按超时 —— 在按下点补发 eContextMenu,与 v114 物理右键同路径。
+// ESM 收到 eContextMenu → DOM contextmenu 事件 → browser.xhtml
+// contentAreaContextMenu 弹出(MOZ_SOURCE_TOUCH 语义正确:触屏长按)。
+//
+// v122: 长按选词修复。OHOS stage2 绕过 APZ(见 OnTouchEvent 注释),而 Gecko
+// 触摸选词由 layout/base/AccessibleCaretEventHub 驱动,它仅在收到 eMouseLongTap
+// 时进入选词状态(:468-473)。正常构建里 eMouseLongTap 由 APZ 的
+// GestureEventListener 产生,OHOS 没有 → 永远选不起来。
+// 故此处先发 eMouseLongTap 触发选词;若 hub 已消费(eConsumeNoDefault,即进
+// 入选词),则跳过 eContextMenu 避免选词+菜单双弹;否则按原逻辑发 contextmenu。
+void nsWindow::OnLongPressTimeout() {
+  mLongPressPending = false;
+  mLongPressTimer = nullptr;
+  // v155: 长按已触发(无论进入选词还是弹菜单),本 tap 的 touchend 不再
+  // 合成点击(长按语义与点击互斥,Android 同款)。
+  mTapSynthLongPressFired = true;
+  if (mDestroyed) {
+    return;
+  }
+
+  // 1) 先发 eMouseLongTap 驱动 AccessibleCaretEventHub 进入选词。
+  WidgetMouseEvent longTapEvent(true, eMouseLongTap, this,
+                                WidgetMouseEvent::eReal);
+  longTapEvent.mRefPoint = mLongPressPoint;
+  longTapEvent.mButton = MouseButton::ePrimary;
+  longTapEvent.mClickCount = 1;
+  longTapEvent.mInputSource = mozilla::dom::MouseEvent_Binding::MOZ_SOURCE_TOUCH;
+  nsEventStatus longTapStatus = DispatchEvent(&longTapEvent);
+  const bool longTapConsumed = longTapStatus == nsEventStatus_eConsumeNoDefault;
+  OHOS_DiagLog(
+      "[XRE] OnLongPressTimeout eMouseLongTap pos=(%d,%d) consumed=%d",
+      mLongPressPoint.x, mLongPressPoint.y, longTapConsumed ? 1 : 0);
+
+  // 2) 若 hub 未消费 longTap(未进入选词),按原逻辑补发 eContextMenu 弹菜单。
+  if (longTapConsumed) {
+    return;
+  }
+  WidgetMouseEvent contextMenuEvent(true, eContextMenu, this,
+                                    WidgetMouseEvent::eReal);
+  contextMenuEvent.mRefPoint = mLongPressPoint;
+  contextMenuEvent.mButton = MouseButton::eSecondary;
+  contextMenuEvent.mClickCount = 1;
+  contextMenuEvent.mInputSource =
+      mozilla::dom::MouseEvent_Binding::MOZ_SOURCE_TOUCH;
+  DispatchEvent(&contextMenuEvent);
+  OHOS_DiagLog("[XRE] OnLongPressTimeout 长按500ms,补发 eContextMenu pos=(%d,%d)",
+          mLongPressPoint.x, mLongPressPoint.y);
+}
+
+void nsWindow::CancelLongPressTimer() {
+  mLongPressPending = false;
+  if (mLongPressTimer) {
+    mLongPressTimer->Cancel();
+    mLongPressTimer = nullptr;
+  }
+}
+
+// v155: tap 合成宽限期到期 —— 系统"触摸→合成鼠标"通道若存活,其 mouse 事件
+// 已在 touchstart+~1ms 或 touchend 后数 ms 内到达并取消本定时器;此刻仍无
+// 系统事件即判定通道死亡,由 Gecko 侧合成三连 mouse 事件产生 click。
+void nsWindow::OnTapSynthTimeout() {
+  mTapSynthTimer = nullptr;
+  if (mDestroyed || !mTapSynthArmed) {
+    return;
+  }
+  mTapSynthArmed = false;
+  if (mTapSynthSawSystemMouse || mTapSynthMoved || mTapSynthLongPressFired) {
+    OHOS_DiagLog("[XRE_TAPSYNTH] 宽限期到,跳过合成: systemMouse=%d moved=%d longPress=%d",
+            (int)mTapSynthSawSystemMouse, (int)mTapSynthMoved,
+            (int)mTapSynthLongPressFired);
+    return;
+  }
+  SynthesizeTapMouseEvents(mTapSynthEnd);
+}
+
+void nsWindow::CancelTapSynthTimer() {
+  if (mTapSynthTimer) {
+    mTapSynthTimer->Cancel();
+    mTapSynthTimer = nullptr;
+  }
+}
