diff --git a/intl/locale/ohos/OSPreferences_ohos.cpp b/intl/locale/ohos/OSPreferences_ohos.cpp
new file mode 100644
index 0000000000..83216e887d
--- /dev/null
+++ b/intl/locale/ohos/OSPreferences_ohos.cpp
@@ -0,0 +1,71 @@
+/* -*- Mode: C++; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can get one at http://mozilla.org/mozilla.org/MPL/2.0/. */
+
+// OpenHarmony OSPreferences(stage1)。
+//
+// 无 JNI,stage1 提供默认实现:系统 locale 从环境变量 LANG 读取(类似 POSIX);
+// 日期模式用 ICU 默认。stage2 对接 OHOS 系统属性/设置后再细化。
+
+#include "OSPreferences.h"
+#include "mozilla/Preferences.h"
+#include "prtime.h"
+
+#include <cstdlib>
+#include <cstring>
+
+using namespace mozilla::intl;
+
+OSPreferences::OSPreferences() {}
+
+namespace {
+// 从环境变量 LANG(如 zh_CN.UTF-8)解析 BCP47 locale。
+bool GetLocaleFromEnv(nsCString& aLocale) {
+  const char* lang = getenv("LANG");
+  if (!lang || !*lang) {
+    lang = getenv("LC_ALL");
+  }
+  if (!lang || !*lang) {
+    // OHOS 默认 en-US
+    aLocale = "en-US"_ns;
+    return true;
+  }
+  // 取点号或 @ 之前的部分,并把 _ 换成 -
+  aLocale = nsDependentCString(lang);
+  int32_t dot = aLocale.FindCharInSet(".@");
+  if (dot >= 0) {
+    aLocale.Truncate(dot);
+  }
+  aLocale.ReplaceChar('_', '-');
+  return true;
+}
+}  // namespace
+
+bool OSPreferences::ReadSystemLocales(nsTArray<nsCString>& aLocaleList) {
+  nsAutoCString locale;
+  if (GetLocaleFromEnv(locale)) {
+    aLocaleList.AppendElement(locale);
+    return true;
+  }
+  return false;
+}
+
+bool OSPreferences::ReadRegionalPrefsLocales(nsTArray<nsCString>& aLocaleList) {
+  return ReadSystemLocales(aLocaleList);
+}
+
+bool OSPreferences::ReadDateTimePattern(DateTimeFormatStyle aDateStyle,
+                                        DateTimeFormatStyle aTimeStyle,
+                                        const nsACString& aLocale,
+                                        nsACString& aRetVal) {
+  // 无系统 API,用 ICU 默认 skeleton。
+  nsAutoCString skeleton;
+  if (!GetDateTimeSkeletonForStyle(aDateStyle, aTimeStyle, aLocale, skeleton)) {
+    return false;
+  }
+  return GetPatternForSkeleton(skeleton, aLocale, aRetVal);
+}
+
+void OSPreferences::RemoveObservers() {}
