+extern "C" void GeckoBridge_SaveProfilerProfile() {
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "GeckoBridge_SaveProfilerProfile", []() {
+        const char* home = getenv("HOME");
+        char path[512];
+        snprintf(path, sizeof(path), "%s/profiler.capture.json",
+                 home ? home
+                      : "/data/storage/el2/base/haps/entry/files");
