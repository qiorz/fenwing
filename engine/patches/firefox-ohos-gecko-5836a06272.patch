+// IME 文本插入桥接:由 geckoview.cpp OHOS_OnInsertText 调用
+// aText: 堆分配的 char16_t 缓冲(由 OHOSInsertTextRunnable::Run 释放)
+// aLength: char16_t 元素个数
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_InsertText(const char16_t* aText, size_t aLength) {
+  nsWindow* topWin = nsWindow::GetTopActiveWindow();
+  OHOS_DiagLog("[XRE] GeckoBridge_InsertText length=%zu topWin=%p",
+          aLength, (void*)topWin);
+  if (!topWin || !aText || aLength == 0) {
+    // 即使无窗口也要释放缓冲,避免内存泄漏
+    delete[] const_cast<char16_t*>(aText);
+    return;
+  }
+  // 派发到 Gecko 主线程,与触摸/鼠标事件同模式
+  // 缓冲所有权转移给 Runnable,Run() 中 delete[] 释放
+  NS_DispatchToMainThread(
+      mozilla::MakeAndAddRef<OHOSInsertTextRunnable>(
+          topWin, const_cast<char16_t*>(aText), aLength));
+}
