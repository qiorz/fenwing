diff --git a/servo/components/style/global_style_data.rs b/servo/components/style/global_style_data.rs
index c2ac902f78..66134add0f 100644
--- a/servo/components/style/global_style_data.rs
+++ b/servo/components/style/global_style_data.rs
@@ -85,7 +85,21 @@ fn thread_spawn(options: rayon::ThreadBuilder) -> io::Result<()> {
     if let Some(stack_size) = options.stack_size() {
         b = b.stack_size(stack_size);
     }
-    let join_handle = b.spawn(|| options.run())?;
+    // v218 (OHOS): HM 调度器大小核选核只看线程 QoS 属性。Stylo 并行样式
+    // 计算会阻塞主线程(join 等待),标 USER_INITIATED(3) 让 reflow 落性能核。
+    // 助手定义在 libxul 内(gfx/webrender_bindings/RenderThread.cpp),静态
+    // 链入同一 libxul.so,链接期解析;非 OHOS 目标 cfg 不编译。
+    let join_handle = b.spawn(|| {
+        #[cfg(all(target_os = "linux", target_env = "ohos"))]
+        {
+            extern "C" {
+                fn OHOS_ApplyThreadQoS(qos: i32, thread_name: *const u8);
+            }
+            let name = b"StyleThread";
+            unsafe { OHOS_ApplyThreadQoS(3, name.as_ptr()) };
+        }
+        options.run()
+    })?;
     STYLE_THREAD_JOIN_HANDLES.lock().push(join_handle);
     Ok(())
 }
