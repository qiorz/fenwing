+// ============================================================================
+// libxul.so 导出符号声明
+// ============================================================================
+// GeckoBridge_SetNativeWindow 由 widget/openharmony/OHOSNativeWindowBridge.cpp
+// 实现,在 libxul.symbols 中导出,用于将 XComponent 的 OHNativeWindow 传递到
+// libxul.so 内部的 HeadlessWidget,供 GLContextProviderEGL 创建 EGLSurface。
+// 注意:本模块编译使用 -fvisibility=hidden,声明外部库符号时必须显式标记
+// visibility("default"),否则链接器会将引用视为本模块内 hidden 符号定义
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_SetNativeWindow(void* aWindow);
