diff --git a/widget/openharmony/OHOSURILoader.cpp b/widget/openharmony/OHOSURILoader.cpp
new file mode 100644
index 0000000000..b67a1851d7
--- /dev/null
+++ b/widget/openharmony/OHOSURILoader.cpp
@@ -0,0 +1,1212 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// OpenHarmony URI 加载器
+//
+// 作用:实现 GeckoBridge_LoadURL 导出符号,供 libgeckoview.so / libgeckoxcomp.so
+// 副本通过 NAPI 接口调用,主动加载指定 URL。
+//
+// 设计原理(参考 Android GeckoView 架构):
+//   桌面 Firefox 通过 -url <url> 命令行参数 + BrowserContentHandler
+//   (command-line-handler 类目)在 nsAppRunner::XRE_mainRun 中创建 chrome
+//   窗口并加载 URL。但 OHOS 平台 mobile/ohos/app.mozbuild 未包含 /browser
+//   目录,BrowserContentHandler 未构建,-url 参数被静默忽略。
+//
+//   OHOS 平台初始 URL 加载方案:geckoview.cpp 的 GeckoMainThread 在调用
+//   XRE_main 前设置 OHOS_INITIAL_URL 环境变量,geckoview.js 的 startup()
+//   在创建 browser 元素后从环境变量读取 URL 并通过 browsingContext.loadURI
+//   加载。这绕过了 GeckoBridge_LoadURL 的复杂链路,直接在 geckoview.js 中
+//   加载初始 URL,更可靠。
+//
+//   GeckoBridge_LoadURL 仅负责后续用户主动输入新 URL 时的加载(通过 NAPI),
+//   此时 geckoview 窗口已存在。
+//
+// 数据流(初始 URL):
