+/* -*- Mode: C++; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// v118: 下载进度回调跨 .so 桥(libxul.so ↔ libgeckoview.so ↔ ArkTS)
+//
+// 范式完全照抄 OHOSFilePickerBridge.cpp / OHOSProgressListener.cpp 的
+// "函数指针注册 + tsfn" 模型(单向通知,无回填):
+//   1. libgeckoview.so 启动时调 GeckoBridge_SetDownloadCallback,把本 .so 内的
+//      OHOS_DownloadNotify(实为 geckoview.cpp 中的 C 函数)注册进来。
+//   2. libxul.so 内 nsExternalAppHandler 在下载 start/progress/complete/failed
+//      四处调 OHOSDownloadBridge_Notify,经存储的函数指针转发到 libgeckoview.so
+//      → napi_threadsafe_function → ArkTS downloadCallback。
+//
+// 与文件选择器不同,下载是单向通知(ArkTS 不需要回填结果),故只有
+// GeckoBridge_SetDownloadCallback 一个导出符号。
+//
+// JSON 事件契约(字段固定,id 为 int64 数字,ArKTS 侧用 number 接收):
+//   {"type":"start","id":N,"url":"..","filename":"..","totalBytes":N,"path":".."}
+//   {"type":"progress","id":N,"receivedBytes":N,"totalBytes":N}
+//   {"type":"complete","id":N,"path":".."}
+//   {"type":"failed","id":N,"errorCode":"0x.."}
+
+#ifndef widget_openharmony_OHOSDownloadBridge_h__
+#define widget_openharmony_OHOSDownloadBridge_h__
+
+namespace mozilla {
+namespace widget {
+
+// 由 libxul.so 内部(nsExternalAppHandler 各插桩点)调用:下发下载事件 JSON。
+// 内部经 gDownloadNotifyCb 转发到 libgeckoview.so。
+// 未注册时记日志并直接返回(下载为单向通知,无需兜底处理)。
+void OHOSDownloadBridge_Notify(const char* aJson);
+
+}  // namespace widget
+}  // namespace mozilla
+
+#endif  // widget_openharmony_OHOSDownloadBridge_h__
