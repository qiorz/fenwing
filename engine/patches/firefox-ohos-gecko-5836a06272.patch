+
+// OpenHarmony GeckoView View 实现(对标 Android 的 AndroidView)
+//
+// 实现细节见 OHOSView.h 头部注释。
+
+#include "OHOSDebug.h"
+#include "OHOSView.h"
+
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <unordered_map>
+
+#include "jsapi.h"
+#include "js/JSON.h"  // JS_ParseJSON
+#include "mozilla/dom/ScriptSettings.h"  // dom::AutoJSAPI
+#include "nsContentUtils.h"  // nsContentUtils::StringifyJSON, JSONBehavior
+#include "nsGlobalWindowInner.h"  // v88: TabManager JS 调用
+#include "nsIGlobalObject.h"      // v88: nsIGlobalObject
+#include "nsIWindowMediator.h"    // v88: 查找 geckoview 窗口
+#include "nsIWindowWatcher.h"
+#include "nsJSUtils.h"       // nsAutoJSString
+#include "nsPIDOMWindow.h"   // v88: 获取窗口脚本上下文
+#include "nsServiceManagerUtils.h"  // do_GetService
+#include "nsThreadUtils.h"   // NS_DispatchToMainThread, Runnable
+#include "xpcpublic.h"       // xpc::PrivilegedJunkScope
+
+namespace mozilla::widget {
+
+// ============================================================================
+// libxul ← libgeckoview 桥接函数指针
+// ============================================================================
+// 由 libgeckoview.so 的 registerNavigationCallback 注册:
+//   GeckoBridge_SetDispatchCallback:Gecko → ArkTS 派发函数指针
+//   GeckoBridge_SetResolveCallback:占位(resolve 由 NAPI 直接调 libxul 导出符号)
+
+// Gecko → ArkTS 派发函数指针(由 libgeckoview.so 注册)
+// 参数:event 名(UTF-8)、data(JSON UTF-8)、callbackId(0 表示无需回调)
+// 返回值:0=已派发成功(不保证 ArkTS 已处理)
+typedef int (*OHOS_DispatchToArkTSFunc)(const char* aEvent, const char* aData,
+                                        int32_t aCallbackId);
+static std::atomic<OHOS_DispatchToArkTSFunc> gDispatchToArkTSFunc{nullptr};
+
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_SetDispatchCallback(
+    OHOS_DispatchToArkTSFunc aFunc) {
+  gDispatchToArkTSFunc.store(aFunc);
+  OHOS_LOG("[XRE] GeckoBridge_SetDispatchCallback 已注册 func=%p\n",
+          (void*)aFunc);
+}
+
+// ============================================================================
+// 待处理回调表(Gecko 主线程)
+// ============================================================================
+// OHOSView::Dispatch 为每个带 callback 的派发分配唯一 callbackId,
+// 存入此表。ArkTS 处理后通过 GeckoBridge_ResolveNavigationEvent 回调,
+// 在 Gecko 主线程查表取出 nsIGeckoViewEventCallback,调用 onSuccess/onError。
+//
+// 线程安全:仅在 Gecko 主线程访问(Dispatch 在主线程,Resolve 通过
+// NS_DispatchToMainThread 也在主线程)。仍加 mutex 防御性保护。
+
+struct PendingCallback {
+  nsCOMPtr<nsIGeckoViewEventCallback> callback;
+  nsCOMPtr<nsIGeckoViewEventFinalizer> finalizer;
+};
+
+static std::mutex sPendingCallbacksMutex;
+static std::unordered_map<int32_t, PendingCallback> sPendingCallbacks;
+static std::atomic<int32_t> sNextCallbackId{1};
+
+// 由 libgeckoview.so 调用(NAPI 主线程),派发到 Gecko 主线程执行。
+// 在 Gecko 主线程查表取 callback,调 onSuccess/onError,
+// 解析 sendRequestForResult 的 Promise,解除 spinEventLoopUntil 阻塞。
+class ResolveNavigationEventRunnable final : public mozilla::Runnable {
+ public:
+  ResolveNavigationEventRunnable(int32_t aCallbackId, bool aSuccess,
+                                 const nsCString& aResult)
+      : mozilla::Runnable("ResolveNavigationEventRunnable"),
+        mCallbackId(aCallbackId),
+        mSuccess(aSuccess),
+        mResult(aResult) {}
+
+  NS_IMETHOD Run() override {
+    PendingCallback pc;
+    bool found = false;
+    {
+      std::lock_guard<std::mutex> lock(sPendingCallbacksMutex);
+      auto it = sPendingCallbacks.find(mCallbackId);
+      if (it != sPendingCallbacks.end()) {
+        pc = std::move(it->second);
+        sPendingCallbacks.erase(it);
+        found = true;
+      }
+    }
+    if (!found) {
+      OHOS_LOG("[XRE] ResolveNavigationEvent callbackId=%d 未找到(已超时或重复)\n",
+              mCallbackId);
+      return NS_OK;
+    }
+
+    OHOS_LOG("[XRE] ResolveNavigationEvent callbackId=%d success=%d result=%s\n",
+            mCallbackId, mSuccess ? 1 : 0, mResult.get());
+
+    // 解析 result JSON 为 JS::Value,传给 onSuccess/onError。
+    // 此 Runnable 在 Gecko 主线程执行,用 AutoJSAPI + PrivilegedJunkScope
+    // 获取可用 JSContext(参考 EventDispatcherBase::Dispatch 惯用法)。
+    mozilla::dom::AutoJSAPI jsapi;
+    if (!jsapi.Init(xpc::PrivilegedJunkScope())) {
+      OHOS_LOG("[XRE] ResolveNavigationEvent AutoJSAPI Init 失败\n");
+      return NS_ERROR_FAILURE;
+    }
+    JSContext* cx = jsapi.cx();
+
+    // 构造回传给 Gecko 的 JS::Value。
+    // LoadURIDelegate.load 的 sendRequestForResult response 语义:
+    //   falsy(false/空) = ALLOW(Gecko 继续加载)
+    //   truthy(非空) = 已处理(Gecko abort)
+    // 因此空 result 应传 JS false(明确 falsy),不能传 undefined
+    // (undefined 会导致 spinEventLoopUntil 的 handled !== undefined 永远为 false)。
+    JS::Rooted<JS::Value> resultVal(cx, JS::BooleanValue(false));
+    if (!mResult.IsEmpty()) {
+      // result 是字符串值(ArkTS 传 allow/deny 或 JSON),用 UTF-8 创建 JSString。
+      JS::Rooted<JSString*> str(
+          cx, JS_NewStringCopyUTF8N(
+                  cx, JS::UTF8Chars(mResult.get(), mResult.Length())));
+      if (str) {
+        resultVal.setString(str);
+      }
+    }
+
+    if (mSuccess && pc.callback) {
+      pc.callback->OnSuccess(resultVal, cx);
+    } else if (!mSuccess && pc.callback) {
+      pc.callback->OnError(resultVal, cx);
+    }
+    if (pc.finalizer) {
+      pc.finalizer->OnFinalize();
+    }
+    return NS_OK;
+  }
+
+ private:
+  int32_t mCallbackId;
+  bool mSuccess;
+  nsCString mResult;
+};
+
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_ResolveNavigationEvent(int32_t aCallbackId,
+                                                    bool aSuccess,
+                                                    const char* aResult) {
+  nsCString result(aResult ? aResult : "");
+  NS_DispatchToMainThread(
+      mozilla::MakeAndAddRef<ResolveNavigationEventRunnable>(aCallbackId,
+                                                              aSuccess, result));
+}
+
+// ============================================================================
+// OHOSView 实现
+// ============================================================================
+
+NS_IMPL_ISUPPORTS(OHOSView, nsIGeckoViewEventDispatcher, nsIGeckoViewView)
+
+OHOSView::OHOSView() {
+  OHOS_LOG("[XRE] OHOSView::OHOSView this=%p\n", (void*)this);
+}
+
+OHOSView::~OHOSView() {
+  OHOS_LOG("[XRE] OHOSView::~OHOSView this=%p\n", (void*)this);
+}
+
+void OHOSView::SetInitData(JSContext* aCx, JS::Handle<JS::Value> aInitData) {
+  // 将 initData 序列化为 JSON 字符串存储,GetInitData 时反序列化。
+  // 这样避免跨 JSContext / 跨线程持有 JS::Value 的 GC 复杂性。
+  if (aInitData.isNullOrUndefined()) {
+    mInitDataJSON.Truncate();
+    return;
+  }
+  nsAutoString json;
+  if (nsContentUtils::StringifyJSON(
+          aCx, aInitData, json,
+          mozilla::dom::UndefinedIsNullStringLiteral)) {
+    mInitDataJSON = json;
+  }
+}
+
+// nsIGeckoViewEventDispatcher::dispatch
+// 由 GeckoViewNavigation/LoadURIDelegate 等通过 Messaging.sys.mjs 调用,
+// 将事件(如 GeckoView:OnLoadRequest、GeckoView:OnNewSession)派发到 ArkTS。
+// 注意:[implicit_jscontext] 生成的 cx 参数在方法末尾(非开头)。
+NS_IMETHODIMP
+OHOSView::Dispatch(JS::Handle<JS::Value> aEvent, JS::Handle<JS::Value> aData,
+                   nsIGeckoViewEventCallback* aCallback,
+                   nsIGeckoViewEventFinalizer* aFinalizer, JSContext* aCx) {
+  // 1. 提取 event 名(UTF-8)
+  nsAutoString eventW;
+  if (aEvent.isString()) {
+    JS::Rooted<JSString*> eventStr(aCx, aEvent.toString());
+    nsAutoJSString autoStr;
+    if (autoStr.init(aCx, eventStr)) {
+      eventW = autoStr;
+    }
+  }
+  NS_ConvertUTF16toUTF8 eventUtf8(eventW);
+
+  // 2. 序列化 data 为 JSON(UTF-8)
+  nsAutoCString dataUtf8("null");
+  if (!aData.isNullOrUndefined()) {
+    nsAutoString jsonW;
+    if (nsContentUtils::StringifyJSON(
+            aCx, aData, jsonW,
+            mozilla::dom::UndefinedIsNullStringLiteral)) {
+      dataUtf8 = NS_ConvertUTF16toUTF8(jsonW);
+    }
+  }
+
+  // OHOS 多窗口:拦截 GeckoView:OnNewSession,直接在 C++ 层创建第二窗口。
+  // 不走 NAPI 往返(避免 spinEventLoopUntil 嵌套 + NAPI tsfn 死锁)。
+  // createContentWindow 的 #handleNewSessionAsync 发出 OnNewSession 后,
+  // 用 spinEventLoopUntil 等待结果。我们在 C++ 层直接 OpenWindow 创建
+  // 第二个 geckoview.xhtml(name=newSessionId),第二窗口的 onInitBrowser
+  // 发 geckoview-window-created 通知,waitAndSetupWindow observer 匹配并
+  // resolve。createContentWindow 拿到新 window 的 browser.browsingContext,
+  // docshell 加载 target=_blank 的 URI。
+  if (eventUtf8.EqualsLiteral("GeckoView:OnNewSession") && aCallback) {
+    OHOS_LOG("[XRE] OHOSView::Dispatch 拦截 OnNewSession,直接创建第二窗口\n");
+
+    // 解析 data JSON 提取 newSessionId
+    // data 格式: {"uri":"...","newSessionId":"abcdef..."}
+    nsAutoCString sessionId;
+    int32_t idStart = dataUtf8.Find("\"newSessionId\":\"");
+    if (idStart >= 0) {
+      idStart += strlen("\"newSessionId\":\"");
+      int32_t idEnd = dataUtf8.Find("\"", idStart);
+      if (idEnd > idStart) {
+        sessionId = Substring(dataUtf8, idStart, idEnd - idStart);
+      }
+    }
+
+    OHOS_LOG("[XRE] OnNewSession sessionId=%s\n", sessionId.get());
+
+    if (!sessionId.IsEmpty()) {
+      // 调 nsIWindowWatcher::OpenWindow 创建第二 geckoview.xhtml 窗口。
+      // name=sessionId,使 waitAndSetupWindow 的 observer (window.name===sessionId) 匹配。
+      nsCOMPtr<nsIWindowWatcher> ww =
+          do_GetService(NS_WINDOWWATCHER_CONTRACTID);
+      if (ww) {
+        nsAutoCString chromeUri("chrome://geckoview/content/geckoview.xhtml");
+        nsAutoCString features("chrome,dialog=no,all");
+        nsCOMPtr<mozIDOMWindowProxy> newWindow;
+        nsresult rv = ww->OpenWindow(nullptr, chromeUri, sessionId, features,
+                                     nullptr, getter_AddRefs(newWindow));
+        OHOS_LOG("[XRE] OnNewSession OpenWindow rv=0x%x newWindow=%p\n",
+                (unsigned)rv, (void*)newWindow.get());
+
+        if (NS_SUCCEEDED(rv) && newWindow) {
+          // 第二窗口创建成功。geckoview.js startup 会 createBrowser +
+          // ModuleManager.init,onInitBrowser 发 geckoview-window-created。
+          // waitAndSetupWindow observer 匹配 window.name===sessionId 后 resolve。
+          // createContentWindow 的 spinEventLoopUntil 会处理这些事件。
+          // 回传 didOpenSession=true(成功打开新会话)。
+          JS::Rooted<JS::Value> trueVal(aCx, JS::BooleanValue(true));
+          aCallback->OnSuccess(trueVal, aCx);
+          if (aFinalizer) {
+            aFinalizer->OnFinalize();
+          }
+          return NS_OK;
+        }
+      }
+    }
+
+    // 创建失败:回传 false(reject),createContentWindow 安全取消导航
+    OHOS_LOG("[XRE] OnNewSession 创建第二窗口失败,返回 false\n");
+    JS::Rooted<JS::Value> falseVal(aCx, JS::BooleanValue(false));
+    aCallback->OnSuccess(falseVal, aCx);
+    if (aFinalizer) {
+      aFinalizer->OnFinalize();
+    }
+    return NS_OK;
+  }
+
+  // 3. 分配 callbackId(若需要回调)
+  int32_t callbackId = 0;
+  if (aCallback) {
+    callbackId = sNextCallbackId.fetch_add(1);
+    std::lock_guard<std::mutex> lock(sPendingCallbacksMutex);
+    sPendingCallbacks[callbackId] = {aCallback, aFinalizer};
+  }
+
+  OHOS_LOG("[XRE] OHOSView::Dispatch event=%s data=%s callbackId=%d\n",
+          eventUtf8.get(), dataUtf8.get(), callbackId);
+
+  // 4. 调用 libgeckoview.so 注册的派发函数,转发到 ArkTS
+  auto func = gDispatchToArkTSFunc.load();
+  if (func) {
+    func(eventUtf8.get(), dataUtf8.get(), callbackId);
+  } else {
+    // 桥未注册:直接 reject 回调,避免 spinEventLoopUntil 死锁
+    OHOS_LOG("[XRE] OHOSView::Dispatch 桥未注册(event=%s),拒绝回调避免死锁\n",
+            eventUtf8.get());
+    if (callbackId != 0) {
+      std::lock_guard<std::mutex> lock(sPendingCallbacksMutex);
+      sPendingCallbacks.erase(callbackId);
+    }
+    if (aCallback) {
+      JS::Rooted<JS::Value> errVal(aCx, JS::NullValue());
+      aCallback->OnError(errVal, aCx);
+    }
+  }
+
+  return NS_OK;
+}
+
+// nsIGeckoViewEventDispatcher::registerListener
+// OHOS 不使用 Gecko 内部监听器机制(事件直接由 ArkTS 处理),空实现。
+// 注意:cx 参数在末尾。
+NS_IMETHODIMP
+OHOSView::RegisterListener(nsIGeckoViewEventListener* aListener,
+                           JS::Handle<JS::Value> aEvents, JSContext* aCx) {
+  OHOS_LOG("[XRE] OHOSView::RegisterListener (no-op, OHOS 不用内部监听器)\n");
+  return NS_OK;
+}
+
+// nsIGeckoViewEventDispatcher::unregisterListener
+// 注意:cx 参数在末尾。
+NS_IMETHODIMP
+OHOSView::UnregisterListener(nsIGeckoViewEventListener* aListener,
+                             JS::Handle<JS::Value> aEvents, JSContext* aCx) {
+  return NS_OK;
+}
+
+// nsIGeckoViewView::initData
+// 反序列化存储的 JSON 为 JS::Value 返回。
+// initData 结构:{ settings: {...}, modules: { GeckoViewNavigation: true, ... } }
+NS_IMETHODIMP
+OHOSView::GetInitData(JSContext* aCx, JS::MutableHandle<JS::Value> aInitData) {
+  if (mInitDataJSON.IsEmpty()) {
+    // 默认 initData(启用导航模块 GeckoViewNavigation,允许 JS 等)
+    // 与 geckoview.js 容错路径的默认值一致。
+    // 用 Latin1Char 重载(纯 ASCII)。
+    static const JS::Latin1Char defaultJson[] =
+        "{\"settings\":{\"allowJavascript\":true,\"displayMode\":0,"
+        "\"userAgentMode\":0,\"viewportMode\":0,\"useTrackingProtection\":"
+        "false,\"suspendMediaWhenInactive\":false,\"isExtensionPopup\":false,"
+        "\"userAgentOverride\":null},"
+        "\"modules\":{\"GeckoViewNavigation\":true}}";
+    JS::Rooted<JS::Value> val(aCx);
+    if (JS_ParseJSON(aCx, defaultJson,
+                     sizeof(defaultJson) / sizeof(JS::Latin1Char) - 1, &val)) {
+      aInitData.set(val);
+    } else {
+      aInitData.setNull();
+    }
+    return NS_OK;
+  }
+
+  // 解析存储的 JSON(mInitDataJSON 是 UTF-16 nsString,用 char16_t 重载)
+  JS::Rooted<JS::Value> val(aCx);
+  if (JS_ParseJSON(aCx, mInitDataJSON.get(), mInitDataJSON.Length(), &val)) {
+    aInitData.set(val);
+  } else {
+    aInitData.setNull();
+  }
+  return NS_OK;
+}
+
+}  // namespace mozilla::widget
+
+// ============================================================================
+// v88: TabManager JS 调用桥(geckoview.cpp NAPI → geckoview.js TabManager)
+// ============================================================================
+// 在 Gecko 主线程找到 navigator:geckoview 窗口,通过其脚本上下文调用
+// geckoview.js 中定义的全局 TabManager 对象的方法。
+//
+// 由于 TabManager 在 geckoview.js 中声明为 `var TabManager = {...}`,
+// 它挂在 window 全局作用域。通过 window 的 nsIGlobalObject 获取 JSContext,
+// 用 JS_GetProperty 取 TabManager 和对应方法,JS_CallFunctionName 调用。
+//
+// action: "create" | "switch" | "close"
+// sessionId: 标签标识(字符串形式数字)
+// url: 仅 create 用
+class TabManagerCallRunnable : public mozilla::Runnable {
+ public:
+  TabManagerCallRunnable(const nsCString& aAction, const nsCString& aSessionId,
+                         const nsCString& aUrl)
+      : mozilla::Runnable("TabManagerCallRunnable"),
+        mAction(aAction), mSessionId(aSessionId), mUrl(aUrl) {}
+
+  NS_IMETHOD Run() override {
+    nsCOMPtr<nsIWindowMediator> mediator =
+        do_GetService(NS_WINDOWMEDIATOR_CONTRACTID);
+    if (!mediator) return NS_OK;
+    nsCOMPtr<mozIDOMWindowProxy> recentWindow;
+    mediator->GetMostRecentWindow(u"navigator:geckoview",
+                                  getter_AddRefs(recentWindow));
+    if (!recentWindow) {
+      OHOS_LOG("[XRE] TabManagerCallRunnable: 未找到窗口\n");
+      return NS_OK;
+    }
+    nsCOMPtr<nsPIDOMWindowOuter> piWin = do_QueryInterface(recentWindow);
+    if (!piWin) return NS_OK;
+    nsCOMPtr<nsPIDOMWindowInner> inner = piWin->GetCurrentInnerWindow();
+    if (!inner) return NS_OK;
+    nsGlobalWindowInner* globalWin = nsGlobalWindowInner::Cast(inner);
+    if (!globalWin) return NS_OK;
+    nsIGlobalObject* sgo = globalWin;
+    if (!sgo) return NS_OK;
+
+    // 进入脚本上下文
+    mozilla::dom::AutoEntryScript aes(sgo, "TabManagerCall");
+    JSContext* cx = aes.cx();
+    JS::Rooted<JSObject*> global(cx, sgo->GetGlobalJSObject());
+    if (!global) return NS_OK;
+
+    // 取 TabManager 全局对象
+    JS::Rooted<JS::Value> tabManagerVal(cx);
+    if (!JS_GetProperty(cx, global, "TabManager", &tabManagerVal) ||
+        !tabManagerVal.isObject()) {
+      OHOS_LOG("[XRE] TabManagerCallRunnable: TabManager 未找到\n");
+      return NS_OK;
+    }
+    JS::Rooted<JSObject*> tabManager(cx, &tabManagerVal.toObject());
+
+    // 选择方法名 + 参数
+    nsCString methodName;
+    JS::RootedValueArray<2> args(cx);
+    JS::RootedString sidStr(
+        cx, JS_NewStringCopyZ(cx, mSessionId.get()));
+    args[0].setString(sidStr ? sidStr
+                             : JS_GetEmptyString(cx));
+
+    if (mAction.EqualsLiteral("create")) {
+      methodName = "createBrowserForSession";
+      JS::RootedString urlStr(cx, JS_NewStringCopyZ(cx, mUrl.get()));
+      args[1].setString(urlStr ? urlStr : JS_GetEmptyString(cx));
+    } else if (mAction.EqualsLiteral("switch")) {
+      methodName = "switchSession";
+    } else if (mAction.EqualsLiteral("close")) {
+      methodName = "closeSession";
+    } else {
+      return NS_OK;
+    }
+
+    JS::Rooted<JS::Value> rval(cx);
+    if (!JS_CallFunctionName(cx, tabManager, methodName.get(), args, &rval)) {
+      OHOS_LOG("[XRE] TabManagerCallRunnable: 调用 %s 失败\n",
+              methodName.get());
+      aes.ReportException();
+    }
+    return NS_OK;
+  }
+
+ private:
+  nsCString mAction;
+  nsCString mSessionId;
+  nsCString mUrl;
+};
+
+// 由 geckoview.cpp NAPI 调用:派发到 Gecko 主线程调用 TabManager
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_CallTabManager(const char* aAction,
+                                            const char* aSessionId,
+                                            const char* aUrl) {
+  if (!aAction || !aSessionId) return;
+  nsCString action(aAction);
+  nsCString sessionId(aSessionId);
+  nsCString url(aUrl ? aUrl : "");
+  NS_DispatchToMainThread(mozilla::MakeAndAddRef<TabManagerCallRunnable>(
+      action, sessionId, url));
+}
diff --git a/widget/openharmony/OHOSView.h b/widget/openharmony/OHOSView.h
new file mode 100644
index 0000000000..7bd1cbede4
--- /dev/null
+++ b/widget/openharmony/OHOSView.h
@@ -0,0 +1,81 @@
+/* -*- Mode: C++; tab-width: 8; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+ * vim: set ts=8 sts=2 et sw=2 tw=80:
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0. */
+
+#ifndef mozilla_widget_OHOSView_h
+#define mozilla_widget_OHOSView_h
+
+// OpenHarmony GeckoView View 实现(对标 Android 的 AndroidView)
+//
+// 作用:实现 nsIGeckoViewView 接口,作为 GeckoView 窗口的 window.arguments[0]。
+//       它既是事件分发器(Gecko → ArkTS),也携带 initData(模块启用/设置)。
+//
+// 设计原理(复用 OHOS 项目已验证的跨 .so 桥接范式):
+//   libgeckoview.so 中 registerNavigationCallback 创建 napi_threadsafe_function,
+//   但该句柄存在 libgeckoview.so 全局状态,libxul.so 无法直接访问。
+//   采用"函数指针注册"模式:
+//     1. libgeckoview.so 将 C 函数指针注册到 libxul.so
+//        (GeckoBridge_SetDispatchCallback / GeckoBridge_SetResolveCallback)
+//     2. libxul.so 中 OHOSView::Dispatch 调用 GeckoBridge_DispatchToArkTS,
+//        该函数调用 libgeckoview.so 注册的函数指针,最终通过
+//        napi_threadsafe_function 回调到 ArkTS 主线程
+//     3. ArkTS 处理完导航事件后,调用 resolveNavigationEvent(callbackId, ...),
+//        libgeckoview.so 通过 GeckoBridge_ResolveNavigationEvent 把结果派发到
+//        Gecko 主线程,解析 sendRequestForResult 的 JS Promise
+//
+// 数据流(Gecko → ArkTS,导航事件如 GeckoView:OnLoadRequest):
+//   GeckoViewNavigation.sys.mjs sendRequestForResult
+//     → Messaging.sys.mjs dispatch
+//     → OHOSView::Dispatch(cx, event, data, callback, finalizer)
+//     → 分配 callbackId,存入 sPendingCallbacks[callbackId] = {callback, finalizer}
+//     → GeckoBridge_DispatchToArkTS(eventUtf8, dataUtf8, callbackId)
+//     → libgeckoview.so gDispatchCallback(eventUtf8, dataUtf8, callbackId)
+//     → napi_call_threadsafe_function(navigationCallback, ...)
+//     → ArkTS FirefoxBridge navigationCallback(event, data, callbackId)
+//
+// 数据流(ArkTS → Gecko,回传导航决策结果):
+//   ArkTS resolveNavigationEvent(callbackId, success, resultJson)
+//     → libgeckoview.so ResolveNavigationEvent
+//     → GeckoBridge_ResolveNavigationEvent(callbackId, success, resultJson)
+//       (NS_DispatchToMainThread 派发到 Gecko 主线程)
+//     → ResolveNavigationEventRunnable::Run
+//     → 查 sPendingCallbacks[callbackId] 取出 callback
+//     → success ? callback->onSuccess(result) : callback->onError(result)
+//     → Messaging.sys.mjs Promise resolve/reject
+//     → spinEventLoopUntil 解除阻塞
+
+#include "jsapi.h"
+#include "nsCOMPtr.h"
+#include "nsIGeckoViewBridge.h"
+#include "nsISupports.h"
+#include "nsString.h"
+
+namespace mozilla::widget {
+
+class OHOSView final : public nsIGeckoViewView {
+ public:
+  NS_DECL_ISUPPORTS
+  NS_DECL_NSIGECKOVIEWVIEW
+  NS_DECL_NSIGECKOVIEWEVENTDISPATCHER
+
+  OHOSView();
+
+  // 设置 initData(JS 对象,含 settings + modules)。
+  // 由窗口创建路径在 OpenWindow 前调用,使 GeckoViewNavigation 等模块被启用。
+  // aCx/aInitData 所有权:OHOSView 持有 initData 的独立 JS::PersistentRootedValue 副本。
+  void SetInitData(JSContext* aCx, JS::Handle<JS::Value> aInitData);
+
+ private:
+  ~OHOSView();
+
+  // initData 序列化为 JSON 字符串存储(避免跨 JSContext 持有 JS::Value 的
+  // GC 复杂性)。GetInitData 时用 JS_ParseJSON 反序列化返回。
+  // 结构:{ settings: {...}, modules: { GeckoViewNavigation: true, ... } }
+  nsString mInitDataJSON;
+};
+
+}  // namespace mozilla::widget
+
+#endif  // mozilla_widget_OHOSView_h
