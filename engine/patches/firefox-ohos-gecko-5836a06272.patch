+// v250: ArkTS → chrome JS 同步调用(window.OHOSChromeBridge.call)
+// 参数:method:string, arg:string(JSON);返回:string(结果 JSON,可为空串)
+// 底层 GeckoBridge_ChromeJSCall 同步等 Gecko 主线程(2s 超时),失败抛错
+// (ArkTS try/catch 回退)。调用频率低(开切换器/底栏命令/设置清数据)。
+napi_value ChromeJSCall(napi_env env, napi_callback_info info) {
+    size_t argc = 2;
+    napi_value args[2];
+    napi_value thisArg;
+    napi_get_cb_info(env, info, &argc, args, &thisArg, nullptr);
+    if (argc < 1) {
+        napi_throw_type_error(env, nullptr, "参数缺失,期望 method 字符串");
+        return nullptr;
+    }
+    char methodBuf[128] = {0};
+    if (!NapiGetString(env, args[0], methodBuf, sizeof(methodBuf))) {
+        napi_throw_type_error(env, nullptr, "method 参数解析失败");
+        return nullptr;
+    }
+    char argBuf[4096] = {0};
+    if (argc >= 2) {
+        if (!NapiGetString(env, args[1], argBuf, sizeof(argBuf))) {
+            argBuf[0] = '\0';
+        }
+    }
+    // 32 标签 × (标题+URL+图标) 上限,16KiB 足够
+    char outBuf[16384] = {0};
+    if (!GeckoBridge_ChromeJSCall(methodBuf, argBuf, outBuf, sizeof(outBuf))) {
+        napi_throw_error(env, nullptr, "GeckoBridge_ChromeJSCall failed");
+        return nullptr;
+    }
+    napi_value result;
+    napi_create_string_utf8(env, outBuf, NAPI_AUTO_LENGTH, &result);
+    return result;
+}
