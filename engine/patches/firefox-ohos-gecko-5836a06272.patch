@@ -0,0 +1,76 @@
+/* -*- Mode: C++; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef widget_openharmony_OHOSDragService_h__
+#define widget_openharmony_OHOSDragService_h__
+
+#include "nsBaseDragService.h"
+#include "mozilla/StaticPtr.h"
+
+namespace mozilla {
+namespace widget {
+
+/**
+ * OpenHarmony drag service stub.
+ *
+ * OHOS 当前无原生 OLE/拖放基础设施,这里只提供一个满足
+ * @mozilla.org/widget/parent/dragservice;1 契约的空实现,保证组件
+ * 注册通过、上层(nsDragServiceSelector via do_GetService)能拿到非空实例。
+ * InvokeDragSessionImpl 返回 NS_ERROR_NOT_IMPLEMENTED,nsBaseDragService
+ * 据此短路拖放会话;数据类方法(GetData/GetNumDropItems 等)由对应的
+ * nsDragSession 实现返回空/false。
+ *
+ * 后续若要接入 OHOS DragFramework(Pasteboard 的拖拽扩展),在此处替换为
+ * 真实 dlopen 实现,签名保持不变。
+ */
+class OHOSDragSession final : public nsBaseDragSession {
+ public:
+  OHOSDragSession() = default;
+
+  // nsIDragSession
+  NS_IMETHOD GetData(nsITransferable* aTransferable,
+                     uint32_t aItemIndex) override;
+  NS_IMETHOD GetNumDropItems(uint32_t* aNumItems) override;
+  NS_IMETHOD IsDataFlavorSupported(const char* aDataFlavor,
+                                   bool* _retval) override;
+  NS_IMETHOD UpdateDragImage(nsINode* aImage, int32_t aImageX,
+                             int32_t aImageY) override;
+  MOZ_CAN_RUN_SCRIPT nsresult
+  EndDragSessionImpl(bool aDoneDrag, uint32_t aKeyModifiers) override;
+
+ protected:
+  virtual ~OHOSDragSession() = default;
+
+  // nsBaseDragSession
+  MOZ_CAN_RUN_SCRIPT nsresult InvokeDragSessionImpl(
+      nsIWidget* aWidget, nsIArray* anArrayTransferables,
+      const mozilla::Maybe<mozilla::CSSIntRegion>& aRegion,
+      uint32_t aActionType) override;
+};
+
+/**
+ * OpenHarmony nsIDragService 实现。
+ *
+ * 注册为单例(对齐 widget/android 的 nsDragService::GetInstance 模式),
+ * 由 nsDragServiceSelector 在主进程通过 do_GetService 获取。
+ */
+class OHOSDragService final : public nsBaseDragService {
+ public:
+  static already_AddRefed<OHOSDragService> GetInstance();
+
+ protected:
+  already_AddRefed<nsIDragSession> CreateDragSession() override;
+
+ private:
+  OHOSDragService() = default;
+  virtual ~OHOSDragService() = default;
+
+  static StaticRefPtr<OHOSDragService> sSingleton;
+};
+
+}  // namespace widget
+}  // namespace mozilla
+
+#endif  // widget_openharmony_OHOSDragService_h__
