new file mode 100644
index 0000000000..848936da81
--- /dev/null
+++ b/widget/openharmony/nsAppShell.cpp
@@ -0,0 +1,355 @@
+/* -*- Mode: c++; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can get one at http://mozilla.org/mozilla.org/MPL/2.0/. */
+
+#include "nsAppShell.h"
+
+#include "OHOSScreenHelper.h"
+#include "mozilla/Hal.h"
+#include "mozilla/widget/ScreenManager.h"
+#include "nsThreadUtils.h"
+#include "nsCOMPtr.h"
+#include "nsIPrefBranch.h"
+#include "nsServiceManagerUtils.h"
+#include "OHOSDebug.h"
+#include "nsXULAppAPI.h"
+
+// 诊断日志:确认 Gecko 事件循环已启动。
+// 注意:libxul.so 不链接 libhilog_ndk.z.so(libxul 是 Gecko 内核本体,保持纯净),
+// 此处改用 fprintf(stderr,...) 输出诊断日志。OHOS 应用进程的 stderr 会被
+// 系统重定向到 hilog,可通过 `hdc shell hilog | grep GeckoOK` 捕获。
+#include <atomic>
+#include <cstdio>
+
+// v155: 线程 CPU 采样器。真机实测应用恒定烧 ~1.0 核(三进程 102-103%),
+// 但 hdc shell 对 /proc/<pid>/task 无权限(hidepid),无法从外部定位烧核线程。
+// 进程内读 /proc/self/task/* 不受限制 —— 每 30s 采样一次各线程 utime+stime,
+// 增量 top3 + 进程总量写入 gecko_xre_diag.txt([CPU_SAMPLE]),供定位
+// 持续烧核的线程(RenderThread/JS/定时器自旋等)。
+#include <dirent.h>
+#include <map>
+#include <pthread.h>
+#include <string>
+#include <unistd.h>
+#include <cstdlib>
+namespace {
+// 由 widget/openharmony/OHOSNativeWindowBridge.cpp 实现(直写文件,无 hilog 依赖)。
+extern "C" void OHOS_DiagLog(const char* fmt, ...);
+
+constexpr uint32_t kCpuSampleIntervalSec = 30;
+
+struct ThreadCpuSample {
+  uint64_t mTotal = 0;  // utime+stime jiffies(累计)
+  std::string mComm;
+};
+
+void CpuSamplerThreadMain() {
+  std::map<pid_t, ThreadCpuSample> last;
+  uint64_t lastProcTotal = 0;
+  // 首个采样窗口用作基线,从第二个窗口起输出增量。
+  for (;;) {
+    sleep(kCpuSampleIntervalSec);
+
+    // 进程级累计(单位 jiffies,CLK_TCK=100 → 100/s = 1 核)
+    uint64_t procTotal = 0;
+    {
+      FILE* f = fopen("/proc/self/stat", "r");
+      if (f) {
+        char line[1024];
+        if (fgets(line, sizeof(line), f)) {
+          char* rp = strrchr(line, ')');
+          if (rp) {
+            int utime = 0, stime = 0;
+            // ')' 后第 12/13 个 token = 字段 14/15(utime/stime)
+            if (sscanf(rp + 2,
+                       "%*s %*d %*d %*d %*d %*d %*u %*u %*u %*u %*u %d %d",
+                       &utime, &stime) == 2) {
+              procTotal = (uint64_t)utime + (uint64_t)stime;
+            }
+          }
+        }
+        fclose(f);
+      }
+    }
+
+    std::map<pid_t, ThreadCpuSample> now;
+    DIR* d = opendir("/proc/self/task");
+    if (!d) {
+      OHOS_DiagLog("[CPU_SAMPLE] opendir /proc/self/task 失败 errno=%d", errno);
+      continue;
+    }
+    struct dirent* e;
+    while ((e = readdir(d)) != nullptr) {
+      if (e->d_name[0] == '.') continue;
+      char path[128];
+      snprintf(path, sizeof(path), "/proc/self/task/%s/stat", e->d_name);
+      FILE* f = fopen(path, "r");
+      if (!f) continue;
+      char line[1024];
+      if (fgets(line, sizeof(line), f)) {
+        char* rp = strrchr(line, ')');
+        if (rp) {
+          int utime = 0, stime = 0;
+          if (sscanf(rp + 2,
+                     "%*s %*d %*d %*d %*d %*d %*u %*u %*u %*u %*u %d %d",
+                     &utime, &stime) == 2) {
+            ThreadCpuSample s;
+            s.mTotal = (uint64_t)utime + (uint64_t)stime;
+            // comm = '(' 与最后一个 ')' 之间(线程名可能含空格)
+            char* lp = strchr(line, '(');
+            if (lp && rp > lp) {
+              s.mComm.assign(lp + 1, rp - lp - 1);
+            }
+            now[(pid_t)atoi(e->d_name)] = s;
+          }
+        }
+      }
+      fclose(f);
+    }
+    closedir(d);
+
+    const uint64_t procDelta = procTotal - lastProcTotal;
+    lastProcTotal = procTotal;
+
+    // 增量 top3(线程退出后残留增量也输出一次,防烧核线程中途退出丢证据)
+    pid_t topTid[3] = {0, 0, 0};
+    uint64_t topDelta[3] = {0, 0, 0};
+    const char* topComm[3] = {"", "", ""};
+    for (const auto& [tid, s] : now) {
+      auto it = last.find(tid);
+      uint64_t delta = (it != last.end()) ? s.mTotal - it->second.mTotal
+                                          : s.mTotal /* 新线程:全量当增量 */;
+      for (int i = 0; i < 3; i++) {
+        if (delta > topDelta[i]) {
+          for (int j = 2; j > i; j--) {
+            topTid[j] = topTid[j - 1];
+            topDelta[j] = topDelta[j - 1];
+            topComm[j] = topComm[j - 1];
+          }
+          topTid[i] = tid;
+          topDelta[i] = delta;
+          topComm[i] = s.mComm.c_str();
+          break;
+        }
+      }
+    }
+    // 已退出线程的末期增量(last 有 now 无)
+    uint64_t exitedTotal = 0;
+    for (const auto& [tid, s] : last) {
+      if (now.find(tid) == now.end()) {
+        exitedTotal += s.mTotal - 0;  // 近似:退出前累计未细分,仅计数提示
+      }
+    }
+    (void)exitedTotal;
+
+    OHOS_DiagLog(
+        "[CPU_SAMPLE] window=%us threads=%zu procDelta=%llu "
+        "top1=%d(%s)=%llu top2=%d(%s)=%llu top3=%d(%s)=%llu",
+        (unsigned)kCpuSampleIntervalSec, now.size(),
+        (unsigned long long)procDelta, (int)topTid[0], topComm[0],
+        (unsigned long long)topDelta[0], (int)topTid[1], topComm[1],
+        (unsigned long long)topDelta[1], (int)topTid[2], topComm[2],
+        (unsigned long long)topDelta[2]);
+
+    last = std::move(now);
+  }
+}
+
+void StartCpuSamplerOnce() {
+  static bool started = false;
+  if (started) {
+    return;
+  }
+  started = true;
+  pthread_t th;
+  if (pthread_create(&th, nullptr, [](void*) -> void* {
+        CpuSamplerThreadMain();
+        return nullptr;
+      }, nullptr) == 0) {
+    pthread_detach(th);
+    fprintf(stderr, "[CPUSampler] 线程 CPU 采样器已启动(30s 周期)\n");
+  }
+}
+
+// 标记 ProcessNextEvent 是否首次进入,首次进入时打日志确认事件循环已启动。
+std::atomic<bool> gFirstProcessNextEvent{true};
+}  // namespace
+
+// OpenHarmony AppShell 实现(无 JNI)。
+//
+// 与 Android 不同,OpenHarmony 进程模型为单进程(参见 PORTING_PLAN.md 4.1),
+// 主线程即 Gecko 主线程。NativeEventCallback 由基类在主线程通过 Runnable
+// 异步触发,无需额外的原生消息泵。
+//
+// 注:nsAppShellSingleton.h 已提供 sAppShell 单例与 nsAppShellInit/Shutdown/
+// Constructor。屏幕 Helper 的注入放在 Init() 中(nsAppShellInit 调用)。
+
+namespace {
+class NativeEventCallbackRunnable : public mozilla::Runnable {
+ public:
+  NativeEventCallbackRunnable()
+      : mozilla::Runnable("nsAppShell::NativeEventCallback") {}
+
+  NS_IMETHOD Run() override;
+};
+}  // namespace
+
+// NS_IMETHOD 在 class 外展开会带 virtual 关键字导致编译错误,
+// 类外定义用 nsresult。
+nsresult NativeEventCallbackRunnable::Run() {
+  // 推进当前线程(主线程)的待处理事件,触发 Gecko 事件循环前进。
+  NS_ProcessPendingEvents(nullptr);
+  return NS_OK;
+}
+
+// v225: 供 TaskController 唤醒钩子使用的单例指针(进程内唯一 app shell,
+// Init 时置位)。定义在 Init 之前。
+static nsAppShell* gOHOSAppShellForWake = nullptr;
+
+nsresult nsAppShell::Init() {
+  nsresult rv = nsBaseAppShell::Init();
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  // v225: 供 TaskController 投递主线程任务后的唤醒钩子使用(进程内单实例)。
+  gOHOSAppShellForWake = this;
+
+  // v107 修复:补齐 hal::Init()(与 Android/gtk/windows nsAppShell 对齐)。
+  // 根因:OHOS AppShell 从未调用 hal::Init() → hal 的 sLockTable 保持 nullptr,
+  // 视频开始播放时 HTMLVideoElement::CreateVideoWakeLockIfNeeded →
+  // ModifyWakeLockWithChildID → sLockTable->WithEntryHandle 空指针解引用
+  // (SEGV_MAPERR @0x12),任何视频进入 playing 状态必崩。
+  // 注意 hal::Init 内部 MOZ_ASSERT(!sInitialized),全进程只允许调用一次,
+  // AppShell::Init 单进程模型下恰好调用一次,安全。
+  mozilla::hal::Init();
+
+  // v135: 注入 OHOS 屏幕 Helper。此前复用的 HeadlessScreenHelper 上报固定
+  // 1366x768,菜单弹层定位被夹进这块假屏幕(显示在窗口中部);
+  // OHOSScreenHelper 通过 OH_NativeDisplayManager 上报真实显示尺寸(物理 px)。
+  if (XRE_IsParentProcess()) {
+    mozilla::widget::ScreenManager& screenManager =
+        mozilla::widget::ScreenManager::GetSingleton();
+    screenManager.SetHelper(
+        mozilla::MakeUnique<mozilla::widget::OHOSScreenHelper>());
+    // v155: 启动线程 CPU 采样器(30s 周期,[CPU_SAMPLE] 入 gecko_xre_diag.txt)。
+    // 单进程模型下 Init 恰好一次;父进程即应用进程。
+    StartCpuSamplerOnce();
+  }
+  return NS_OK;
+}
+
+void nsAppShell::ScheduleNativeEventCallback() {
+  // v155: 置原生泵唤醒标记并 Notify(任意线程调用)。主线程若正阻塞在
+  // ProcessNextNativeEvent 的 CondVar 等待中,立即唤醒;若未阻塞则为下次
+  // 等待预置标记(标记/等待同锁,无丢失唤醒窗口)。
+  {
+    mozilla::MutexAutoLock lock(mNativeCbMutex);
+    mNativeCbPending = true;
+  }
+  mNativeCbCond.Notify();
+  // 在主线程异步派发,驱动 Gecko 事件循环。
+  NS_DispatchToMainThread(mozilla::MakeAndAddRef<NativeEventCallbackRunnable>(),
+                          NS_DISPATCH_NORMAL);
+}
+
+// v225: TaskController 主线程投递后的纯唤醒钩子。背景:上游 TaskController
+// 不再走 OnDispatchedEvent(且 v31 在 EnsureMainThreadTasksScheduled 跳过
+// 该调用以解 mGraphMutex 递归死锁),导致 v155 设计的"新投递唤醒 CondVar"
+// 通路实际不存在 —— 主线程空闲阻塞在 ProcessNextNativeEvent 的 100ms
+// 有界等待时,任何新投递(含 vsync 刷新 tick)都要等满超时才被消费。
+// 真机实证:零负载 rAF 页主线程动画钳在 ~17fps(RD_TICK 双峰:burst 8.3ms
+// + >52ms 洞),[MT_LONG] 无 >20ms 任务(排除长任务占用)。本钩子由
+// EnsureMainThreadTasksScheduled 在持 mGraphMutex 下调用,只碰
+// mNativeCbMutex(两锁无嵌套关系)——置标记+Notify,不投递 runnable
+// (投递会经 AddTask 重取 mGraphMutex,v31 死锁教训)。
+extern "C" void OHOS_TaskControllerNotifyAppShell() {
+  if (nsAppShell* shell = gOHOSAppShellForWake) {
+    shell->NotifyNativeWaitForNewTasks();
+  }
+}
+
+void nsAppShell::NotifyNativeWaitForNewTasks() {
+  // v225b: 只 Notify 不置 mNativeCbPending。首版曾置 flag,引发空闲自旋
+  // (真机实证空闲主线程 99.6% CPU):置 flag 使下次 ProcessNextNativeEvent
+  // 跳过等待,而每次主线程投递都置位,nsBaseAppShell 的 dummy 事件驱动链
+  // 自激成忙循环。语义辨析:任务已在队列时 NS_ProcessNextEvent 先查队列、
+  // 不会进等待,flag 纯属多余;Notify 只服务"主线程已在 CondVar 等待中"
+  // 的场景。
+  // v243: Notify 前持锁 —— 纯 Notify 无锁时,与等待方"锁内检查 flag→
+  // Wait"的间隙(查队列后/Wait 前的投递)存在丢失唤醒窗口,落空即睡满
+  // 100ms(120Hz 下=12 帧整段卡顿,空闲→活动首帧偶发)。持锁消除间隙:
+  // Notify 要么发生在等待方持锁检查前(其锁内检查将看到任务已入队),要么
+  // 发生在 Wait 已释锁阻塞中(必然唤醒)。锁持有纳秒级;锁序单向
+  // (调用方 mGraphMutex → 本锁,等待方临界区内不取其他锁),无环。不置
+  // flag(v225b 自旋教训不变),100ms 有界等待兜底语义不变。
+  {
+    mozilla::MutexAutoLock lock(mNativeCbMutex);
+    mNativeCbCond.Notify();
+  }
+}
+
+bool nsAppShell::ProcessNextNativeEvent(bool mayWait) {
+  // 首次进入事件循环时打日志,确认 XRE_main 已成功到达 Gecko 事件循环。
+  // 这是诊断 XRE_main 是否阻塞的关键标志:看到此日志即说明 Gecko 内核已
+  // 完成初始化并进入主循环,后续 sleeping 状态是 NS_ProcessNextEvent
+  // (mayWait=true) 的正常等待行为,不是死锁。
+  // 用 fprintf(stderr) 是因为 libxul.so 不链接 libhilog_ndk.z.so,
+  // stderr 在 OHOS 应用进程会被系统重定向到 hilog。
+  if (gFirstProcessNextEvent.exchange(false)) {
+    fprintf(stderr, "[GeckoOK] Gecko 事件循环首次启动 (ProcessNextNativeEvent)\n");
+    fflush(stderr);
+    // v263: 诊断总开关接线——OHOS_LOG 族默认静音(生产无 stderr/hilog 噪声),
+    // profile pref ohos.diag.verbose=true 时打开(about:config 或 user.js 持久,
+    // 重启生效)。此处 XPCOM/pref 服务已就绪,是首个可靠读取点。
+    {
+      nsCOMPtr<nsIPrefBranch> prefs =
+          do_GetService(NS_PREFSERVICE_CONTRACTID);
+      bool verbose = false;
+      if (prefs) {
+        prefs->GetBoolPref("ohos.diag.verbose", &verbose);
+      }
+      mozilla::widget::gOHOSVerbose.store(verbose,
+                                          std::memory_order_relaxed);
+    }
+  }
+  // stage1(headless 基底)阶段没有额外的原生事件源需要 pump,
+  // 所有事件均通过 nsBaseAppShell / Runnable 投递到 Gecko 线程队列。
+  // stage2 接入 XComponent 输入后,这里会从输入队列取出触摸/鼠标事件。
+  //
+  // v155(根治 Gecko 主线程 100% CPU 空转):mayWait=true 且无原生事件时,
+  // 阻塞在 CondVar 上等 ScheduleNativeEventCallback 唤醒(见 nsAppShell.h
+  // 成员注释的完整根因分析)。此前空实现立即返回 false,nsBaseAppShell::
+  // OnProcessNextEvent 逐轮 DispatchDummyEvent,线程永不睡眠([CPU_SAMPLE]
+  // 实证 top1=GeckoMainThread ~99%/核,自 stage1 移植起持续存在)。
+  // mayWait=false(基类 drain 路径)保持立即返回 false。
+  // 有界等待 100ms:兜底极端丢唤醒不至于卡死,空闲时仅 10 次/秒 dummy
+  // 唤醒,CPU 趋近 0。
+  if (mayWait) {
+    mozilla::MutexAutoLock lock(mNativeCbMutex);
+    if (!mNativeCbPending) {
+      mNativeCbCond.Wait(mozilla::TimeDuration::FromMilliseconds(100));
+    }
+    mNativeCbPending = false;
+  }
+  return false;
+}
+
+// ---------------------------------------------------------------------------
+// message_pump_ohos 依赖的 mozilla::ProcessNextEvent / NotifyEvent。
+// 移植自 widget/android/nsAppShell.cpp。OpenHarmony 单进程下直接驱动
+// Gecko 主线程事件队列。
+// ---------------------------------------------------------------------------
+namespace mozilla {
+
+bool ProcessNextEvent() {
+  // 处理主线程的待处理事件(mayWait=true 会阻塞等待)。
+  return NS_ProcessNextEvent(nullptr, true);
+}
+
+void NotifyEvent() {
+  // 唤醒主线程事件循环:投递一个空 Runnable 使其从等待中返回。
+  NS_DispatchToMainThread(NS_NewRunnableFunction("OHOS_NotifyEvent", [] {}));
+}
+
+}  // namespace mozilla
+
diff --git a/widget/openharmony/nsAppShell.h b/widget/openharmony/nsAppShell.h
new file mode 100644
index 0000000000..35b2ca45bc
--- /dev/null
+++ b/widget/openharmony/nsAppShell.h
@@ -0,0 +1,63 @@
+/* -*- Mode: c++; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can get one at http://mozilla.org/mozilla.org/MPL/2.0/. */
+
+#ifndef nsAppShell_h__
+#define nsAppShell_h__
+
+#include "nsBaseAppShell.h"
+#include "mozilla/CondVar.h"
+#include "mozilla/Mutex.h"
+
+// OpenHarmony 事件循环。
+//
+// 移植说明:Android 版 nsAppShell 依赖 jni/Natives.h 与 Java 层消息泵,
+// OpenHarmony 没有 JVM,这里改为基于 nsBaseAppShell 的纯 C++ 实现,
+// 与 widget/gtk 的 nsAppShell 思路一致 —— ScheduleNativeEventCallback
+// 通过 Runnable 在主线程异步派发,ProcessNextNativeEvent 处理 Gecko
+// 自身投递到本 Shell 的事件。
+//
+// stage2(XComponent 输入事件转发)阶段会在此扩展触摸/鼠标事件的入队逻辑。
+
+class nsAppShell final : public nsBaseAppShell {
+ public:
+  nsAppShell() = default;
+  NS_INLINE_DECL_REFCOUNTING_INHERITED(nsAppShell, nsBaseAppShell)
+
+  // 重声明为 public:nsAppShellSingleton.h 的 nsAppShellInit 通过
+  // static_cast<nsAppShell*>()->Init() 调用本方法。
+  nsresult Init();
+
+  // v225: TaskController 主线程投递后的纯唤醒钩子(见 nsAppShell.cpp 的
+  // OHOS_TaskControllerNotifyAppShell)。只置标记+Notify,不投递 runnable
+  // ——投递会经 AddTask 重取 mGraphMutex,v31 在同锁递归死锁的教训。
+  void NotifyNativeWaitForNewTasks();
+
+ protected:
+  ~nsAppShell() = default;
+
+  void ScheduleNativeEventCallback() override;
+  bool ProcessNextNativeEvent(bool mayWait) override;
+
+ private:
+  // v155: 原生事件泵阻塞原语(修 Gecko 主线程 100% CPU 空转)。
+  // nsBaseAppShell::OnProcessNextEvent 的契约:无事件且 mayWait=true 时,
+  // ProcessNextNativeEvent 应阻塞在原生泵里等事件(gtk 阻塞在
+  // g_main_context_iteration、Windows 阻塞在 MsgWaitForMultipleObjects、
+  // Android 阻塞在 epoll 管道);OHOS 移植是空实现立即返回 false,基类于是
+  // 走 DispatchDummyEvent 兜底,每轮注入 dummy 事件 → 线程永不睡眠 →
+  // 主线程恒定 ~100% CPU([CPU_SAMPLE] 实证 top1=GeckoMainThread 99%+)。
+  // 此处以 Mutex+CondVar 实现"等 ScheduleNativeEventCallback 唤醒":
+  //   - ScheduleNativeEventCallback(任意线程):置 pending 标记 + Notify;
+  //   - ProcessNextNativeEvent(mayWait=true,主线程):pending 未置时
+  //     有界等待(100ms 兜底防极端丢唤醒卡死),返回前清标记。
+  // 唤醒源:nsIThread::Dispatch → OnDispatchedEvent → ScheduleNativeEventCallback
+  // 以及 IPC ScheduleWork → NotifyEvent → NS_DispatchToMainThread,覆盖全部
+  // Gecko 事件到达路径。空闲时每 100ms 至多一次 dummy 唤醒,CPU 趋近 0。
+  mozilla::Mutex mNativeCbMutex{"nsAppShell::mNativeCbMutex"};
+  mozilla::CondVar mNativeCbCond{mNativeCbMutex, "nsAppShell::mNativeCbCond"};
+  bool mNativeCbPending = false;
+};
+
+#endif  // nsAppShell_h__
diff --git a/widget/openharmony/nsDeviceContextSpecOHOS.cpp b/widget/openharmony/nsDeviceContextSpecOHOS.cpp
new file mode 100644
index 0000000000..ffe4a5c884
--- /dev/null
+++ b/widget/openharmony/nsDeviceContextSpecOHOS.cpp
@@ -0,0 +1,112 @@
+/* -*- Mode: C++; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// OHOS 设备上下文实现(克隆自 widget/android/nsDeviceContextAndroid)。
+//
+// MakePrintTarget / Init / BeginDocument 与 Android 完全一致:匿名临时文件 +
+// PrintTargetPDF。EndDocument → DoEndDocument 差异:
+//   - kOutputDestinationFile 且 mTempFile:Android 移到目标路径(保留,显式 Save As)。
+//   - 其余情况(OHOS 静默 Save-to-PDF,输出目标为 printer):取临时 PDF 路径经
+//     OHOSPrintBridge_Notify 投递给 ArkTS,由 ArkTS 的 print.print 拉起系统打印
+//     预览并删除临时文件。此处把 mTempFile 置空,Gecko 析构不再删除该文件,
+//     清理权交给 ArkTS。
+
+#include "nsDeviceContextSpecOHOS.h"
+
+#include "mozilla/gfx/PrintTargetPDF.h"
+#include "mozilla/RefPtr.h"
+#include "nsComponentManagerUtils.h"
+#include "nsString.h"
+#include "nsIFile.h"
+#include "nsIFileStreams.h"
+#include "nsIPrintSettings.h"
+#include "nsDirectoryServiceDefs.h"
+#include "nsAnonymousTemporaryFile.h"
+#include "OHOSPrintBridge.h"  // OHOSPrintBridge_Notify
+
+using namespace mozilla;
+using namespace mozilla::gfx;
+
+NS_IMPL_ISUPPORTS(nsDeviceContextSpecOHOS, nsIDeviceContextSpec)
+
+nsDeviceContextSpecOHOS::~nsDeviceContextSpecOHOS() {
+  // 安全网:打印被取消等 DoEndDocument 未执行的早销毁路径才到这里删除临时文件。
+  // 已通知 ArkTS 的临时文件在 DoEndDocument 中置空 mTempFile,此处不会重复删除。
+  if (mTempFile) {
+    mTempFile->Remove(false);
+  }
+}
+
+already_AddRefed<PrintTarget> nsDeviceContextSpecOHOS::MakePrintTarget() {
+  double width, height;
+  mPrintSettings->GetEffectiveSheetSize(&width, &height);
+
+  // convert twips to points
+  width /= TWIPS_PER_POINT_FLOAT;
+  height /= TWIPS_PER_POINT_FLOAT;
+
+  auto stream = [&]() -> nsCOMPtr<nsIOutputStream> {
+    if (mPrintSettings->GetOutputDestination() ==
+        nsIPrintSettings::kOutputDestinationStream) {
+      nsCOMPtr<nsIOutputStream> out;
+      mPrintSettings->GetOutputStream(getter_AddRefs(out));
+      return out;
+    }
+    if (NS_FAILED(
+            NS_OpenAnonymousTemporaryNsIFile(getter_AddRefs(mTempFile)))) {
+      return nullptr;
+    }
+    // Print to printer not supported...
+    nsCOMPtr<nsIFileOutputStream> s =
+        do_CreateInstance("@mozilla.org/network/file-output-stream;1");
+    if (NS_FAILED(s->Init(mTempFile, -1, -1, 0))) {
+      return nullptr;
+    }
+    return s;
+  }();
+
+  return PrintTargetPDF::CreateOrNull(stream, IntSize::Ceil(width, height));
+}
+
+NS_IMETHODIMP
+nsDeviceContextSpecOHOS::Init(nsIPrintSettings* aPS, bool aIsPrintPreview) {
+  mPrintSettings = aPS;
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+nsDeviceContextSpecOHOS::BeginDocument(const nsAString& aTitle,
+                                       const nsAString& aPrintToFileName,
+                                       int32_t aStartPage,
+                                       int32_t aEndPage) {
+  return NS_OK;
+}
+
+RefPtr<PrintEndDocumentPromise> nsDeviceContextSpecOHOS::EndDocument() {
+  return nsIDeviceContextSpec::EndDocumentPromiseFromResult(DoEndDocument(),
+                                                            __func__);
+}
+
+NS_IMETHODIMP
+nsDeviceContextSpecOHOS::DoEndDocument() {
+  if (!mTempFile) {
+    return NS_OK;
+  }
+
+  // OHOS 静默 Save-to-PDF:无条件把临时 PDF 路径投递给 ArkTS(由 print.print 拉起
+  // 系统打印预览并在终态清理)。不区分 outputDestination —— OHOS 无 Gecko 侧文件
+  // 保存 UI,所有打印产物都经系统打印预览处理,使"临时 PDF → 通知 ArkTS"在任意
+  // print settings(默认 destination=printer / outputFormat=PDF)下都确定成立,
+  // 不依赖 SAVE_TO_PDF_PRINTER 或特定 toFileName。
+  nsAutoString tempPath;
+  if (NS_SUCCEEDED(mTempFile->GetPath(tempPath))) {
+    NS_ConvertUTF16toUTF8 pathUtf8(tempPath);
+    mozilla::widget::OHOSPrintBridge_Notify(pathUtf8.get());
+  }
+  // 释放 mTempFile 引用但不删除文件,清理权交给 ArkTS(print.print 终态回调)。
+  // 析构函数的 Remove(false) 仅作打印被取消等 DoEndDocument 未执行路径的安全网。
+  mTempFile = nullptr;
+  return NS_OK;
+}
