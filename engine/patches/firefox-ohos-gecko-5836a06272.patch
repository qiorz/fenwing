+            // 上方先剔除旧 user_pref,这里再显式写 false,确保所有历史 profile
+            // 冷启后自动收敛,同时不影响其它关键诊断通道。
+            fputs("user_pref(\"gfx.webrender.debug.dl.dump-parent\", false);\n", fw);
+            fputs("user_pref(\"gfx.webrender.debug.dl.dump-content\", false);\n", fw);
+            fputs("user_pref(\"gfx.webrender.debug.dl.dump-content-serialized\", false);\n", fw);
+            fputs("user_pref(\"layout.display-list.dump\", false);\n", fw);
+            fputs("user_pref(\"layout.display-list.dump-parent\", false);\n", fw);
+            fputs("user_pref(\"layout.display-list.dump-content\", false);\n", fw);
+            if (uiMode == "native") {
