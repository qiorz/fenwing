+/* -*- Mode: C++; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// OHOS 最小 PDF 打印设置服务实现(克隆自 widget/android/nsPrintSettingsServiceAndroid)。
+//
+// 与 Android 一致:构造时设 kOutputFormatPDF + 打印机名 "PDF printer",使静默
+// Save-to-PDF 生效。OHOS 无真实打印机契约,Gecko 只产出 PDF 临时文件交给 ArkTS
+// 的系统打印预览(print.print),故无需更多字段。
+
+#include "nsPrintSettingsServiceOHOS.h"
+
+#include "nsPrintSettingsImpl.h"
+
+class nsPrintSettingsOHOS : public nsPrintSettings {
+ public:
+  nsPrintSettingsOHOS() {
+    // The aim here is to set up the objects enough that silent printing works
+    SetOutputFormat(nsIPrintSettings::kOutputFormatPDF);
+    SetPrinterName(u"PDF printer"_ns);
+  }
+};
+
+nsresult nsPrintSettingsServiceOHOS::_CreatePrintSettings(
+    nsIPrintSettings** _retval) {
+  nsPrintSettings* printSettings = new nsPrintSettingsOHOS();
+  NS_ENSURE_TRUE(printSettings, NS_ERROR_OUT_OF_MEMORY);
+  NS_ADDREF(*_retval = printSettings);
+  (void)InitPrintSettingsFromPrefs(*_retval, false,
+                                   nsIPrintSettings::kInitSaveAll);
+  return NS_OK;
+}
+
+already_AddRefed<nsIPrintSettings> CreatePlatformPrintSettings(
+    const mozilla::PrintSettingsInitializer& aSettings) {
+  RefPtr<nsPrintSettings> settings = new nsPrintSettingsOHOS();
+  settings->InitWithInitializer(aSettings);
+  return settings.forget();
+}
