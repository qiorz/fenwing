+// ============================================================================
+// NAPI 接口实现
+// ============================================================================
+
+// 初始化火狐内核
+// 参数:opts = { url: string, resourceDir: string, commandlineArgs: string }
+// 返回:立即返回 null(不阻塞 ArkTS 主线程),Gecko 在独立线程启动
+napi_value InitFirefox(napi_env env, napi_callback_info info) {
+    size_t argc = 1;
+    napi_value args[1];
+    napi_value thisArg;
+    napi_get_cb_info(env, info, &argc, args, &thisArg, nullptr);
+    if (argc < 1) {
+        OH_LOG_ERROR(LOG_APP, "InitFirefox 参数缺失,期望 opts 对象");
+        napi_throw_type_error(env, nullptr, "参数缺失,期望 opts 对象");
+        return nullptr;
+    }
+
+    // 解析 opts.url
+    char urlBuf[1024] = {0};
+    napi_value urlValue;
+    if (napi_get_named_property(env, args[0], "url", &urlValue) == napi_ok) {
+        NapiGetString(env, urlValue, urlBuf, sizeof(urlBuf));
+    }
+
+    // 解析 opts.resourceDir
+    char resourceBuf[1024] = {0};
+    napi_value resourceValue;
+    if (napi_get_named_property(env, args[0], "resourceDir", &resourceValue) == napi_ok) {
+        NapiGetString(env, resourceValue, resourceBuf, sizeof(resourceBuf));
+    }
+
+    // 解析 opts.commandlineArgs(使用 \u001f 作为分隔符)
+    char cmdlineBuf[2048] = {0};
+    napi_value cmdlineValue;
+    if (napi_get_named_property(env, args[0], "commandlineArgs", &cmdlineValue) == napi_ok) {
+        NapiGetString(env, cmdlineValue, cmdlineBuf, sizeof(cmdlineBuf));
+    }
+
+    // v219: JIT 降级测试开关。命令行参数带 --airweb-force-no-jit 时
+    // setenv AIRWEB_FORCE_NO_JIT=1,XPCOMInit.cpp 的坚盾探测将其视为
+    // "RWX 权限被拒"直接降级纯解释器——用于在未开坚盾守护的设备上
+    // 回归"权限被拒→不闪退"适配路径(setenv 在 GeckoMainThread
+    // 启动前执行,对随后 XRE_main 内的 getenv 可见)。
+    if (strstr(cmdlineBuf, "airweb-force-no-jit") != nullptr) {
+        setenv("AIRWEB_FORCE_NO_JIT", "1", 1);
+        OH_LOG_INFO(LOG_APP, "[OHOS_JIT] 测试开关生效,本次启动强制走无JIT降级路径");
+    }
+
+    // v108: 解析 opts.uiMode("native"=browser.xhtml 原生 UI / "classic"=geckoview.xhtml)
+    // 缺省 classic,保持既有行为;双轨切换见 GeckoMainThread 中 prefs.js 写入逻辑。
+    char uiModeBuf[64] = {0};
+    napi_value uiModeValue;
+    if (napi_get_named_property(env, args[0], "uiMode", &uiModeValue) == napi_ok) {
+        NapiGetString(env, uiModeValue, uiModeBuf, sizeof(uiModeBuf));
+    }
+
+    OH_LOG_INFO(LOG_APP, "InitFirefox 调用, url=%{public}s, resourceDir=%{public}s, uiMode=%{public}s",
+                urlBuf, resourceBuf, uiModeBuf);
+
+    // soDir: .so 文件目录,通过 dladdr 自动检测
+    // OpenHarmony 中 .so 已由系统加载,dladdr 可获取其完整路径
+    // 注意:变量名使用 dlinfo 避免与函数参数 info(napi_callback_info) 冲突
+    char soDirBuf[1024] = {0};
+    Dl_info dlinfo;
+    if (dladdr((void*)InitFirefox, &dlinfo) && dlinfo.dli_fname) {
+        const char* path = dlinfo.dli_fname;
+        const char* lastSlash = strrchr(path, '/');
+        if (lastSlash) {
+            size_t dirLen = lastSlash - path;
+            if (dirLen < sizeof(soDirBuf) - 1) {
+                memcpy(soDirBuf, path, dirLen);
+                soDirBuf[dirLen] = '\0';
+            }
+        }
+    }
+    if (strlen(soDirBuf) == 0) {
+        OH_LOG_ERROR(LOG_APP, "dladdr 自动检测 soDir 失败");
+        napi_throw_type_error(env, nullptr, "dladdr 自动检测 soDir 失败");
+        return nullptr;
+    }
+    OH_LOG_INFO(LOG_APP, "soDir dladdr 检测: %{public}s", soDirBuf);
+
+    // greDir: GRE 资源目录
+    // resourceDir 由 ArkTS 层传入,指向沙箱中包含 omni.ja 的目录
+    // 若 resourceDir 为空(异常情况),回退到 soDir 作为 greDir
+    char greDirBuf[1024] = {0};
+    if (strlen(resourceBuf) > 0) {
+        strncpy(greDirBuf, resourceBuf, sizeof(greDirBuf) - 1);
+    } else {
+        OH_LOG_WARN(LOG_APP, "resourceDir 为空,回退到 soDir 作为 greDir");
+        strncpy(greDirBuf, soDirBuf, sizeof(greDirBuf) - 1);
+    }
+
+    // 创建独立线程启动 Gecko 主循环(XRE_main 阻塞)
+    std::string soDir(soDirBuf);
+    std::string greDir(greDirBuf);
+    std::string initialUrl(urlBuf);
+    std::string uiMode(uiModeBuf);
+    OH_LOG_INFO(LOG_APP, "GRE 路径: soDir=%{public}s, greDir=%{public}s",
+                soDir.c_str(), greDir.c_str());
+    // v161: 显式 8MB 栈。std::thread 走 pthread 默认栈(HarmonyOS musl 实测
+    // ~1MB,faultlog [anon:stack] 0x101000),低于 SpiderMonkey 主线程栈配额
+    // (XPCJSContext Linux 分支 getrlimit(8MB)→pref 2MB cap)——页面 JS 深递归
+    // 在配额触发前撞穿真实栈底,SIGSEGV stack-buffer-overflow 整进程闪退
+    // (QA"主页浏览新闻页闪退"/v155 启动 JIT 帧同款,崩溃地址恒=栈底-8)。
+    // 桌面 Linux 主线程栈 8MB,此处对齐;SpiderMonkey 经 pthread_getattr_np
+    // 自动读取新栈基址/尺寸,配额语义与桌面一致(深递归→InternalError 而非闪退)。
+    struct GeckoThreadArgs {
+        std::string soDir, greDir, initialUrl, uiMode;
+    };
+    auto* threadArgs = new GeckoThreadArgs{soDir, greDir, initialUrl, uiMode};
+    pthread_attr_t geckoAttr;
+    pthread_attr_init(&geckoAttr);
+    pthread_attr_setstacksize(&geckoAttr, 8 * 1024 * 1024);
+    pthread_t geckoTid;
+    int threadRc = pthread_create(
+        &geckoTid, &geckoAttr,
+        [](void* p) -> void* {
+            auto* a = static_cast<GeckoThreadArgs*>(p);
+            GeckoMainThread(a->soDir, a->greDir, a->initialUrl, a->uiMode);
+            delete a;
+            return nullptr;
+        },
+        threadArgs);
+    pthread_attr_destroy(&geckoAttr);
+    if (threadRc == 0) {
+        pthread_detach(geckoTid);
+    } else {
+        // 8MB 栈分配失败(内存紧张)时回退默认栈,保证可启动。
+        OH_LOG_ERROR(LOG_APP, "Gecko 8MB 栈线程创建失败 rc=%{public}d, 回退默认栈", threadRc);
+        delete threadArgs;
+        std::thread geckoThread(GeckoMainThread, soDir, greDir, initialUrl, uiMode);
+        geckoThread.detach();
+    }
+
+    gGeckoReady = true;
+    OH_LOG_INFO(LOG_APP, "Gecko 启动线程已派发");
+
+    // 立即返回 null,不阻塞 ArkTS 主线程
+    napi_value result;
+    napi_get_null(env, &result);
+    return result;
+}
