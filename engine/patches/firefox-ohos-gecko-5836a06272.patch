diff --git a/browser/base/content/ohos-chrome-bridge.js b/browser/base/content/ohos-chrome-bridge.js
new file mode 100644
index 0000000000..d9d47e613e
--- /dev/null
+++ b/browser/base/content/ohos-chrome-bridge.js
@@ -0,0 +1,1305 @@
+/* -*- indent-tabs-mode: nil; js-indent-level: 2 -*-
+ * [OHOS v250/v252] ohos-chrome-bridge.js — ArkTS 化 chrome 的 gBrowser 桥.
+ *
+ * 背景:v250 起手机底栏/标签切换器与 2in1 顶栏标签条改由 ArkTS 系统组件
+ * 绘制(禁 JIT 解释器税为零),XUL 对应区域视觉让位。v252 扩展为全 chrome
+ * ArkTS 化核心桥:2in1 nav-bar/doorhanger/下载面板/findbar 接管。
+ * 本模块在 chrome 窗口挂 window.OHOSChromeBridge,向 C++
+ * (widget/openharmony/OHOSChromeBridge.cpp)暴露两条通道:
+ *
+ *   ① 同步调用:GeckoBridge_ChromeJSCall → OHOSChromeBridge.call(method,
+ *      argJson) → 返回 JSON 字符串。方法表:
+ *        tabList           → {tabs:[{i,title,url,icon,active}],selected,sec}
+ *        command           → arg {"cmd":"select|close|new|closeCurrent|menu|
+ *                            home|hardReload","index":N}
+ *        clearData         → arg {"history":t,"cache":t,"cookies":t} (异步执行,
+ *                            立即返回 "ok")
+ *        doorhanger        → arg {"cmd":"respond","seq":N,"action":
+ *                            "primary|secondary|dismiss","remember":bool}
+ *        find              → arg {"cmd":"open|next|prev","query":s,
+ *                            "matchCase":bool}
+ *   ② 状态推送(统一信封,全部复用 "airweb-tab-state" obs topic → C++
+ *      OHOSTabStateObserver → tsfn → ArkTS registerTabStateCallback;
+ *      零新增 obs topic = 零 .so 重编,§3.3 通道复用总原则):
+ *        (无 type)              → 旧版标签列表(向后兼容)
+ *        {type:"tabs",...}      → 标签列表 + sec(选中页安全态)
+ *        {type:"loadState"}     → {loading:bool}(三路完成信号机,v252 自
+ *                                  phone-chrome.js 迁入,全形态;ArkTS 底栏
+ *                                  刷新/停止键真值源)
+ *        {type:"doorhanger"}    → 权限/密码等提示(PopupNotifications 包装)
+ *        {type:"doorhangerDismissed"} → Gecko 侧先移除(超时/程序移除)
+ *        {type:"findbarOpen"}   → XUL findbar 被请求打开(菜单/Ctrl+F),
+ *                                  ArkTS FindBarOverlay 接管
+ *        {type:"findResult"}    → {total,current} 匹配计数
+ *        {type:"urlbarFocus"}   → Ctrl+L/Ctrl+K 拦截(幽灵 urlbar 焦点陷阱)
+ *
+ * 无 JIT 手机一切从简(无轮询,纯事件驱动,一次性接线)。gBrowser 未就绪前的
+ * call 返回 null(C++ 判失败,ArkTS 回退)。
+ */
+
+(() => {
+  const TAG = "[OHOS v252 chrome-bridge]";
+
+  // ---- 信封推送(复用 airweb-tab-state obs topic) ----
+  function pushEnvelope(type, payload) {
+    try {
+      payload.type = type;
+      Services.obs.notifyObservers(
+        null,
+        "airweb-tab-state",
+        JSON.stringify(payload)
+      );
+    } catch (e) {
+      dump(`${TAG} pushEnvelope(${type}) 失败: ${e}\n`);
+    }
+  }
+
+  function homePageURI() {
+    return Services.io.newURI("about:home");
+  }
+
+  // ---- 页面安全态(锁图标真值,§3.3 决策③) ----
+  // gBrowser.selectedBrowser.securityUI.state(nsISecureBrowserUI):
+  //   STATE_IS_BROKEN=混合内容, STATE_IS_SECURE=安全, STATE_IS_INSECURE=明文;
+  //   about:/file: 等 securityUI 未建 → "local"(ArkTS 不显示锁)。
+  function securityStateOf(browser) {
+    try {
+      // about:/chrome: 内部页直接判 local(真机实证 about:home 的
+      // securityUI.state 带 INSECURE 位,锁图标真值不可用于内部页)
+      const uri = browser && browser.currentURI;
+      if (uri && (uri.schemeIs("about") || uri.schemeIs("chrome"))) {
+        return "local";
+      }
+      const sui = browser && browser.securityUI;
+      if (!sui || typeof sui.state !== "number") {
+        return "local";
+      }
+      const WPL = Ci.nsIWebProgressListener;
+      const s = sui.state;
+      if (s & WPL.STATE_IS_BROKEN) {
+        return "broken";
+      }
+      if (s & WPL.STATE_IS_SECURE) {
+        return "secure";
+      }
+      if (s & WPL.STATE_IS_INSECURE) {
+        return "insecure";
+      }
+      return "local";
+    } catch (e) {
+      return "local";
+    }
+  }
+
+  function tabListJson() {
+    if (!window.gBrowser) {
+      return null;
+    }
+    const tabs = [];
+    const all = gBrowser.tabs;
+    for (let i = 0; i < all.length; i++) {
+      const tab = all[i];
+      const b = tab.linkedBrowser;
+      let url = "";
+      try {
+        url = b?.currentURI?.spec || "";
+      } catch (e) {}
+      tabs.push({
+        i,
+        title: tab.label || "新标签页",
+        url,
+        // v266: 冷标签防闪门控两信号——pending(会话恢复/内存卸载的惰性
+        // 标签,SessionStore 置 attribute,恢复启动时移除)+loading(docshell
+        // 在途载荷)。选中冷标签的瞬时 about:blank 上报曾直翻 ArkTS 首页
+        // 面板,真实 URL 提交后才收起("先闪首页再进网页")。
+        pending: tab.hasAttribute("pending") || false,
+        loading: !!(b && b.webProgress && b.webProgress.isLoadingDocument),
+        // v253: tab.image 本端口恒空(真机实证:title 推送正常、image 不置位),
+        // 改从 faviconCache(Places 异步解析)取 PNG data URI
+        icon: tab.getAttribute("image") || faviconGet(url) || "",
+        active: tab === gBrowser.selectedTab,
+      });
+    }
+    resolveFavicons(tabs);
+    return JSON.stringify({
+      tabs,
+      selected: all.indexOf(gBrowser.selectedTab),
+      sec: securityStateOf(gBrowser.selectedBrowser),
+    });
+  }
+
+  /* ====================================================================
+   * [OHOS v253] favicon 数据通道(2in1 标签条图标).
+   *
+   * 背景:tab.getAttribute("image") 在本移植恒空(v253 真机实证),且 ArkTS
+   * Image 不支持 .ico——双坑一根治。两级解析:①Places favicon 库
+   * getFaviconForPage(FF142 无 getFaviconDataForPage)→ moz-anno URI →
+   * NetUtil.asyncFetch 取字节;②库无记录回退 origin+/favicon.ico 直取
+   * (本端口 favicon 抓取管线存疑,直取兜底)。字节统一经 createImageBitmap
+   * (Gecko 自带 ico/svg 解码)+ canvas 重编码 16x16 PNG data URI 推 ArkTS。
+   * Map 按页面 URL 缓存(含"无图标"空串,避免重查);解析完成 schedulePush
+   * 补推。仅 2in1 启用(手机切换器不展示图标,省无 JIT 解释器税)。
+   * ==================================================================== */
+  const faviconCache = new Map(); // pageUrl → dataURI | ""(已查无图标)
+  const faviconPending = new Set(); // 在途解析(防重复发车)
+  // v265: 空串有界重试。冷启首推常早于 Places/网络就绪,一次失败即把
+  // "" 写入缓存后永久跳过——真机实证:重启后全部历史标签图标退化为占位
+  // 符,仅"激活后发生重定向换了 URL"的标签才恢复。misses 记次,后续
+  // 每次标签推送对 "" 条目重试,至多 2 次(确无图标的站点不无限发车)。
+  const faviconMisses = new Map(); // pageUrl → 已重试次数
+  // v265: origin 级二级缓存——搜索页 URL 参数易变(baidu sa=/from= 每次
+  // 不同),精确键必失配;解码成功时同时按 prePath 存一份,查取先精确后
+  // origin(FAVDIAG 实证:www.baidu.com/s?wd=全国… decode ok 后 tab 仍
+  // 占位,新 push 的 url 已换参数)。
+  function faviconOriginOf(url) {
+    try {
+      const u = Services.io.newURI(url);
+      return u.prePath || "";
+    } catch (e) {
+      return "";
+    }
+  }
+  function faviconSet(pageUrl, dataUri) {
+    faviconCache.set(pageUrl, dataUri);
+    if (dataUri) {
+      const o = faviconOriginOf(pageUrl);
+      if (o) {
+        faviconCache.set(o, dataUri);
+      }
+    }
+  }
+  function faviconGet(url) {
+    const hit = faviconCache.get(url);
+    if (hit) {
+      return hit;
+    }
+    const o = faviconOriginOf(url);
+    return (o && faviconCache.get(o)) || "";
+  }
+  let placesFavicons = null;
+  let netUtil = null;
+
+  /** 字节流 → 16x16 PNG data URI(createImageBitmap 解码 ico/svg) */
+  function faviconToDataUri(pageUrl, bytes, mimeType) {
+    try {
+      const blob = new Blob([bytes], { type: mimeType });
+      createImageBitmap(blob)
+        .then(bmp => {
+          try {
+            const canvas = document.createElementNS(
+              "http://www.w3.org/1999/xhtml",
+              "canvas"
+            );
