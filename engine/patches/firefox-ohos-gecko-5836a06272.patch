+
+#ifndef AVCODEC_H264DEC_H
+#define AVCODEC_H264DEC_H
+
+#include "libavutil/buffer.h"
+#include "libavutil/mem_internal.h"
+
+#include "cabac.h"
+#include "error_resilience.h"
+#include "h264_parse.h"
+#include "h264_ps.h"
+#include "h264_sei.h"
