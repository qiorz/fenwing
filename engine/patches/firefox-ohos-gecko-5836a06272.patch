+// OHOS v259a 白带渲染侧定位探针（取证期代码，定案后整体移除并重织补丁）。
+//
+// 背景（ai_log 2026-10-02 v258 §8.3）：画面冻结在中间态（地址栏细缝+内容
+// 上移 64-67 设备px+底部白带），布局探针/DL 重建 nudge/force_redraw 均不愈，
+// 仅切标签（换内容文档/PresShell）可愈——嫌疑集中在 WR 场景保留内容与渲染
+// 期空间树的几何。本模块在 WR 内部两个汇聚点 dump 真值，全部由 flag 文件
+// 门控（`hdc shell touch <arm>` 开、`rm` 关，C++ 侧 OHOS_ProbeArmed 共用
+// 同一文件）：
+//   ① scene_builder_thread::process_transaction 的 SetDisplayList——进景 DL
+//      真值（iframe bounds、scroll frame external offset、空间树 descriptor）；
+//   ② render_backend::update_document 的 PublishDocument 前——帧侧真值
+//      （文档视图 device_rect、pipeline epochs、解析后的空间树节点
+//      offset/scale——含 APZ 采样滚动偏移）。
+// 输出 <files>/wr_probe_dump.txt（append，8MiB 停写保护；进程级互斥）。
+// 判别矩阵：iframe bounds 错→child DL 构建；epoch 停更→事务/管线断链；
+// 解析 offset 错→scroll 元数据/采样；全对而画面坏→composite/damage 层
+// （配 RendererOGL 逐帧 dirtyRects 面积日志对表）。
+//
+// 性能：未 arm 时热路径只有一次 atomic 读 + 至多 200ms 一次的 exists()。
+
+use std::fs::OpenOptions;
+use std::io::Write;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::Mutex;
+use time::precise_time_ns;
+
+use api::units::LayoutRect;
+use api::{BuiltDisplayList, DisplayItem, DocumentId, Epoch, PipelineId, SpatialTreeItem};
+use crate::internal_types::FastHashMap;
+use crate::spatial_node::{SpatialNode, SpatialNodeType};
+use crate::spatial_tree::SpatialTree;
+
+const OUT_PATH: &str = "/data/storage/el2/base/haps/entry/files/wr_probe_dump.txt";
+const CHECK_INTERVAL_NS: u64 = 200 * 1_000_000;
+const OUT_CAP_BYTES: u64 = 8 * 1024 * 1024;
+
+static ARMED: AtomicBool = AtomicBool::new(false);
+static LAST_CHECK_NS: AtomicU64 = AtomicU64::new(0);
+static WRITE_MUTEX: Mutex<()> = Mutex::new(());
+static OUT_FULL: AtomicBool = AtomicBool::new(false);
+// 帧侧/场景侧 dump 的内容签名——连续相同只打一行省 Volume。
+static LAST_FRAME_SIG: AtomicU64 = AtomicU64::new(0);
+static LAST_SCENE_SIG: Mutex<u64> = Mutex::new(0);
+
+/// v259b：诊断构建常开（hdc shell 对 app 沙箱与 /data/local/tmp 均无写权，
+/// 运行时 arm 通道不可达；坏态=新进程首个新标签页确定性复现，冷启全程
+/// 捕获正是取证所需）。首次调用时轮转超限转储文件（每进程 4MiB 预算）。
+pub fn armed() -> bool {
+    // v265: 休眠(v258 白带案已定案)。v259b 诊断构建常开在本端口属热路径税:
+    // qq.com 类页面 DL 重发 ~11 次/秒,场景侧/帧侧 dump 曾把 wr_probe_dump
+    // 顶到 8MiB 上限并参与渲染风暴(587% CPU 实录)。恢复取证改回 true 即可。
+    return false;
+    #[allow(unreachable_code)]
+    let now = precise_time_ns();
+    let last = LAST_CHECK_NS.load(Ordering::Relaxed);
+    if !ARMED.load(Ordering::Relaxed) || now.saturating_sub(last) > CHECK_INTERVAL_NS {
+        LAST_CHECK_NS.store(now, Ordering::Relaxed);
+        if !ARMED.load(Ordering::Relaxed) {
+            ARMED.store(true, Ordering::Relaxed);
+            // 转储文件轮转：>4MiB 截断重开（跨冷启累积防 8MiB 上限耗尽）。
+            if let Ok(md) = std::fs::metadata(OUT_PATH) {
+                if md.len() > 4 * 1024 * 1024 {
+                    let _ = std::fs::write(OUT_PATH, b"");
+                    OUT_FULL.store(false, Ordering::Relaxed);
+                }
+            }
+            write(&format!("[PROBE] arm=1 (wr rust 侧,诊断构建常开)"));
+        }
+        true
+    } else {
+        ARMED.load(Ordering::Relaxed)
+    }
+}
+
+/// 追加一行 dump（毫秒级单调时间戳前缀）。8MiB 停写。
+pub fn write(line: &str) {
+    let _guard = WRITE_MUTEX.lock().unwrap();
+    if OUT_FULL.load(Ordering::Relaxed) {
+        return;
+    }
+    if let Ok(md) = std::fs::metadata(OUT_PATH) {
+        if md.len() > OUT_CAP_BYTES {
+            OUT_FULL.store(true, Ordering::Relaxed);
+            if let Ok(mut f) = OpenOptions::new().append(true).open(OUT_PATH) {
+                let _ = writeln!(f, "[PROBE] dump 超 8MiB 停写(arm 撤除后重跑请先删本文件)");
+            }
+            return;
+        }
+    }
+    if let Ok(mut f) = OpenOptions::new().create(true).append(true).open(OUT_PATH) {
+        let now = precise_time_ns();
+        let _ = writeln!(
+            f,
+            "[{:>9}.{:03}] {}",
+            now / 1_000_000_000,
+            (now / 1_000_000) % 1000,
+            line
+        );
+    }
+}
+
+fn pid_str(p: PipelineId) -> String {
+    format!("ns{}id{}", p.0, p.1)
+}
+
+fn rect_str(r: &LayoutRect) -> String {
+    format!(
+        "({:.1},{:.1} {:.1}x{:.1})",
+        r.min.x, r.min.y, r.max.x - r.min.x, r.max.y - r.min.y
+    )
+}
+
+/// ① 场景侧：SetDisplayList 进景 dump（scene_builder_thread 调用）。
+/// 打 DL 侧 iframe bounds 与 scroll frame external offset——child 构建真值。
+/// 同 pipeline 连续相同内容（光标闪烁类无几何变化事务）签名去重。
+pub fn note_scene_update(
+    document_id: &DocumentId,
+    pipeline_id: PipelineId,
+    epoch: Epoch,
+    dl: &BuiltDisplayList,
+) {
+    if !armed() {
+        return;
+    }
+    let mut body = String::with_capacity(2048);
+    body.push_str(&format!(
+        "[SCENE] SetDisplayList doc={:?} pipeline={} epoch={}",
+        document_id,
+        pid_str(pipeline_id),
+        epoch.0
+    ));
+    // 空间树段：scroll frame / reference frame descriptor（external offset 是
+    // nsSubDocumentFrame DL 侧偏移的直读点）。
+    let mut n_scroll = 0u32;
+    let mut n_ref = 0u32;
+    let mut n_sticky = 0u32;
+    dl.iter_spatial_tree(|item| {
+        match item {
+            SpatialTreeItem::ScrollFrame(d) => {
+                n_scroll += 1;
+                if n_scroll <= 32 {
+                    body.push_str(&format!(
+                        "\n[SCENE]   sf#{} frame={} content={} ext_off=({:.1},{:.1}) ext_id={} parent_space={:?}",
+                        n_scroll,
+                        rect_str(&d.frame_rect),
+                        rect_str(&d.content_rect),
+                        d.external_scroll_offset.x,
+                        d.external_scroll_offset.y,
+                        d.external_id.0,
+                        d.parent_space,
+                    ));
+                }
+            }
+            SpatialTreeItem::ReferenceFrame(d) => {
+                n_ref += 1;
+                if n_ref <= 32 {
+                    body.push_str(&format!(
+                        "\n[SCENE]   rf#{} origin=({:.1},{:.1}) parent={:?} kind={:?}",
+                        n_ref,
+                        d.origin.x,
+                        d.origin.y,
+                        d.parent_spatial_id,
+                        d.reference_frame.kind,
+                    ));
+                }
+            }
+            SpatialTreeItem::StickyFrame(_) => {
+                n_sticky += 1;
+            }
+            SpatialTreeItem::Invalid => {}
+        }
+    });
+    if n_scroll > 32 || n_ref > 32 {
+        body.push_str(&format!(
+            "\n[SCENE]   …共 sf={} rf={} sticky={}",
+            n_scroll, n_ref, n_sticky
+        ));
+    }
+    // 主 DL 段：iframe（browser 元素→内容 pipeline 的位置/尺寸）+ 深负 clip
+    // 原始值（v259d:child 是否直发毒值——与 scene_building 的 [CLIP_POISON]
+    // 对表，raw 相同=child 直发，raw 正常+snapped 毒=WR 平移毒）。
+    let mut n_iframe = 0u32;
+    let mut n_negclip = 0u32;
+    let mut traversal = dl.iter();
+    while let Some(item) = traversal.next() {
+        match item.item() {
+            DisplayItem::Iframe(info) => {
+                n_iframe += 1;
+                if n_iframe <= 16 {
+                    body.push_str(&format!(
+                        "\n[SCENE]   iframe#{} bounds={} pipeline={} clip={}",
+                        n_iframe,
+                        rect_str(&info.bounds),
+                        pid_str(info.pipeline_id),
+                        rect_str(&info.clip_rect),
+                    ));
+                }
+            }
+            DisplayItem::RectClip(info) => {
+                if info.clip_rect.min.y < -500.0 {
+                    n_negclip += 1;
+                    if n_negclip <= 8 {
+                        body.push_str(&format!(
+                            "\n[SCENE]   !!RectClip id={:?} raw={}",
+                            info.id,
+                            rect_str(&info.clip_rect),
+                        ));
+                    }
+                }
+            }
+            DisplayItem::RoundedRectClip(info) => {
+                if info.clip.rect.min.y < -500.0 {
+                    n_negclip += 1;
+                    if n_negclip <= 8 {
+                        body.push_str(&format!(
+                            "\n[SCENE]   !!RoundedRectClip id={:?} raw={}",
+                            info.id,
+                            rect_str(&info.clip.rect),
+                        ));
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+    if n_negclip > 8 {
+        body.push_str(&format!("\n[SCENE]   …共负clip={}", n_negclip));
+    }
+    if n_iframe > 16 {
+        body.push_str(&format!("\n[SCENE]   …共 iframe={}", n_iframe));
+    }
+    // 签名=几何内容（不含首行 epoch——光标闪烁类事务 epoch 递增但几何
+    // 不变，去重跳过；几何一旦变化必打）。
+    let geo_part = match body.find('\n') {
+        Some(pos) => &body[pos..],
+        None => "",
+    };
+    let sig = fnv1a(geo_part.as_bytes());
+    {
+        let mut last = LAST_SCENE_SIG.lock().unwrap();
+        if *last == sig {
+            return;
+        }
+        *last = sig;
+    }
+    let mut rest = body.as_str();
+    while let Some(pos) = rest.find('\n') {
+        let (line, tail) = rest.split_at(pos);
+        write(line);
+        rest = &tail[1..];
+    }
+    if !rest.is_empty() {
+        write(rest);
+    }
+}
+
+/// ② 帧侧：PublishDocument 前 dump（render_backend 调用）。
+/// pipeline epochs + 文档视图 + 解析后空间树（渲染几何真值，含 APZ 采样）。
+/// 连续内容相同的帧只打一行签名，防刷屏。
+pub fn note_frame_publish(
+    document_id: &DocumentId,
+    publish_id: u64,
+    view_device_rect: &api::units::DeviceIntRect,
+    frame_device_rect: &api::units::DeviceIntRect,
+    pipeline_epochs: &FastHashMap<PipelineId, Epoch>,
+    spatial_tree: &SpatialTree,
+) {
+    if !armed() {
+        return;
+    }
+    let mut body = String::with_capacity(4096);
+    let mut eps: Vec<(&PipelineId, &Epoch)> = pipeline_epochs.iter().collect();
+    eps.sort_by_key(|(p, _)| (p.0, p.1));
+    body.push_str(&format!(
+        "[FRAME] doc={:?} pub={} view_dev=({},{},{}x{}) frame_dev=({},{},{}x{}) epochs[",
+        document_id,
+        publish_id,
+        view_device_rect.min.x,
+        view_device_rect.min.y,
+        view_device_rect.max.x - view_device_rect.min.x,
+        view_device_rect.max.y - view_device_rect.min.y,
+        frame_device_rect.min.x,
+        frame_device_rect.min.y,
+        frame_device_rect.max.x - frame_device_rect.min.x,
+        frame_device_rect.max.y - frame_device_rect.min.y,
+    ));
+    for (p, e) in &eps {
+        body.push_str(&format!("{}:{},", pid_str(**p), e.0));
+    }
+    body.push_str("]");
+    for (i, node) in spatial_tree.ohos_nodes().iter().enumerate() {
+        body.push_str(&ohos_node_line(i, node));
+    }
+    let sig = fnv1a(body.as_bytes());
+    if sig == LAST_FRAME_SIG.load(Ordering::Relaxed) {
+        return;
+    }
+    LAST_FRAME_SIG.store(sig, Ordering::Relaxed);
+    // 逐行 write（同一互斥下逐行追加，崩溃安全）。
+    let mut rest = body.as_str();
+    while let Some(pos) = rest.find('\n') {
+        let (line, tail) = rest.split_at(pos);
+        write(line);
+        rest = &tail[1..];
+    }
+    if !rest.is_empty() {
+        write(rest);
+    }
+}
+
+fn ohos_node_line(i: usize, node: &SpatialNode) -> String {
+    let kind = match &node.node_type {
+        SpatialNodeType::ScrollFrame(info) => format!(
+            "sf view={} ext_id={} ext_off=({:.1},{:.1}) scrollable=({:.1},{:.1}) sampled=({:.1},{:.1})",
+            rect_str(&info.viewport_rect),
+            info.external_id.0,
+            info.external_scroll_offset.x,
+            info.external_scroll_offset.y,
+            info.scrollable_size.width,
+            info.scrollable_size.height,
+            info.offsets.first().map(|o| o.offset.x).unwrap_or(0.0),
+            info.offsets.first().map(|o| o.offset.y).unwrap_or(0.0),
+        ),
+        SpatialNodeType::ReferenceFrame(info) => format!(
+            "rf origin=({:.1},{:.1}) pipeline_root={}",
+            info.origin_in_parent_reference_frame.x,
+            info.origin_in_parent_reference_frame.y,
+            info.is_pipeline_root,
+        ),
+        SpatialNodeType::StickyFrame(_) => "sticky".to_string(),
+    };
+    format!(
+        "\n[FRAME]   node#{} parent={:?} p={} {} vt=({:.1},{:.1})x({:.3},{:.3})",
+        i,
+        node.parent,
+        pid_str(node.pipeline_id),
+        kind,
+        node.viewport_transform.offset.x,
+        node.viewport_transform.offset.y,
+        node.viewport_transform.scale.x,
+        node.viewport_transform.scale.y,
+    )
+}
+
+fn fnv1a(bytes: &[u8]) -> u64 {
+    let mut h: u64 = 0xcbf29ce484222325;
+    for b in bytes {
+        h ^= *b as u64;
+        h = h.wrapping_mul(0x100000001b3);
+    }
+    h
+}
