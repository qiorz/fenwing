+class OHOSTabStateObserver final : public nsIObserver {
+ public:
+  NS_DECL_ISUPPORTS
+  NS_DECL_NSIOBSERVER
+
+  OHOSTabStateObserver() = default;
+
+ private:
+  ~OHOSTabStateObserver() = default;
+};
+
+NS_IMPL_ISUPPORTS(OHOSTabStateObserver, nsIObserver)
+
+NS_IMETHODIMP
+OHOSTabStateObserver::Observe(nsISupports* aSubject, const char* aTopic,
+                              const char16_t* aData) {
+  if (strcmp(aTopic, "airweb-tab-state") == 0) {
+    if (aData) {
+      NS_ConvertUTF16toUTF8 json(aData);
+      const std::string& s = json.get();
+      // v256f→v257: 解析选中标签(active:true 项)的 url,特权页(about:/
+      // chrome:)期间置全绘保险丝模式(消费端 gfx.ohos.chrome-content-
+      // full-paint,默认关)。轻量字符串扫描,不引 JSON 依赖:找
+      // "active":true,向前找最近的 "url":" 读到下个引号。
+      // v257 修复两个结构缺陷:
+      // ① airweb-tab-state 是信封复用主题(loadState/urlbarFocus/findResult/
+      //   doorhanger 等都走 pushEnvelope 同 topic 投递),旧版对每个信封都
+      //   扫描,非 tab 信封必无 "active":true → 特权页上 Ctrl+L/Ctrl+F 会
+      //   把模式静默打回 0 直到下一标签事件。仅 tab 承载信封(含 "tabs":
+      //   列表,其余信封无此键)参与模式判定;
+      // ② 扫描移出 gTabStateCallback 判空——ArkTS 回调未注册(降级路径)
+      //   时模式逻辑不再整体失效。
+      if (s.find("\"tabs\":") != std::string::npos) {
+        size_t act = s.find("\"active\":true");
+        bool chromeSel = false;
+        if (act != std::string::npos) {
+          size_t u = s.rfind("\"url\":\"", act);
+          if (u != std::string::npos) {
+            u += 7;
+            size_t end = s.find('"', u);
+            if (end != std::string::npos) {
+              std::string url = s.substr(u, end - u);
+              chromeSel = url.compare(0, 6, "about:") == 0 ||
+                          url.compare(0, 7, "chrome:") == 0;
+            }
+          }
+        }
+        OHOS_SetChromeContentMode(chromeSel ? 1 : 0);
+      }
+      if (gTabStateCallback) {
+        // 回调内部(tsfn 投递前)已复制字符串,指针不过期
+        gTabStateCallback(json.get());
+      }
+    }
+  } else if (strcmp(aTopic, "airweb-addon-install") == 0) {
+    if (gAddonInstallCallback && aData) {
+      NS_ConvertUTF16toUTF8 json(aData);
+      gAddonInstallCallback(json.get());
+    }
+  }
+  return NS_OK;
+}
+
+// 幂等注册(仅 Gecko 主线程调用;由 OHOSProgressListener 的标签补挂链触发)
+void OHOS_EnsureTabStateObserver() {
+  static bool sRegistered = false;
+  if (sRegistered) {
+    return;
+  }
+  nsCOMPtr<nsIObserverService> obsServ = mozilla::services::GetObserverService();
+  if (!obsServ) {
+    return;
+  }
+  obsServ->AddObserver(new OHOSTabStateObserver(), "airweb-tab-state", false);
+  obsServ->AddObserver(new OHOSTabStateObserver(), "airweb-addon-install", false);
+  sRegistered = true;
+  OHOS_LOG("[XRE] OHOSTabStateObserver 已注册(airweb-tab-state+airweb-addon-install)\n");
+}
+
+// ============================================================================
+// 通道 1:ArkTS → chrome JS 同步调用(GeckoBridge_ChromeJSCall)
+// ============================================================================
+
+struct OHOSChromeJSCallContext {
+  std::mutex mtx;
+  std::condition_variable cv;
+  bool done = false;
+  // v243 同款:调用方超时放弃所有权标志(mtx 保护),runnable 迟到时锁内
+  // 裁决 delete,消除栈 ctx 销毁后 runnable 执行的 UAF 窗口。
+  bool abandoned = false;
+  // v265: 异步派发所有权移交(runnable Run 尾恒 delete,无等待方)。
+  // 派发前置位,此后只读。
+  bool asyncOwned = false;
+  nsCString method;
+  nsCString arg;
+  nsCString result;
+  bool ok = false;
+};
+
+class OHOSChromeJSCallRunnable final : public mozilla::Runnable {
+ public:
+  explicit OHOSChromeJSCallRunnable(OHOSChromeJSCallContext* aCtx)
+      : mozilla::Runnable("OHOSChromeJSCallRunnable"), mCtx(aCtx) {}
+
+  NS_IMETHOD Run() override {
+    nsCOMPtr<mozIDOMWindowProxy> recentWindow = OHOSFindChromeWindow();
+    nsCOMPtr<nsPIDOMWindowOuter> piWin = do_QueryInterface(recentWindow);
+    nsCOMPtr<nsPIDOMWindowInner> inner =
+        piWin ? piWin->GetCurrentInnerWindow() : nullptr;
+    nsGlobalWindowInner* globalWin =
+        inner ? nsGlobalWindowInner::Cast(inner) : nullptr;
+    nsIGlobalObject* sgo = globalWin;
+    if (sgo) {
+      mozilla::dom::AutoEntryScript aes(sgo, "OHOSChromeJSCall");
+      JSContext* cx = aes.cx();
+      JS::Rooted<JSObject*> global(cx, sgo->GetGlobalJSObject());
+      JS::Rooted<JS::Value> bridgeVal(cx);
+      if (global &&
+          JS_GetProperty(cx, global, "OHOSChromeBridge", &bridgeVal) &&
+          bridgeVal.isObject()) {
+        JS::Rooted<JSObject*> bridge(cx, &bridgeVal.toObject());
+        JS::RootedValueArray<2> args(cx);
+        JS::RootedString mstr(cx, JS_NewStringCopyZ(cx, mCtx->method.get()));
+        JS::RootedString astr(cx, JS_NewStringCopyZ(cx, mCtx->arg.get()));
+        args[0].setString(mstr ? mstr : JS_GetEmptyString(cx));
+        args[1].setString(astr ? astr : JS_GetEmptyString(cx));
+        JS::Rooted<JS::Value> rval(cx);
+        if (JS_CallFunctionName(cx, bridge, "call", args, &rval)) {
+          mCtx->ok = true;
+          if (rval.isString()) {
+            nsAutoJSString str;
+            if (str.init(cx, rval.toString())) {
+              mCtx->result = NS_ConvertUTF16toUTF8(str);
+            }
+          }
+        } else {
+          // JS 异常:清异常继续(不影响主线程其他任务)
+          aes.ReportException();
+          OHOS_LOG("[XRE] OHOSChromeJSCall %s JS 异常\n",
+                  mCtx->method.get());
+        }
+      } else {
+        OHOS_LOG("[XRE] OHOSChromeJSCall: OHOSChromeBridge 未就绪 method=%s\n",
+                mCtx->method.get());
+      }
+    }
+    // v243 同款锁内所有权裁决(v265: asyncOwned 时无等待方,一并移交)
+    bool orphaned = false;
+    {
+      std::lock_guard<std::mutex> lock(mCtx->mtx);
+      orphaned = mCtx->abandoned;
+      if (!orphaned) {
+        mCtx->done = true;
+        mCtx->cv.notify_one();
+      }
+    }
+    if (orphaned || mCtx->asyncOwned) {
+      delete mCtx;
+    }
+    return NS_OK;
+  }
+
+ private:
+  OHOSChromeJSCallContext* mCtx;
+};
+
+// 同步调用 chrome 窗口 window.OHOSChromeBridge.call(method, argJson)。
+// 返回值:1=调用成功(结果写入 aOutBuf,可为空串),0=失败/超时/未就绪。
+__attribute__((visibility("default")))
+extern "C" int GeckoBridge_ChromeJSCall(const char* aMethod, const char* aArg,
+                                        char* aOutBuf, int aBufLen) {
+  if (!aMethod || !aOutBuf || aBufLen <= 0) {
+    return 0;
+  }
+  aOutBuf[0] = '\0';
+  auto* ctx = new OHOSChromeJSCallContext();
+  ctx->method.Assign(aMethod);
+  ctx->arg.Assign(aArg ? aArg : "");
+  if (NS_IsMainThread()) {
+    OHOSChromeJSCallRunnable runnable(ctx);
+    runnable.Run();
+  } else {
+    nsresult rv = NS_DispatchToMainThread(
+        mozilla::MakeAndAddRef<OHOSChromeJSCallRunnable>(ctx));
+    if (NS_FAILED(rv)) {
+      OHOS_LOG("[XRE] GeckoBridge_ChromeJSCall 派发失败 rv=0x%x\n",
+              (unsigned)rv);
+      delete ctx;
+      return 0;
+    }
+    std::unique_lock<std::mutex> lock(ctx->mtx);
+    const bool ok =
+        ctx->cv.wait_for(lock, std::chrono::seconds(2),
+                         [ctx]() { return ctx->done; });
+    if (!ok) {
+      ctx->abandoned = true;
+      lock.unlock();
+      OHOS_LOG("[XRE] GeckoBridge_ChromeJSCall 超时 2s method=%s(所有权移交)\n",
+              aMethod);
+      return 0;
+    }
+    lock.unlock();
+  }
+  int ok = ctx->ok ? 1 : 0;
+  if (ok) {
+    snprintf(aOutBuf, aBufLen, "%s", ctx->result.get());
+  }
+  delete ctx;
+  return ok;
+}
+
+// v265: 异步命令通道——命令族(select/close/new/menu/home/loadURL 等)
+// fire-and-forget,派发到 Gecko 主线程即返回,不等执行结果(效果经
+// airweb-tab-state 推送回流)。动机:同步版 2s 等待在 Gecko 主线程忙时
+// (会话恢复/重布局/合成期)会把 ArkTS 主线程逐次钉死最长 2s,用户连点
+// 标签即"切标签卡死"观感(v265 mini 取证:部署旧包 + 连点 2s 超时叠加)。
+// 返回:1=派发受理,0=派发失败(与同步版失败同语义,调用方静默降级)。
+__attribute__((visibility("default")))
+extern "C" int GeckoBridge_ChromeJSCallAsync(const char* aMethod,
+                                             const char* aArg) {
+  if (!aMethod) {
+    return 0;
+  }
+  auto* ctx = new OHOSChromeJSCallContext();
+  ctx->method.Assign(aMethod);
+  ctx->arg.Assign(aArg ? aArg : "");
+  ctx->asyncOwned = true;
+  nsresult rv = NS_DispatchToMainThread(
+      mozilla::MakeAndAddRef<OHOSChromeJSCallRunnable>(ctx));
+  if (NS_FAILED(rv)) {
+    OHOS_LOG("[XRE] GeckoBridge_ChromeJSCallAsync 派发失败 rv=0x%x\n",
+            (unsigned)rv);
+    delete ctx;
+    return 0;
+  }
+  return 1;
+}
