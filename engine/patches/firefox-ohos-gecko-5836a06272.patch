+// ============================================================================
+// 页内查找 Runnable
+// ============================================================================
+// 通过 nsIFind 获取接口实现页内查找。Gecko 的页内查找标准方式是
+// 通过 nsIWebBrowserFind(nsIDocShell 实现),支持大小写敏感、回环查找。
+class OHOSFindInPageRunnable : public mozilla::Runnable {
+ public:
+  OHOSFindInPageRunnable(const nsString& aQuery, bool aBackward, bool aMatchCase)
+      : mozilla::Runnable("OHOSFindInPageRunnable"),
+        mQuery(aQuery),
+        mBackward(aBackward),
+        mMatchCase(aMatchCase) {}
+
+  NS_IMETHOD Run() override {
+    if (mQuery.IsEmpty()) {
+      return NS_OK;
+    }
+    nsCOMPtr<nsIWebNavigation> webNav = GetContentWebNavigation();
+    nsCOMPtr<nsIDocShell> docShell = do_QueryInterface(webNav);
+    if (!docShell) {
+      OHOS_LOG("[XRE] OHOSFindInPage: docShell 未就绪\n");
+      return NS_OK;
+    }
+    // nsIDocShell 实现 nsIWebBrowserFind,这是 Gecko 标准页内查找接口
+    nsCOMPtr<nsIWebBrowserFind> finder = do_QueryInterface(docShell);
+    if (!finder) {
+      OHOS_LOG("[XRE] OHOSFindInPage: nsIWebBrowserFind 不可用\n");
+      return NS_OK;
+    }
+    // SetSearchString 接受 const nsAString&,nsString 可隐式转 nsAString&,直接传 mQuery
+    finder->SetSearchString(mQuery);
+    finder->SetFindBackwards(mBackward);
+    finder->SetMatchCase(mMatchCase);
+    // SetWrapFind(true):查找到末尾时回环到开头继续(对应旧错误命名 SetWrapSearch)
+    finder->SetWrapFind(true);
+    bool didFind = false;
+    finder->FindNext(&didFind);
+    // NS_ConvertUTF16toUTF8 在 nsUTF8Utils.h 中定义,通常已通过 mozilla/Preferences.h
+    // 等头文件间接 include;此处用于将 nsString 转换为 UTF-8 以便 fprintf 输出
+    OHOS_LOG("[XRE] OHOSFindInPage: query='%s' found=%d\n",
+            NS_ConvertUTF16toUTF8(mQuery).get(), (int)didFind);
+    return NS_OK;
+  }
+
+ private:
+  nsString mQuery;
+  bool mBackward;
+  bool mMatchCase;
+};
