+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can get one at http://mozilla.org/mozilla.org/MPL/2.0/. */
+
+#include "nsLookAndFeel.h"
+
+#include "gfxFont.h"  // gfxFontStyle 完整定义
+
+// OpenHarmony nsLookAndFeel(stage1):所有原生查询返回 NS_ERROR_FAILURE,
+// 由 nsXPLookAndFeel 回退到默认值。stage2 对接 OHOS 主题服务后细化。
+
+nsresult nsLookAndFeel::NativeGetInt(IntID aID, int32_t& aResult) {
+  return NS_ERROR_FAILURE;
+}
+
+nsresult nsLookAndFeel::NativeGetFloat(FloatID aID, float& aResult) {
+  return NS_ERROR_FAILURE;
+}
+
+nsresult nsLookAndFeel::NativeGetColor(ColorID aID, ColorScheme aScheme,
+                                       nscolor& aResult) {
+  // v148 根治(chrome 弹窗纯黑):OHOS 无原生主题服务,系统色回退到 XP 通用
+  // standin 表(深色模式经 GenericDarkColor,未覆盖的 ID 自动落回通用表,
+  // 不会产出黑色)。此前返回 NS_ERROR_FAILURE 时,sColorStores 全填
+  // kNoColor,chrome 弹窗的系统色关键字(popup.css --panel-background: Menu、
+  // MenuText 等)在 LookAndFeel::Color(LookAndFeel.h:448)落到默认
+  // aDefault=NS_RGB(0,0,0)=opaque black —— ≡菜单/右键菜单/下载面板等一切
+  // XUL popup 背景+文字+边框全部 rgba(0,0,0,1) 黑底黑字(黑菜单根因)。
+  aResult = GetStandinForNativeColor(aID, aScheme);
+  return NS_OK;
+}
+
+bool nsLookAndFeel::NativeGetFont(FontID aID, nsString& aFontName,
+                                  gfxFontStyle& aFontStyle) {
+  aFontName.Truncate();
+  aFontStyle = gfxFontStyle();
+  return false;
+}
