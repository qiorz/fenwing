diff --git a/browser/base/content/phone-chrome.js b/browser/base/content/phone-chrome.js
new file mode 100644
index 0000000000..f5c12028d6
--- /dev/null
+++ b/browser/base/content/phone-chrome.js
@@ -0,0 +1,133 @@
+/* -*- indent-tabs-mode: nil; js-indent-level: 2 -*-
+ * [OHOS v233→v252] phone-chrome.js — 手机形态 chrome 残核(HarmonyOS 移植).
+ *
+ * v252 P4 瘦身(609→~120 行):v250 起 ArkTS 组件接管底栏六键/标签切换器/
+ * 进度条/标签计数,原 DOM 接线对幽灵元素是死代码,已删;v234 三路加载
+ * 完成信号机迁 ohos-chrome-bridge.js(全形态,loadState 信封)。
+ *
+ * 本文件仅存 XUL 布局行为(ArkTS 够不着的部分):
+ *   ① mozilla.org 域 per-tab 桌面 Firefox UA(AMO 安装链依赖,v236)
+ *   ② 键盘避让 pref → CSS 变量 --phone-bottom-inset(#browser 让位是
+ *      XUL 布局行为;media query 无法表达连续值,必须有这小段 JS)
+ *   ③ :root width/height 属性移除(v238c viewport 根治配套)
+ *   ④ toast 单例(window.ohosPhoneToast,书签/扩展安装等 chrome 模块调用)
+ *
+ * 形态门控:ohos.form.factor != "phone" 时首行即返回;全部事件驱动无轮询。
+ */
+
+(() => {
+  // ---- 形态门控 ----
+  let formFactor = "";
+  try {
+    formFactor = Services.prefs.getCharPref("ohos.form.factor", "");
+  } catch (e) {}
+  if (formFactor !== "phone") {
+    return;
+  }
+  dump("[OHOS v252] phone-chrome.js active (残核:UA/键盘/根属性/toast)\n");
+
+  // ---- v236: mozilla.org 域 per-tab 桌面 Firefox UA ----
+  // AMO(addons.mozilla.org)按 UA 判定浏览器:手机档伪装 Chrome Mobile 时
+  // AMO 给安卓引导页且不显示 xpi 安装按钮。docShell.customUserAgent 同时
+  // 改写该 tab 的 navigator.userAgent 与 HTTP UA(GeckoView 同机制),对
+  // mozilla.org 域切换真实桌面 Firefox 串(版本随构建宏),离开即清(null
+  // 恢复全局移动 UA)。其余站点零影响。
+  const DESKTOP_FX_UA =
+    `Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:142.0) ` +
+    `Gecko/20100101 Firefox/142.0`;
+
+  function applySiteUA(browser, uri) {
+    try {
+      const isMozilla = uri.schemeIs("https") &&
+        /(^|\.)mozilla\.org$/.test(uri.host || "");
+      const ds = browser.docShell;
+      if (ds) {
+        ds.customUserAgent = isMozilla ? DESKTOP_FX_UA : null;
+      }
+    } catch (e) {
+      dump(`[OHOS v236] applySiteUA 失败: ${e}\n`);
+    }
+  }
+
+  // ---- v234: 键盘避让(ArkTS NativeShellPage 推 ohos.chrome.kbd_height_px,
+  // vp 数值即 CSSpx,与 top_inset v188 同构;手机 CSS 全用 --phone-bottom-inset
+  // 消费:内容区让位)----
+  const KBD_PREF = "ohos.chrome.kbd_height_px";
+
+  function applyKeyboardInset() {
+    let h = 0;
+    try {
+      h = parseFloat(Services.prefs.getCharPref(KBD_PREF, "0")) || 0;
+    } catch (e) {}
+    // v235c: 合理域 clamp(键盘典型 200-350 CSSpx;异常上报/残值防御,
+    // 314 残值把底栏顶到屏幕中部的实测事故见 NativeShellPage v235c 注释)
+    h = Math.max(0, Math.min(400, h));
+    document.documentElement.style.setProperty("--phone-bottom-inset", `${h}px`);
+  }
+
+  // ---- toast 单例(新顶旧;暴露给其他 chrome 模块) ----
+  let toastEl = null;
+  let toastTimer = 0;
+
+  function showToast(msg) {
+    if (!toastEl) {
+      return;
+    }
+    toastEl.textContent = msg;
+    toastEl.setAttribute("shown", "true");
+    clearTimeout(toastTimer);
+    toastTimer = setTimeout(() => toastEl.removeAttribute("shown"), 2400);
+  }
+  window.ohosPhoneToast = showToast;
+
+  // ---- 初始化(window load:DOM/XUL 绑定/gBrowser 全就绪后) ----
+  function init() {
+    toastEl = document.getElementById("phone-toast");
+    if (!toastEl) {
+      dump("[OHOS v252] phone 元素缺失(toast),残核部分未接线\n");
+    }
+
+    // mozilla.org 域 UA 切换(独立 tabsProgressListener,与 ohos-chrome-bridge
+    // 的推送/加载态 listener 并存)
+    if (window.gBrowser) {
+      gBrowser.addTabsProgressListener({
+        onLocationChange(browser, webProgress, request, uri) {
+          if (uri) {
+            applySiteUA(browser, uri);
+          }
+        },
+      });
+    }
+
+    // 键盘避让 pref 监听
+    try {
+      Services.prefs.addObserver(KBD_PREF, applyKeyboardInset);
+      applyKeyboardInset();
+    } catch (e) {
+      dump(`[OHOS v234] 键盘 inset 监听失败: ${e}\n`);
+    }
+
+    // [OHOS v238c] 撤销 browser-init.js 的桌面默认窗口尺寸属性
+    // (min(screen.availWidth*0.9,1280),OHOS availWidth 基准错误时=450
+    // → chrome 布局溢出真视口,viewport meta 全灭,见 phone-chrome.css
+    // :root 铺满规则注释)。CSS !important 已压过属性,此处再移除避免
+    // 任何几何代码(getAttribute("width"))读到 450。
+    const rootEl = document.documentElement;
+    if (rootEl.hasAttribute("width")) {
+      rootEl.removeAttribute("width");
+    }
+    if (rootEl.hasAttribute("height")) {
+      rootEl.removeAttribute("height");
+    }
+
+    dump("[OHOS v252] phone chrome 残核已接线(UA/键盘/根属性/toast)\n");
+  }
+
+  window.addEventListener("load", () => {
+    try {
+      init();
+    } catch (e) {
+      dump(`[OHOS v252] phone-chrome init 失败: ${e}\n`);
+    }
+  });
+})();
