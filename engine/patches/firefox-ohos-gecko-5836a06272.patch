+// v146 修正:仅靠 Invalidate+RequestRepaint 不可靠(Invalidate 只置 widget
+// 标记,view 树没有 invalid region,paint 无脏区可重建 display list)。
+// 改为直接经 nsViewManager::InvalidateView 标脏 view + PresShell::SchedulePaint
+// 调度重绘(view 树标脏的正路),保留原双调用做兜底。
+// 注:v146 当时以"[WRLM] 入口 30 分钟零次"论证注入块从不执行,v147 经
+// gecko_xre_diag.txt 查明该"零次"系 hilog 实时捕获管线假象——注入块本就在
+// 跑(主窗口 mNeedsPaint 恒 true 致 ~2Hz 常重建);InvalidateView 仍是更直接
+// 的标脏正路,保留。popup 黑屏真凶为 v148 系统色默认黑(nsLookAndFeel.cpp)。
+static void OHOS_InvalidateTopLevelForPopup(nsIWidget* aPopup) {
+  if (!aPopup) {
+    return;
+  }
+  nsIWidget* top = aPopup->GetTopLevelWidget();
+  if (!top || top == aPopup) {
+    return;
+  }
+  mozilla::LayoutDeviceIntRect bounds = top->GetBounds();
+  top->Invalidate(mozilla::LayoutDeviceIntRect(0, 0, bounds.Width(),
+                                               bounds.Height()));
+  nsIWidgetListener* listener = top->GetWidgetListener();
+  if (listener) {
+    listener->RequestRepaint();
+  }
+  // v146: view 树标脏 + 调度重绘(正路)
+  bool viewInvalidated = false, paintScheduled = false;
+  if (nsView* topView = nsView::GetViewFor(top)) {
+    topView->GetViewManager()->InvalidateView(topView);
+    viewInvalidated = true;
+    if (mozilla::PresShell* presShell =
+            topView->GetViewManager()->GetPresShell()) {
+      presShell->SchedulePaint();
+      paintScheduled = true;
+    }
+  }
+  OHOS_DiagLog("[XRE_POPUP] v134: 强制顶层窗口重绘(RequestRepaint) top=%p bounds=%dx%d listener=%p viewInvalidated=%d paintScheduled=%d",
+          (void*)top, bounds.Width(), bounds.Height(), (void*)listener,
+          (int)viewInvalidated, (int)paintScheduled);
+}
+
+// popup 显示计数 +1 (由 nsWindow::Show 在 popup 窗口 aState=true 真实转换时调用)
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_PopupShown(nsIWidget* aPopup) {
+  int after = gOHOSOpenPopupCount.fetch_add(1, std::memory_order_relaxed) + 1;
+  if (aPopup && !gOHOSOpenPopupWidgets.Contains(aPopup)) {
+    gOHOSOpenPopupWidgets.AppendElement(aPopup);
+  }
+  OHOS_DiagLog("[XRE_POPUP] GeckoBridge_PopupShown count=%d widgets=%zu popup=%p tid=%zu",
+          after, (size_t)gOHOSOpenPopupWidgets.Length(), (void*)aPopup,
+          (size_t)std::hash<std::thread::id>{}(std::this_thread::get_id()));
+  OHOS_InvalidateTopLevelForPopup(aPopup);
+}
+
+// popup 显示计数 -1 (由 nsWindow::Show 在 popup 窗口 aState=false 真实转换时调用)
+// 防负 clamp:正常情况下 PopupShown/Hidden 配对,此处防御性处理避免计数错乱
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_PopupHidden(nsIWidget* aPopup) {
+  int prev = gOHOSOpenPopupCount.fetch_sub(1, std::memory_order_relaxed);
+  int after = prev > 0 ? prev - 1 : 0;
+  if (prev <= 0) {
+    // 防负 clamp:回退到 0
+    gOHOSOpenPopupCount.store(0, std::memory_order_relaxed);
+  }
+  if (aPopup) {
+    gOHOSOpenPopupWidgets.RemoveElement(aPopup);
+  }
+  OHOS_DiagLog("[XRE_POPUP] GeckoBridge_PopupHidden count=%d (prev=%d) widgets=%zu popup=%p tid=%zu",
+          after, prev, (size_t)gOHOSOpenPopupWidgets.Length(), (void*)aPopup,
+          (size_t)std::hash<std::thread::id>{}(std::this_thread::get_id()));
+  OHOS_InvalidateTopLevelForPopup(aPopup);
+}
+
+// 查询当前是否有 popup 打开 (libxul 内部调用,不导出符号表)
+extern "C" bool GeckoBridge_AnyPopupOpen() {
+  return gOHOSOpenPopupCount.load(std::memory_order_relaxed) > 0;
+}
+
+// v134: 供 WebRenderLayerManager 在主窗口 EndTransaction 中枚举打开的 popup。
+// 仅在 Gecko 主线程调用(与注册表写操作同线程,无需加锁)。
+extern "C" int32_t GeckoBridge_GetOpenPopupCount() {
+  return (int32_t)gOHOSOpenPopupWidgets.Length();
+}
+
+extern "C" nsIWidget* GeckoBridge_GetOpenPopupWidget(int32_t aIndex) {
+  if (aIndex < 0 || aIndex >= (int32_t)gOHOSOpenPopupWidgets.Length()) {
+    return nullptr;
+  }
+  return gOHOSOpenPopupWidgets.ElementAt(aIndex);
+}
