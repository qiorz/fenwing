+/*
+ * AArch64 optimization stub for AAC Parametric Stereo DSP init function.
+ *
+ * FFmpeg 7.x provides NEON-optimized PS DSP in libavcodec/aarch64/
+ * aacpsdsp_init_aarch64.c (+ aacpsdsp_neon.S), but these files were not
+ * vendored into ffvpx during the AAC port (v107). This stub provides an
+ * empty implementation so the AAC decoder links cleanly, falling back to
+ * the standard C PS DSP implementation (correct, just slower than NEON).
+ *
+ * Same pattern as h264_init_aarch64_stub.c (v96). If NEON PS optimization
+ * is needed later, replace this file with the actual
+ * aacpsdsp_init_aarch64.c from FFmpeg 7.x.
+ */
+
+#include "aacpsdsp.h"
+
+void ff_psdsp_init_aarch64(PSDSPContext *s)
+{
+    /* no-op: use standard C implementation */
+}
