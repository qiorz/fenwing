+// 同步原语:GeckoMainThread 等待 OnSurfaceCreated 注入 OHNativeWindow
+// 必须在 libxul.so 内(单一份),避免 .so 副本各自独立导致同步失败
+static std::mutex gNativeWindowMutex;
+static std::condition_variable gNativeWindowCV;
+
+// 日志采样计数器:OHOS_GetNativeWindow 可能高频调用,采样输出避免日志冲爆
+static std::atomic<uint64_t> gGetNativeWindowCallCount{0};
+static std::atomic<bool> gGetNativeWindowFirstLogged{false};
+
+// XComponent 表面尺寸,由 OnSurfaceCreated/OnSurfaceChanged 注入
