+// 由 libgeckoview.so / libgeckoxcomp.so 副本调用:加载指定 URL
+// 在 libxul.symbols 中导出,供 NAPI 桥接模块动态链接调用
+// 注意:Mozilla 构建系统默认使用 -fvisibility=hidden,必须显式标记
+// visibility("default") 才能将符号导出到动态符号表
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_LoadURL(const char* aUrl) {
+  if (!aUrl || aUrl[0] == '\0') {
+    OHOS_LOG("[XRE] GeckoBridge_LoadURL url 为空,忽略\n");
+    return;
+  }
+  OHOS_LOG("[XRE] GeckoBridge_LoadURL url=%s\n", aUrl);
+
+  nsCString url(aUrl);
+  nsresult rv =
+      NS_DispatchToMainThread(mozilla::MakeAndAddRef<OHOSLoadURLEvent>(url));
+  if (NS_FAILED(rv)) {
+    OHOS_LOG("[XRE] GeckoBridge_LoadURL 派发失败 rv=0x%x\n",
+            (unsigned)rv);
+  }
+}
+
+// v88: 按 sessionId 加载 URL 到指定标签
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_LoadURLForSession(const char* aSessionId,
+                                              const char* aUrl) {
+  if (!aUrl || aUrl[0] == '\0' || !aSessionId) {
+    OHOS_LOG("[XRE] GeckoBridge_LoadURLForSession 参数为空,忽略\n");
+    return;
+  }
+  OHOS_LOG("[XRE] GeckoBridge_LoadURLForSession session=%s url=%s\n",
+          aSessionId, aUrl);
+  nsCString url(aUrl);
