+// ============================================================================
+// A3: 真实会话历史(GeckoBridge_GetSessionHistory)
+// ============================================================================
+// 背景:原 FirefoxBridge 自维护 globalHistoryIndex/maxHistoryIndex 启发式计数器,
+//   loadURL 时把其他标签的 historyIndex 标 -1,导致切回标签全量重载。
+// 实现:同步 C API,通过 out-params 返回 {index, count}。
+//   内部用 std::mutex + std::condition_variable 阻塞等待 Gecko 主线程 Runnable
+//   查询 nsIWebNavigation::GetSessionHistory → nsISHistory::GetIndex/GetCount。
+//   geckoview.cpp 的 NAPI 层在 NAPI 线程同步调用此 C 函数(阻塞,但耗时极短 —
+//   仅一次主线程派发 + 两次 getter)。ArkTS 层调用频率低(导航后/标签切换前)。
+// 返回值:true 成功(已填充 *outIndex/*outCount);false 失败(docShell 未就绪)。
+// v104: 若调用方已在 Gecko 主线程,直接查询,避免同步等待死锁/2s 超时。
+#include <mutex>
+#include <condition_variable>
+
+// 前向声明:实现见 GeckoBridge_GetSessionHistory 之前
+static bool QuerySessionHistoryOnMainThread(int32_t* outIndex, int32_t* outCount);
+
+struct SessionHistoryQueryContext {
+  std::mutex mtx;
+  std::condition_variable cv;
+  bool done = false;
+  int32_t index = 0;
+  int32_t count = 0;
+  bool ok = false;
+};
+
+class OHOSGetSessionHistoryRunnable : public mozilla::Runnable {
+ public:
+  explicit OHOSGetSessionHistoryRunnable(SessionHistoryQueryContext* aCtx)
+      : mozilla::Runnable("OHOSGetSessionHistoryRunnable"),
+        mCtx(aCtx) {}
+
+  NS_IMETHOD Run() override {
+    int32_t idx = 0;
+    int32_t cnt = 0;
+    mCtx->ok = QuerySessionHistoryOnMainThread(&idx, &cnt);
+    mCtx->index = idx;
+    mCtx->count = cnt;
+    std::lock_guard<std::mutex> lock(mCtx->mtx);
+    mCtx->done = true;
+    mCtx->cv.notify_one();
+    return NS_OK;
+  }
+
+ private:
+  SessionHistoryQueryContext* mCtx;
+};
+
+// 在 Gecko 主线程上直接查询 session history(无派发/无阻塞)。
+// v104: GetSessionHistory() 返回 already_AddRefed<ChildSHistory>,用 Index()/Count()。
+// v105: GetContentWebNavigation() 在某些时序下返回占位 docShell(其 BrowsingContext
+//   指向 about:blank,Index=-1/Count=0),导致前进/后退按钮永远 disabled。
+//   改为通过 chrome docShell 的 BrowsingContext 找到「真正持有用户导航历史的
+//   content docShell」,判断条件:BrowsingContext 当前 URI 非 about:blank 且
+//   ChildSHistory::Count() > 0。遍历所有 typeContent 子 docShell,取第一个匹配。
+static bool QuerySessionHistoryOnMainThread(int32_t* outIndex, int32_t* outCount) {
+  // v105: 直接遍历 chrome docShell 的所有 typeContent 子项,找一个有真实历史的。
+  // v110: 双轨窗口查找(native 轨道 windowtype=navigator:browser)
+  nsCOMPtr<mozIDOMWindowProxy> recentWindow = OHOSFindChromeWindow();
+  if (!recentWindow) {
+    *outIndex = 0;
+    *outCount = 0;
+    return false;
+  }
+  nsCOMPtr<nsPIDOMWindowOuter> piWindow = do_QueryInterface(recentWindow);
+  if (!piWindow) {
+    *outIndex = 0;
+    *outCount = 0;
+    return false;
+  }
+  nsCOMPtr<nsIDocShell> chromeDocShell = piWindow->GetDocShell();
+  nsCOMPtr<nsIDocShellTreeItem> chromeTreeItem = chromeDocShell;
+  if (!chromeTreeItem) {
+    *outIndex = 0;
+    *outCount = 0;
+    return false;
+  }
+
+  // 第一遍:v112 多标签修复——优先「IsActive==true 且 Count() > 0」的
+  // content docShell(当前选中标签的真实历史)。此前取第一个 Count>0 的,
+  // 多标签下恒返回标签1,系统返回键 canGoBack 判断失真。
+  // 第二遍:找任何 Count() > 0 的(v105 兼容)。
+  // 第三遍:全空时回退到第一个 content docShell(保留旧行为兼容)。
+  int32_t childCount = 0;
+  chromeTreeItem->GetInProcessChildCount(&childCount);
+  nsCOMPtr<nsIWebNavigation> fallbackWebNav;
+  nsCOMPtr<nsIWebNavigation> anyHistoryWebNav;
+  int32_t anyIdx = 0, anyCnt = 0;
+  for (int32_t i = 0; i < childCount; ++i) {
+    nsCOMPtr<nsIDocShellTreeItem> child;
+    chromeTreeItem->GetInProcessChildAt(i, getter_AddRefs(child));
+    if (!child) continue;
+    int32_t itemType = 0;
+    child->GetItemType(&itemType);
+    if (itemType != nsIDocShellTreeItem::typeContent) continue;
+
+    nsCOMPtr<nsIWebNavigation> webNav = do_QueryInterface(child);
+    if (!webNav) continue;
+    if (!fallbackWebNav) {
+      fallbackWebNav = webNav;
+    }
+    RefPtr<mozilla::dom::ChildSHistory> shistory = webNav->GetSessionHistory();
+    if (!shistory) continue;
+    int32_t idx = shistory->Index();
+    int32_t cnt = shistory->Count();
+    if (cnt <= 0) continue;
+
+    // 记录第一个有历史的(v105 兼容兜底)
+    if (!anyHistoryWebNav) {
+      anyHistoryWebNav = webNav;
+      anyIdx = idx;
+      anyCnt = cnt;
+    }
+    // v112: 当前选中标签(BrowsingContext::IsActive)且有真实历史 → 立即返回
+    nsCOMPtr<nsIDocShell> childDocShell = do_QueryInterface(child);
+    bool isActive = false;
+    if (childDocShell) {
+      RefPtr<mozilla::dom::BrowsingContext> bc =
+          childDocShell->GetBrowsingContext();
+      isActive = bc && bc->IsActive();
+    }
+    if (isActive) {
+      *outIndex = idx;
+      *outCount = cnt;
+      OHOS_LOG("[XRE] OHOSGetSessionHistory(selected-tab): index=%d count=%d\n", idx, cnt);
+      return true;
+    }
+  }
+
+  // 无 active 有历史:回退第一个有历史的 content docShell(v105 行为)。
+  if (anyHistoryWebNav) {
+    *outIndex = anyIdx;
+    *outCount = anyCnt;
+    OHOS_LOG("[XRE] OHOSGetSessionHistory(any-history): index=%d count=%d\n", anyIdx, anyCnt);
+    return true;
+  }
+
+  // 全部 count==0:回退第一个 content docShell(兼容初始 about:blank 状态)。
+  if (fallbackWebNav) {
+    RefPtr<mozilla::dom::ChildSHistory> shistory =
+        fallbackWebNav->GetSessionHistory();
+    if (shistory) {
+      int32_t idx = shistory->Index();
+      int32_t cnt = shistory->Count();
+      *outIndex = idx;
+      *outCount = cnt;
+      OHOS_LOG("[XRE] OHOSGetSessionHistory(fallback): index=%d count=%d\n", idx, cnt);
+      return true;
+    }
+  }
+
+  OHOS_LOG("[XRE] OHOSGetSessionHistory: 无 content webNav\n");
+  *outIndex = 0;
+  *outCount = 0;
+  return false;
+}
+
+__attribute__((visibility("default")))
+extern "C" bool GeckoBridge_GetSessionHistory(int32_t* outIndex, int32_t* outCount) {
+  if (!outIndex || !outCount) {
+    return false;
+  }
+  // v104: 已在主线程时直接查询,避免 NS_DispatchToMainThread + 同步等待死锁
+  // (NAPI 若偶发跑在 Gecko 主线程,旧实现会 2s 超时并返回 false)。
+  if (NS_IsMainThread()) {
+    return QuerySessionHistoryOnMainThread(outIndex, outCount);
+  }
+  SessionHistoryQueryContext ctx;
+  nsresult rv = NS_DispatchToMainThread(
+      mozilla::MakeAndAddRef<OHOSGetSessionHistoryRunnable>(&ctx));
+  if (NS_FAILED(rv)) {
+    OHOS_LOG("[XRE] GeckoBridge_GetSessionHistory 派发失败 rv=0x%x\n", (unsigned)rv);
+    *outIndex = 0;
+    *outCount = 0;
+    return false;
+  }
+  // 阻塞等待主线程 Runnable 完成(带 2s 超时防死锁)
+  std::unique_lock<std::mutex> lock(ctx.mtx);
+  ctx.cv.wait_for(lock, std::chrono::seconds(2),
+                  [&ctx]() { return ctx.done; });
+  if (!ctx.done) {
+    OHOS_LOG("[XRE] GeckoBridge_GetSessionHistory 超时 2s\n");
+    *outIndex = 0;
+    *outCount = 0;
+    return false;
+  }
+  *outIndex = ctx.index;
+  *outCount = ctx.count;
+  return ctx.ok;
+}
