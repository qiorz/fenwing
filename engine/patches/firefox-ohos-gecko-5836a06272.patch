+// ============================================================================
+// 公共辅助:获取当前 geckoview 窗口的 content nsIWebNavigation
+// ============================================================================
+// v88: 多 session 架构 — 提供两种寻址方式:
+//   GetContentWebNavigation():旧接口,返回第一个 content docShell(默认标签)
+//   GetWebNavigationForSession(sessionId):按 sessionId 寻址对应 browser 的 docShell
+//
+// sessionId → docShell 映射:通过 nsIDocShellTreeItem 的 typeContent 子项,
+// 每个标签对应一个 content docShell。映射关系由 CreateSession 时的索引维护。
+// 为简化实现,sessionId 直接编码 docShell 的 outerWindowID,这里遍历子 docShell
+// 比对 DOMWindowouterWindowID。若 sessionId 非数字(旧 "default"),回退到第一个。
+
+// v112: 多标签修复——查找当前选中标签(IsActive)的 content docShell。
+// gBrowser(native 轨道)/TabManager(classic 轨道)切换标签时设置
+// selected browser 的 docShellIsActive=true,其余为 false。
+// 此前 GoBack/getSessionHistory 一律取第一个 content docShell(标签1),
+// 多标签下导航/历史查询全部失真(v110 §2.4 遗留)。
+// 找不到 active 时回退第一个 content docShell(兼容单标签/初始化时序)。
+static already_AddRefed<nsIDocShellTreeItem> FindActiveContentTreeItem(
+    nsIDocShellTreeItem* chromeTreeItem) {
+  int32_t childCount = 0;
+  chromeTreeItem->GetInProcessChildCount(&childCount);
+  nsCOMPtr<nsIDocShellTreeItem> fallback;
+  for (int32_t i = 0; i < childCount; ++i) {
+    nsCOMPtr<nsIDocShellTreeItem> child;
+    chromeTreeItem->GetInProcessChildAt(i, getter_AddRefs(child));
+    if (!child) {
+      continue;
+    }
+    int32_t itemType = 0;
+    child->GetItemType(&itemType);
+    if (itemType != nsIDocShellTreeItem::typeContent) {
+      continue;
+    }
+    if (!fallback) {
+      fallback = child;
+    }
+    // v112: active 判定走 BrowsingContext::IsActive()(nsIDocShell 无
+    // GetIsActive 接口;docShellIsActive 属性最终反映到 BrowsingContext)
+    nsCOMPtr<nsIDocShell> childDocShell = do_QueryInterface(child);
+    if (!childDocShell) {
+      continue;
+    }
+    RefPtr<mozilla::dom::BrowsingContext> bc =
+        childDocShell->GetBrowsingContext();
+    if (bc && bc->IsActive()) {
+      return child.forget();
+    }
+  }
+  return fallback.forget();
+}
+
+static already_AddRefed<nsIWebNavigation> GetContentWebNavigation() {
+  // v110: 双轨窗口查找(native 轨道 windowtype=navigator:browser)
+  nsCOMPtr<mozIDOMWindowProxy> recentWindow = OHOSFindChromeWindow();
+  if (!recentWindow) {
+    return nullptr;
+  }
+  nsCOMPtr<nsPIDOMWindowOuter> piWindow = do_QueryInterface(recentWindow);
+  if (!piWindow) {
+    return nullptr;
+  }
+  nsCOMPtr<nsIDocShell> chromeDocShell = piWindow->GetDocShell();
+  if (!chromeDocShell) {
+    return nullptr;
+  }
+  nsCOMPtr<nsIDocShellTreeItem> chromeTreeItem = chromeDocShell;
+  if (!chromeTreeItem) {
+    return nullptr;
+  }
+  // v112: 优先当前选中标签(IsActive),多标签下 GoBack/Reload 等操作
+  // 作用于用户实际看到的标签而非恒为标签1。
+  nsCOMPtr<nsIDocShellTreeItem> activeChild =
+      FindActiveContentTreeItem(chromeTreeItem);
+  if (activeChild) {
+    nsCOMPtr<nsIWebNavigation> webNav = do_QueryInterface(activeChild);
+    return webNav.forget();
+  }
+  return nullptr;
+}
+
+// v88: 按 sessionId 寻址指定标签的 content nsIWebNavigation。
+// sessionId 为标签创建时的 browserIndex(数字字符串),用以选取第 N 个 content docShell。
+// v112 多标签修复:sessionId="default"(系统返回键 GeckoBridge_GoBack/GoForward/
+//   Reload/Stop 走此路径)改为寻址当前选中标签(IsActive)而非第一个,
+//   否则多标签下系统返回永远操作标签1(v110 §2.4 遗留)。
+// 显式数字 sessionId 保持按下标寻址(classic 轨道 TabManager session 语义)。
+// 找不到时回退到当前选中/第一个 content docShell(兼容性)。
+static already_AddRefed<nsIWebNavigation> GetWebNavigationForSession(const nsCString& aSessionId) {
+  // v110: 双轨窗口查找(native 轨道 windowtype=navigator:browser)
+  nsCOMPtr<mozIDOMWindowProxy> recentWindow = OHOSFindChromeWindow();
+  if (!recentWindow) {
+    return nullptr;
+  }
+  nsCOMPtr<nsPIDOMWindowOuter> piWindow = do_QueryInterface(recentWindow);
+  if (!piWindow) {
+    return nullptr;
+  }
+  nsCOMPtr<nsIDocShell> chromeDocShell = piWindow->GetDocShell();
+  if (!chromeDocShell) {
+    return nullptr;
+  }
+  nsCOMPtr<nsIDocShellTreeItem> chromeTreeItem = chromeDocShell;
+  if (!chromeTreeItem) {
+    return nullptr;
+  }
+  // v112: "default" → 当前选中标签(IsActive)
+  if (aSessionId.EqualsLiteral("default")) {
+    nsCOMPtr<nsIDocShellTreeItem> activeChild =
+        FindActiveContentTreeItem(chromeTreeItem);
+    if (activeChild) {
+      nsCOMPtr<nsIWebNavigation> webNav = do_QueryInterface(activeChild);
+      return webNav.forget();
+    }
+    return nullptr;
+  }
+  // 显式数字 sessionId:按下标选取第 N 个 content docShell
+  int32_t targetIndex = atoi(aSessionId.get());
+  if (targetIndex < 0) targetIndex = 0;
+  int32_t childCount = 0;
+  chromeTreeItem->GetInProcessChildCount(&childCount);
+  int32_t contentIndex = 0;
+  for (int32_t i = 0; i < childCount; ++i) {
+    nsCOMPtr<nsIDocShellTreeItem> child;
+    chromeTreeItem->GetInProcessChildAt(i, getter_AddRefs(child));
+    if (!child) {
+      continue;
+    }
+    int32_t itemType = 0;
+    child->GetItemType(&itemType);
+    if (itemType == nsIDocShellTreeItem::typeContent) {
+      if (contentIndex == targetIndex) {
+        nsCOMPtr<nsIWebNavigation> webNav = do_QueryInterface(child);
+        return webNav.forget();
+      }
+      contentIndex++;
+    }
+  }
+  // 回退:返回当前选中/第一个 content docShell
+  return GetContentWebNavigation();
+}
