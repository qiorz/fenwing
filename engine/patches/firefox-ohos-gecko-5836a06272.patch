+int32_t gSerializedCount = 0;
+const int32_t kMaxItems = 200;
+const int32_t kMaxDepth = 8;
+// 二级菜单(subview)已展开视图 id 集合:防 view A nav → view B nav → view A 环。
+nsTHashSet<nsString>& VisitedViews() {
