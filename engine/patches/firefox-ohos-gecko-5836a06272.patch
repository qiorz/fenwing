+// 在主线程异步加载 URL 的 Runnable
+// v88: 携带 mSessionId,加载到指定标签的 docShell
+class OHOSLoadURLEvent : public mozilla::Runnable {
+ public:
+  explicit OHOSLoadURLEvent(const nsCString& aUrl,
+                            const nsCString& aSessionId = "default"_ns)
+      : mozilla::Runnable("OHOSLoadURLEvent"),
+        mUrl(aUrl), mSessionId(aSessionId) {}
+
+  NS_IMETHOD Run() override {
+    OHOS_LOG("[XRE] OHOSLoadURLEvent[%s]::Run url=%s\n",
+            mSessionId.get(), mUrl.get());
+
+    nsCOMPtr<nsIWebNavigation> webNav = GetWebNavigationForSession(mSessionId);
+    if (!webNav) {
+      // 窗口/docShell 未就绪(可能 createBrowser 尚未完成),注册延迟监听
+      OHOS_LOG("[XRE] OHOSLoadURLEvent[%s] webNav 未就绪,跳过\n",
+              mSessionId.get());
+      return NS_OK;
+    }
+
+    nsCOMPtr<nsIURI> uri;
+    nsresult rv = NS_NewURI(getter_AddRefs(uri), mUrl);
+    if (NS_FAILED(rv)) {
+      OHOS_LOG("[XRE] OHOSLoadURLEvent[%s] NS_NewURI 失败 rv=0x%x url=%s\n",
+              mSessionId.get(), (unsigned)rv, mUrl.get());
+      return NS_OK;
+    }
+
+    // 构造 LoadURIOptions,使用系统主身份触发加载
+    mozilla::dom::LoadURIOptions loadURIOptions;
+    loadURIOptions.mTriggeringPrincipal = nsContentUtils::GetSystemPrincipal();
+
+    rv = webNav->LoadURI(uri, loadURIOptions);
+    OHOS_LOG("[XRE] OHOSLoadURLEvent[%s] LoadURI rv=0x%x\n",
+            mSessionId.get(), (unsigned)rv);
+    return NS_OK;
+  }
+
+ private:
+  nsCString mUrl;
+  nsCString mSessionId;
+};
