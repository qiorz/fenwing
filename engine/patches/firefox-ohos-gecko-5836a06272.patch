index 0000000000..817f7ef82e
--- /dev/null
+++ b/widget/openharmony/OHOSProgressListener.cpp
@@ -0,0 +1,1143 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can get one at http://www.mozilla.org/MPL/2.0/. */
+
+// OpenHarmony 页面加载进度监听器
+//
+// 作用:实现 GeckoBridge_SetURLChangeCallback / GeckoBridge_NotifyURLChange
+// 等导出符号,将 Gecko 内核的 URL 变化与页面加载状态通知到 ArkTS 层。
+//
+// 设计原理:
+//   libgeckoview.so 中 RegisterURLCallback 创建 napi_threadsafe_function,
+//   但该句柄存在 libgeckoview.so 的全局状态中,libxul.so 无法直接访问。
+//   采用"函数指针注册"模式:libgeckoview.so 将一个 C 函数指针注册到 libxul.so,
+//   libxul.so 在检测到 URL 变化/页面加载状态变化时调用该函数指针,
+//   该 C 函数(libgeckoview.so 中)再调用 napi_threadsafe_function 回调 ArkTS。
+//
+// 数据流(URL 变化):
+//   Gecko docShell webProgress -> OHOSProgressListener::OnLocationChange
+//     -> GeckoBridge_NotifyURLChange(url)
+//     -> gURLChangeCallback(url)  [libgeckoview.so 注册的函数指针]
+//     -> napi_call_threadside_function(urlCallback)
+//     -> ArkTS FirefoxBridge urlChangeCallback
+//
+// 数据流(页面加载状态):
+//   Gecko docShell webProgress -> OHOSProgressListener::OnStateChange
+//     -> GeckoBridge_NotifyPageLoad("start"/"stop")
+//     -> gPageLoadCallback(state)
+//     -> napi_call_threadside_function(pageLoadCallback)
+//     -> ArkTS FirefoxBridge pageLoadCallback
+
+#include <cstdio>
+#include <cstring>
+
+#include "mozilla/Services.h"  // services::GetObserverService
+#include "mozilla/Unused.h"
+#include "nsCOMPtr.h"
+#include "nsIChannel.h"  // v134: LOAD_DOCUMENT_URI 判定文档主请求
+#include "nsIDocShell.h"
+#include "nsIDocShellTreeItem.h"
+#include "nsIInterfaceRequestorUtils.h"  // do_GetInterface
+#include "nsIObserverService.h"
+#include "nsITimer.h"  // v136: 周期重扫定时器(为新标签补挂 listener)
+#include "nsIWebProgress.h"
+#include "nsIWebProgressListener.h"
+#include "nsIWindowMediator.h"
+#include "nsPIDOMWindow.h"
+#include "nsServiceManagerUtils.h"  // do_GetService
+#include "nsString.h"
+#include "nsThreadUtils.h"  // NS_DispatchToMainThread
+#include "nsWeakReference.h"
+#include "mozilla/RefPtr.h"
+#include "base/message_loop.h"  // MessageLoop::PostDelayedTask
+// v110: 双轨窗口查找(native=navigator:browser / classic=navigator:geckoview)
+#include "OHOSWindowFinder.h"
+// v135: BrowsingContext::IsActive 判定选中 browser(v112 FindActiveContentTreeItem 语义)
+#include "mozilla/dom/BrowsingContext.h"
+// v136: 窗口层活跃判定(nsWindow::GetTopActiveWindow / sActiveWindows),
+//   多窗口/单窗口双模型下定位「当前顶层活跃 nsWindow」,替代仅依赖
+//   BrowsingContext::IsActive(content 侧 active 概念,在 OHOS 多窗口模型下
+//   新 session 窗口可能不是 IsActive 导致 same=0 → 不发 ohos-url-change)。
+#include "nsIBaseWindow.h"  // GetTreeOwnerWindow → GetMainWidget(DOMWindow→widget)
+#include "nsWindow.h"  // stage2_xcomponent 已在 moz.build LOCAL_INCLUDES
+// v135: OHOS_DiagLog 写 gecko_xre_diag.txt(取地址栏断链根因取证)
+extern "C" void OHOS_DiagLog(const char* fmt, ...);
+// v250: 标签状态推送观察者注册(OHOSChromeBridge.cpp;幂等,主线程调用)
+void OHOS_EnsureTabStateObserver();
+// v249 paint-holding（F4 导航白闪）：实现在 RendererOGL.cpp。
+extern "C" void OHOS_PaintHoldEngage(const char* aReason, void* aOldDocument);
+extern "C" void OHOS_PaintHoldRelease(const char* aReason);
+// v257: 特权页全绘保险丝(gfx.ohos.chrome-content-full-paint)的模式开关,
+// 实现在 RenderCompositorEGL.cpp,同 DSO 内部。
+extern "C" void OHOS_SetChromeContentMode(int aOn);
+// v105: 时间戳用于限制 progress 上报频率(100ms 最小间隔)
+#include "prtime.h"  // PR_Now
+// A5: stderr 日志门控(OHOS_LOG 宏,OnProgressChange 等高频回调静默化)
+#include "OHOSDebug.h"
+
+// v105: 返回当前毫秒时间戳(单调,用于限制 OnProgressChange 上报频率)
+static inline int64_t NowMs() { return PR_Now() / 1000; }
+
+// ============================================================================
+// 桥接函数指针(libgeckoview.so 注册)
+// ============================================================================
+
+// 前向声明:本文件末尾定义,供 InitProgressListenerRunnable 使用
+// 注意:必须带 visibility("default") 与定义匹配(项目默认 -fvisibility=hidden)
+__attribute__((visibility("default")))
+extern "C" bool GeckoBridge_RegisterProgressListener(mozIDOMWindowProxy* aWindow);
+
+// v136 前向声明:遍历 chrome 窗口所有 content docShell,为尚未注册 listener 的
+//   content docShell 自动补挂 OHOSProgressListener。定义在 OHOSProgressListener 类后。
+//   放为自由函数(非类静态成员),以便在类定义之前被 OHOSStartupObserver /
+//   InitProgressListenerRunnable / 周期重扫定时器调用。
+int32_t OHOS_RegisterAllTabsListeners(mozIDOMWindowProxy* aWindow);
+
+// ============================================================================
+// 初始化辅助类(监听 browser-delayed-startup-finished 通知)
+// ============================================================================
+// 根因修复:进度监听器原先只在 OHOSLoadURLEvent::Run 中注册,但初始 URL 由
+// geckoview.js 从 OHOS_INITIAL_URL 环境变量加载,不经过 GeckoBridge_LoadURL,
+// 导致初始页面加载时进度监听器未注册,URL/PageLoad 回调无法触发。
+//
+// 解决方案:在 GeckoBridge_SetURLChangeCallback(ArkTS initFirefox 时调用)中,
+// 派发 InitProgressListenerRunnable 到 Gecko 主线程:
+//   1. 立即尝试通过 nsIWindowMediator 查找窗口并注册(窗口已创建时)
+//   2. 窗口不存在时注册 OHOSStartupObserver 监听 browser-delayed-startup-finished
+//      通知(geckoview.js startup() 第 931 行发送),通知到达时再注册
+
+// 监听 browser-delayed-startup-finished 通知,通知到达时注册进度监听器
+class OHOSStartupObserver final : public nsIObserver {
+ public:
+  NS_DECL_ISUPPORTS
+  NS_DECL_NSIOBSERVER
+
+  OHOSStartupObserver() = default;
+
+ private:
+  ~OHOSStartupObserver() = default;
+};
+
+NS_IMPL_ISUPPORTS(OHOSStartupObserver, nsIObserver)
+
+NS_IMETHODIMP
+OHOSStartupObserver::Observe(nsISupports* aSubject, const char* aTopic,
+                              const char16_t* aData) {
+  if (strcmp(aTopic, "browser-delayed-startup-finished") == 0) {
+    OHOS_LOG( "[XRE] OHOSStartupObserver 收到 browser-delayed-startup-finished\n");
+    // v110: 通知的 aSubject 就是已就绪的 chrome 窗口(classic=geckoview.js /
+    //   native=browser-init.js 均以窗口为 subject 发射),优先直接使用,
+    //   避免 native 轨道下再查 mediator 的 windowtype 不匹配问题。
+    nsCOMPtr<mozIDOMWindowProxy> recentWindow = do_QueryInterface(aSubject);
+    if (!recentWindow) {
+      // 兜底:双轨窗口查找(navigator:geckoview → navigator:browser)
+      recentWindow = OHOSFindChromeWindow();
+    }
+    if (recentWindow) {
+      GeckoBridge_RegisterProgressListener(recentWindow);
+      // v136: 启动时为所有 content docShell(全部标签)补挂 listener。
+      //   native 轨道下 NAPI 未暴露 createSession,首标签之后的新标签都靠
+      //   本调用 + 周期重扫定时器兜底补挂。
+      OHOS_RegisterAllTabsListeners(recentWindow);
+    } else {
+      OHOS_LOG( "[XRE] OHOSStartupObserver 通知到达但未找到窗口\n");
+    }
+    // 注册完成后移除自身(单次通知,不再需要)
+    nsCOMPtr<nsIObserverService> obsServ =
+        mozilla::services::GetObserverService();
+    if (obsServ) {
+      obsServ->RemoveObserver(this, "browser-delayed-startup-finished");
+    }
+  }
+  return NS_OK;
+}
+
+// v136: 周期重扫定时器 — 扫描 chrome 窗口所有 content docShell,
+//   为新建标签(尚未注册 listener 的)补挂 OHOSProgressListener。
+//   native 轨道下 ArkTS 新建标签走 gBrowser.addTab,无 C++ 回调入口,
+//   只能周期轮询补挂。
+//   v249b: 删除"连续 30 次无新增停止定时器"的节能自杀——m8 真机实证:
+//   启动 90s 后定时器已停,之后新建的标签永远没有 listener →
+//   nav-start engage 永不触发 → paint-holding 在新标签上完全失效
+//   (qq.com 白闪 1 帧根因)。3s 一次枚举几十个 docShell 的成本可忽略,
+//   常驻即可。
+static void RescanTabsForListeners(nsITimer* aTimer) {
+  nsCOMPtr<mozIDOMWindowProxy> recentWindow = OHOSFindChromeWindow();
+  if (!recentWindow) {
+    return;
+  }
+  OHOS_RegisterAllTabsListeners(recentWindow);
+}
+
+// 在 Gecko 主线程初始化进度监听器
+class InitProgressListenerRunnable final : public mozilla::Runnable {
+ public:
+  InitProgressListenerRunnable()
+      : mozilla::Runnable("InitProgressListenerRunnable") {}
+
+  NS_IMETHOD Run() override {
+    // 立即尝试查找窗口并注册(v110: 双轨查找,native=navigator:browser)
+    nsCOMPtr<mozIDOMWindowProxy> recentWindow = OHOSFindChromeWindow();
+    if (recentWindow) {
+      // 窗口已创建,尝试注册(可能 browser 元素尚未创建,返回 false)
+      if (GeckoBridge_RegisterProgressListener(recentWindow)) {
+        OHOS_LOG( "[XRE] InitProgressListenerRunnable 注册成功\n");
+        // v136: 启动时为所有 content docShell(全部标签)补挂 listener
+        OHOS_RegisterAllTabsListeners(recentWindow);
+        return NS_OK;
+      }
+      // 注册失败:窗口已存在但 content docShell 未就绪(browser 元素未创建)
+      OHOS_LOG( "[XRE] InitProgressListenerRunnable 窗口存在但 docShell 未就绪\n");
+    } else {
+      OHOS_LOG( "[XRE] InitProgressListenerRunnable 窗口不存在\n");
+    }
+    // 注册失败或窗口不存在,注册 Observer 等待 browser-delayed-startup-finished
+    // (该通知在 geckoview.js startup() 中 browser 元素创建后发送)
+    OHOS_LOG( "[XRE] InitProgressListenerRunnable 注册 Observer 等待 startup\n");
+    nsCOMPtr<nsIObserverService> obsServ =
+        mozilla::services::GetObserverService();
+    if (obsServ) {
+      obsServ->AddObserver(new OHOSStartupObserver(),
+                           "browser-delayed-startup-finished", false);
+    } else {
+      OHOS_LOG( "[XRE] InitProgressListenerRunnable ObserverService 不可用\n");
+    }
+    return NS_OK;
+  }
+};
+
+// URL 变化回调函数指针(由 libgeckoview.so RegisterURLCallback 注册)
+// v88: 回调签名增加 sessionId 参数,支持多标签独立回调
+static void (*gURLChangeCallback)(const char* sessionId, const char*) = nullptr;
+
+// 页面加载状态回调函数指针(由 libgeckoview.so RegisterPageLoadCallback 注册)
+static void (*gPageLoadCallback)(const char* sessionId, const char*) = nullptr;
+
+// v77: 页面加载进度回调函数指针(由 libgeckoview.so RegisterProgressCallback 注册)
+// progress: 0-100 百分比
+static void (*gProgressCallback)(const char* sessionId, int32_t) = nullptr;
+
+// 由 libgeckoview.so 调用:注册 URL 变化回调函数指针
+//
+// 注意:此函数由 ArkTS 层 initFirefox 中的 registerURLCallback 触发(NAPI 主线程),
+// 此时 Gecko 主线程(XRE_main)尚未启动,NS_DispatchToMainThread 会失败(XPCOM 未初始化)。
+// 进度监听器的注册改由 GeckoBridge_InitProgressListener 在 nsWindow::Create 中触发
+// (此时 Gecko 主线程已就绪,XPCOM 已初始化)。
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_SetURLChangeCallback(
+    void (*cb)(const char* sessionId, const char*)) {
+  gURLChangeCallback = cb;
+  OHOS_LOG( "[XRE] GeckoBridge_SetURLChangeCallback 已注册 cb=%p\n", (void*)cb);
+}
+
+// 由 libxul.so 内部调用:通知 URL 变化
+// v88: 增加 sessionId 参数,标识事件来源标签
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_NotifyURLChange(const char* aSessionId,
+                                            const char* aUrl) {
+  if (gURLChangeCallback && aUrl) {
+    gURLChangeCallback(aSessionId, aUrl);
+  }
+}
+
+// 由 libgeckoview.so 调用:注册页面加载状态回调函数指针
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_SetPageLoadCallback(
+    void (*cb)(const char* sessionId, const char*)) {
+  gPageLoadCallback = cb;
+  OHOS_LOG( "[XRE] GeckoBridge_SetPageLoadCallback 已注册 cb=%p\n", (void*)cb);
+}
+
+// 由 libxul.so 内部调用:通知页面加载状态
+// aState: "start" 或 "stop"
+// v88: 增加 sessionId 参数
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_NotifyPageLoad(const char* aSessionId,
+                                           const char* aState) {
+  if (gPageLoadCallback && aState) {
+    gPageLoadCallback(aSessionId, aState);
+  }
+}
+
+// v77: 由 libgeckoview.so 调用:注册页面加载进度回调函数指针
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_SetProgressCallback(
+    void (*cb)(const char* sessionId, int32_t)) {
+  gProgressCallback = cb;
+  OHOS_LOG( "[XRE] GeckoBridge_SetProgressCallback 已注册 cb=%p\n", (void*)cb);
+}
+
+// v243: 首帧合成完成回调函数指针(由 libgeckoview.so RegisterFirstCompositeCallback
+// 注册)。Renderer 线程首次成功 SwapBuffers 时由 RenderCompositorEGL::EndFrame
+// 经 GeckoBridge_NotifyFirstComposite 调用 → ArkTS 撤 Splash(信号严格等价
+// "真有像素上屏",优于 pageLoad stop)。
+static void (*gFirstCompositeCallback)() = nullptr;
+
+// 由 libgeckoview.so 调用:注册首帧合成回调函数指针
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_SetFirstCompositeCallback(void (*cb)()) {
+  gFirstCompositeCallback = cb;
+  OHOS_LOG( "[XRE] GeckoBridge_SetFirstCompositeCallback 已注册 cb=%p\n", (void*)cb);
+}
+
+// 由 libxul.so 内部调用(Renderer 线程):通知首帧合成完成。一次性消费。
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_NotifyFirstComposite() {
+  if (gFirstCompositeCallback) {
+    void (*cb)() = gFirstCompositeCallback;
+    gFirstCompositeCallback = nullptr;  // 一次性:取副本后清空防重入
+    cb();
+  }
+}
+
+// v77: 由 libxul.so 内部调用:通知页面加载进度
+// aProgress: 0-100 百分比
+// v88: 增加 sessionId 参数
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_NotifyProgress(const char* aSessionId,
+                                           int32_t aProgress) {
+  if (gProgressCallback) {
+    OHOS_LOG( "[XRE] GeckoBridge_NotifyProgress session=%s progress=%d\n",
+            aSessionId ? aSessionId : "(null)", aProgress);
+    gProgressCallback(aSessionId, aProgress);
+  }
+}
+
+// ============================================================================
+// nsIWebProgressListener 实现
+// ============================================================================
+
+// OHOS 页面加载进度监听器
+// 注册到 geckoview 窗口的 content docShell 的 webProgress 上,
+// 监听 URL 变化(onLocationChange)和页面加载状态(onStateChange)
+//
+// v88: 多 session 架构 — 每个标签的 browser 有独立 docShell/webProgress,
+//   每个 OHOSProgressListener 实例携带 mSessionId,回调时附带该标识,
+//   使 ArkTS 层能区分事件来自哪个标签。
+class OHOSProgressListener final : public nsIWebProgressListener,
+                                   public nsSupportsWeakReference {
+ public:
+  NS_DECL_ISUPPORTS
+  NS_DECL_NSIWEBPROGRESSLISTENER
+
+  // v88: 构造时绑定 sessionId
+  explicit OHOSProgressListener(const nsCString& aSessionId)
+      : mSessionId(aSessionId), mPageLoading(false) {}
+
+  // 注册到指定窗口的 content docShell
+  // v88: 改为 RegisterForSession — 每个 sessionId 对应一个 browser/content docShell
+  // aSessionId: 标签标识(与 ArkTS TabInfo.id 对应)
+  // 返回值:true 成功;false 失败(窗口/docShell 未就绪,可稍后重试)
+  static bool RegisterForSession(mozIDOMWindowProxy* aWindow,
+                                 const nsCString& aSessionId,
+                                 int32_t aBrowserIndex);
+
+ private:
+  ~OHOSProgressListener() = default;
+
+  // v88: 该监听器所属标签的 sessionId
+  nsCString mSessionId;
+  // v88: 实例级 start/stop 配对标志(取代原进程级 static)
+  bool mPageLoading;
+  // v105: 上次已上报的进度值(0-100)。
+  //   Gecko OnProgressChange 的 max 是请求开始时的预估值(Content-Length 或 -1),
+  //   实际下载字节 cur 常远超 max,导致 cur*100/max 直接 100,顶部进度条秒藏。
+  //   改为「单调递增 + 指数平滑 + 仅 STOP 上报 100」,与 Chrome/Edge 一致:
+  //   - STATE_START 时重置为 0
+  //   - 每次 OnProgressChange 只允许上升,不让 cur>max 直接 100
+  //   - max<=0(未知大小)时按指数曲线逼近 95,永不自发到 100
+  //   - 仅 STATE_STOP 才上报 100
+  int32_t mLastProgress = 0;
+  // v105: 上次上报的时间戳(ms),限制最小上报间隔 100ms 避免高频刷新抖动。
+  int64_t mLastNotifyMs = 0;
+};
+
+NS_IMPL_ISUPPORTS(OHOSProgressListener, nsIWebProgressListener,
+                  nsISupportsWeakReference)
+
+NS_IMETHODIMP
+OHOSProgressListener::OnStateChange(nsIWebProgress* aWebProgress,
+                                    nsIRequest* aRequest,
+                                    uint32_t aStateFlags,
+                                    nsresult aStatus) {
+  // v76: 用标志位确保 start/stop 配对,解决 iframe/重定向导致的 stop 信号丢失
+  // v88: mPageLoading 从进程级 static 改为实例成员,每个标签独立跟踪加载状态
+  // v134: 真机证据——OnLocationChange 能触发(经 GetIsTopLevel 过滤),
+  //   但 start/stop 完全不到达:STATE_IS_WINDOW 位在 OHOS native 轨道的
+  //   docShell 通知链上可能不置位(与 v109 断链同源)。修复:
+  //   1) 与 OnLocationChange/OnProgressChange 一致,先用 GetIsTopLevel 丢弃
+  //      非顶层通知;
+  //   2) start/stop 判定接受 STATE_IS_WINDOW|STATE_IS_DOCUMENT|STATE_IS_NETWORK
+  //      任一位(顶层过滤已由 GetIsTopLevel 保证,不再依赖 WINDOW 位)。
+  if (aWebProgress) {
+    bool isTopLevel = false;
+    if (NS_SUCCEEDED(aWebProgress->GetIsTopLevel(&isTopLevel)) && !isTopLevel) {
+      return NS_OK;
+    }
+  }
+  // v134 诊断:打印原始状态位(仅 start/stop 相关)。节流:仅前 40 次,
+  // 避免每个子资源请求都刷日志把 hilog 缓冲区冲爆(后续导航仍可见窗口级事件)。
+  if (aStateFlags & (nsIWebProgressListener::STATE_START |
+                     nsIWebProgressListener::STATE_STOP)) {
+    static int sStateLogCount = 0;
+    // 窗口/文档/网络级事件不限流(数量少),请求级限前 40 条
+    const uint32_t kNonRequestBits =
+        nsIWebProgressListener::STATE_IS_WINDOW |
+        nsIWebProgressListener::STATE_IS_DOCUMENT |
+        nsIWebProgressListener::STATE_IS_NETWORK;
+    if ((aStateFlags & kNonRequestBits) || sStateLogCount < 40) {
+      sStateLogCount++;
+      OHOS_LOG( "[XRE] OnStateChange[%s] 原始 flags=0x%x status=0x%x "
+              "(START=%d STOP=%d WIN=%d DOC=%d NET=%d REQ=%d)\n",
+              mSessionId.get(), aStateFlags, (unsigned)aStatus,
+              !!(aStateFlags & nsIWebProgressListener::STATE_START),
+              !!(aStateFlags & nsIWebProgressListener::STATE_STOP),
+              !!(aStateFlags & nsIWebProgressListener::STATE_IS_WINDOW),
+              !!(aStateFlags & nsIWebProgressListener::STATE_IS_DOCUMENT),
+              !!(aStateFlags & nsIWebProgressListener::STATE_IS_NETWORK),
+              !!(aStateFlags & nsIWebProgressListener::STATE_IS_REQUEST));
+    }
+  }
+  const uint32_t kScopeBits = nsIWebProgressListener::STATE_IS_WINDOW |
+                              nsIWebProgressListener::STATE_IS_DOCUMENT |
+                              nsIWebProgressListener::STATE_IS_NETWORK;
+  // v134 真机取证:OHOS native 轨道上,文档加载的 START 只以
+  // STATE_START|STATE_IS_REQUEST(0x10001) 到达,WINDOW/DOCUMENT/NETWORK 位
+  // 从不置位(STOP 有 0xc0010 窗口级)。若只认 scope 位,"页面开始加载"永不
+  // 触发、进度条永远不转。改用 nsIChannel::LOAD_DOCUMENT_URI 精确识别文档
+  // 主请求:图片/CSS 等子资源不带此标志,不会误报。
+  bool isDocRequest = false;
+  nsCOMPtr<nsIChannel> channel(do_QueryInterface(aRequest));
+  if (channel) {
+    nsLoadFlags loadFlags = 0;
+    if (NS_SUCCEEDED(channel->GetLoadFlags(&loadFlags))) {
+      isDocRequest = (loadFlags & nsIChannel::LOAD_DOCUMENT_URI) != 0;
+    }
+  }
+  // 窗口级开始:页面开始加载(首次 start 上报,忽略重复 start)
+  if ((aStateFlags & nsIWebProgressListener::STATE_START) &&
+      ((aStateFlags & kScopeBits) || isDocRequest)) {
+    if (!mPageLoading) {
+      mPageLoading = true;
+      // v249 paint-holding（F4 导航白闪根修）：前台标签新导航开始 →
+      // 进入保持期（旧帧保持到新文档 contentful / STOP / 2s 超时）。
+      // 后台标签（docshell 非 active）不 engage，避免冻结前台画面。
+      {
+        bool ohosTabActive = false;
+        void* ohosOldDoc = nullptr;
+        nsCOMPtr<mozIDOMWindowProxy> ohosWin;
+        aWebProgress->GetDOMWindow(getter_AddRefs(ohosWin));
+        if (auto* piWin = nsPIDOMWindowOuter::From(ohosWin)) {
+          if (mozilla::dom::BrowsingContext* bc = piWin->GetBrowsingContext()) {
+            ohosTabActive = bc->IsActive();
+          }
+          // 记录旧文档指针作身份令牌（仅作指针比较，从不解引用）：engage
+          // 后旧文档的同拍 contentful 帧不得释放保持期，只有新文档的
+          // contentful 才算数。注意不能用 Document::GetPresContext()
+          // （头文件 inline 声明无定义，hidden 可见性下链接失败）。
+          ohosOldDoc = (void*)piWin->GetExtantDoc();
+        }
+        if (ohosTabActive) {
+          OHOS_PaintHoldEngage("nav-start", ohosOldDoc);
+        } else {
+          // v249 诊断：nav-start 未 engage 的原因取证（active 态/session 归属）
+          OHOS_DiagLog("[PAINT_HOLD] nav-start skip active=%d session=%s",
+                       (int)ohosTabActive, mSessionId.get());
+        }
+      }
+      // v105: 每次页面加载开始重置进度计数器,避免上次残留的 mLastProgress 污染本次。
+      mLastProgress = 0;
+      mLastNotifyMs = 0;
+      OHOS_LOG( "[XRE] OHOSProgressListener[%s] 页面开始加载\n",
+              mSessionId.get());
+      GeckoBridge_NotifyPageLoad(mSessionId.get(), "start");
+      // v160: 通知 chrome JS 加载开始。XULBrowserWindow 挂在 <browser>
+      // 元素桥接链路上(v109 docShell 断链,STATE 事件不到达),标签转圈/
+      // "正在连接…"状态文本由 chrome 侧在 start 时设置后无人清理 = 卡死。
+      // 本 observer 与 ohos-url-change 同族,chrome 侧(browser.js
+      // OHOSLoadStateObserver)据此驱动 XULBrowserWindow 等价状态机。
+      if (nsCOMPtr<nsIObserverService> obsServ =
+              mozilla::services::GetObserverService()) {
+        obsServ->NotifyObservers(nullptr, "ohos-load-state", u"start");
+      }
+    }
+  }
+  // 窗口/文档/网络级停止:页面加载完成(只上报一次 stop)
+  if ((aStateFlags & nsIWebProgressListener::STATE_STOP) &&
+      (aStateFlags & kScopeBits)) {
+    // v249: 加载收尾兜底释放 paint-holding（正常路径由新文档首个
+    // contentful 帧释放；错误页/空页等无 contentful 场景靠这里）。
+    OHOS_PaintHoldRelease("load-stop");
+    if (mPageLoading) {
+      mPageLoading = false;
+      // v105: 仅在 STATE_STOP 才上报 100,与 Chrome/Edge 行为一致。
+      //   OnProgressChange 因 max 不准永远到不了真实 100,只能靠 STOP 收尾。
+      mLastProgress = 100;
+      GeckoBridge_NotifyProgress(mSessionId.get(), 100);
+      OHOS_LOG( "[XRE] OHOSProgressListener[%s] 页面加载完成\n",
+              mSessionId.get());
+      GeckoBridge_NotifyPageLoad(mSessionId.get(), "stop");
+      if (nsCOMPtr<nsIObserverService> obsServ =
+              mozilla::services::GetObserverService()) {
+        obsServ->NotifyObservers(nullptr, "ohos-load-state", u"stop");
+      }
+    } else if (mLastProgress != 100) {
+      // v134 自愈:监听器注册晚于文档 START(启动竞态)时 mPageLoading 未置位,
+      // 窗口级 STOP 到达仍收尾一次,避免 ArkTS 加载条/命令态永远卡在加载中。
+      mLastProgress = 100;
+      GeckoBridge_NotifyProgress(mSessionId.get(), 100);
+      OHOS_LOG( "[XRE] OHOSProgressListener[%s] 页面加载完成(start 缺失自愈)\n",
+              mSessionId.get());
+      GeckoBridge_NotifyPageLoad(mSessionId.get(), "stop");
+      if (nsCOMPtr<nsIObserverService> obsServ =
+              mozilla::services::GetObserverService()) {
+        obsServ->NotifyObservers(nullptr, "ohos-load-state", u"stop");
+      }
+    }
+  }
+
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+OHOSProgressListener::OnProgressChange(nsIWebProgress* aWebProgress,
+                                       nsIRequest* aRequest,
+                                       int32_t aCurSelfProgress,
+                                       int32_t aMaxSelfProgress,
+                                       int32_t aCurTotalProgress,
+                                       int32_t aMaxTotalProgress) {
+  // v77: 上报页面加载进度百分比到 ArkTS 层
+  // v88: 回调附带 sessionId
+  // v104: 仅顶层文档进度 — iframe/子 frame 进度会刷 100% 噪声,
+  //   导致 LoadingBar 误判“已完成”并秒藏顶部进度条。
+  if (aWebProgress) {
+    bool isTopLevel = false;
+    if (NS_SUCCEEDED(aWebProgress->GetIsTopLevel(&isTopLevel)) && !isTopLevel) {
+      return NS_OK;
+    }
+  }
+
+  // v105.1: 关键修复 — STOP 之后 Gecko 仍会对子资源/重定向/bfcache 恢复触发
+  //   OnProgressChange(日志中可见「页面加载完成」之后还出现 OnProgressChange cur=0 max=0)。
+  //   v105 没有这层守卫,导致进度从 100 被拉回 95,ArkTS 加载条永远不消失、
+  //   闪烁、并干扰 XComponent 焦点造成白屏。
+  //   修复:仅当窗口级加载进行中(mPageLoading=true)才上报进度。
+  if (!mPageLoading) {
+    return NS_OK;
+  }
+
+  // v105.1: max<=0 且 cur<=0 是 Gecko 在页面切换瞬间的空载回调,
+  //   不要在这种情况下推进进度(否则会从 0 跳到 95)。
+  if (aMaxTotalProgress <= 0 && aCurTotalProgress <= 0) {
+    return NS_OK;
+  }
+
+  // v105: 平滑进度算法 — 修复「cur>max 直接 100」导致的秒藏问题。
+  //   新算法:
+  //   - max>0 且 cur<=max:用 cur*95/max 作为「候选值」
+  //   - max>0 且 cur>max:夹紧到 95(只剩 5% 给 STOP 收尾,避免抢报 100)
+  //   - max<=0(未知大小):从当前已上报值向 95 缓慢逼近(系数 0.05)
+  //   - 单调递增:只允许 progress 上升,不下降(防抖)
+  //   - 限频:两次上报间隔 < 100ms 跳过(高频抖动无意义)
+  //   - 上限 95:不到 STATE_STOP 永不自发到 100(Stop 才由 OnStateChange 收尾)
+
+  int32_t candidate = 0;
+  if (aMaxTotalProgress > 0) {
+    if (aCurTotalProgress >= aMaxTotalProgress) {
+      // cur 超过预估 max:夹紧到 95,保留 5% 给 STOP。
+      candidate = 95;
+    } else {
+      candidate = aCurTotalProgress * 95 / aMaxTotalProgress;
+      if (candidate < 0) candidate = 0;
+      if (candidate > 95) candidate = 95;
+    }
+  } else {
+    // max 未知(分块/无 Content-Length):从当前已上报值向 95 指数逼近。
+    // 系数 0.05(剩余距离的 5%),保证有可见的爬升反馈。
+    candidate = mLastProgress + (95 - mLastProgress) / 20;
+    if (candidate <= mLastProgress) candidate = mLastProgress + 1;
+    if (candidate > 95) candidate = 95;
+  }
+
+  // 单调递增:防抖动(cur 回退/iframe 重置等)
+  if (candidate < mLastProgress) {
+    candidate = mLastProgress;
+  }
+  if (candidate > 95) candidate = 95;
+
+  // 限频:100ms 内无新上报(同值不上报,减少 IPC/线程切换开销)
+  if (candidate == mLastProgress) {
+    return NS_OK;
+  }
+  int64_t now = NowMs();
+  if (mLastNotifyMs != 0 && now - mLastNotifyMs < 100) {
+    return NS_OK;
+  }
+
+  mLastProgress = candidate;
+  mLastNotifyMs = now;
+  OHOS_LOG( "[XRE] OnProgressChange[%s] cur=%d max=%d -> progress=%d\n",
+          mSessionId.get(), aCurTotalProgress, aMaxTotalProgress, candidate);
+  GeckoBridge_NotifyProgress(mSessionId.get(), candidate);
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+OHOSProgressListener::OnLocationChange(nsIWebProgress* aWebProgress,
+                                       nsIRequest* aRequest,
+                                       nsIURI* aLocation,
+                                       uint32_t aFlags) {
+  if (!aLocation) {
+    return NS_OK;
+  }
+
+  // v104: 仅同步顶层文档 URL 到地址栏。
+  // 根因:B站等站点 iframe(s1.hdslb.com/.../iframe.html) 也会触发
+  // OnLocationChange;不过滤时会污染 activeTab.url/历史/前进后退状态,
+  // 表现为“点了链接地址栏乱跳、像没加载”。
+  // GeckoView:LocationChange 事件已带 isTopLevel,此处对齐。
+  if (aWebProgress) {
+    bool isTopLevel = false;
+    if (NS_SUCCEEDED(aWebProgress->GetIsTopLevel(&isTopLevel)) && !isTopLevel) {
+      return NS_OK;
+    }
+  }
+
+  nsAutoCString spec;
+  nsresult rv = aLocation->GetSpec(spec);
+  if (NS_FAILED(rv) || spec.IsEmpty()) {
+    return NS_OK;
+  }
+
+  // 跳过 about:blank 等内部页面
+  if (spec.EqualsLiteral("about:blank")) {
+    return NS_OK;
+  }
+
+  OHOS_LOG( "[XRE] OHOSProgressListener[%s] URL 变化: %s\n",
+          mSessionId.get(), spec.get());
+  GeckoBridge_NotifyURLChange(mSessionId.get(), spec.get());
+
+  // v135/v136 根因取证(P0):比对 OHOSProgressListener 注册的 docShell 与
+  // 当前选中标签(gBrowser.selectedBrowser / 多窗口下的顶层活跃 nsWindow)
+  // 是否同一对象。若不同,说明 listener 挂到了非选中 browser,地址栏不更新。
+  // 取 DOMWindow 比较(同 docShell 必同 DOMWindow,指针可直接比)。
+  nsCOMPtr<mozIDOMWindowProxy> listenerDOMWin;
+  if (aWebProgress) {
+    aWebProgress->GetDOMWindow(getter_AddRefs(listenerDOMWin));
+  }
+  nsCOMPtr<mozIDOMWindowProxy> chromeWindow = OHOSFindChromeWindow();
+
+  // v136: DOMWindow → nsWindow 映射,用于窗口层活跃判定。
+  //   listener 所在 content docShell 的根 chrome window 经
+  //   nsPIDOMWindowOuter::GetTreeOwnerWindow → nsIBaseWindow::GetMainWidget
+  //   取到其顶层 nsWindow;与 nsWindow::GetTopActiveWindow() 比较。
+  //   多窗口模型下,只有「顶层活跃 nsWindow 的 content」才应刷地址栏。
+  auto WidgetForChromeWindow = [](mozIDOMWindowProxy* aWin) -> nsWindow* {
+    if (!aWin) return nullptr;
+    nsCOMPtr<nsPIDOMWindowOuter> piWin = do_QueryInterface(aWin);
+    if (!piWin) return nullptr;
+    nsCOMPtr<nsIBaseWindow> treeOwnerWin = piWin->GetTreeOwnerWindow();
+    if (!treeOwnerWin) return nullptr;
+    nsCOMPtr<nsIWidget> widget;
+    treeOwnerWin->GetMainWidget(getter_AddRefs(widget));
+    return widget ? static_cast<nsWindow*>(widget.get()) : nullptr;
+  };
+
+  nsWindow* topActive = nsWindow::GetTopActiveWindow();
+  nsWindow* chromeWidget = WidgetForChromeWindow(chromeWindow);
+  // winActive:多窗口模型下 chromeWindow 即当前顶层活跃 nsWindow。
+  // 单窗口多标签模型下 chromeWindow 恒为唯一顶层窗口,topActive 也恒为它,
+  // winActive 恒为 true(此时标签选中判定靠下面的 bcActiveHit)。
+  bool winActive = (topActive != nullptr) && (topActive == chromeWidget);
+
+  // v135: 单窗口多标签模型 — 在 chrome docShell 的 content 子列表里找
+  //   BrowsingContext::IsActive 的子 docShell(v112 FindActiveContentTreeItem
+  //   语义),取其 DOMWindow 作为「选中 browser 的 content window」代理值。
+  nsCOMPtr<mozIDOMWindowProxy> selectedDOMWin;
+  bool bcActiveHit = false;
+  if (chromeWindow) {
+    nsCOMPtr<nsPIDOMWindowOuter> piWin = do_QueryInterface(chromeWindow);
+    nsCOMPtr<nsIDocShell> chromeDS = piWin ? piWin->GetDocShell() : nullptr;
+    nsCOMPtr<nsIDocShellTreeItem> chromeTreeItem = chromeDS;
+    if (chromeTreeItem) {
+      int32_t cc = 0;
+      chromeTreeItem->GetInProcessChildCount(&cc);
+      for (int32_t i = 0; i < cc; ++i) {
+        nsCOMPtr<nsIDocShellTreeItem> child;
+        chromeTreeItem->GetInProcessChildAt(i, getter_AddRefs(child));
+        if (!child) continue;
+        int32_t itemType = 0;
+        child->GetItemType(&itemType);
+        if (itemType != nsIDocShellTreeItem::typeContent) continue;
+        nsCOMPtr<nsIDocShell> childDS = do_QueryInterface(child);
+        if (!childDS) continue;
+        RefPtr<mozilla::dom::BrowsingContext> bc = childDS->GetBrowsingContext();
+        if (bc && bc->IsActive()) {
+          selectedDOMWin = child->GetWindow();
+          bcActiveHit = true;
+          break;
+        }
+      }
+    }
+  }
+  OHOS_DiagLog(
+      "[XRE_URL] OHOSProgressListener[%s] loc=%s | listenerWin=%p "
+      "selectedActiveWin=%p same=%d | chromeWidget=%p topActive=%p "
+      "winActive=%d bcActiveHit=%d",
+      mSessionId.get(), spec.get(), (void*)listenerDOMWin.get(),
+      (void*)selectedDOMWin.get(),
+      (int)(listenerDOMWin == selectedDOMWin), (void*)chromeWidget,
+      (void*)topActive, (int)winActive, (int)bcActiveHit);
+
+  // v136 修复:窗口层活跃判定替代单纯 BrowsingContext::IsActive。
+  // 根因:v135 的 fireObserver gating 仅认 BrowsingContext::IsActive(content
+  //   侧 active 概念),OHOS 多窗口模型下新 session 窗口可能不是 IsActive
+  //   → same=0 → 不发;真机取证 v135 部署后只有 session 0 收到 fireObserver,
+  //   新标签 same=0 静默。
+  // 正解(OHOS):窗口层活跃 — listener 所属 nsWindow == 当前顶层活跃 nsWindow
+  //   (winActive)时即视为「前台标签」,放行;单窗口多标签模型下 winActive 恒
+  //   true,此时依赖 BrowsingContext::IsActive 的 bcActiveHit 精确锁定选中标签。
+  //   两条命中其一即 fire,彼此覆盖双模型。
+  bool fireObserver = false;
+  if (listenerDOMWin && selectedDOMWin && listenerDOMWin == selectedDOMWin) {
+    // 精确命中:listener 即 IsActive 的 content docShell(单/多窗口通用)
+    fireObserver = true;
+  } else if (listenerDOMWin && winActive && !bcActiveHit) {
+    // 窗口层命中:多窗口模型下顶层活跃 nsWindow 的 content,且单窗口模型下
+    //   未找到 IsActive 子(初始化期/竞态)时,该 listener 通常是唯一 content。
+    fireObserver = true;
+  } else if (listenerDOMWin && !selectedDOMWin && winActive) {
+    // 兜底:无 IsActive 子 + 顶层窗口活跃 → 放行(首标签/竞态自愈)
+    fireObserver = true;
+  }
+  if (fireObserver) {
+    nsCOMPtr<nsIObserverService> obsServ =
+        mozilla::services::GetObserverService();
+    if (obsServ) {
+      // data 仅传 URL spec(选中判定已在 C++ 完成)。
+      obsServ->NotifyObservers(nullptr, "ohos-url-change",
+                               NS_ConvertUTF8toUTF16(spec).get());
+    }
+    OHOS_DiagLog("[XRE_URL] OHOSProgressListener[%s] 已发 ohos-url-change "
+                 "loc=%s (fireObserver=%d winActive=%d bcActiveHit=%d)",
+                 mSessionId.get(), spec.get(), (int)fireObserver,
+                 (int)winActive, (int)bcActiveHit);
+  }
+
+  // v257: 特权页全绘保险丝(gfx.ohos.chrome-content-full-paint,默认关)的
+  // 导航时刻真值源:与 hash-nav engage 同门(fireObserver=本次导航属于前台
+  // 标签),但跟随每次 location 变化(不只 same-document)——整页导航、冷启
+  // 恢复会话的首个权威翻转都来自这里;tab 信封扫描只补切标签/属性变更。
+  // 后台标签导航不翻转。mode 消费端有 pref 门,翻转本身无开销。
+  if (fireObserver) {
+    const bool chromePage =
+        spec.Length() >= 6 &&
+        (strncmp(spec.get(), "about:", 6) == 0 ||
+         strncmp(spec.get(), "chrome:", 7) == 0);
+    OHOS_SetChromeContentMode(chromePage ? 1 : 0);
+  }
+
+  // v256f: about:/chrome: 页的页内 hash 导航(prefs/addons 分类切换)engage
+  // paint-holding。这类切换是同文档 URI 变化,不走 STATE_START,nav-start
+  // engage 永不触发——切换期间的重排风暴(prefs 新 pane 渐进布局,手机无
+  // JIT 下可达 500ms/帧×数秒)会以中间态逐帧上屏,v256e 修掉 980 视口主
+  // 触发源后仍偶发。hold 期间零 present(旧画面钉死),新 pane 首个
+  // contentful 帧释放(旧文档身份传 nullptr:同文档切换,任何 contentful
+  // 帧都算新 pane 内容)。仅前台标签(fireObserver 即本 listener 为活跃
+  // 标签的判定)且 URI 属 about:/chrome:(网页锚点跳转不受影响);5s 超时
+  // 兜底维持。v257: 抑制实现已改为 render 前离屏路径(RendererOGL.cpp),
+  // 本 engage 的语义不变。
+  if (fireObserver &&
+      (aFlags & nsIWebProgressListener::LOCATION_CHANGE_SAME_DOCUMENT)) {
+    const bool isAboutOrChrome =
+        spec.Length() >= 6 &&
+        (strncmp(spec.get(), "about:", 6) == 0 ||
+         strncmp(spec.get(), "chrome:", 7) == 0);
+    if (isAboutOrChrome) {
+      OHOS_PaintHoldEngage("hash-nav", nullptr);
+    }
+  }
+
+  return NS_OK;
+}
