diff --git a/build/moz.configure/ohos-ndk.configure b/build/moz.configure/ohos-ndk.configure
new file mode 100644
index 0000000000..aed649f43e
--- /dev/null
+++ b/build/moz.configure/ohos-ndk.configure
@@ -0,0 +1,99 @@
+# -*- Mode: python; indent-tabs-mode: nil; tab-width: 40 -*-
+# vim: set filetype=python:
+# OpenHarmony NDK 配置(仿 android-ndk.configure)
+# 提供 OHOS NDK 路径解析、sysroot、cflags 等
+#
+# 关键职责:为交叉编译注入 --target=aarch64-linux-ohos 与 --sysroot,
+# 否则 OHOS NDK 的 clang(本质是 Apple-darwin clang)会默认编译为
+# host(darwin)目标,而非 OHOS。这些 flags 会被 flags.configure /
+# finalize-flags.configure 拼装进最终的 CFLAGS/CXXFLAGS/ASFLAGS/LDFLAGS。
+
+option(
+    env="OHOS_SDK_NATIVE",
+    nargs=1,
+    help="Path to OpenHarmony NDK (native SDK)",
+)
+
+
+@depends("OHOS_SDK_NATIVE")
+@imports("os")
+def ohos_ndk_root(value):
+    if value:
+        path = value[0]
+        if not os.path.isdir(path):
+            die("OHOS_SDK_NATIVE path does not exist: %s", path)
+        return path
+    # 默认路径(macOS DevEco Studio 安装位置)
+    default_paths = [
+        os.path.expanduser("~/Library/Huawei/Sdk/openharmony/native"),
+    ]
+    for p in default_paths:
+        if os.path.isdir(p):
+            return p
+    die("OpenHarmony NDK not found. Set OHOS_SDK_NATIVE env var.")
+
+
+set_config("OHOS_NDK", ohos_ndk_root)
+
+
+@depends(ohos_ndk_root)
+@imports("os")
+def ohos_toolchain(ndk_root):
+    # OHOS NDK 目录结构:<ndk>/llvm/bin/clang
+    return os.path.join(ndk_root, "llvm")
+
+
+@depends(ohos_ndk_root)
+@imports("os")
+def ohos_sysroot(ndk_root):
+    # OHOS sysroot:<ndk>/sysroot
+    return os.path.join(ndk_root, "sysroot")
+
+
+set_config("OHOS_SYSROOT", ohos_sysroot)
+
+
+# 仅在 OHOS 目标下计算 flags,非 OHOS 构建时返回 None,
+# 这样 flags.configure 中的 ohos_flags 引用始终安全。
+@depends(ohos_toolchain, ohos_sysroot, target)
+def ohos_flags(toolchain, sysroot, target):
+    # OHOS NDK 的 clang 已内置 ohos target 支持,只需显式提供 triple + sysroot。
+    # triple 形如 aarch64-linux-ohos。
+    clang_target = "%s-linux-ohos" % target.cpu
+
+    cflags = [
+        "--target=%s" % clang_target,
+        "--sysroot=%s" % sysroot,
+        "-D__MUSL__",
+        "-DMDB_USE_ROBUST=0",
+        "-Wno-error=unused-command-line-argument",
+        # OpenHarmony 使用 musl libc,定义 __OHOS__ 宏供代码区分平台
+        "-D__OHOS__",
+        # third_party/libwebrtc 的生成 moz.build 按 OS_TARGET 设置 WEBRTC_*
+        # 平台宏;OHOS 不在其枚举内,这里全局注入 WEBRTC_POSIX/WEBRTC_LINUX
+        # (与 Android/Linux 同源),使 libwebrtc 平台分支正常生效。
+        "-DWEBRTC_POSIX",
+        "-DWEBRTC_LINUX",
+    ]
+
+    return namespace(
+        cflags=cflags,
+        cxxflags=cflags,
+        asflags=["--target=%s" % clang_target, "--sysroot=%s" % sysroot],
+        ldflags=[
+            "--target=%s" % clang_target,
+            "--sysroot=%s" % sysroot,
+            "-fuse-ld=lld",
+            "-Wl,--build-id",
+        ],
+    )
+
+
+@depends(ohos_toolchain)
+@imports("os")
+def ohos_libclang_path(toolchain):
+    # bindgen 需要 libclang
+    return os.path.join(toolchain, "lib")
+
+
+set_config("LIBCLANG_PATH", ohos_libclang_path)
