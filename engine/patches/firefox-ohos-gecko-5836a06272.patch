+void nsWindow::ResetKeyState() {
+  // 失焦/销毁时清零修饰键跟踪,防键丢失卡键(如 Ctrl 按下后窗口失焦,
+  // 收不到 keyup,导致 mTrackedModifiers 一直保留 CONTROL 位)。
+  if (mTrackedModifiers != static_cast<mozilla::Modifiers>(0)) {
+    OHOS_DiagLog("[XRE] nsWindow::ResetKeyState 清零修饰键跟踪 oldMods=0x%x",
+            (int)mTrackedModifiers);
+    mTrackedModifiers = static_cast<mozilla::Modifiers>(0);
+  }
+}
+
+// 物理键盘事件入口:由 GeckoBridge_DispatchKeyEvent Runnable(Gecko 主线程)调用。
+//
+// 流程:OHOS XComponent C 回调 → GeckoBridge_DispatchKeyEvent(geckoview.cpp)
+//   → NS_DispatchToMainThread → OHOSKeyEventRunnable::Run → 本函数。
+//   与 OnMouseEvent/OnTouchEvent 同款跨线程模式。
+//
+// IME 防重复输入判定(关键设计):
+//   现有 IME 路径(OnInsertText/OnDeleteBackward/OnSendEnterKey)由 OHOS 软键盘
+//   驱动,仅在 IME 激活(焦点在 <input>/<textarea>)时触发。物理键盘的 printable
+//   键若同时发 keypress(charCode)会与 IME 已提交文本重复。
+//   判定:本函数对所有物理键发 eKeyDown/eKeyUp(无 charCode),并在 eKeyDown 后
+//   始终发 eKeyPress(对齐桌面平台 keypress 派发模型,v136 修复:见函数内注释)。
+//   但 eKeyPress 的 mCharCode 仅在
+//   焦点不在 IME 编辑框时填充(由 mInputContext.mIMEState.mEnabled 判断:
+//   Enabled/Password 表示 IME 接管文本输入,此时 keypress 不带 charCode,
+//   只作快捷键/命令键使用;Disabled/不在编辑框时正常带 charCode 触发字符输入)。
+//   这样:Ctrl+T(快捷键)正常触发 chrome keyset;字母键在地址栏/页面文本框
+//   由 IME 接管不重复;在非编辑区域正常输入字符。
+//   Enter/Backspace 的现有硬编码(OnSendEnterKey/OnDeleteBackward)保持不动,
+//   本路径与它们共存 —— IME 合成的 Enter/Backspace 走旧路径,物理键盘的
+//   Enter/Backspace 走本路径,两者来源不同(IME NAPI vs XComponent 键回调),
+//   不会同时触发。
+void nsWindow::OnKeyEvent(int32_t aAction, int32_t aKeyCode,
+                          int64_t aDeviceId, int64_t aTime,
+                          uint32_t aModifiers) {
+  // 入口诊断(Layer 3):确认事件到达 + 原始数据。
+  // 输入流畅性:普通键避免每键同步文件日志(OHOS_DiagLog 写 ohos_diag.txt),
+  //   此处入口原始数据由 geckoview.cpp DispatchKeyEvent 的 OH_LOG_INFO(hilog)覆盖,
+  //   故移除 per-key 文件日志;保留 hilog/异常路径。
+  //   若需 [XRE] OnKeyEvent 文件诊断,临时恢复本行即可。
+
+  const bool isDown = (aAction == 0);  // OH_NATIVEXCOMPONENT_KEY_ACTION_DOWN=0
+
+  // 修饰键状态推导:
+  // 内部跟踪(兜底):修饰键本身 down 时置位,up 时清位;非修饰键不动跟踪值。
+  // Gecko Modifiers 位见 widget/EventForwards.h。
+  if (aKeyCode == OH_KEY_CTRL_LEFT || aKeyCode == OH_KEY_CTRL_RIGHT) {
+    if (isDown) mTrackedModifiers |= mozilla::MODIFIER_CONTROL;
+    else mTrackedModifiers &= ~mozilla::MODIFIER_CONTROL;
+  } else if (aKeyCode == OH_KEY_SHIFT_LEFT || aKeyCode == OH_KEY_SHIFT_RIGHT) {
+    if (isDown) mTrackedModifiers |= mozilla::MODIFIER_SHIFT;
+    else mTrackedModifiers &= ~mozilla::MODIFIER_SHIFT;
+  } else if (aKeyCode == OH_KEY_ALT_LEFT || aKeyCode == OH_KEY_ALT_RIGHT) {
+    if (isDown) mTrackedModifiers |= mozilla::MODIFIER_ALT;
+    else mTrackedModifiers &= ~mozilla::MODIFIER_ALT;
+  } else if (aKeyCode == OH_KEY_META_LEFT || aKeyCode == OH_KEY_META_RIGHT) {
+    if (isDown) mTrackedModifiers |= mozilla::MODIFIER_META;
+    else mTrackedModifiers &= ~mozilla::MODIFIER_META;
+  }
+
+  // 优先用 SDK 提供的 aModifiers(若非 0);否则回退内部跟踪值。
+  mozilla::Modifiers mods;
+  if (aModifiers != 0) {
+    // SDK 掩码(CTRL=1,SHIFT=2,ALT=4,FN=8)→ Gecko Modifiers 位
+    mods = static_cast<mozilla::Modifiers>(0);
+    if (aModifiers & OH_MOD_CTRL)  mods |= mozilla::MODIFIER_CONTROL;
+    if (aModifiers & OH_MOD_SHIFT) mods |= mozilla::MODIFIER_SHIFT;
+    if (aModifiers & OH_MOD_ALT)   mods |= mozilla::MODIFIER_ALT;
+    if (aModifiers & OH_MOD_FN)    mods |= mozilla::MODIFIER_FN;
+  } else {
+    mods = mTrackedModifiers;
+  }
+
+  const uint32_t domKeyCode = ConvertOHOSKeyCodeToDOMKeyCode(aKeyCode);
+  const mozilla::KeyNameIndex keyNameIndex =
+      ConvertOHOSKeyCodeToKeyNameIndex(aKeyCode);
+  const mozilla::CodeNameIndex codeNameIndex =
+      ConvertOHOSKeyCodeToCodeNameIndex(aKeyCode);
+
+  // DOM keyCode 诊断(Layer 3):真机按 Ctrl+T 时看此行确认 T 到达且 mods 含 CONTROL
+  // 输入流畅性:per-key 同步文件日志已移除,键盘入口由 hilog 覆盖。
+
+  // 构造 keydown / keyup
+  EventMessage msg = isDown ? eKeyDown : eKeyUp;
+  WidgetKeyboardEvent event(true, msg, this);
+  event.mKeyCode = domKeyCode;
+  event.mModifiers = mods;
+  event.mKeyNameIndex = keyNameIndex;
+  event.mCodeNameIndex = codeNameIndex;
+  // mLocation 由 CodeNameIndex 推导(对齐 GeckoEditableSupport.cpp:400)
+  event.mLocation =
+      WidgetKeyboardEvent::ComputeLocationFromCodeValue(event.mCodeNameIndex);
+
+  // mIsRepeat:OHOS 单次 down/up 不带 repeat 标志,系统级 auto-repeat 在 OHOS
+  // 是否合成多次 down 待真机验证;此处先按 false,若实测 auto-repeat 不工作
+  // 再从 aTime 间隔推导(后续优化)。
+  event.mIsRepeat = false;
+
+  nsEventStatus status = DispatchEvent(&event);
+  bool prevented = event.DefaultPrevented();
+  // status 仅用于派发,preventDefault 判定走 event.DefaultPrevented()(对齐 Gecko
+  // 其他平台从事件对象而非返回值取消费状态的惯例)。保留赋值以明确派发已发生。
+  (void)status;
+
+  // eKeyPress:isDown 时始终派发,对齐桌面平台(Windows/GTK)的 keypress 派发模型。
+  // 用于字符输入 + 命令键(如 chrome keyset 部分绑定走 keypress)。
+  //
+  // OHOS v136 关键修复:百度搜索框等页面在 keydown 上 preventDefault,旧逻辑
+  // `if (isDown && !prevented)` 直接跳过 keypress,导致 Gecko 隐式表单提交
+  // (HTMLInputElement::PostHandleEvent eKeyPress → MaybeSubmitForm)、空格滚动、
+  // Backspace 退格、PageUp/Down 翻页等"靠 keypress 默认行为"的功能全部失效。
+  // 正确语义:keydown 被 preventDefault 时 keypress 仍要派发(页面 JS 能收到,
+  // MaybeSubmitForm 等内部路径因此得以执行),但给 keypress 打上"默认行为已被
+  // 阻止"标记(PreventDefaultBeforeDispatch + eAllow),抑制 Gecko 自身的滚动/
+  // 退格等默认动作——这与 TextEventDispatcher.cpp:610-617 在 keydown 被消费时
+  // 给 keypress 打 mDefaultPrevented 的做法一致,且保持跨进程转发。
+  if (isDown) {
+    WidgetKeyboardEvent pressEvent(true, eKeyPress, this);
+    pressEvent.mKeyCode = domKeyCode;
+    pressEvent.mModifiers = mods;
+    pressEvent.mKeyNameIndex = keyNameIndex;
+    pressEvent.mCodeNameIndex = codeNameIndex;
+    pressEvent.mLocation = event.mLocation;
+    pressEvent.mIsRepeat = false;
+
+    // 若前驱 keydown 被 preventDefault,给 keypress 打上"默认行为已阻止"标记
+    // (不阻止跨进程转发),对齐桌面平台语义:页面 JS 仍收到 keypress,
+    // 而 Gecko 的滚动/退格等默认动作被抑制。PreventDefaultBeforeDispatch 是
+    // WidgetEvent 公共接口,内部仅置 mDefaultPrevented=true(由 chrome 侧阻止)。
+    if (prevented) {
+      pressEvent.PreventDefaultBeforeDispatch(CrossProcessForwarding::eAllow);
+    }
+
+    // IME 接管判定:焦点在可编辑框时,文本输入由 IME 路径负责,
+    // 此处 keypress 不带 charCode(仅作命令键/快捷键载体,如回车提交)。
+    const bool imeActive =
+        (mInputContext.mIMEState.mEnabled ==
+             mozilla::widget::IMEEnabled::Enabled ||
+         mInputContext.mIMEState.mEnabled ==
+             mozilla::widget::IMEEnabled::Password);
+
+    // v132: 命令修饰键(Ctrl/Alt/Meta)在场时不受 IME 抑制——
+    // XUL <key> 字母快捷键全是字符型绑定(browserSets.ftl 的 .key='T' 等,
+    // KeyEventHandler mMisc=1),匹配走 keypress 的 charCode;
+    // charCode=0 会让全部字母快捷键失配(v131 [XRE_KEY] 取证:
+    // 81 handler 链中 mDetail=116('t') 存在但比对 code=0 失败)。
+    // 安全性:nsEditor 对带 Ctrl/Alt/Meta 的 keypress 不执行插字,
+    // 不会与 IME 提交产生重复文本。
+    const bool hasCommandModifier =
+        (mods & (mozilla::MODIFIER_CONTROL | mozilla::MODIFIER_ALT |
+                 mozilla::MODIFIER_META)) != 0;
+
+    if (keyNameIndex == KEY_NAME_INDEX_USE_STRING &&
+        (!imeActive || hasCommandModifier)) {
+      // 可打印字符 + 非 IME 编辑框:推导 charCode。
+      // Shift 推翻字母大小写 + 标点移位(简化:仅处理字母大小写,
+      // 标点移位由页面按 keydown 的 key/code 自行处理更可靠,这里只给基本字符)。
+      char16_t ch = 0;
+      bool shift = (mods & mozilla::MODIFIER_SHIFT) != 0;
+      if (aKeyCode >= OH_KEY_A && aKeyCode <= OH_KEY_Z) {
+        ch = static_cast<char16_t>(
+            (aKeyCode - OH_KEY_A) + (shift ? 'A' : 'a'));
+      } else if (aKeyCode >= OH_KEY_0 && aKeyCode <= OH_KEY_9) {
+        ch = static_cast<char16_t>('0' + (aKeyCode - OH_KEY_0));
+      } else if (aKeyCode == OH_KEY_SPACE) {
+        ch = u' ';
+      } else if (aKeyCode == OH_KEY_ENTER) {
+        ch = u'\n';
+      }
+      // 其他标点的 charCode 推导较复杂(依赖键盘布局),此处留 0,
+      // 页面可通过 keydown 的 mKeyCode/mKeyNameIndex 处理。
+      if (ch) {
+        pressEvent.mCharCode = ch;
+        pressEvent.mKeyValue.Assign(ch);
+      }
+    }
+    // IME 激活时:keypress 不带 charCode,但 mKeyCode/mKeyNameIndex 仍有效,
+    // 供 chrome/页面命令绑定(如 Enter 提交表单走 keypress 是 Gecko 隐式提交路径)。
+    // keypress 频率远低于 pointer MOVE,保留这一条文件诊断作为 charCode/IME/
+    // preventDefault 回归的关键取证锚点;入口与 keyCode 的重复日志仍保持删除。
+    OHOS_DiagLog(
+        "[XRE] OnKeyEvent keypress domKeyCode=0x%x charCode=0x%x "
+        "imeActive=%d keydownPrevented=%d pressDefaultPrevented=%d",
+        pressEvent.mKeyCode, pressEvent.mCharCode, imeActive ? 1 : 0,
+        prevented ? 1 : 0, pressEvent.DefaultPrevented() ? 1 : 0);
+    DispatchEvent(&pressEvent);
+  }
+}
