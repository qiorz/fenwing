+// v242: 合成双指 pinch —— 双指缩放验收通道。
+// 背景:APZ 重开后(v241)双指缩放具备前提,但无自动化通道(uinput 单指、
+// 真人手指不可自动化、uitest 被拒)。方案:16ms 步进双指序列 ——
+//   eTouchStart[指0] → eTouchStart[指0,指1](第二指落下,双触点同帧)
+//   → N×eTouchMove[双指 span 渐变] → eTouchEnd[双指同帧]
+// 直接构造双指 WidgetTouchEvent 走 nsWindow::DispatchInputEvent(与
+// OnTouchEvent 的 APZ 分支同路由),APZ 手势识别器消费 span 变化完成
+// pinch 缩放。kill-switch(APZ 关)时事件仍进 DOM(无缩放,验收读数不变)。
+// 触发:aa start -U 'airweb-synth-pinch?factor=1.8&dur=600&cy=0.45&via=1'
+//   factor: span 终值/初值(>1 放大,<1 缩小,默认1.8);
+//   cy: pinch 锚点纵坐标(窗口高度比例,默认0.45 避开 chrome/手势区);
+//   via: 1=走 v270 多指合并器全链(新增代码验证通道),缺省 0=直注(旧通道)。
+namespace {
+struct SynthPinchState {
+  nsCOMPtr<nsITimer> mTimer;
+  mozilla::LayoutDeviceIntPoint mCenter;  // pinch 锚点(设备px)
+  float mSpan = 0.0f;      // 当前两指间距(设备px)
+  float mStepSpan = 0.0f;  // 每步 span 增量
+  int32_t mRemaining = 0;  // 剩余 move 步数
+  bool mSecondDown = false;
+  bool mActive = false;
+  bool mViaBridge = false;  // v270: 经多指合并器(验证 GeckoBridge_ DispatchMultiTouchEvent 全链)而非直注
+};
+SynthPinchState gSynthPinch;
+
+static void SynthPinchCancelTimer() {
+  // v159b 同款:REPEATING 定时器必须显式 Cancel。
+  if (gSynthPinch.mTimer) {
+    gSynthPinch.mTimer->Cancel();
+    gSynthPinch.mTimer = nullptr;
+  }
+  gSynthPinch.mActive = false;
+}
+
+static void SynthPinchSend(nsWindow* aWin, mozilla::EventMessage aMsg, float aSpan,
+                           bool aSingleFinger) {
+  const mozilla::LayoutDeviceIntPoint& c = gSynthPinch.mCenter;
+  const float half = aSpan / 2.0f;
+  if (gSynthPinch.mViaBridge) {
+    // v270: 批语义帧(与真实 XComponent 多点回调同构)走合并器——
+    // 验证 GeckoBridge_DispatchMultiTouchEvent → OHOS_ForwardMultiBatch →
+    // nsWindow::OnMultiTouchEvent 全链(除 NDK 结构体读取外的全部新代码)。
+    // 映射:Start 首=global DOWN 单点(指0);Start 双指=global DOWN 双点
+    // (指1 type DOWN);Move=global MOVE 双点;End=global UP 双点(指1 UP)。
+    OHOSMultiBatch b;
+    const bool isEnd = (aMsg == mozilla::eTouchEnd);
+    const bool isStart = (aMsg == mozilla::eTouchStart);
+    b.mGlobalAction =
+        isEnd ? 1 : (isStart ? 0 : 2);
+    b.mCount = aSingleFinger ? 1 : 2;
+    b.mIds[0] = 0;
+    b.mXs[0] = (float)(c.x - (int32_t)half);
+    b.mYs[0] = (float)c.y;
+    b.mTypes[0] = (isStart && aSingleFinger) ? 0 : (isEnd ? 1 : 2);
+    b.mPressed[0] = isEnd ? 0 : 1;
+    if (!aSingleFinger) {
+      b.mIds[1] = 1;
+      b.mXs[1] = (float)(c.x + (int32_t)half);
+      b.mYs[1] = (float)c.y;
+      b.mTypes[1] = isStart ? 0 : (isEnd ? 1 : 2);
+      b.mPressed[1] = isEnd ? 0 : 1;
+    }
+    b.mTime = PR_IntervalToMilliseconds(PR_IntervalNow());
+    OHOS_ForwardMultiBatch(b);
+    return;
+  }
+  RefPtr<mozilla::dom::Touch> t0 = new mozilla::dom::Touch(
+      0,
+      mozilla::LayoutDeviceIntPoint((int32_t)(c.x - half), c.y),
+      mozilla::LayoutDeviceIntPoint(1, 1), 0.0f, 0.0f);
+  mozilla::WidgetTouchEvent ev(true, aMsg, aWin);
+  ev.mRefPoint = mozilla::LayoutDeviceIntPoint(c.x, c.y);
+  ev.mTouches.AppendElement(t0);
+  if (!aSingleFinger) {
+    RefPtr<mozilla::dom::Touch> t1 = new mozilla::dom::Touch(
+        1,
+        mozilla::LayoutDeviceIntPoint((int32_t)(c.x + half), c.y),
+        mozilla::LayoutDeviceIntPoint(1, 1), 0.0f, 0.0f);
+    ev.mTouches.AppendElement(t1);
+  }
+  aWin->DispatchInputEvent(&ev);
+}
+
+static void SynthPinchTick(nsITimer*, void*) {
+  nsWindow* topWin = nsWindow::GetTopActiveWindow();
+  if (!topWin) {
+    SynthPinchCancelTimer();
+    return;
+  }
+  if (!gSynthPinch.mSecondDown) {
+    gSynthPinch.mSecondDown = true;
+    SynthPinchSend(topWin, mozilla::eTouchStart, gSynthPinch.mSpan, false);
+    return;
+  }
+  if (gSynthPinch.mRemaining > 0) {
+    gSynthPinch.mSpan += gSynthPinch.mStepSpan;
+    gSynthPinch.mRemaining--;
+    SynthPinchSend(topWin, mozilla::eTouchMove, gSynthPinch.mSpan, false);
+    return;
+  }
+  SynthPinchSend(topWin, mozilla::eTouchEnd, gSynthPinch.mSpan, false);
+  OHOS_DiagLog("[APZ_PINCH] 合成 pinch 完成 endSpan=%.0f", gSynthPinch.mSpan);
+  SynthPinchCancelTimer();
+}
+}  // namespace
+
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_SynthTouchPinch(float aFactor, int32_t aDurationMs,
+                                            float aCenterYRatio,
+                                            int32_t aViaBridge) {
+  OHOS_DiagLog("[APZ_PINCH] GeckoBridge_SynthTouchPinch factor=%.2f dur=%dms cy=%.2f via=%d",
+          aFactor, aDurationMs, aCenterYRatio, aViaBridge);
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "GeckoBridge_SynthTouchPinch",
+      [aFactor, aDurationMs, aCenterYRatio, aViaBridge]() {
+        nsWindow* topWin = nsWindow::GetTopActiveWindow();
+        if (!topWin) {
+          return;
+        }
+        if (gSynthPinch.mActive) {
+          SynthPinchCancelTimer();
+        }
+        const mozilla::LayoutDeviceIntRect bounds = topWin->GetBounds();
+        if (bounds.width <= 0 || bounds.height <= 0) {
+          return;
+        }
+        if (aCenterYRatio <= 0.05f || aCenterYRatio >= 0.95f) {
+          gSynthPinch.mCenter = mozilla::LayoutDeviceIntPoint(
+              bounds.width / 2, (int32_t)(bounds.height * 0.45f));
+        } else {
+          gSynthPinch.mCenter = mozilla::LayoutDeviceIntPoint(
+              bounds.width / 2, (int32_t)(bounds.height * aCenterYRatio));
+        }
+        const float span0 = bounds.width * 0.25f;
+        float factor = aFactor;
+        if (factor < 0.2f || factor > 5.0f) {
+          factor = 1.8f;
+        }
+        const float span1 = span0 * factor;
+        const int32_t steps =
+            std::max(4, (aDurationMs > 0 ? aDurationMs : 600) / 16);
+        gSynthPinch.mSpan = span0;
+        gSynthPinch.mStepSpan = (span1 - span0) / steps;
+        gSynthPinch.mRemaining = steps - 1;
+        gSynthPinch.mSecondDown = false;
+        gSynthPinch.mActive = true;
+        gSynthPinch.mViaBridge = (aViaBridge != 0);
+        // 第一指落下(单触点帧);第二指由首个 tick 补上,保持真实手势序列。
+        SynthPinchSend(topWin, mozilla::eTouchStart, gSynthPinch.mSpan, true);
+        NS_NewTimerWithFuncCallback(
+            getter_AddRefs(gSynthPinch.mTimer), SynthPinchTick, nullptr, 16,
+            nsITimer::TYPE_REPEATING_PRECISE, "SynthPinchTick",
+            NS_GetCurrentThread());
+      }));
+}
