@@ -0,0 +1,57 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 2 -*- */
+/* vim: set sw=2 ts=4 expandtab:
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef nsUserIdleServiceOHOS_h__
+#define nsUserIdleServiceOHOS_h__
+
+#include "nsUserIdleService.h"
+#include "mozilla/AppShutdown.h"
+
+namespace mozilla::widget {
+
+// v175: OHOS 用户空闲服务。修复 Issue 2(SessionSaver.sys.mjs 模块顶层
+// Cc['@mozilla.org/widget/useridleservice;1'] 为 undefined → TypeError →
+// 模块整体加载失败 → SessionStore 保存/TAB_CLOSE 收集全部不工作,
+// 真机 diag 实证 SessionSaver.sys.mjs:437 报错 + TabClose entries=0)。
+// 实现对齐 nsUserIdleServiceAndroid:OHOS 无系统级 idle 查询接口,
+// PollIdleTime 返回 false,GetIdleTime 回退用 time since
+// mLastUserInteraction —— 由 NoteUserInput(输入事件侧)喂数。
+class nsUserIdleServiceOHOS : public nsUserIdleService {
+ public:
+  NS_INLINE_DECL_REFCOUNTING_INHERITED(nsUserIdleServiceOHOS,
+                                       nsUserIdleService)
+
+  bool PollIdleTime(uint32_t* aIdleTime) override;
+
+  static already_AddRefed<nsUserIdleServiceOHOS> GetInstance() {
+    RefPtr<nsUserIdleService> idleService = nsUserIdleService::GetInstance();
+    if (!idleService) {
+      // Avoid late instantiation or resurrection during shutdown.
+      if (mozilla::AppShutdown::IsInOrBeyond(
+              mozilla::ShutdownPhase::AppShutdownConfirmed)) {
+        return nullptr;
+      }
+      idleService = new nsUserIdleServiceOHOS();
+    }
+
+    return idleService.forget().downcast<nsUserIdleServiceOHOS>();
+  }
+
+  // 输入事件通知:把 mLastUserInteraction 推到 Now(经 ResetIdleTimeOut(0)),
+  // 使 GetIdleTime 的回退路径反映真实交互。调用方须在 Gecko 主线程
+  // (nsWindow::OnTouchEvent 即是)。服务未注册/shutdown 后静默 no-op。
+  // 每次调用 do_GetService 命中组件管理器服务缓存,开销可忽略,
+  // 避免静态 nsCOMPtr 的 XPCOM shutdown 生命周期问题。
+  static void NoteUserInput();
+
+ protected:
+  nsUserIdleServiceOHOS() = default;
+  virtual ~nsUserIdleServiceOHOS() = default;
+};
+
+}  // namespace mozilla::widget
+
+#endif  // nsUserIdleServiceOHOS_h__
