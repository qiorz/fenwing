+// 由 HeadlessWidget::GetNativeData 调用:获取当前原生窗口句柄
+// 返回 nullptr 表示尚未有 Surface 注入(EGL 将创建 fallback surface)
+extern "C" void* OHOS_GetNativeWindow() {
+  void* win = gOHOSNativeWindow.load(std::memory_order_relaxed);
+  // 采样日志:首次非空调用必输出,之后每 1000 次输出一次,避免高频冲爆日志
+  uint64_t count = gGetNativeWindowCallCount.fetch_add(1, std::memory_order_relaxed);
+  if (win != nullptr && !gGetNativeWindowFirstLogged.exchange(true)) {
+    OHOS_DiagLog("[XRE] OHOS_GetNativeWindow 首次非空 window=%p count=%llu",
+            win, (unsigned long long)count);
+  } else if (count % 1000 == 0) {
+    OHOS_DiagLog("[XRE] OHOS_GetNativeWindow 采样 count=%llu window=%p",
+            (unsigned long long)count, win);
+  }
+  return win;
+}
