+// XComponent 回调
+// ============================================================================
+
+// Surface 创建回调:将原生窗口句柄传递给 libxul.so 的 widget 层
+// Gecko 的 GLContextProviderEGL 通过 HeadlessWidget::GetNativeData
+// (NS_NATIVE_WINDOW) 获取此窗口句柄创建 EGLWindowSurface
+//
+// 同步设计:不使用本 .so 内的 condition_variable,而是通过 GeckoBridge_SetNativeWindow
+// 在 libxul.so 内部完成"设置 + notify_all"。原因:libgeckoview.so 与 libgeckoxcomp.so
+// 是同一份代码的两个文件副本,本 .so 内的 static 全局变量在两个副本中各有一份,
+// CV 在副本间无法共享。libxul.so 在内存中只有一份,其内部 CV 可被所有 .so 副本
+// 的等待线程(GeckoBridge_WaitNativeWindow)共享,notify_all 才能正确唤醒等待线程。
+static void OnSurfaceCreated(OH_NativeXComponent* component, void* window) {
+    gNativeWindow = window;  // 仅用于本地诊断日志
+    // 获取 XComponent 表面尺寸,传递给 libxul.so 供 nsWindow::Create 使用
+    // 根因修复:OpenWindow 创建 GeckoView 窗口时初始尺寸为 0x0,需用实际表面尺寸修正
+    uint64_t width = 0, height = 0;
+    int32_t ret = OH_NativeXComponent_GetXComponentSize(component, window, &width, &height);
+    if (ret == 0 && width > 0 && height > 0) {
+        GeckoBridge_SetSurfaceSize((int)width, (int)height);
+        // v56:本地缓存 Surface 尺寸,供 getSurfaceSize NAPI 查询
+        gSurfaceWidth.store((int)width, std::memory_order_relaxed);
+        gSurfaceHeight.store((int)height, std::memory_order_relaxed);
+        OH_LOG_INFO(LOG_APP, "XComponent OnSurfaceCreated, window=%{public}p size=%{public}llux%{public}llu",
+                    window, (unsigned long long)width, (unsigned long long)height);
+    } else {
+        OH_LOG_WARN(LOG_APP, "XComponent OnSurfaceCreated GetXComponentSize 失败 ret=%{public}d, window=%{public}p", ret, window);
+    }
+    // 将原生窗口传递给 libxul.so,内部设置 atomic 变量并 notify_all 唤醒等待线程
+    GeckoBridge_SetNativeWindow(window);
+    OH_LOG_INFO(LOG_APP, "XComponent OnSurfaceCreated, window=%{public}p (已传递给 libxul 并通知等待线程)", window);
+
+    // v57:IME Attach(仅首次 OnSurfaceCreated 执行)
+    // 此处 XComponent 已就绪,windowId 可获取,Attach 一次后软键盘可正常使用
+    OHOS_IME_Attach();
+}
