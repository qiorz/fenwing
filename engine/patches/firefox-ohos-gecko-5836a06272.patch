+float nsWindow::GetDPI() {
+  // v56:DPI = densityPixels × 96,使 GetDefaultScaleInternal 返回 densityPixels。
+  // 这样 Gecko 的 CSS px ↔ 设备px 缩放与 ArkUI 的 vp ↔ 物理px(density)一致,
+  // 页面内容大小匹配屏幕物理尺寸(解决"网页太小")。
+  // ArkUI density = OH_NativeDisplayManager densityPixels(实测 1.9),
+  // 对应 DPI = 1.9 × 96 = 182.4。
+  static float sCachedDPI = 0.0f;
+  if (sCachedDPI > 0.0f) {
+    return sCachedDPI;
+  }
+  float densityPixels = 0.0f;
+  NativeDisplayManager_ErrorCode rc =
+      OH_NativeDisplayManager_GetDefaultDisplayDensityPixels(&densityPixels);
+  if (rc == DISPLAY_MANAGER_OK && densityPixels > 0.0f) {
+    sCachedDPI = densityPixels * 96.0f;
+    OHOS_DiagLog("[XRE] GetDPI: densityPixels=%.2f -> DPI=%.1f (scale=%.2f)",
+            densityPixels, sCachedDPI, densityPixels);
+  } else {
+    // 回退:典型 PC density 2.0
+    sCachedDPI = 192.0f;
+    OHOS_DiagLog("[XRE] GetDPI: API 失败 rc=%d -> 回退 DPI=192 (scale=2.0)", (int)rc);
+  }
+  return sCachedDPI;
+}
+
+double nsWindow::GetDefaultScaleInternal() {
+  // v56:scale = densityPixels(ArkUI 密度比),CSS px 与设备 px 按 density 缩放。
+  // Gecko 内部用此 scale 把 CSS px 映射到设备 px(Surface 渲染像素)。
+  // 与 ArkUI vp↔物理px 的 density 一致,保证内容大小匹配屏幕。
+  return GetDPI() / 96.0;
+}
+
+void nsWindow::Move(double aX, double aY) {
+  int32_t x = NSToIntRound(aX);
+  int32_t y = NSToIntRound(aY);
+
+  // v123 popup 全链诊断:layout 通过 nsView::DoResetWidgetBounds → MoveClient
+  // → Move 把 popup 锚定到 ≡ 按钮下方。记录此处验证 popup 位置是否正确驱动。
+  if (mWindowType == WindowType::Popup) {
+    OHOS_DiagLog("[XRE_POPUP] Move this=%p -> (%d,%d) (旧 mBounds=%d,%d)",
+            (void*)this, x, y, mBounds.X(), mBounds.Y());
+  }
+
+  if (mBounds.IsEqualXY(x, y) && mWindowType != WindowType::Popup) {
+    return;
+  }
+
+  mBounds.MoveTo(x, y);
+  if (mWidgetListener) {
+    mWidgetListener->WindowMoved(this, x, y,
+                                 nsIWidgetListener::ByMoveToRect::No);
+  }
+}
+
+void nsWindow::Resize(double aWidth, double aHeight, bool aRepaint) {
+  int32_t width = NSToIntRound(aWidth);
+  int32_t height = NSToIntRound(aHeight);
+
+  // v108: 单窗口全屏模型修正。browser.xhtml 顶层窗口会被窗口体系按内容首选尺寸
+  // (约 1349x779,来自 XULStore/窗口默认值)Resize,小于 XComponent Surface,
+  // 导致 chrome 只在 Surface 局部区域渲染(竖直方向挤压在中部)。
+  // OHOS 上顶层窗口与唯一 EGL Surface 一一对应,TopLevel/Dialog 的尺寸
+  // 必须始终等于 Surface 尺寸;Popup 不受影响(尺寸由 layout 驱动)。
+  // 用户拖动改变 2in1 窗口大小时,ArkTS 侧会更新 Surface 尺寸,
+  // OHOS_GetSurfaceSize 随之返回新值,此处依然正确。
+  // v243: 去掉 mNativeWindow != nullptr 前提 —— surface 尺寸由独立的
+  // gSurfaceWidth/Height 原子提供(OnSurfaceCreated/Changed 注入,与
+  // native window 指针无关),Create 3s 等待超时的窗口(native window 迟到)
+  // 此前拿布局首选尺寸 1349x779 生效,与实际 surface(如 2091x1227)失配
+  // 正是"冷启一帧内容放大裁切+右侧空白竖带"的几何根源(P0-3 守卫的治本
+  // 配套)。surface 值未注入时 (0,0) 被下方 >1 过滤,行为不变。
+  if (mWindowType == WindowType::TopLevel || mWindowType == WindowType::Dialog) {
+    int surfaceW = 0, surfaceH = 0;
+    OHOS_GetSurfaceSize(&surfaceW, &surfaceH);
+    if (surfaceW > 1 && surfaceH > 1 && (width != surfaceW || height != surfaceH)) {
+      // v258d: 取证调用者(新标签页瞬间会出现 Resize(2280x1425) 类
+      // 持久化尺寸注入,虽被纠正回 Surface 真值,但与键盘白带画面冻结
+      // 的错误几何同数值族)。dladdr 就地解析符号名(设备 /proc/maps 受限,
+      // 无法事后 addr2line)。
+      const void* ra0 = __builtin_return_address(0);
+      const void* ra1 = __builtin_return_address(1);
+      Dl_info info0{}, info1{};
+      dladdr(ra0, &info0);
+      dladdr(ra1, &info1);
+      OHOS_DiagLog("[XRE] v108 Resize 修正: %dx%d -> Surface %dx%d "
+              "caller0=%s+%lu caller1=%s+%lu",
+              width, height, surfaceW, surfaceH,
+              info0.dli_sname ? info0.dli_sname : "?",
+              info0.dli_sname
+                  ? (unsigned long)((char*)ra0 - (char*)info0.dli_saddr)
+                  : 0UL,
+              info1.dli_sname ? info1.dli_sname : "?",
+              info1.dli_sname
+                  ? (unsigned long)((char*)ra1 - (char*)info1.dli_saddr)
+                  : 0UL);
+      width = surfaceW;
+      height = surfaceH;
+    }
+  }
+
+  OHOS_DiagLog("[XRE] nsWindow::Resize(w,h) this=%p type=%d aSize=%.1fx%.1f->%dx%d mBounds=%dx%d listener=%p attached=%p",
+          (void*)this, (int)mWindowType, aWidth, aHeight, width, height,
+          mBounds.Width(), mBounds.Height(), (void*)mWidgetListener,
+          (void*)mAttachedWidgetListener);
+
+  if (mBounds.IsEqualSize(width, height) && mWindowType != WindowType::Popup) {
+    return;
+  }
+
+  // v123 popup 全链诊断:记录 layout 驱动的 popup 尺寸(应≈菜单内容尺寸,
+  // 如 501x668 量级,而非整个 Surface)。这是验证修复的关键日志点。
+  if (mWindowType == WindowType::Popup) {
+    OHOS_DiagLog("[XRE_POPUP] Resize(w,h) this=%p %dx%d -> mBounds=(%d,%d %dx%d)",
+            (void*)this, width, height,
+            mBounds.X(), mBounds.Y(), mBounds.Width(), mBounds.Height());
+  }
+
+  mBounds.SizeTo(LayoutDeviceIntSize(width, height));
+
+  // 通知合成器客户端尺寸变化
+  if (mWidgetListener) {
+    mWidgetListener->WindowResized(this, mBounds.Width(), mBounds.Height());
+  }
+  if (mAttachedWidgetListener) {
+    mAttachedWidgetListener->WindowResized(this, mBounds.Width(),
+                                           mBounds.Height());
+  }
+
+  OnSizeChanged(IntSize(width, height));
+}
+
+void nsWindow::Resize(double aX, double aY, double aWidth, double aHeight,
+                      bool aRepaint) {
+  // v123 popup 全链诊断:nsView::DoResetWidgetBounds → ResizeClient → 此重载,
+  // 是 popup 定位+定尺寸的最终落点。用 [XRE_POPUP] tag 标记便于检索。
+  if (mWindowType == WindowType::Popup) {
+    OHOS_DiagLog("[XRE_POPUP] Resize(x,y,w,h) this=%p pos=(%.1f,%.1f) size=%.1fx%.1f",
+            (void*)this, aX, aY, aWidth, aHeight);
+  } else {
+    OHOS_DiagLog("[XRE] nsWindow::Resize(x,y,w,h) this=%p type=%d pos=(%.1f,%.1f) size=%.1fx%.1f",
+            (void*)this, (int)mWindowType, aX, aY, aWidth, aHeight);
+  }
+  Move(aX, aY);
+  Resize(aWidth, aHeight, aRepaint);
+}
