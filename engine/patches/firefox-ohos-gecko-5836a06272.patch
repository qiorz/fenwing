+// v137: nsCursor → OHOS Input_PointerStyle 映射表。
+// 参考 widget/android/nsWindow.cpp:3412 GetCursorType 的 OHOS 等价物。
+// 枚举值见 multimodalinput/oh_pointer_style.h(since 22)。
+// 方向键对齐:nsIWidget.h:163-210 的 eCursor_*_resize 与 OHOS 双向箭头映射。
+static int32_t GetOHOSPointerStyle(nsCursor aCursor) {
+  switch (aCursor) {
+    case eCursor_standard:
+      return DEFAULT;
+    case eCursor_select:
+      return TEXT_CURSOR;
+    case eCursor_vertical_text:
+      return HORIZONTAL_TEXT_CURSOR;
+    case eCursor_hyperlink:
+      return HAND_POINTING;
+    case eCursor_wait:
+    case eCursor_spinning:
+      return LOADING;
+    case eCursor_crosshair:
+    case eCursor_cell:
+      return CROSS;
+    case eCursor_move:
+    case eCursor_all_scroll:
+      return MOVE;
+    case eCursor_help:
+      return HELP;
+    case eCursor_copy:
+      return CURSOR_COPY;
+    case eCursor_not_allowed:
+    case eCursor_no_drop:
+      return CURSOR_FORBID;
+    case eCursor_grab:
+      return HAND_OPEN;
+    case eCursor_grabbing:
+      return HAND_GRABBING;
+    case eCursor_zoom_in:
+      return ZOOM_IN;
+    case eCursor_zoom_out:
+      return ZOOM_OUT;
+    // 东西向 resize
+    case eCursor_w_resize:
+    case eCursor_e_resize:
+    case eCursor_ew_resize:
+    case eCursor_col_resize:
+      return WEST_EAST;
+    // 南北向 resize
+    case eCursor_n_resize:
+    case eCursor_s_resize:
+    case eCursor_ns_resize:
+    case eCursor_row_resize:
+      return NORTH_SOUTH;
+    // 西北-东南向 resize
+    case eCursor_nw_resize:
+    case eCursor_se_resize:
+    case eCursor_nwse_resize:
+      return NORTH_WEST_SOUTH_EAST;
+    // 东北-西南向 resize
+    case eCursor_ne_resize:
+    case eCursor_sw_resize:
+    case eCursor_nesw_resize:
+      return NORTH_EAST_SOUTH_WEST;
+    // 其余无直接对应的(自定义图片、隐藏、上下文菜单等)落 default。
+    case eCursor_alias:
+    case eCursor_context_menu:
+    case eCursor_none:
+    default:
+      NS_WARNING_ASSERTION(aCursor < eCursorCount, "Invalid cursor type");
+      return DEFAULT;
+  }
+}
+
+void nsWindow::SetCursor(const Cursor& aDefaultCursor) {
+  // 缓存当前 Cursor(对齐 nsBaseWidget::SetCursor 语义,nsBaseWidget.cpp:695)。
+  // 自定义图片光标(aDefaultCursor.mContainer 非空)暂不支持,落 default 分支。
+  mCursor = aDefaultCursor;
+
+  int32_t style = GetOHOSPointerStyle(aDefaultCursor.mDefaultCursor);
+  // 同值去重:ESM 每次 mousemove 都会调用 SetCursor,样式未变时跳过,
+  // 避免高频重复 OH_Input_SetPointerStyle IPC。
+  if (style == mLastPointerStyle) {
+    return;
+  }
+  mLastPointerStyle = style;
+  OHOS_ApplyPointerStyle(style);
+}
+
+void* nsWindow::GetNativeData(uint32_t aDataType) {
+  switch (aDataType) {
+    case NS_NATIVE_WINDOW:
+      // 返回本窗口的 mNativeWindow。
+      // 第二+窗口(由 OnNewSession 的 OpenWindow 创建)的 mNativeWindow 为 null
+      // (不绑定 native window,避免与第一窗口的 EGLSurface 冲突)。
+      // 返回 nullptr 让 Gecko 知道此窗口无原生 surface。
+      // 注意:不能回退到全局 OHOS_GetNativeWindow(),那会返回第一窗口的
+      // OHNativeWindow,导致两个 EGLSurface 绑定同一 native window 崩溃。
+      if (mNativeWindow) {
+        return mNativeWindow;
+      }
+      return nullptr;
+    case NS_NATIVE_WIDGET:
+      return this;
+    default:
+      return nullptr;
+  }
+}
+
+void nsWindow::SetNativeData(uint32_t aDataType, uintptr_t aVal) {
+  switch (aDataType) {
+    case NS_NATIVE_WINDOW:
+      // 外部注入 OHNativeWindow(由 XComponent NAPI 层调用)
+      mNativeWindow = reinterpret_cast<OHNativeWindow*>(aVal);
+      break;
+    default:
+      break;
+  }
+}
+
+void nsWindow::SetNativeWindow(OHNativeWindow* aWindow) {
+  mNativeWindow = aWindow;
+  OHOS_DiagLog("[XRE] nsWindow::SetNativeWindow this=%p window=%p",
+          (void*)this, (void*)aWindow);
+}
