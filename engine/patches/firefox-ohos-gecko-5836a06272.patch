+  .urlbarView-url {
+    font-size: 12px !important;
+    color: var(--phone-text-secondary) !important;
+  }
+
+  /* ---- 加载进度条(#phone-progress,nav-bar 底缘 2px,JS 节流写 scaleX) ---- */
+  #phone-progress {
+    display: block;
+    position: absolute;
+    left: 0;
+    right: 0;
+    bottom: 0;
+    height: 2px;
+    opacity: 0;
+    visibility: hidden;
+    pointer-events: none;
+    z-index: 10;
+    transition: opacity 200ms ease-out, visibility 200ms;
