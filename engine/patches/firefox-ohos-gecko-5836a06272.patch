+// IME 插入文本(英文字符/数字/符号 + 中文合成完成后的最终文本)
+// 文档明确:text 内存仅在回调内有效,回调返回后释放 → 必须在此同步复制
+static void OHOS_OnInsertText(InputMethod_TextEditorProxy* proxy,
+                              const char16_t* text, size_t length) {
+    if (!text || length == 0) return;
+    // 立即拷贝文本到堆内存,在 Gecko 主线程上消费时释放
+    // char16_t 与 Gecko char16_t 兼容(均为 uint16_t / wchar_t 在 OHOS aarch64)
+    char16_t* buf = new char16_t[length];
+    memcpy(buf, text, length * sizeof(char16_t));
+    OH_LOG_INFO(LOG_APP, "[IME] OnInsertText length=%{public}zu", length);
+    GeckoBridge_InsertText(buf, length);
+}
