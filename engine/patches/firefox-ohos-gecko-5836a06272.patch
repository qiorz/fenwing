+// IME Enter 键 Runnable:在 Gecko 主线程上调用 nsWindow::OnSendEnterKey
+class OHOSEnterKeyRunnable : public mozilla::Runnable {
+ public:
+  OHOSEnterKeyRunnable(nsWindow* aWin, int32_t aEnterKeyType)
+      : mozilla::Runnable("OHOSEnterKeyRunnable"),
+        mWin(aWin), mEnterKeyType(aEnterKeyType) {}
+
+  NS_IMETHOD Run() override {
