+
+bool nsWindow::WidgetTypeSupportsAcceleration() {
+  // OHOS 单 EGL Surface 架构,GLContextProviderEGL 硬编码全局单例
+  // OHOS_GetNativeWindow()(gfx/gl/GLContextProviderEGL.cpp:27-29
+  // GET_NATIVE_WINDOW_FROM_COMPOSITOR_WIDGET → OHOS_GetNativeWindow())。
+  //
+  // popup 返回 false 的原因与行为(v111 引入,v128 修正注释):
+  //   popup 自身 WRLM 仍会创建独立 compositor/RenderCompositorEGL,其
+  //   CreateEGLSurface 最终也绑定到全局 OHOS_GetNativeWindow()(同一 Surface)。
+  //   返回 false 让 popup 走软件 WebRender/SWGL 路径,避免与主窗口硬件
+  //   compositor 在同一 EGLSurface 上争用 Present(参考 GTK
+  //   widget/gtk/nsWindow.cpp:794 对 IsSmallPopup 返回 false)。
+  //
+  //   注意:popup 在 OHOS 上"是否走软件渲染"与"是否委托 TopLevel WRLM"是两件
+  //   独立的事。v123 错误地把两者耦合(声称"软件渲染 + 共享 TopLevel 场景"),
+  //   实际 popup 委托后其 EndTransaction 会替换 TopLevel 场景(见 GetWindowRenderer
+  //   上方 v128 注释)。v128 起 popup 不再委托,走自身独立 WRLM;此处返回 false
+  //   仅控制 popup 自身 WRLM 的加速策略,与主窗口无关。
+  //
+  // 真机验证要点:popup 打开时此处命中一次即可,不应每帧刷(popup WRLM 创建后
+  // 该函数不再被频繁调用)。
+  if (mWindowType == WindowType::Popup) {
+    OHOS_DiagLog("[XRE_POPUP] WidgetTypeSupportsAcceleration: popup this=%p "
+            "mBounds=(%d,%d %dx%d) -> false(popup 自身软件渲染,不委托)",
+            (void*)this, mBounds.X(), mBounds.Y(),
+            mBounds.Width(), mBounds.Height());
+    return false;
+  }
+  return true;
+}
