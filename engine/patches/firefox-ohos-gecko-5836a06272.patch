+bool nsWindow::CheckForRollup(int32_t aX, int32_t aY) {
+  // v111 popup 无法关闭修复(GTK widget/gtk/nsWindow.cpp:7417 CheckForRollup
+  // 的 OHOS 适配):GTK popup 是独立 X 窗口,系统把点击路由给 popup 窗口;
+  // OHOS 所有输入事件都 DispatchEvent 到主 nsWindow,popup widget 收不到事件,
+  // nsXULPopupManager 的 rollup 永远不触发 → ≡ 菜单打开后点外部无法关闭。
+  // 此处补齐:popup 打开时,down 事件先检查坐标是否在当前 popup bounds 外,
+  // 在外则 Rollup 关闭全部 popup 并消费事件(GTK 同款:rollup 后 return)。
+  nsIRollupListener* rollupListener = nsBaseWidget::GetActiveRollupListener();
+  if (!rollupListener) {
+    return false;
+  }
+  nsCOMPtr<nsIWidget> rollupWidget = rollupListener->GetRollupWidget();
+  if (!rollupWidget) {
+    return false;  // 无 popup 打开,正常分发
+  }
+
+  // 点击在 popup bounds 内:不 rollup。菜单项命中由 ESM 的 popup 捕获链
+  // (popup 打开时 nsXULPopupManager 设置 capturing presshell)重定向到
+  // popup presshell 处理,事件继续走主窗口 DispatchEvent 即可到达。
+  LayoutDeviceIntRect popupBounds = rollupWidget->GetBounds();
+  if (popupBounds.Contains(aX, aY)) {
+    return false;
+  }
+
+  // v119 多级子菜单链适配(GTK widget/gtk/nsWindow.cpp:7447-7466 移植):
+  // v111 只对照最顶层 popup,子菜单展开后 GetRollupWidget() 返回子菜单
+  // widget,回点父级 ≡ 菜单项被判为"popup 外"而把整条链全关。
+  // 此处补齐:遍历整条子菜单 widget 链(顶→根)做命中测试——
+  // 命中同类型链内某层(i < sameTypeCount)则不 rollup;
+  // 命中更外层父级则 mCount=sameTypeCount 只关同类型链尾若干层。
+  AutoTArray<nsIWidget*, 5> widgetChain;
+  uint32_t sameTypeCount = rollupListener->GetSubmenuWidgetChain(&widgetChain);
+  uint32_t countForRollup = 0;  // 0 = 关闭全部 popup
+  for (uint32_t i = 0; i < widgetChain.Length(); ++i) {
+    if (widgetChain[i] && widgetChain[i]->GetBounds().Contains(aX, aY)) {
+      if (i < sameTypeCount) {
+        return false;  // 命中同类型链内某层,不 rollup
+      }
+      countForRollup = sameTypeCount;  // 命中外层父级,只关同类型那几层
+      break;
+    }
+  }
+
+  // 点击在 popup 链外(或外层父级内):Rollup(countForRollup=0 全关;
+  // =sameTypeCount 只关同类型链尾),消费该事件。
+  OHOS_DiagLog("[XRE] CheckForRollup: 点击(%d,%d)在 popup bounds(%d,%d %dx%d)外,执行 Rollup count=%u sameType=%u",
+          aX, aY, popupBounds.X(), popupBounds.Y(),
+          popupBounds.Width(), popupBounds.Height(), countForRollup,
+          sameTypeCount);
+  nsIRollupListener::RollupOptions options{countForRollup,
+                                           nsIRollupListener::FlushViews::Yes};
+  LayoutDeviceIntPoint point(aX, aY);
+  options.mPoint = &point;
+  return rollupListener->Rollup(options);
+}
+
+// v218: popup 楔死自愈守卫回调(见 Create 内 [XRE_POPUP_GUARD] 注释)。
+void nsWindow::OnPopupWedgeGuardTimeout() {
+  mPopupWedgeGuardTimer = nullptr;
+  if (mDestroyed || mWindowType != WindowType::Popup) {
+    return;
+  }
+  if (mBounds.Width() > 1 && mBounds.Height() > 1) {
+    // 期间已 Resize 到真实尺寸 = 正常打开时序,静默解除布防。
+    return;
+  }
+  if (!mPopupCounted) {
+    // v218b: 从未 Show 过的 0 尺寸 popup 是隐藏的预载面板(启动期
+    // CustomizableWidgets/原生菜单预构建实测 5 个),静止即其常态,
+    // 不是楔死态,Rollup 反而会破坏菜单基建(真机首验实证:误 Rollup
+    // 后 ≡ 无响应)。楔死态的 1px 壳是"被显示但视图塌缩"——必然
+    // mPopupCounted=true,以此区分。
+    return;
+  }
+  OHOS_DiagLog("[XRE_POPUP_GUARD] 750ms 后仍为退化尺寸 %dx%d(已 Show),判定楔死态,Rollup 全部 popup 自愈",
+          mBounds.Width(), mBounds.Height());
+  nsIRollupListener* rollupListener = nsBaseWidget::GetActiveRollupListener();
+  if (rollupListener) {
+    nsIRollupListener::RollupOptions options{
+        0 /* 全关 */, nsIRollupListener::FlushViews::Yes};
+    rollupListener->Rollup(options);
+  }
+}
