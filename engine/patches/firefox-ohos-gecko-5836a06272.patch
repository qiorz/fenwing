+// 默认 true),强制走 JS 选择路径。OHOS 的"强制纳入 baidu + 强制默认"补丁
+// 挂在 SearchEngineSelector.sys.mjs 的 JS 路径(featureGate=false 才走到),
+// Rust 路径是编译态代码无法挂 JS 补丁,不关门控则补丁永远不生效。
+pref("browser.search.rustSelector.featureGate", false);
+
+// ============================================================================
+// v141: 问题⑦ 补充——地址栏 Firefox Suggest 在线建议(Merino,
+// services.mozilla 官方服务)全部关闭,残留项仅本地历史/书签。
+pref("browser.urlbar.quicksuggest.enabled", false);
+pref("browser.urlbar.suggest.quicksuggest.nonsponsored", false);
+pref("browser.urlbar.suggest.quicksuggest.sponsored", false);
+
+// ============================================================================
+// v155: 浏览器条/地址栏流畅性。OHOS 单进程 + 共享主线程下,每次地址栏输入
+// 同时查询 engines/topsites/openpage 并构造 10 行结果会与 chrome 点击争用。
+// 本平台仅内置百度且无独立 topsites/switch-to-tab 价值,关闭三路低收益源并把
+// 结果上限收紧到 6;保留历史与书签建议。
+pref("browser.urlbar.suggest.engines", false);
+pref("browser.urlbar.suggest.topsites", false);
+pref("browser.urlbar.suggest.openpage", false);
+pref("browser.urlbar.maxRichResults", 6);
+
+// 标签密集操作时减少 sessionstore 周期写盘与撤销标签序列化规模。
+// v261: 25s→15s(上游默认)。force-stop/kill 前未到 interval 的标签状态
+// 全丢(切后台 flushSession 是兜底但异步落盘需时间),收窄窗口降低丢标签面。
+pref("browser.sessionstore.interval", 15000);
+pref("browser.sessionstore.max_tabs_undo", 3);
+
+// ArkTS 原生菜单覆盖层为 OHOS 菜单默认呈现路径。≡ appMenu、menulist/设置语言下拉
+// 统一脱离 XUL popup/单 EGL Surface scene-merge，避免 popup 显隐全量重绘与输入死区。
+// Gecko 侧桥未注册或菜单不可序列化时仍自动回退原 XUL 路径。
+pref("ohos.menu.native_overlay", true);
+
+// ============================================================================
+// v228: 内存足迹收紧三项(P2 挂账落地,第五轮审计 B 清单收官)。
+// 动机:单进程架构下页面内存/chrome/解码全在主进程,musl malloc 碎片敏感,
+// 内存压力→LMK 风险与分配器劣化是"用越久越卡"的结构性来源。
+// ============================================================================
+// ① 图片 surface cache 上限:StaticPrefList 默认 2024*1024(~2GB,桌面大内存
+// 假设)。收紧到 512MB——图密集页长刷时解码表面缓存不再无界增长;正常浏览
+// 远达不到上限,无命中率损失。AtStartup 镜像。
+pref("image.mem.surfacecache.max_size_kb", 524288);
+// ② 会话历史视图缓存:all.js 默认 -1(按内存动态,桌面大内存拿到很多)。
+// 后退/前进时保留的已解析文档数。移动端 4 页足够覆盖常见后退链,防多标签
+// 浏览时大量文档树驻留(每个 viewer 是完整的 DOM+layout)。
+pref("browser.sessionhistory.max_total_viewers", 4);
+// ③ 低内存时卸载后台标签:firefox.js 在非 MACOSX/WIN 平台拿 false(OHOS
+// 落 #else 桌面残留)。单进程长驻应用后台标签 RSS 是大头,置 true 让
+// TabUnloader 在内存压力时丢弃后台标签文档(保留标题/favicon/会话历史,
+// 切回时重载)。min_inactive_duration 默认 600000(10 分钟)保证只卸载
+// 真正久置的标签,刚用过的标签不受影响。
+pref("browser.tabs.unloadOnLowMemory", true);
+
+// [OHOS v258] 书签工具栏禁用自动显示:上游默认 "newtab"(新标签页自动弹
+// 书签栏)在本移植触发渲染冻结——工具栏 36CSSpx 布局过渡期被 paint-hold/
+// 中间帧冻结,后续帧 damage 只覆盖光标闪烁区,地址栏剩细缝+页面画到
+// y134+底部 154px 白带+点击命中偏移(前往按钮无响应同根),切标签才恢复
+// (v258 探针定案:inner/screen 全程不变,XUL 窗口从未 resize,唯一布局
+// 过渡=PersonalToolbar 显示)。渲染侧根治挂账,先消触发器。
+pref("browser.toolbars.bookmarks.visibility", "never");
+
+// [OHOS v259] urlbar 搜索模式切换器去离屏化:上游 urlbar-searchbar.css 把
+// #urlbar-searchmode-switcher 摆在 position:fixed; top:-999px("离屏保焦
+// 点"技巧,pref=false 分支)。该离屏元素进同一 picture-cache 切片后,切片
+// cluster bounds 顶边被拉到 -999CSS×2.4=-2282.6 设备px(v259d [CLIP_POISON]
+// 实证 raw=-2282.6 与 CSS 分毫不差),OHOS 无 OS 合成器(纯 Draw 合成器)的
+// 图块网格映射被污染——新标签页内容上移 68px+地址栏细缝+底部 161px 白带
+// (v257-v259 挂账的整个白带家族:凡地址栏聚焦过即触发)。桌面平台经 OS
+// 合成器 surface 变换免疫,上游无此症状。pref=true 让 CSS 整个离屏块跳过
+// (切换器回归文档流),v259e 真机验证新标签页/键盘周期全绿。
+pref("browser.urlbar.unifiedSearchButton.always", true);
+
+// [DIAG v260] 禁用 NewTab 预加载浏览器:上游 NewTabPagePreloading 会把一个
+// 预加载 about:newtab 的 browser panel 直接 append 进 tabbrowser deck(靠
+// deck 选中语义隐藏非选中 panel);OHOS 无 OS 合成器,deck"全子 panel 叠画/
+// 末位胜出"疑似使预加载 Firefox Home 盖在真实标签上(游离 browser 撕裂)。
+// 诊断 A/B 用:若撕裂消失则坐实,再决定 XUL 侧根治还是保持禁用(新标签慢
+// 一点的代价)。
+pref("browser.newtab.preload", false);
