+// 由 geckoview.so 调用:设置 XComponent 回调注入的原生窗口句柄
+// 在 libxul.symbols 中导出,供 libgeckoview.so / libgeckoxcomp.so 动态链接调用
+// 注意:Mozilla 构建系统默认使用 -fvisibility=hidden,必须显式标记
+// visibility("default") 才能将符号导出到动态符号表
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_SetNativeWindow(void* aWindow) {
+  {
+    std::lock_guard<std::mutex> lock(gNativeWindowMutex);
+    // v243: 指针变化(含置 null/换代)即 EGLSurface 失效信号(见上方注释)。
+    // 首启注入(null→非null)时 EGLSurface 尚未懒建,消费为空操作,无害。
+    if (gOHOSNativeWindow.load(std::memory_order_relaxed) != aWindow) {
+      gEGLSurfaceInvalidated.store(true, std::memory_order_relaxed);
+    }
+    gOHOSNativeWindow.store(aWindow, std::memory_order_relaxed);
+  }
+  // 通知所有等待线程(无论等待方在哪个 .so 副本中,等待的都是
+  // libxul.so 内这一份 condition_variable)
+  gNativeWindowCV.notify_all();
+  // 诊断日志:用 OHOS_DiagLog 直接写入文件(不依赖 dup2 stderr 重定向)
+  OHOS_DiagLog("[XRE] GeckoBridge_SetNativeWindow aWindow=%p tid=%zu",
+          aWindow, (size_t)std::hash<std::thread::id>{}(std::this_thread::get_id()));
+}
+
+// 由 GeckoMainThread 调用:阻塞等待 OnSurfaceCreated 注入 OHNativeWindow
+// aTimeoutMs:超时毫秒数;返回非 nullptr 表示已就绪,nullptr 表示超时
+// 同步原语在 libxul.so 内,确保跨 .so 副本同步生效
+__attribute__((visibility("default")))
+extern "C" void* GeckoBridge_WaitNativeWindow(int aTimeoutMs) {
+  std::unique_lock<std::mutex> lock(gNativeWindowMutex);
+  void* current = gOHOSNativeWindow.load(std::memory_order_relaxed);
+  if (current != nullptr) {
+    OHOS_DiagLog("[XRE] GeckoBridge_WaitNativeWindow 已就绪(无等待) window=%p", current);
+    return current;
+  }
+  OHOS_DiagLog("[XRE] GeckoBridge_WaitNativeWindow 进入等待 timeout=%dms", aTimeoutMs);
+  bool notified = gNativeWindowCV.wait_for(lock,
+    std::chrono::milliseconds(aTimeoutMs),
+    [] {
+      return gOHOSNativeWindow.load(std::memory_order_relaxed) != nullptr;
+    });
+  void* result = gOHOSNativeWindow.load(std::memory_order_relaxed);
+  OHOS_DiagLog("[XRE] GeckoBridge_WaitNativeWindow 等待结束 notified=%d window=%p",
+          (int)notified, result);
+  return result;
+}
