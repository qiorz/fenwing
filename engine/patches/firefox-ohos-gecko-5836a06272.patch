diff --git a/widget/openharmony/AuxvalStub.cpp b/widget/openharmony/AuxvalStub.cpp
new file mode 100644
index 0000000000..9b3f90c980
--- /dev/null
+++ b/widget/openharmony/AuxvalStub.cpp
@@ -0,0 +1,26 @@
+/* -*- Mode: C++; tab-width: 8; indent-tabs-mode: nil; c-basic-offset: 2 -*- */
+/* vim: set ts=8 et sw=2 tw=80: */
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// OpenHarmony getauxval stub
+//
+// 背景:OHOS libc(musl)已提供 getauxval 为 global+weak 符号,但 libxul.so
+// 用 -fvisibility=hidden 编译,所有引用方(abseil/libyuv/libvpx 等)的 .o
+// 中 getauxval 引用被标记为 hidden。链接器要求 hidden 符号必须在同一个
+// DSO(libxul.so)内定义,libc.so 中的 global 定义不满足要求。
+//
+// 方案:在 widget/openharmony(FINAL_LIBRARY="xul")中提供 getauxval 的 stub
+// 实现,编译进 libxul.so。hidden 定义不与 libc.so 的 global+weak 定义冲突
+// (hidden 不参与全局符号表)。
+//
+// 返回 0 的安全性:getauxval(AT_HWCAP) 返回 0 表示不支持任何可选硬件特性。
+// abseil GetCpuType() 会跳过 HWCAP_CPUID 分支返回 kUnknown;libyuv 在
+// aarch64 上仍启用 Neon(mandatory),其他可选特性退化为软件实现。功能正常,
+// 仅性能略降(stage2 可改为转发到 libc 的真实 getauxval)。
+
+extern "C" unsigned long getauxval(unsigned long type) {
+  (void)type;
+  return 0;
+}
diff --git a/widget/openharmony/GfxInfo.cpp b/widget/openharmony/GfxInfo.cpp
