+// v257f: ResizeSurface — 主动推 surface 尺寸(物理 px)触发 nsWindow::Resize。
+// 2in1 自由窗键盘收起后 XComponent 布局恢复链可能断裂(收起后无
+// OnSurfaceChanged),Gecko 布局视口卡在键盘压缩值(深色 about:newtab 底部
+// 露默认背景 #F9F9FB 白带的根因,真机数值闭环 130+1312+161≈1600)。ArkTS
+// 侧用窗口矩形真值(系统层已恢复)调本接口,等价"导航后自愈"的 Resize 全链
+// 重算,免导航。参数:number width, number height(物理像素)。
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_ResizeSurface(int32_t aWidth, int32_t aHeight);
+
+napi_value ResizeSurface(napi_env env, napi_callback_info info) {
+    size_t argc = 2;
+    napi_value args[2];
+    napi_value thisArg;
+    napi_get_cb_info(env, info, &argc, args, &thisArg, nullptr);
+    if (argc < 2) {
+        napi_throw_type_error(env, nullptr, "参数缺失,期望 width + height(number)");
+        return nullptr;
+    }
+    int32_t width = 0, height = 0;
+    napi_get_value_int32(env, args[0], &width);
+    napi_get_value_int32(env, args[1], &height);
+    if (width <= 0 || height <= 0) {
+        napi_throw_type_error(env, nullptr, "resizeSurface 参数非法(<=0)");
+        return nullptr;
+    }
+    OH_LOG_INFO(LOG_APP, "ResizeSurface 调用 GeckoBridge_ResizeSurface %{public}dx%{public}d", width, height);
+    GeckoBridge_ResizeSurface(width, height);
+    napi_value result;
+    napi_get_null(env, &result);
+    return result;
+}
