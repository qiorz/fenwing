+// 获取 XComponent Surface 渲染尺寸(EGL swapchain 像素尺寸)
+// 返回 {width, height}。ArkTS 用此尺寸除以组件 vp 尺寸,算出鼠标坐标转换比值。
+// 根因(v56):OH_NativeXComponent_GetXComponentSize 返回的 Surface 尺寸(如 2091x1227)
+// 与 ArkUI vp 空间(1642x1094)和屏幕物理像素(3120x2080)都不同,是独立坐标系。
+// 鼠标坐标(vp)必须乘 (surfacePx/componentVp) 才能映射到 Gecko mBounds 空间。
+// v161: libxul 侧权威 Surface 尺寸查询(见 OHOSNativeWindowBridge.cpp)
+// 本 .so 与 libgeckoxcomp.so 为同二进制双副本,本地 gSurfaceWidth 原子
+// 只在 xcomp 副本被写入,读本地恒 0 —— 必须直查 libxul。
+// 声明必须带 visibility("default")(v151 教训:裸 extern 在
+// -fvisibility=hidden 下引用为 hidden,lld 拒绑共享库符号)。
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_GetSurfaceSize(int* aWidth, int* aHeight);
+
+napi_value GetSurfaceSize(napi_env env, napi_callback_info info) {
+    int w = 0, h = 0;
+    GeckoBridge_GetSurfaceSize(&w, &h);
+    if (w <= 0 || h <= 0) {
+        // libxul 尚未收到 SetSurfaceSize(启动极早期)时回退本地缓存
+        w = gSurfaceWidth.load(std::memory_order_relaxed);
+        h = gSurfaceHeight.load(std::memory_order_relaxed);
+    }
+    napi_value obj;
+    napi_create_object(env, &obj);
+    napi_value widthVal, heightVal;
+    napi_create_int32(env, w, &widthVal);
+    napi_create_int32(env, h, &heightVal);
+    napi_set_named_property(env, obj, "width", widthVal);
+    napi_set_named_property(env, obj, "height", heightVal);
+    return obj;
+}
