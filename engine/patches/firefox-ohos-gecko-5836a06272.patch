+// ============================================================================
+// 通用导航 Runnable(Reload / Stop / GoBack / GoForward / GoToIndex)
+// v88: 携带 mSessionId,导航操作针对指定标签
+// ============================================================================
+class OHOSNavActionRunnable : public mozilla::Runnable {
+ public:
+  enum Action { kReload, kStop, kGoBack, kGoForward, kGoToIndex };
+  explicit OHOSNavActionRunnable(Action aAction, int32_t aIndex = 0,
+                                const nsCString& aSessionId = "default"_ns)
+      : mozilla::Runnable("OHOSNavActionRunnable"),
+        mAction(aAction), mIndex(aIndex), mSessionId(aSessionId) {}
+
+  NS_IMETHOD Run() override {
+    nsCOMPtr<nsIWebNavigation> webNav = GetWebNavigationForSession(mSessionId);
+    if (!webNav) {
+      OHOS_LOG("[XRE] OHOSNavActionRunnable[%s]: webNav 未就绪\n",
+              mSessionId.get());
+      return NS_OK;
+    }
+    switch (mAction) {
+      case kReload:
+        webNav->Reload(nsIWebNavigation::LOAD_FLAGS_NONE);
+        OHOS_LOG("[XRE] OHOSNavAction[%s]: Reload\n", mSessionId.get());
+        break;
+      case kStop:
+        webNav->Stop(nsIWebNavigation::STOP_ALL);
+        OHOS_LOG("[XRE] OHOSNavAction[%s]: Stop\n", mSessionId.get());
+        break;
+      case kGoBack:
+        webNav->GoBack(false, false);
+        OHOS_LOG("[XRE] OHOSNavAction[%s]: GoBack\n", mSessionId.get());
+        break;
+      case kGoForward:
+        webNav->GoForward(false, false);
+        OHOS_LOG("[XRE] OHOSNavAction[%s]: GoForward\n", mSessionId.get());
+        break;
+      case kGoToIndex:
+        webNav->GotoIndex(mIndex, false);
+        OHOS_LOG("[XRE] OHOSNavAction[%s]: GoToIndex(%d)\n",
+                mSessionId.get(), mIndex);
+        break;
+    }
+    return NS_OK;
+  }
+
+ private:
+  Action mAction;
+  int32_t mIndex;
+  nsCString mSessionId;
+};
