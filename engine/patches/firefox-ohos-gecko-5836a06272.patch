+//*****************************************************************************
+// 文本输入(v57:OHOS IME NDK 集成)
+//*****************************************************************************
+// SetInputContext 由 Gecko IMEStateManager 在焦点变化时调用:
+//   - 用户点击 <input> → mIMEState.mEnabled = Enabled → 通知显示软键盘
+//   - 用户离开 <input> → mIMEState.mEnabled = Disabled → 通知隐藏软键盘
+// GeckoBridge_NotifyIMEState 在 libxul.so 中调用 geckoview.cpp 注册的
+// OHOS_ShowKeyboard/OHOS_HideKeyboard → OH_InputMethodProxy_Show/HideKeyboard
+//
+// IMEEnabled 枚举(mozilla/widget/IMEData.h):
+//   Enabled(可编辑,显示软键盘), Disabled(不可编辑), Password(密码框), Unknown
+// 映射到 OHOS IME_TEXT_INPUT_TYPE_*(供 geckoview.cpp OHOS_OnGetTextConfig 回填)
+static int32_t OHOS_MapIMEInputType(const InputContext& aContext) {
+  // 根据 HTML input type 选择 OHOS 输入类型
+  const nsString& htmlInputType = aContext.mHTMLInputType;
+  if (htmlInputType.EqualsLiteral("number") ||
+      htmlInputType.EqualsLiteral("tel")) {
+    return 2;  // IME_TEXT_INPUT_TYPE_NUMBER
+  }
+  if (htmlInputType.EqualsLiteral("email")) {
+    return 5;  // IME_TEXT_INPUT_TYPE_EMAIL_ADDRESS
+  }
+  if (htmlInputType.EqualsLiteral("url")) {
+    return 6;  // IME_TEXT_INPUT_TYPE_URL
+  }
+  if (htmlInputType.EqualsLiteral("password")) {
+    return 7;  // IME_TEXT_INPUT_TYPE_VISIBLE_PASSWORD
+  }
+  return 0;  // IME_TEXT_INPUT_TYPE_TEXT(默认)
+}
+
+void nsWindow::SetInputContext(const InputContext& aContext,
+                               const InputContextAction& aAction) {
+  mInputContext = aContext;
+  // 通知 OHOS IME 框架当前输入状态(显示/隐藏软键盘 + 输入类型)
+  // IMEEnabled 是 scoped enum,Enabled/Password 时显示软键盘
+  bool enabled = (aContext.mIMEState.mEnabled == mozilla::widget::IMEEnabled::Enabled ||
+                  aContext.mIMEState.mEnabled == mozilla::widget::IMEEnabled::Password);
+  // v168:程序性聚焦(页面 autofocus,如新标签页搜索框)不拉起软键盘 ——
+  // 它经 IME show → ArkTS TextInput 持焦,会把系统返回键全部消费在
+  // TextField(AceTextField "consumed backpressed event"),onBackPress 的
+  // 全屏退出/历史后退路由被挡死。仅用户手势(KEY/MOUSE/TOUCH/LONGPRESS/
+  // DURING_*)引发的聚焦才显示;隐藏通知不受影响。
+  if (enabled) {
+    switch (aAction.mCause) {
+      case mozilla::widget::InputContextAction::CAUSE_KEY:
+      case mozilla::widget::InputContextAction::CAUSE_MOUSE:
+      case mozilla::widget::InputContextAction::CAUSE_TOUCH:
+      case mozilla::widget::InputContextAction::CAUSE_LONGPRESS:
+      case mozilla::widget::InputContextAction::CAUSE_UNKNOWN_DURING_NON_KEYBOARD_INPUT:
+      case mozilla::widget::InputContextAction::CAUSE_UNKNOWN_DURING_KEYBOARD_INPUT:
+        break;  // 用户手势 → 照常显示
+      default:
+        enabled = false;  // 程序性聚焦 → 不拉键盘
+        break;
+    }
+  }
+  int32_t inputType = OHOS_MapIMEInputType(aContext);
+  OHOS_DiagLog("[XRE] nsWindow::SetInputContext enabled=%d mEnabled=%d cause=%d htmlType=%s → imeType=%d",
+          (int)enabled, (int)aContext.mIMEState.mEnabled, (int)aAction.mCause,
+          NS_ConvertUTF16toUTF8(aContext.mHTMLInputType).get(), inputType);
+  GeckoBridge_NotifyIMEState(enabled, inputType);
+}
+
+InputContext nsWindow::GetInputContext() { return mInputContext; }
+
+// IME 文本插入:由 GeckoBridge_InsertText → OHOSInsertTextRunnable 调用
+// 派发 WidgetContentCommandEvent(eContentCommandInsertText) 到 Gecko
+// Gecko 内部由 PresShell::HandleEvent 处理,将文本插入到 focused <input>/<textarea>
+// 参考 widget/android/GeckoEditableSupport.cpp:1011 的实现
+void nsWindow::OnInsertText(const char16_t* aText, size_t aLength) {
+  if (!aText || aLength == 0) return;
+
+  // char16_t → nsString(共享同一份 UTF-16 编码)
+  nsString text(reinterpret_cast<const char16_t*>(aText), aLength);
+  OHOS_DiagLog("[XRE] nsWindow::OnInsertText length=%zu text='%s'",
+          aLength, NS_ConvertUTF16toUTF8(text).get());
+
+  WidgetContentCommandEvent event(true, eContentCommandInsertText, this);
+  // mString 是 Maybe<nsString>,用 Some() 包装
+  event.mString = Some(text);
+  DispatchEvent(&event);
+}
+
+// IME 删除文本:由 GeckoBridge_DeleteBackward → OHOSDeleteTextRunnable 调用
+// aLength > 0: 向前删除(backspace,删除光标左侧字符)
+// aLength < 0: 向后删除(forward/delete,删除光标右侧字符)
+//
+// v101 根因修复:之前用 eContentCommandDelete,它要求 GetActiveEditor() 返回
+// 非 null(即 Gecko DOM 有焦点的 editable)。但原生 focusControl.requestFocus
+// (隐藏的 IME TextInput)会抢走焦点,导致 GetActiveEditor 返回 null,
+// eContentCommandDelete 被静默 no-op(IsCommandEnabled=false),删除无效。
+// 改为派发 WidgetKeyboardEvent(eKeyPress, NS_VK_BACK)(对齐 OnSendEnterKey):
+// keypress 由焦点 editor 的 keybinding 处理,不依赖 cmd_delete controller 的
+// enabled 状态,即使焦点状态不理想也能被 editor 的默认 backspace 处理逻辑消费。
+void nsWindow::OnDeleteBackward(int32_t aLength) {
+  OHOS_DiagLog("[XRE] nsWindow::OnDeleteBackward length=%d", aLength);
+  if (aLength == 0) return;
+
+  // 派发 eKeyPress(Backspace)事件,循环 |aLength| 次
+  // NS_VK_BACK = Backspace 键码(Gecko 标准),editor 收到后删除光标前字符
+  int32_t count = aLength > 0 ? aLength : -aLength;
+  for (int32_t i = 0; i < count; i++) {
+    WidgetKeyboardEvent event(true, eKeyPress, this);
+    event.mKeyCode = NS_VK_BACK;
+    DispatchEvent(&event);
+  }
+}
+
+// IME Enter 键:由 GeckoBridge_SendEnterKey → OHOSEnterKeyRunnable 调用
+// 派发 WidgetKeyboardEvent 序列到 Gecko
+// Gecko 内部由 PresShell 处理,触发表单提交/链接点击/换行等
+void nsWindow::OnSendEnterKey(int32_t aEnterKeyType) {
+  OHOS_DiagLog("[XRE] nsWindow::OnSendEnterKey type=%d", aEnterKeyType);
+
+  // v110 临时诊断(验证后移除):查 nsFocusManager 当前焦点,
+  //   区分「键事件没路由到 content」与「表单提交路径断裂」。
+  {
+    nsCOMPtr<nsIFocusManager> fm =
+        do_GetService("@mozilla.org/focus-manager;1");
+    if (fm) {
+      RefPtr<mozilla::dom::Element> focusedEl;
+      fm->GetFocusedElement(getter_AddRefs(focusedEl));
+      nsAutoString elTag;
+      nsAutoString elId;
+      if (focusedEl) {
+        focusedEl->NodeInfo()->NameAtom()->ToString(elTag);
+        nsAtom* idAtom = focusedEl->GetID();
+        if (idAtom) {
+          idAtom->ToString(elId);
+        }
+      } else {
+        elTag.AssignLiteral("null(无焦点元素)");
+      }
+      OHOS_DiagLog("[XRE] OnSendEnterKey focus: el=<%s id=%s>",
+              NS_ConvertUTF16toUTF8(elTag).get(),
+              NS_ConvertUTF16toUTF8(elId).get());
+    } else {
+      OHOS_DiagLog("[XRE] OnSendEnterKey focus: FocusManager 不可用");
+    }
+  }
+
+  // v110 修复:之前只发 eKeyPress,百度等站点的搜索提交/联想选择绑在
+  //   keydown 监听上,收不到事件,软键盘「完成」无法提交表单(v109 副发现)。
+  //   按 Gecko 标准派发完整 eKeyDown → eKeyPress → eKeyUp 序列
+  //   (对齐 widget/android GeckoEditableSupport 的合成键事件):
+  //   - keydown:触发页面 JS 的 keydown 监听(百度表单提交走这里)
+  //   - keypress:触发 Gecko 隐式表单提交(HTMLInputElement::MaybeSubmitForm)
+  //   - keydown 被页面 preventDefault 时跳过 keypress(对齐真实键盘行为,
+  //     避免页面 JS 提交 + Gecko 隐式提交双重触发)
+  // v140 修复:补 mKeyNameIndex/mCodeNameIndex/mLocation(复用 OnKeyEvent
+  //   的 OH_KEY_ENTER 转换结果)。此前三事件只有 mKeyCode/mCharCode,DOM 侧
+  //   KeyboardEvent.key 算出 "Unidentified",百度智能输入框(chat-textarea)
+  //   等现代站点 JS 判 e.key === 'Enter' 不命中 → Enter 提交完全失效
+  //   (真机实证:sogou 经典 input 靠 MaybeSubmitForm 隐式提交可工作,
+  //   baidu chat-textarea inline onkeydown 均未触发/JS 提交不命中)。
+  //   补齐后 DOM 事件 key='Enter'/code='Enter',与物理键盘路径(OnKeyEvent)
+  //   产出完全对齐。
+  const mozilla::KeyNameIndex enterKeyName =
+      ConvertOHOSKeyCodeToKeyNameIndex(OH_KEY_ENTER);
+  const mozilla::CodeNameIndex enterCodeName =
+      ConvertOHOSKeyCodeToCodeNameIndex(OH_KEY_ENTER);
+  const uint32_t enterLocation =
+      WidgetKeyboardEvent::ComputeLocationFromCodeValue(enterCodeName);
+
+  WidgetKeyboardEvent downEvent(true, eKeyDown, this);
+  downEvent.mKeyCode = NS_VK_RETURN;
+  downEvent.mCharCode = 0;
+  downEvent.mKeyNameIndex = enterKeyName;
+  downEvent.mCodeNameIndex = enterCodeName;
+  downEvent.mLocation = enterLocation;
+  nsEventStatus downStatus = DispatchEvent(&downEvent);
+  // v110 临时诊断(验证后移除):定位 keydown 是否到达页面/被消费
+  OHOS_DiagLog("[XRE] OnSendEnterKey keydown dispatched status=%d prevented=%d",
+          (int)downStatus, (int)downEvent.DefaultPrevented());
+
+  bool skipPress = downEvent.DefaultPrevented();
+  if (!skipPress) {
+    WidgetKeyboardEvent pressEvent(true, eKeyPress, this);
+    pressEvent.mKeyCode = NS_VK_RETURN;
+    pressEvent.mCharCode = '\n';
+    pressEvent.mKeyNameIndex = enterKeyName;
+    pressEvent.mCodeNameIndex = enterCodeName;
+    pressEvent.mLocation = enterLocation;
+    nsEventStatus pressStatus = DispatchEvent(&pressEvent);
+    OHOS_DiagLog("[XRE] OnSendEnterKey keypress dispatched status=%d prevented=%d",
+            (int)pressStatus, (int)pressEvent.DefaultPrevented());
+  } else {
+    OHOS_DiagLog("[XRE] OnSendEnterKey keypress skipped (keydown 被页面消费)");
+  }
+
+  WidgetKeyboardEvent upEvent(true, eKeyUp, this);
+  upEvent.mKeyCode = NS_VK_RETURN;
+  upEvent.mCharCode = 0;
+  upEvent.mKeyNameIndex = enterKeyName;
+  upEvent.mCodeNameIndex = enterCodeName;
+  upEvent.mLocation = enterLocation;
+  DispatchEvent(&upEvent);
+}
