+// ============================================================================
+// 文件日志辅助函数
+// ============================================================================
+// hilog 缓冲区在高频日志场景下会丢失日志,导致 XRE_main 返回值等关键信息
+// 无法被捕获。将关键日志同时写入文件,确保调试时能获取完整的执行轨迹。
+// 日志文件路径由 GeckoMainThread 在启动时设置(应用沙箱可写目录)。
+#include <cstdio>
+#include <cstdarg>
+#include <ctime>
+#include <cstdlib>  // v163: atoi(airweb-profiler-capture secs 解析)
+#include <cstdint>  // v163: intptr_t(profiler 定时落盘线程传参)
+#include <sys/syscall.h>
+#include <unistd.h>
+
+// 全局日志文件路径,由 GeckoMainThread 在启动时设置
+// 使用应用沙箱目录(/data/storage/el2/base/haps/entry/files/),应用有写权限
+static std::string gLogFilePath = "/data/storage/el2/base/haps/entry/files/gecko_debug.txt";
+
+// 获取线程 ID(跨平台兼容写法)
+static int GeckoGetTid() {
+    return static_cast<int>(syscall(SYS_gettid));
+}
+
+static void WriteLogFile(const char* fmt, ...) {
+    // v226(审计C5): 持久 FILE* + 互斥 + 节流 flush(对齐 OHOS_DiagLog 的
+    // v172 优化)。原实现每条 fopen+fflush+fclose(路径解析+inode+同步落盘),
+    // 24 个调用点含 Gecko 主线程/IME 高频路径。崩溃尾部 ≤250ms 丢失可接受。
+    static FILE* sLogFP = nullptr;
+    static std::mutex sLogMutex;
+    static int64_t sLastFlushMs = 0;
+
+    // 先格式化字符串到缓冲区,供文件和 hilog 共用
+    char logBuf[2048];
+    va_list args1;
+    va_start(args1, fmt);
+    vsnprintf(logBuf, sizeof(logBuf), fmt, args1);
+    va_end(args1);
+
+    std::lock_guard<std::mutex> lock(sLogMutex);
+    if (!sLogFP) {
+        sLogFP = fopen(gLogFilePath.c_str(), "a");
+        if (!sLogFP) {
+            // 主路径不可写,尝试备用路径
+            sLogFP = fopen("/data/local/tmp/airweb_gecko.txt", "a");
+        }
+        if (!sLogFP) {
+            // v113: 删除"文件成功也 OH_LOG 双写"(GTK 线移植工程 P3 实证死锁根因:
+            // hilogd 流控停读后 OH_LOG 在 UNIX datagram socket 上永久阻塞发送线程,
+            // WriteLogFile 的调用方含 Gecko 主线程/IME 高频路径,双写会把单条
+            // 日志成本翻倍并放大触达流控阈值的概率)。
+            // 现策略(Air 系列范式):文件优先,仅当两个文件路径都不可写时才上 hilog
+            // (此时日志已无其他出口,值得一搏),且降级为单条 ERROR。
+            OH_LOG_ERROR(LOG_APP, "WriteLogFile 全部路径不可写,日志落 hilog: %{public}s", logBuf);
+            return;
+        }
+    }
+    // 写入时间戳前缀
+    struct timespec ts;
+    clock_gettime(CLOCK_REALTIME, &ts);
+    struct tm tm_info;
+    localtime_r(&ts.tv_sec, &tm_info);
+    fprintf(sLogFP, "%02d-%02d %02d:%02d:%02d.%03ld ",
+            tm_info.tm_mon + 1, tm_info.tm_mday,
+            tm_info.tm_hour, tm_info.tm_min, tm_info.tm_sec,
+            ts.tv_nsec / 1000000);
+    // 写入日志内容
+    fprintf(sLogFP, "%s\n", logBuf);
+    struct timespec mono;
+    clock_gettime(CLOCK_MONOTONIC, &mono);
+    int64_t nowMs = (int64_t)mono.tv_sec * 1000 + mono.tv_nsec / 1000000;
+    if (nowMs - sLastFlushMs > 250) {
+        fflush(sLogFP);
+        sLastFlushMs = nowMs;
+    }
+}
