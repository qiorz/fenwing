+    int result = gBootstrap->XRE_main(argc, argv.data(), config);
+    WriteLogFile("[STEP7] XRE_main 返回, result=%d", result);
+    OH_LOG_INFO(LOG_APP, "XRE_main 返回, 结果: %{public}d", result);
