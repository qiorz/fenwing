+   * 空转(fastFind 无高亮无计数)③XUL findbar 已被本桥抑制。单进程下
+   * chrome 可同步直访 contentDocument,自建引擎:TreeWalker 全量匹配表
+   * + Range 选区高亮 + scrollTo 定位,天然带精确 n/N 计数。
+   */
+  const findState = { q: "", list: [], pos: -1, marks: [], styleEl: null };
+
+  function findReset() {
+    findState.q = "";
+    findState.list = [];
+    findState.pos = -1;
+    findState.marks = [];
+    findState.styleEl = null;
+  }
+
+  /** 清除页内高亮 mark(还原文本;导航后 DOM 已换代,安全跳过) */
+  function findClearMarks() {
+    const win = gBrowser.selectedBrowser?.contentWindow;
+    if (!win || !win.document) {
+      findReset();
+      return;
+    }
+    const doc = win.document;
+    for (const m of findState.marks) {
+      try {
+        if (m && m.parentNode) {
+          m.replaceWith(doc.createTextNode(m.textContent));
+        }
+      } catch (e) {}
+    }
+    findState.marks = [];
+    if (findState.styleEl && findState.styleEl.parentNode) {
+      try {
+        findState.styleEl.remove();
+      } catch (e) {}
+    }
+    findState.styleEl = null;
+    // v261: normalize 合并被 surroundContents 分裂的相邻文本节点——不合并时
+    // "Baidu" 还原成 "B"+"aidu" 两节点,跨节点查询词(q=ba)全量漏匹配
+    // (真机实证 q=b 2269 处后 q=ba total=0)。
+    try {
+      (doc.body || doc.documentElement).normalize();
+    } catch (e) {}
+  }
+
+  /** 收集全文档匹配 occurrence(文本节点内偏移,文档序) */
+  function findCollect(q, matchCase) {
+    const list = [];
+    const needle = matchCase ? q : q.toLowerCase();
+    const win = gBrowser.selectedBrowser.contentWindow;
+    if (!win || !win.document || !win.document.body) {
+      return list;
+    }
+    const doc = win.document;
+    const root = doc.documentElement || doc.body;
+    const walker = doc.createTreeWalker(root, win.NodeFilter.SHOW_TEXT);
+    while (walker.nextNode()) {
+      const node = walker.currentNode;
+      const raw = node.data || "";
+      const hay = matchCase ? raw : raw.toLowerCase();
+      let i = hay.indexOf(needle);
+      while (i !== -1) {
+        list.push({ node, index: i });
+        i = hay.indexOf(needle, i + needle.length);
+      }
+    }
+    return list;
+  }
+
+  /**
+   * 高亮全部匹配并定位当前项:mark 包裹(内容选区渲染在本移植不绘制,
+   * 真机实证;mark 是 DOM 直改,闭合可控)。当前项橙色,其余亮黄。
+   */
+  function findApplyMarks(q) {
+    const win = gBrowser.selectedBrowser.contentWindow;
+    if (!win || !win.document) {
+      return;
+    }
+    const doc = win.document;
+    // v252c: 倒序包裹——surroundContents 会分裂文本节点,先包后面的不破坏
+    // 前面 occurrence 的 node/offset(同节点多命中场景 16→10 掉包根因);
+    // 样式走 CSSOM 直设(setAttribute("style") 首轮实证 DOM 里在但不渲染)
+    // v261: mark 限量——大页面全量 surroundContents 耗时失控(百度页 q=b
+    // 2269 处 mark 实测超 2s,ChromeJSCall 同步超时→ArkTS 误降级旧路径
+    // 丢计数)。计数保持全量(findCollect 快),视觉 mark 前 200 处+当前项。
+    const FIND_MARK_LIMIT = 200;
+    let curMark = null;
+    for (let i = findState.list.length - 1; i >= 0; i--) {
+      if (i >= FIND_MARK_LIMIT && i !== findState.pos) {
+        continue;
+      }
+      const occ = findState.list[i];
+      if (!occ.node || !occ.node.parentNode) {
+        continue;
+      }
+      try {
+        const range = doc.createRange();
+        range.setStart(occ.node, occ.index);
+        range.setEnd(occ.node, occ.index + q.length);
+        const mark = doc.createElement("mark");
+        if (i === findState.pos) {
+          mark.style.backgroundColor = "#ff9500";
+          mark.style.color = "#15141a";
+          mark.style.borderRadius = "2px";
+          mark.style.fontWeight = "600";
+          curMark = mark;
+        } else {
+          mark.style.backgroundColor = "#ffe900";
+          mark.style.color = "#15141a";
+          mark.style.borderRadius = "2px";
+        }
+        range.surroundContents(mark);
+        findState.marks.push(mark);
+      } catch (e) {
+        // 跨节点/受保护节点:跳过该 occurrence
+      }
+    }
+    // 当前项滚动入视
+    if (curMark) {
+      try {
+        const rect = curMark.getBoundingClientRect();
+        if (rect && win.innerHeight) {
+          win.scrollTo(win.scrollX,
+            win.scrollY + rect.top - win.innerHeight * 0.3);
+        }
+      } catch (e) {}
+    }
+  }
+
+  function doFind(arg) {
+    if (!window.gBrowser) {
+      return "err:no-gbrowser";
+    }
+    const b = gBrowser.selectedBrowser;
+    if (!b) {
+      return "err:no-browser";
+    }
+    const q = String(arg.query || "");
+    try {
+      if (arg.cmd === "clear") {
+        findClearMarks();
+        findReset();
+        return "ok";
+      }
+      if (!q) {
+        findClearMarks();
+        findReset();
+        pushFindResultRaw(0, -1);
+        return "ok";
+      }
+      // 每动作全周期:清高亮 → (查询词变化时)重收集 → 计算 pos → 高亮
+      if (q !== findState.q) {
+        findClearMarks();
+        findState.q = q;
+        findState.list = findCollect(q, !!arg.matchCase);
+        findState.pos = findState.list.length > 0 ? 0 : -1;
+      } else {
+        findClearMarks();
+        const n = findState.list.length;
+        if (n > 0) {
+          if (arg.cmd === "prev") {
+            findState.pos = (findState.pos - 1 + n) % n;
+          } else {
+            // open(重复查询)与 next 同为前进
+            findState.pos = (findState.pos + 1) % n;
+          }
+        }
+      }
+      findApplyMarks(q);
+      pushFindResultRaw(findState.list.length, findState.pos);
+      dump(`[OHOS v252] find ${arg.cmd} q=${q} total=${findState.list.length} pos=${findState.pos} marks=${findState.marks.length} m0=${findState.marks[0] ? String(findState.marks[0].getAttribute("style")).slice(0, 24) : "none"}\n`);
+      return "ok";
+    } catch (e) {
+      dump(`${TAG} find(${arg.cmd}) 异常: ${e}\n`);
+      return "err:" + e;
+    }
+  }
+
+  function hookFindbar(fb) {
+    if (!fb || fb.__ohosFindHooked) {
+      return;
+    }
+    fb.__ohosFindHooked = true;
+    for (const m of ["startFind", "quickFind", "open", "openWithFindSelected"]) {
+      if (typeof fb[m] === "function") {
+        fb[m] = function () {
+          // 抑制 XUL findbar 打开,只通知 ArkTS(唯一查找 UI)
+          pushEnvelope("findbarOpen", {});
+          return undefined;
+        };
+      }
+    }
+    dump(`${TAG} findbar 已接管(${fb.id || "FindToolbar"})\n`);
+  }
+
+  function wireFindbar() {
+    if (!window.gBrowser || typeof gBrowser.getFindBar !== "function") {
+      return;
+    }
+    const origGet = gBrowser.getFindBar.bind(gBrowser);
+    gBrowser.getFindBar = function () {
+      const p = origGet();
+      if (p && typeof p.then === "function") {
+        return p.then(fb => {
+          hookFindbar(fb);
+          return fb;
+        });
+      }
+      hookFindbar(p);
+      return p;
+    };
+  }
+
+  /* ====================================================================
+   * [OHOS v252 P2] 隐形焦点陷阱拦截 — Ctrl+L / Ctrl+K.
+   * XUL urlbar 幽灵化后,chrome 快捷键仍会把焦点切给隐形 urlbar(用户
+   * 打字"消失")。chrome 级 keydown capture 拦截,转发 ArkTS 地址胶囊
+   * 进编辑态(方案 §3.1③ 第一级处置)。
+   * ==================================================================== */
+  function wireUrlbarHotkeys() {
+    window.addEventListener(
+      "keydown",
+      e => {
+        if (
+          e.ctrlKey &&
+          !e.altKey &&
+          !e.metaKey &&
+          (e.key === "l" || e.key === "L" || e.key === "k" || e.key === "K")
+        ) {
+          e.preventDefault();
+          e.stopPropagation();
+          pushEnvelope("urlbarFocus", {});
+        }
+      },
+      true
+    );
+  }
+
+  /* ====================================================================
+   * [OHOS v252 P4] 加载状态机(自 phone-chrome.js 迁入,全形态).
+   * 三路完成信号幂等汇合(v234 真机实证:nsBrowserStatusFilter 聚合把
+   * WINDOW STOP 挂到全部在途请求,挂起子资源把加载态拖死 28s):
+   *   ① 内容 DOMContentLoaded(capture) ② WINDOW STATE_STOP
+   *   ③ 15s 超时兜底
+   * → {type:"loadState",loading} 信封(ArkTS 底栏刷新/停止键真值源)。
+   * ==================================================================== */
+  const loadingMap = new WeakMap();
+  const loadTimers = new Map();
+
+  function browserLoading(browser, val) {
+    if (val !== undefined) {
+      loadingMap.set(browser, val);
+    }
+    return loadingMap.get(browser) === true;
+  }
+
+  function pushLoadState(loading) {
+    pushEnvelope("loadState", { loading });
+  }
+
+  function settleLoad(browser) {
+    browserLoading(browser, false);
+    const t = loadTimers.get(browser);
+    if (t) {
+      clearTimeout(t);
+      loadTimers.delete(browser);
+    }
+    if (window.gBrowser && browser === gBrowser.selectedBrowser) {
+      pushLoadState(false);
+    }
+  }
+
+  function armLoadTimer(browser) {
+    const old = loadTimers.get(browser);
+    if (old) {
+      clearTimeout(old);
+    }
+    loadTimers.set(browser, setTimeout(() => {
+      loadTimers.delete(browser);
+      if (browserLoading(browser)) {
+        dump("[OHOS v252] load 15s 超时兜底触发\n");
+        settleLoad(browser);
+      }
+    }, 15000));
+  }
+
+  function bindContentReady(browser) {
+    if (!browser) {
+      return;
+    }
+    browser.addEventListener(
+      "DOMContentLoaded",
+      () => {
+        if (browserLoading(browser)) {
+          settleLoad(browser);
+        }
+      },
+      true
+    );
+  }
+
+  const LoadPL = {
+    onStateChange(browser, webProgress, request, flags) {
+      if (flags & Ci.nsIWebProgressListener.STATE_IS_WINDOW) {
+        if (flags & Ci.nsIWebProgressListener.STATE_START) {
+          browserLoading(browser, true);
+          armLoadTimer(browser);
+          if (browser === gBrowser.selectedBrowser) {
+            pushLoadState(true);
+          }
+        } else if (flags & Ci.nsIWebProgressListener.STATE_STOP) {
+          if (browserLoading(browser)) {
+            settleLoad(browser);
+          }
+        }
+      }
+    },
+    onLocationChange(browser) {
+      // v252c: 导航换代 → 查找高亮/计数失效,清态(闭合 mark 还原在旧文档内跳过)
+      if (findState.q && browser === gBrowser.selectedBrowser) {
+        try {
+          findClearMarks();
+          findReset();
+        } catch (e) {}
+      }
+      // 选中新标签 → 同步一次加载态(切换瞬间 UI 真值)
+      if (
+        browser === gBrowser.selectedBrowser &&
+        typeof browser.webProgress?.isLoadingDocument === "boolean"
+      ) {
+        pushLoadState(!!browser.webProgress.isLoadingDocument);
+      }
+    },
+  };
+
+  window.OHOSChromeBridge = {
+    call(method, argJson) {
+      let arg = {};
+      try {
+        arg = argJson ? JSON.parse(argJson) : {};
+      } catch (e) {
+        return "err:bad-json";
+      }
+      switch (method) {
+        case "tabList":
+          return tabListJson();
+        case "command":
+          return doCommand(arg);
+        case "clearData":
+          return clearData(arg);
+        case "doorhanger":
+          return doorhangerRespond(arg);
+        case "find":
+          return doFind(arg);
+        case "pushTabState":
+          pushState();
+          return "ok";
+        default:
+          return "err:unknown-method";
+      }
+    },
+  };
+
+  // v251: 扩展安装进度推送(AMO 慢下载 ArkTS 横幅)。
+  // AddonManager InstallListener → Services.obs "airweb-addon-install"
+  // (JSON {phase,name,progress,maxProgress,error}) → C++ 观察者 → ArkTS。
+  // onDownloadProgress 高频,200ms 节流且末段(100%)放行。
+  let addonProgressLastPush = 0;
+  function pushAddonInstall(phase, install, error) {
+    try {
+      const name =
+        (install && install.name) ||
+        (install && install.sourceURI && install.sourceURI.host) ||
+        "";
+      const payload = {
+        phase,
+        name,
+        progress: install ? install.progress : -1,
+        maxProgress: install ? install.maxProgress : -1,
+      };
+      if (error !== undefined && error !== null) {
+        payload.error = String(error);
+      }
+      Services.obs.notifyObservers(
+        null,
+        "airweb-addon-install",
+        JSON.stringify(payload)
+      );
+    } catch (e) {
+      // 安装对象字段可能瞬态不完整,吞掉等下一事件(chrome JS 无弹窗)
+    }
+  }
+
+  function wireAddonInstallListener() {
+    let AddonManager;
+    try {
+      AddonManager = ChromeUtils.importESModule(
+        "resource://gre/modules/AddonManager.sys.mjs"
+      ).AddonManager;
+    } catch (e) {
+      dump(`${TAG} AddonManager 导入失败: ${e}\n`);
+      return;
+    }
+    AddonManager.addInstallListener({
+      onNewInstall(install) {
+        pushAddonInstall("started", install);
+      },
+      onDownloadStarted(install) {
+        pushAddonInstall("started", install);
+      },
+      onDownloadProgress(install) {
+        const now = Date.now();
+        const done =
+          install.maxProgress > 0 && install.progress >= install.maxProgress;
+        if (!done && now - addonProgressLastPush < 200) {
+          return;
+        }
+        addonProgressLastPush = now;
+        pushAddonInstall("downloading", install);
+      },
+      onDownloadEnded(install) {
+        pushAddonInstall("installing", install);
+      },
+      onInstallStarted(install) {
+        pushAddonInstall("installing", install);
+      },
+      onInstallEnded(install) {
+        pushAddonInstall("ended", install);
+      },
+      onDownloadFailed(install) {
+        pushAddonInstall("failed", install, install.error);
+      },
+      onInstallFailed(install) {
+        pushAddonInstall("failed", install, install.error);
+      },
+      onDownloadCancelled(install) {
+        pushAddonInstall("cancelled", install);
+      },
+      onInstallCancelled(install) {
+        pushAddonInstall("cancelled", install);
+      },
+    });
+    dump(`${TAG} AddonManager 安装监听已接线\n`);
+  }
+
+  // 标签状态推送接线(window load 后 gBrowser 就绪)
+  window.addEventListener("load", () => {
+    try {
+      wireAddonInstallListener();
+      wireDoorhanger();
+      wireFindbar();
+      wireUrlbarHotkeys();
+      if (!window.gBrowser) {
+        return;
+      }
+      const tc = gBrowser.tabContainer;
+      tc.addEventListener("TabOpen", schedulePush);
+      tc.addEventListener("TabClose", schedulePush);
+      tc.addEventListener("TabSelect", schedulePush);
+      tc.addEventListener("TabAttrModified", schedulePush);
+      // v251b: 选中标签 LocationChange → 去抖推送。背景:C++ OHOSProgressListener
+      // 对新标签存在挂接竞态(about:home 瞬时加载,LocationChange 先于监听器
+      // 补挂 → ArkTS 地址胶囊/首页面板永远停留在旧标签 URL,真机实证)。
+      // chrome JS 侧 tabsProgressListener 无此竞态,推送通道即 URL 同步兜底。
+      // v252: 同一 listener 挂载加载状态机(loadState 信封,全形态)。
+      gBrowser.addTabsProgressListener({
+        onLocationChange(aBrowser, aWebProgress, aRequest, aLocationURI) {
+          // v265: 导航即失效该 URL 的 favicon 缓存与重试计数——活载会把
+          // 图标写进 Places,清掉空串毒化让下一推送按新库重解析(重启后
+          // 历史标签图标只认"激活过"的死局由此打开)。
+          try {
+            const u = aLocationURI && aLocationURI.spec;
+            if (u && u.startsWith("http")) {
+              faviconCache.delete(u);
+              faviconMisses.delete(u);
+            }
+          } catch (e) {}
+          if (aBrowser === gBrowser.selectedBrowser) {
+            schedulePush();
+          }
+          LoadPL.onLocationChange(aBrowser, aWebProgress, aRequest, aLocationURI);
+        },
+      });
+      gBrowser.addTabsProgressListener(LoadPL);
+      tc.addEventListener("TabOpen", e => {
+        bindContentReady(e.target.linkedBrowser);
+      });
+      // 加载状态机播种:存量标签挂 DOMContentLoaded;在途加载武装超时
+      try {
+        for (const tab of gBrowser.tabs) {
+          const b = tab.linkedBrowser;
+          bindContentReady(b);
+          if (b?.webProgress?.isLoadingDocument) {
+            loadingMap.set(b, true);
+            armLoadTimer(b);
+          }
+        }
+      } catch (e) {}
+      schedulePush(); // 初次推送(含会话恢复的存量标签)
+      // v268: 启动/会话恢复完成后全量刷后台节流——恢复出的背景标签在首次
+      // select 前可能全部 docShell 激活(v265 动画页 493% CPU 实案同族),
+      // 延迟一拍等恢复落停后裁决(选中标签恒激活,其余失活)。
+      setTimeout(() => {
+        try {
+          for (const t of gBrowser.tabs) {
+            t.linkedBrowser.docShellIsActive = (t === gBrowser.selectedTab);
+          }
+        } catch (e) {}
+      }, 3000);
+      dump(`${TAG} 已接线(全形态;doorhanger/find/热键/加载态)\n`);
+      // v260b 冷启主页种子:单标签 about:blank 且非 pending 恢复在途时装载
+      // 主页。背景:本移植 browser.xhtml 窗口由 defaultChromeURI 创建,无
+      // window arguments,上游浏览器的主页装载链(BrowserStartup→
+      // loadOneOrMoreURIs)不跑——历史上该空白被 NewTab 预加载 browser 的
+      // Firefox Home"冒充"覆盖,禁用预加载(pref browser.newtab.preload=
+      // false)后空白暴露。种子对 -U 流无害:显式 URI 的待补发链遇非目标
+      // urlChange 会就绪补射,最终收敛到 -U 目标。
+      // v263:盲定时 2500ms 与慢设备会话恢复竞态——恢复链尚未把选中标签
+      // 装载到目标 URI(如 about:downloads)时种子先把主页种进去,表象
+      // "恢复后呈现起始页"。改通知驱动:将恢复(startup.page>=3 或
+      // resume_from_crash)时等 sessionstore-windows-restored(有会话恢复
+      // 完成/无会话可恢复两分支均发)后 1500ms 再评估,15s 长超时兜底;
+      // 不恢复时维持 2500ms 旧路径。
+      let seeded = false;
+      const trySeed = () => {
+        if (seeded) {
+          return;
+        }
+        try {
+          const b = gBrowser.selectedBrowser;
+          if (
+            gBrowser.tabs.length === 1 &&
+            !gBrowser.selectedTab.hasAttribute("pending") &&
+            b.currentURI.spec === "about:blank"
+          ) {
+            seeded = true;
+            b.loadURI(homePageURI(), {
+              triggeringPrincipal:
+                Services.scriptSecurityManager.getSystemPrincipal(),
+            });
+          }
+        } catch (e) {
+          dump(`${TAG} 主页种子异常: ${e}\n`);
+        }
+      };
+      const willRestore =
+        Services.prefs.getIntPref("browser.startup.page", 1) >= 3 ||
+        Services.prefs.getBoolPref(
+          "browser.sessionstore.resume_from_crash",
+          false
+        );
+      if (willRestore) {
+        Services.obs.addObserver(
+          {
+            observe() {
+              setTimeout(trySeed, 1500);
+            },
+          },
+          "sessionstore-windows-restored"
+        );
+        setTimeout(trySeed, 15000);
+      } else {
+        setTimeout(trySeed, 2500);
+      }
+    } catch (e) {
+      dump(`${TAG} init 失败: ${e}\n`);
+    }
+  });
+})();
