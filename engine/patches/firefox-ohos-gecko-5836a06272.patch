+
+// v100: OHOS 系统剪贴板实现(替代 HeadlessClipboard)
+//
+// 数据流:
+//   复制:SetNativeClipboardData
+//     → OH_Pasteboard_Create
+//     → OH_UdsPlainText_Create + OH_UdsPlainText_SetContent(utf8)
+//     → OH_UdmfRecord_Create + OH_UdmfRecord_AddPlainText
+//     → OH_UdmfData_Create + OH_UdmfData_AddRecord
+//     → OH_Pasteboard_SetData
+//     → 逆序 Destroy
+//   粘贴:GetNativeClipboardData
+//     → OH_Pasteboard_GetData(&status)(需 READ_PASTEBOARD 权限)
+//     → OH_UdmfData_GetPrimaryPlainText → OH_UdsPlainText_GetContent
+//     → strdup 到 nsCString(GetContent 返回 borrowed 指针,Destroy 前必须拷出)
+//     → Destroy
+//
+// 链接说明:
+//   OHOS pasteboard/udmf 头文件没有 __attribute__((visibility("default"))),
+//   而 Gecko 默认 -fvisibility=hidden(gcc_hidden.h 强制 include),直接 include
+//   这些头文件会让符号在编译单元内被标记 hidden,链接报 "undefined hidden symbol"。
+//   解决:不用 SDK 头文件,改用 dlopen + dlsym 在运行时解析函数指针。
+//   这避免了编译期可见性问题,也避免 libxul.so 对 pasteboard/udmf 的 NEEDED
+//   硬依赖(运行时找不到库只是剪贴板不可用,不影响内核加载)。
+//
+// OHOS pasteboard 写入不需要权限;读取需要 ohos.permission.READ_PASTEBOARD,
+// 无权限时 status==ERR_PERMISSION_ERROR(201),静默返回空。
+
+#include "OHOSDebug.h"
+#include "OHOSClipboard.h"
+
+#include <cstdint>  // uintptr_t(v150 哨兵指针拦截)
+#include <cstdio>
+#include <dlfcn.h>  // dlopen/dlsym
+
+#include "mozilla/ScopeExit.h"
+#include "nsComponentManagerUtils.h"
+#include "nsCOMPtr.h"
+#include "nsISupportsPrimitives.h"
+#include "nsString.h"
+#include "nsThreadUtils.h"
+
+namespace mozilla {
+namespace widget {
+
+// OHOS pasteboard/udmf 的不透明句柄类型(实际是 void* 别名)
+using OH_Pasteboard = void;
+using OH_UdmfData = void;
+using OH_UdmfRecord = void;
+using OH_UdsPlainText = void;
+
+// OHOS plain-text 的 UTD 类型标识(用于 HasType 查询)
+static const char* kOHOSPlainTextType = "general.plain-text";
+
+// ============================================================================
+// 函数指针类型定义(对照 OHOS SDK 头文件签名)
+// ============================================================================
+using FnOH_Pasteboard_Create = OH_Pasteboard* (*)();
+using FnOH_Pasteboard_Destroy = void (*)(OH_Pasteboard*);
+using FnOH_Pasteboard_SetData = int (*)(OH_Pasteboard*, OH_UdmfData*);
+using FnOH_Pasteboard_GetData = OH_UdmfData* (*)(OH_Pasteboard*, int*);
+using FnOH_Pasteboard_ClearData = int (*)(OH_Pasteboard*);
+using FnOH_Pasteboard_HasType = bool (*)(OH_Pasteboard*, const char*);
+
+using FnOH_UdmfData_Create = OH_UdmfData* (*)();
+using FnOH_UdmfData_Destroy = void (*)(OH_UdmfData*);
+using FnOH_UdmfData_AddRecord = int (*)(OH_UdmfData*, OH_UdmfRecord*);
+using FnOH_UdmfData_GetPrimaryPlainText = int (*)(OH_UdmfData*, OH_UdsPlainText*);
+// v135: 新增——读路径必须先用 HasType 探测,否则系统剪贴板里没有 plain-text
+// 记录时,OH_Pasteboard_GetData 仍会返回一个"非空但内部为空"的 UdmfData,
+// 直接喂给 GetPrimaryPlainText 会解引用 NULL+8 成员崩溃(SIGSEGV @0x9)。
+using FnOH_UdmfData_HasType = bool (*)(OH_UdmfData*, const char*);
+using FnOH_UdmfData_GetRecordCount = int (*)(OH_UdmfData*);
+
+using FnOH_UdmfRecord_Create = OH_UdmfRecord* (*)();
+using FnOH_UdmfRecord_Destroy = void (*)(OH_UdmfRecord*);
+using FnOH_UdmfRecord_AddPlainText = int (*)(OH_UdmfRecord*, OH_UdsPlainText*);
+
+using FnOH_UdsPlainText_Create = OH_UdsPlainText* (*)();
+using FnOH_UdsPlainText_Destroy = void (*)(OH_UdsPlainText*);
+using FnOH_UdsPlainText_SetContent = int (*)(OH_UdsPlainText*, const char*);
+using FnOH_UdsPlainText_GetContent = const char* (*)(OH_UdsPlainText*);
+
+// ============================================================================
+// 运行时库加载:dlopen libpasteboard.so + libudmf.so 一次,缓存函数指针。
+// 首次调用剪贴板操作时加载;加载失败则所有剪贴板操作降级为空操作。
+// ============================================================================
+struct OHOSClipboardLibs {
+  void* pasteboardLib = nullptr;  // libpasteboard.so
+  void* udmfLib = nullptr;        // libudmf.so
+  // pasteboard
+  FnOH_Pasteboard_Create create = nullptr;
+  FnOH_Pasteboard_Destroy destroy = nullptr;
+  FnOH_Pasteboard_SetData setData = nullptr;
+  FnOH_Pasteboard_GetData getData = nullptr;
+  FnOH_Pasteboard_ClearData clearData = nullptr;
+  FnOH_Pasteboard_HasType hasType = nullptr;
+  // udmf data
+  FnOH_UdmfData_Create dataCreate = nullptr;
+  FnOH_UdmfData_Destroy dataDestroy = nullptr;
+  FnOH_UdmfData_AddRecord dataAddRecord = nullptr;
+  FnOH_UdmfData_GetPrimaryPlainText dataGetPrimaryPlainText = nullptr;
+  // v135: 读路径防御性探测——避免对内部为空的 UdmfData 调用 GetPrimaryPlainText
+  FnOH_UdmfData_HasType dataHasType = nullptr;
+  FnOH_UdmfData_GetRecordCount dataGetRecordCount = nullptr;
+  // udmf record
+  FnOH_UdmfRecord_Create recordCreate = nullptr;
+  FnOH_UdmfRecord_Destroy recordDestroy = nullptr;
+  FnOH_UdmfRecord_AddPlainText recordAddPlainText = nullptr;
+  // uds plaintext
+  FnOH_UdsPlainText_Create ptCreate = nullptr;
+  FnOH_UdsPlainText_Destroy ptDestroy = nullptr;
+  FnOH_UdsPlainText_SetContent ptSetContent = nullptr;
+  FnOH_UdsPlainText_GetContent ptGetContent = nullptr;
+  bool loaded = false;  // 是否已尝试加载(成功或失败均置 true)
+};
+
+static OHOSClipboardLibs gLibs;
+
+template <typename T>
+static void Resolve(void* lib, const char* name, T* fnPtr) {
+  *fnPtr = reinterpret_cast<T>(dlsym(lib, name));
+}
+
+// 加载 OHOS pasteboard + udmf 库并解析所有需要的函数指针。
+// 成功加载所有符号返回 true;任何一步失败返回 false(后续剪贴板操作降级)。
+static bool EnsureLibsLoaded() {
+  if (gLibs.loaded) {
+    return gLibs.pasteboardLib != nullptr && gLibs.udmfLib != nullptr;
+  }
+  gLibs.loaded = true;
+
+  // 先加载 udmf(pasteboard 内部依赖 udmf 的符号)
+  gLibs.udmfLib = dlopen("libudmf.so", RTLD_NOW | RTLD_GLOBAL);
+  if (!gLibs.udmfLib) {
+    OHOS_LOG("[XRE] OHOSClipboard: dlopen libudmf.so 失败: %s\n", dlerror());
+    return false;
+  }
+  Resolve(gLibs.udmfLib, "OH_UdmfData_Create", &gLibs.dataCreate);
+  Resolve(gLibs.udmfLib, "OH_UdmfData_Destroy", &gLibs.dataDestroy);
+  Resolve(gLibs.udmfLib, "OH_UdmfData_AddRecord", &gLibs.dataAddRecord);
+  Resolve(gLibs.udmfLib, "OH_UdmfData_GetPrimaryPlainText",
+          &gLibs.dataGetPrimaryPlainText);
+  Resolve(gLibs.udmfLib, "OH_UdmfData_HasType", &gLibs.dataHasType);
+  Resolve(gLibs.udmfLib, "OH_UdmfData_GetRecordCount",
+          &gLibs.dataGetRecordCount);
+  Resolve(gLibs.udmfLib, "OH_UdmfRecord_Create", &gLibs.recordCreate);
+  Resolve(gLibs.udmfLib, "OH_UdmfRecord_Destroy", &gLibs.recordDestroy);
+  Resolve(gLibs.udmfLib, "OH_UdmfRecord_AddPlainText", &gLibs.recordAddPlainText);
+  Resolve(gLibs.udmfLib, "OH_UdsPlainText_Create", &gLibs.ptCreate);
+  Resolve(gLibs.udmfLib, "OH_UdsPlainText_Destroy", &gLibs.ptDestroy);
+  Resolve(gLibs.udmfLib, "OH_UdsPlainText_SetContent", &gLibs.ptSetContent);
+  Resolve(gLibs.udmfLib, "OH_UdsPlainText_GetContent", &gLibs.ptGetContent);
+
+  // 再加载 pasteboard
+  gLibs.pasteboardLib = dlopen("libpasteboard.so", RTLD_NOW | RTLD_GLOBAL);
+  if (!gLibs.pasteboardLib) {
+    OHOS_LOG("[XRE] OHOSClipboard: dlopen libpasteboard.so 失败: %s\n",
+            dlerror());
+    return false;
+  }
+  Resolve(gLibs.pasteboardLib, "OH_Pasteboard_Create", &gLibs.create);
+  Resolve(gLibs.pasteboardLib, "OH_Pasteboard_Destroy", &gLibs.destroy);
+  Resolve(gLibs.pasteboardLib, "OH_Pasteboard_SetData", &gLibs.setData);
+  Resolve(gLibs.pasteboardLib, "OH_Pasteboard_GetData", &gLibs.getData);
+  Resolve(gLibs.pasteboardLib, "OH_Pasteboard_ClearData", &gLibs.clearData);
+  Resolve(gLibs.pasteboardLib, "OH_Pasteboard_HasType", &gLibs.hasType);
+
+  // v135: 校验所有必需符号都解析成功。任何一个缺失(库版本不匹配/未来 SDK
+  // 变动)都降级为剪贴板不可用,绝不在运行时调用 NULL 函数指针导致崩溃。
+  const bool allResolved =
+      gLibs.create && gLibs.destroy && gLibs.setData && gLibs.getData &&
+      gLibs.clearData && gLibs.hasType && gLibs.dataCreate &&
+      gLibs.dataDestroy && gLibs.dataAddRecord &&
+      gLibs.dataGetPrimaryPlainText && gLibs.dataHasType &&
+      gLibs.dataGetRecordCount && gLibs.recordCreate && gLibs.recordDestroy &&
+      gLibs.recordAddPlainText && gLibs.ptCreate && gLibs.ptDestroy &&
+      gLibs.ptSetContent && gLibs.ptGetContent;
+  if (!allResolved) {
+    OHOS_LOG("[XRE] OHOSClipboard: 必需符号解析不完整,剪贴板降级不可用\n");
+    return false;
+  }
+
+  OHOS_LOG("[XRE] OHOSClipboard: 库加载成功 pasteboard=%p udmf=%p\n",
+          (void*)gLibs.pasteboardLib, (void*)gLibs.udmfLib);
+  return true;
+}
+
+OHOSClipboard::OHOSClipboard()
+    : nsBaseClipboard(mozilla::dom::ClipboardCapabilities(
+          true /* supportsSelectionClipboard */,
+          true /* supportsFindClipboard */,
+          true /* supportsSelectionCache */)) {}
+
+NS_IMPL_ISUPPORTS_INHERITED0(OHOSClipboard, nsBaseClipboard)
+
+NS_IMETHODIMP
+OHOSClipboard::SetNativeClipboardData(nsITransferable* aTransferable,
+                                      ClipboardType aWhichClipboard) {
+  MOZ_DIAGNOSTIC_ASSERT(aTransferable);
+  MOZ_DIAGNOSTIC_ASSERT(
+      nsIClipboard::IsClipboardTypeSupported(aWhichClipboard));
+
+  // 先清空,再写入新数据
+  EmptyNativeClipboardData(aWhichClipboard);
+
+  if (!EnsureLibsLoaded()) {
+    return NS_ERROR_NOT_AVAILABLE;
+  }
+
+  // 仅处理 text/plain(HTML 可后续扩展)
+  nsTArray<nsCString> flavors;
+  nsresult rv = aTransferable->FlavorsTransferableCanExport(flavors);
+  if (NS_FAILED(rv)) {
+    return rv;
+  }
+
+  nsAutoString utf16string;
+  bool gotText = false;
+  for (const auto& flavor : flavors) {
+    if (!flavor.EqualsLiteral(kTextMime) && !flavor.EqualsLiteral(kHTMLMime)) {
+      continue;
+    }
+    nsCOMPtr<nsISupports> data;
+    rv = aTransferable->GetTransferData(flavor.get(), getter_AddRefs(data));
+    if (NS_FAILED(rv)) {
+      continue;
+    }
+    nsCOMPtr<nsISupportsString> wideString = do_QueryInterface(data);
+    if (!wideString) {
+      continue;
+    }
+    wideString->GetData(utf16string);
+    gotText = true;
+    break;
+  }
+
+  if (!gotText) {
+    return NS_OK;
+  }
+
+  NS_ConvertUTF16toUTF8 utf8text(utf16string);
+
+  OH_Pasteboard* pb = gLibs.create();
+  if (!pb) {
+    OHOS_LOG("[XRE] OHOSClipboard: OH_Pasteboard_Create 失败\n");
+    return NS_ERROR_FAILURE;
+  }
+  auto pbGuard = MakeScopeExit([pb] { gLibs.destroy(pb); });
+
+  OH_UdsPlainText* pt = gLibs.ptCreate();
+  if (!pt) {
+    return NS_ERROR_FAILURE;
+  }
+  auto ptGuard = MakeScopeExit([pt] { gLibs.ptDestroy(pt); });
+
+  if (gLibs.ptSetContent(pt, utf8text.get()) != 0) {
+    OHOS_LOG("[XRE] OHOSClipboard: OH_UdsPlainText_SetContent 失败\n");
+    return NS_ERROR_FAILURE;
+  }
+
+  OH_UdmfRecord* rec = gLibs.recordCreate();
+  if (!rec) {
+    return NS_ERROR_FAILURE;
+  }
+  auto recGuard = MakeScopeExit([rec] { gLibs.recordDestroy(rec); });
+
+  if (gLibs.recordAddPlainText(rec, pt) != 0) {
+    OHOS_LOG("[XRE] OHOSClipboard: OH_UdmfRecord_AddPlainText 失败\n");
+    return NS_ERROR_FAILURE;
+  }
+
+  OH_UdmfData* data = gLibs.dataCreate();
+  if (!data) {
+    return NS_ERROR_FAILURE;
+  }
+  auto dataGuard = MakeScopeExit([data] { gLibs.dataDestroy(data); });
+
+  if (gLibs.dataAddRecord(data, rec) != 0) {
+    OHOS_LOG("[XRE] OHOSClipboard: OH_UdmfData_AddRecord 失败\n");
+    return NS_ERROR_FAILURE;
+  }
+
+  int status = gLibs.setData(pb, data);
+  if (status != 0) {  // ERR_OK == 0
+    OHOS_LOG("[XRE] OHOSClipboard: OH_Pasteboard_SetData 失败 status=%d\n",
+            status);
+    return NS_ERROR_FAILURE;
+  }
+
+  mSequenceNumber++;
+  OHOS_LOG("[XRE] OHOSClipboard: 复制成功 len=%zu\n", utf8text.Length());
+  return NS_OK;
+}
+
+mozilla::Result<nsCOMPtr<nsISupports>, nsresult>
+OHOSClipboard::GetNativeClipboardData(const nsACString& aFlavor,
+                                      ClipboardType aWhichClipboard) {
+  MOZ_DIAGNOSTIC_ASSERT(
+      nsIClipboard::IsClipboardTypeSupported(aWhichClipboard));
+
+  if (!aFlavor.EqualsLiteral(kTextMime)) {
+    return nsCOMPtr<nsISupports>{};
+  }
+
+  if (!EnsureLibsLoaded()) {
+    return nsCOMPtr<nsISupports>{};
+  }
+
+  OH_Pasteboard* pb = gLibs.create();
+  if (!pb) {
+    return nsCOMPtr<nsISupports>{};
+  }
+  auto pbGuard = MakeScopeExit([pb] { gLibs.destroy(pb); });
+
+  // v149 第一道防线(pasteboard 级预检):剪贴板不含 plain-text 时直接返回,
+  // 根本不调 OH_Pasteboard_GetData。入参是 pb 而非 UdmfData,不触及 impl
+  // 解引用,绝对安全。v135 的 UdmfData 级 HasType 探测已被真机崩溃栈击穿
+  // (见下方第二道防线注释),必须前置 pb 级过滤。
+  if (!gLibs.hasType(pb, kOHOSPlainTextType)) {
+    return nsCOMPtr<nsISupports>{};
+  }
+
+  // 读取系统剪贴板(需 READ_PASTEBOARD 权限,无权限 status==201)
+  int status = 0;
+  OH_UdmfData* data = gLibs.getData(pb, &status);
+  // v150 第三形态拦截(SIGSEGV @0x1,真机 2026-08-12 12:32 栈实证):
+  // OH_Pasteboard_GetData 除 NULL/退化对象外,还会返回小整数哨兵
+  // (实测 (void*)0x1 且 status==0)——hasType(pb) 与 GetData 之间剪贴板
+  // 被清空的竞态下,底层 IPC 把错误码强转成指针。0x1 非 NULL 亦非有效映射:
+  // v149 的 impl 探测读 *(void**)0x1 当场崩(栈顶即本文件 :367),
+  // dataGuard 的 dataDestroy(0x1) 同样会崩。
+  // 防御:任何 < PAGE_SIZE(0x1000) 的"指针"都不可能是有效堆对象(NULL 也
+  // 被该条件涵盖),必须在 dataGuard 建立与任何解引用之前拦截;哨兵绝不可
+  // 喂给 dataDestroy。
+  if (reinterpret_cast<uintptr_t>(data) < 0x1000 || status != 0) {
+    if (status == 201) {  // ERR_PERMISSION_ERROR
+      OHOS_LOG("[XRE] OHOSClipboard: 读取无权限(READ_PASTEBOARD 未授权)\n");
+    } else {
+      OHOS_LOG("[XRE] OHOSClipboard: GetData 无效返回 data=%p status=%d,降级\n",
+              data, status);
+    }
+    return nsCOMPtr<nsISupports>{};
+  }
+  // v135: getData 返回的 UdmfData 由调用方负责销毁,之前漏销毁(内存泄漏)。
+  // 用 dataGuard 保证无论后续走哪条返回路径都回收。
+  auto dataGuard = MakeScopeExit([data] { gLibs.dataDestroy(data); });
+
+  // v149 第二道防线(impl 空指针探测,根治 SIGSEGV @0x9 复发):
+  // v135 以为 OH_UdmfData_HasType 可以安全探测退化数据,真机崩溃栈
+  // (2026-08-12 11:49, tid 主线程)证伪:崩溃就在 libudmf
+  // OH_UdmfData_HasType+48 内部,addr 0x9 = NULL impl + 8。
+  // 触发链:点击工具栏按钮(下载 ↓ 等)→ 地址栏 blur → JS focus/blur
+  // 监听器粘贴可用性查询 → nsBaseClipboard::GetData → 本函数;
+  // hasType(pb) 与 GetData 之间存在剪贴板被清空/替换的竞态窗口,
+  // GetData 会返回 impl 为 NULL 的退化 UdmfData,此后任何 UDMF API
+  // (HasType/GetRecordCount/GetPrimaryPlainText)调用即崩。
+  // OHOS NDK 不透明句柄实为 { impl*, ... } 结构,impl 位于首字
+  // (与崩溃地址 0x9 = impl 偏移 +8 吻合),探测首字即可识别退化对象。
+  if (*reinterpret_cast<void* const*>(data) == nullptr) {
+    OHOS_LOG("[XRE] OHOSClipboard: UdmfData impl 为空,降级返回\n");
+    return nsCOMPtr<nsISupports>{};
+  }
+
+  // v135 根因修复(崩溃 SIGSEGV @0x9):
+  // OH_Pasteboard_GetData 即便 status==0 也可能返回一个"非空但内部记录为
+  // 空/非 plain-text"的 UdmfData(例如剪贴板当前存的是 HTML/URI/pixelMap,
+  // 或刚被 Clear 后的瞬态)。直接对其调用 OH_UdmfData_GetPrimaryPlainText
+  // 会解引用内部的 NULL primary-record 成员(偏移 +8)→ SIGSEGV。
+  // 修复:调用前必须确认 data 里确实存在 "general.plain-text" 类型且至少有
+  // 一条记录;否则跳过 GetPrimaryPlainText,优雅降级返回空。
+  if (!gLibs.dataHasType(data, kOHOSPlainTextType)) {
+    return nsCOMPtr<nsISupports>{};
+  }
+  if (gLibs.dataGetRecordCount(data) <= 0) {
+    return nsCOMPtr<nsISupports>{};
+  }
+
+  OH_UdsPlainText* pt = gLibs.ptCreate();
+  if (!pt) {
+    return nsCOMPtr<nsISupports>{};
+  }
+  auto ptGuard = MakeScopeExit([pt] { gLibs.ptDestroy(pt); });
+
+  // 即使 HasType 通过,GetPrimaryPlainText 仍可能因内部竞态返回非 0;
+  // 此时降级为空结果,不再继续访问 pt 内容。
+  if (gLibs.dataGetPrimaryPlainText(data, pt) != 0) {
+    return nsCOMPtr<nsISupports>{};
+  }
+
+  // GetContent 返回 borrowed 指针,pt Destroy 前必须拷出
+  const char* raw = gLibs.ptGetContent(pt);
+  if (!raw) {
+    return nsCOMPtr<nsISupports>{};
+  }
+  nsAutoString text = NS_ConvertUTF8toUTF16(raw);
+
+  nsresult rv;
+  nsCOMPtr<nsISupportsString> dataWrapper =
+      do_CreateInstance(NS_SUPPORTS_STRING_CONTRACTID, &rv);
+  if (NS_WARN_IF(NS_FAILED(rv))) {
+    return nsCOMPtr<nsISupports>{};
+  }
+  rv = dataWrapper->SetData(text);
+  if (NS_WARN_IF(NS_FAILED(rv))) {
+    return nsCOMPtr<nsISupports>{};
+  }
+
+  return nsCOMPtr<nsISupports>(std::move(dataWrapper));
+}
+
+nsresult OHOSClipboard::EmptyNativeClipboardData(
+    ClipboardType aWhichClipboard) {
+  MOZ_DIAGNOSTIC_ASSERT(
+      nsIClipboard::IsClipboardTypeSupported(aWhichClipboard));
+
+  if (!EnsureLibsLoaded()) {
+    return NS_ERROR_NOT_AVAILABLE;
+  }
+
+  OH_Pasteboard* pb = gLibs.create();
+  if (!pb) {
+    return NS_ERROR_FAILURE;
+  }
+  auto pbGuard = MakeScopeExit([pb] { gLibs.destroy(pb); });
+
+  int status = gLibs.clearData(pb);
+  mSequenceNumber++;
+  return status == 0 ? NS_OK : NS_ERROR_FAILURE;
+}
+
+mozilla::Result<int32_t, nsresult>
+OHOSClipboard::GetNativeClipboardSequenceNumber(ClipboardType aWhichClipboard) {
+  MOZ_DIAGNOSTIC_ASSERT(
+      nsIClipboard::IsClipboardTypeSupported(aWhichClipboard));
+  return mSequenceNumber;
+}
+
+mozilla::Result<bool, nsresult>
+OHOSClipboard::HasNativeClipboardDataMatchingFlavors(
+    const nsTArray<nsCString>& aFlavorList, ClipboardType aWhichClipboard) {
+  MOZ_DIAGNOSTIC_ASSERT(
+      nsIClipboard::IsClipboardTypeSupported(aWhichClipboard));
+
+  if (!EnsureLibsLoaded()) {
+    return false;
+  }
+
+  for (const auto& flavor : aFlavorList) {
+    if (!flavor.EqualsLiteral(kTextMime)) {
+      continue;
+    }
+    OH_Pasteboard* pb = gLibs.create();
+    if (!pb) {
+      continue;
+    }
+    auto pbGuard = MakeScopeExit([pb] { gLibs.destroy(pb); });
+    if (gLibs.hasType(pb, kOHOSPlainTextType)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace widget
+}  // namespace mozilla
