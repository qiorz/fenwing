+// 握手,OHOS 无对应物 —— v243 方案路线①"失效+懒建自愈")。
+static std::atomic<bool> gEGLSurfaceInvalidated{false};
+
+// v243: RenderCompositorEGL::BeginFrame(Renderer 线程)调用,消费失效标志。
+// libxul 内部符号,无需 visibility 标记(同 DSO 链接)。
+extern "C" bool OHOS_ConsumeEGLSurfaceInvalidated() {
+  return gEGLSurfaceInvalidated.exchange(false, std::memory_order_relaxed);
+}
