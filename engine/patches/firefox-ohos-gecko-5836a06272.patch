+// 从 napi_value 读取 UTF-8 字符串到指定缓冲区
+// 返回值:true 成功;false 失败(缓冲区不足或类型不匹配)
+static bool NapiGetString(napi_env env, napi_value value, char* buf, size_t bufSize) {
+    size_t len = 0;
+    if (napi_get_value_string_utf8(env, value, nullptr, 0, &len) != napi_ok) return false;
+    if (len + 1 > bufSize) return false;
+    return napi_get_value_string_utf8(env, value, buf, bufSize, &len) == napi_ok;
+}
