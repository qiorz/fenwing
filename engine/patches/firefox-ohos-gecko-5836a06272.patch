+// IME 状态通知:由 nsWindow::SetInputContext 调用
+// 根据 Gecko IMEStateManager 的状态变化,显示/隐藏软键盘
+// aEnabled: true=显示软键盘, false=隐藏软键盘
+// aInputType: IME_TEXT_INPUT_TYPE_* 枚举值(供 geckoview.cpp 更新 TextConfig)
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_NotifyIMEState(bool aEnabled, int32_t aInputType) {
+  OHOS_DiagLog("[XRE] GeckoBridge_NotifyIMEState enabled=%d type=%d show=%p hide=%p",
+          (int)aEnabled, aInputType, (void*)gShowKeyboardFunc, (void*)gHideKeyboardFunc);
+  if (aEnabled && gShowKeyboardFunc) {
+    gShowKeyboardFunc();
+  } else if (!aEnabled && gHideKeyboardFunc) {
+    gHideKeyboardFunc();
+  }
+}
+
+typedef void (*OHOS_FullscreenNotifyFunc)(bool aFullScreen);
+static OHOS_FullscreenNotifyFunc gFullscreenNotify = nullptr;
+
+// 注册 ArkTS 窗口全屏回调。状态放在 libxul.so 单实例中,避免
+// libgeckoview/libgeckoxcomp 两份 geckoview.cpp 的全局变量彼此隔离。
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_SetFullscreenCallback(
+    OHOS_FullscreenNotifyFunc aCb) {
+  gFullscreenNotify = aCb;
+  OHOS_DiagLog("[XRE_FULLSCREEN] SetFullscreenCallback cb=%p", (void*)aCb);
+}
+
+// DOM Fullscreen → ArkTS 通知入口。由 nsWindow::MakeFullScreen 在 Gecko
+// 主线程调用;回调仅投递 nonblocking TSFN,不等待 ArkUI 窗口 API。
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_NotifyFullscreen(bool aFullScreen) {
+  OHOS_DiagLog("[XRE_FULLSCREEN] Notify state=%d cb=%p", (int)aFullScreen,
+               (void*)gFullscreenNotify);
+  if (gFullscreenNotify) {
+    gFullscreenNotify(aFullScreen);
+  }
+}
+
+// ============================================================================
+// 鼠标光标样式桥接 (v137: 网页 hover 元素时跟随变化光标)
+// ============================================================================
+// 根因:nsWindow::SetCursor 原为空 stub(误称"OHOS 无系统鼠标光标管理")。
+// EventStateManager::UpdateCursor 每次 mousemove 调 aWidget->SetCursor,
+// 经此桥接把映射后的 Input_PointerStyle 应用到主窗口。
+//
+// 双路径设计(v150:libohinput.so stub 判定后):
+//   真机实测:打包的 libohinput.so 与 SDK sysroot 同 MD5,readelf 显示
+//   OH_Input_SetPointerStyle 与 OH_Input_GetPointerStyle 同址 0x40a0、size=4,
+//   函数体仅返回首参(windowId),C-native OH_Input_SetPointerStyle 永不生效,
+//   且 Set 返回值恒等 windowId(被误读为 result,即"异常 101"线索之一)。
+//   设备 /system /vendor 亦无真实 libohinput.so。
+//
+//   因此实际生效路径改为 ArkTS pointer.setPointerStyleSync:
+//     nsWindow::SetCursor(去重) → OHOS_ApplyPointerStyle(本文件,libxul)
+//       → gPointerStyleNotify(函数指针,跨so) → geckoview.so OHOS_PointerStyleNotify
+//       → napi_threadsafe_function → ArkTS FirefoxBridge → pointer.setPointerStyleSync
+//   C-native OH_Input_* 仅作诊断保留(记录 stub 返回/回读,佐证 stub 判定)。
+//
+// windowId 来源:ArkTS EntryAbility 在 onWindowStageCreate 拿到主窗口 windowId
+// (>=0)后,经 geckoview.cpp SetMainWindowId napi → OHOS_SetMainWindowId 注入。
+//
+// 时序保证:窗口未就绪时(gMainWindowId<0)SetCursor 已会先到达,
+// OHOS_ApplyPointerStyle 把最新 style 缓存到 gLastStyle 并转发 ArkTS
+// (ArkTS 用自身存储的 windowId 兜底);待 OHOS_SetMainWindowId 注入有效
+// windowId 时,立即把缓存 style 回灌 ArkTS(并跑一次 C 诊断)。
+//
+// Pointer style ArkTS 回调函数指针(由 libgeckoview.so 经
+// GeckoBridge_SetPointerStyleCallback 注册到 libxul.so 单实例)。
+// 与 IME ArkTS 回调(GeckoBridge_SetIMEArkTSCallback)同款跨so模式:
+// libxul.so 单一份,无论哪个 .so 副本触发 OHOS_ApplyPointerStyle,
+// 都调用到 libgeckoview.so 注册的 tsfn → ArkTS。
+typedef void (*OHOS_PointerStyleFunc)(int32_t windowId, int32_t style);
+static OHOS_PointerStyleFunc gPointerStyleNotify = nullptr;
+
+// 注册 ArkTS 光标样式回调(由 libgeckoview.so 启动时调用一次)
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_SetPointerStyleCallback(OHOS_PointerStyleFunc aCb) {
+  gPointerStyleNotify = aCb;
+  OHOS_DiagLog("[XRE_CURSOR] GeckoBridge_SetPointerStyleCallback cb=%p", (void*)aCb);
+}
+
+__attribute__((visibility("default")))
+extern "C" void OHOS_SetMainWindowId(int32_t id) {
+  // 校验注入的 windowId:OH_Input_SetPointerStyle 头文件仅声明 >=0,
+  // pointer.setPointerStyleSync 亦要求有效窗口 id。ArkTS 侧
+  // win.getWindowProperties().id 必 >=0,此处 <0 视为无效,不覆盖已有 id、
+  // 不下发,直接返回(防御性,避免 -1 污染 gMainWindowId 触发异常路径)。
+  if (id < 0) {
+    OHOS_DiagLog("[XRE_CURSOR] OHOS_SetMainWindowId 忽略无效 id=%d(<0)", id);
+    return;
+  }
+  gMainWindowId.store(id, std::memory_order_relaxed);
+  int32_t style = gLastStyle.load(std::memory_order_relaxed);
+  OHOS_DiagLog("[XRE_CURSOR] OHOS_SetMainWindowId id=%d cached style=%d", id, style);
+
+  // windowId 就绪:立即把缓存样式回灌 ArkTS 实际生效路径。
+  if (gPointerStyleNotify) {
+    gPointerStyleNotify(id, style);
+  }
+
+  // C 诊断路径(保留以佐证 stub 判定):Set 后回读 OH_Input_GetPointerStyle。
+  // stub 预期:setRes == windowId(首参,非 INPUT_SUCCESS=0);
+  //            getRes 同样为 stub 返回(readStyle 保持哨兵 -1,stub 不写输出)。
+  Input_Result setRes = OH_Input_SetPointerStyle(id, style);
+  int32_t readStyle = -1;  // 哨兵:stub 不写入则保持 -1
+  Input_Result getRes = OH_Input_GetPointerStyle(id, &readStyle);
+  OHOS_DiagLog("[XRE_CURSOR] OHOS_SetMainWindowId C-diag set=%d get=%d readStyle=%d "
+           "(stub预期 set==wid=%d readStyle==-1)",
+           (int)setRes, (int)getRes, readStyle, id);
+}
+
+// 由 nsWindow::SetCursor 调用:把映射后的 Input_PointerStyle 应用到主窗口。
+// 样式去重已由 nsWindow::SetCursor(mLastPointerStyle)完成,此处收到的必为
+// 真正变化的 style,无需再去重。
+__attribute__((visibility("default")))
+extern "C" void OHOS_ApplyPointerStyle(int32_t style) {
+  gLastStyle.store(style, std::memory_order_relaxed);
+  int32_t wid = gMainWindowId.load(std::memory_order_relaxed);
+
+  // 实际生效路径:转发到 ArkTS pointer.setPointerStyleSync(经跨so回调 + TSFN)。
+  // 传入 wid(可能 -1);ArkTS 侧若见 -1 会用其存储的 mainWindowId 兜底。
+  if (gPointerStyleNotify) {
+    gPointerStyleNotify(wid, style);
+  }
+
+  if (wid < 0) {
+    // windowId 未就绪:绝不调用 OH_Input_SetPointerStyle(-1)。
+    // 头文件 Set 仅声明 >=0;真机 stub 下 -1 直接被当作返回值(异常 101 路径),
+    // 且无实际意义。ArkTS 回调已带 wid,由 ArkTS 兜底,故此处仅记日志后返回。
+    OHOS_DiagLog("[XRE_CURSOR] OHOS_ApplyPointerStyle style=%d wid=%d(<0 跳过C-Set,已转ArkTS)",
+             style, wid);
+    return;
+  }
+
+  // C 诊断路径(保留):记录 stub 返回值与回读,帮助判定异常 101 / stub 行为。
+  Input_Result setRes = OH_Input_SetPointerStyle(wid, style);
+  int32_t readStyle = -1;  // 哨兵:stub 不写入则保持 -1
+  Input_Result getRes = OH_Input_GetPointerStyle(wid, &readStyle);
+  OHOS_DiagLog("[XRE_CURSOR] OHOS_ApplyPointerStyle style=%d wid=%d set=%d get=%d readStyle=%d",
+           style, wid, (int)setRes, (int)getRes, readStyle);
+}
diff --git a/widget/openharmony/OHOSPerfHint.cpp b/widget/openharmony/OHOSPerfHint.cpp
new file mode 100644
index 0000000000..bac0870f07
--- /dev/null
+++ b/widget/openharmony/OHOSPerfHint.cpp
@@ -0,0 +1,194 @@
+/* -*- Mode: C++; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*- */
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// ============================================================================
+// v228: perfHint 场景上报(鸿蒙 FAST Kit SchedulingOptimization,C 接口)。
+//
+// 依据官方文档《使用perfHint系统性能优化(C/C++)》(API 26 起可用):
+// 应用向系统上报性能场景(启动/页面加载/页面绘制/动效…),系统调度器
+// 据此在 CPU 负载/温度允许时优化应用性能(提频/大核倾向)。OhosWeb 是
+// 自绘 XComponent 引擎,系统无法从 ArkUI 视角感知"页面加载中/连续绘制中"
+// ——这些场景信号此前完全缺失(HM 大小核调度只看线程 QoS,见 v222 实测)。
+//
+// 集成方式(手册铁律 1:桥不链接预编译库,一律 dlopen+dlsym):
+//   - dlopen("libscheduling_optimization.z.so") 探测,API<26 设备无此库
+//     → 一次性记日志后静默降级,全部调用变 no-op,零功能影响。
+//   - 枚举值按官方 scheduling_optimization.h 数值内联定义(不 include
+//     HMS 头——Gecko 构建用 OpenHarmony SDK sysroot,HMS 头不在路径)。
+//   - 不带 tids:官方文档约束"通过线程ID提升QoS优先级时避免与QoS API
+//     混用",v214 起已给 8 个 Gecko 关键线程打 QoS,故只报场景不带线程。
+//   - 场景上报 fire-and-forget:官方明示"不保证每次调用都有提升",
+//     失败/限流只打日志不影响主流程。
+//
+// 场景布点(全部 libxul 内,无跨 .so 符号问题):
+//   APP_LAUNCH(MEDIUM): xpcom/build/XPCOMInit.cpp XPCOM_Init 早期 BEGIN
+//     → gfx/webrender_bindings/RenderCompositorEGL.cpp 首次 EndFrame END。
+//     覆盖 XPCOM/JS/omni/chrome 初始化+首帧渲染(ArkTS 壳段不在此窗口,
+//     该段由系统 AppStartup 机制覆盖,libxul 无法触达)。
+//   PAGE_LOAD(MEDIUM): docshell/base/nsDocShell.cpp OnStateChange
+//     STATE_TRANSFERRING BEGIN → EndPageLoad END。多标签并发时 BEGIN/END
+//     可能交错(某次 END 迟到/早退),场景语义是建议非精确计数,可接受。
+//   PAGE_DRAWING(MEDIUM): RenderCompositorEGL EndFrame 连续呈现检测
+//     (相邻呈现间隔 <=200ms 视为绘制窗口开始;窗口悬挂的 END 由下一次
+//     活动时补发——静止期 EndFrame 不被调用,无法即时检测静止)。
+//
+// 线程模型:EnsureInit 由 std::call_once 保护;SendHint 纯本线程调用
+// (主线程/RenderThread),builder 生命周期单次调用内闭合,无线程共享态。
+// ============================================================================
+
+#include <dlfcn.h>
+#include <stdio.h>
+
+#include <atomic>
+#include <mutex>
+
+#include "mozilla/Types.h"
+
+// ---- 场景/状态/时长常量(数值与 HMS scheduling_optimization.h 一致) ----
+// SceneType
+#define OHOS_PH_APP_LAUNCH 1
+#define OHOS_PH_PAGE_TRANSITION 2
+#define OHOS_PH_PAGE_LOAD 3
+#define OHOS_PH_PAGE_DRAWING 6
+// SceneState
+#define OHOS_PH_END 0
+#define OHOS_PH_BEGIN 1
+// DurationType:SHORT 单次<=1s 间隔>3s;MEDIUM <=10s 间隔>30s;LONG <=60s
+#define OHOS_PH_SHORT 1
+#define OHOS_PH_MEDIUM 2
+#define OHOS_PH_LONG 3
+
+// ---- dlsym 惰性绑定 ----
+typedef struct HMS_FAST_PerfHintConfigBuilder HMS_FAST_PerfHintConfigBuilder;
+typedef struct HMS_FAST_PerfHintConfig HMS_FAST_PerfHintConfig;
+// 错误码 0 = SUCCESS(与文档一致;仅用于日志,不分支)
+typedef int HMS_FAST_SchedulingOptimization_ErrorCode;
+typedef HMS_FAST_SchedulingOptimization_ErrorCode (*PH_VoidPP)(
+    HMS_FAST_PerfHintConfigBuilder**);
+typedef HMS_FAST_SchedulingOptimization_ErrorCode (*PH_SetInt)(
+    HMS_FAST_PerfHintConfigBuilder*, int);
+typedef HMS_FAST_SchedulingOptimization_ErrorCode (*PH_Build)(
+    HMS_FAST_PerfHintConfigBuilder*, HMS_FAST_PerfHintConfig**);
+typedef void (*PH_DestroyConfig)(HMS_FAST_PerfHintConfig*);
+typedef void (*PH_DestroyBuilder)(HMS_FAST_PerfHintConfigBuilder*);
+typedef HMS_FAST_SchedulingOptimization_ErrorCode (*PH_PerfHint)(
+    const HMS_FAST_PerfHintConfig*);
+
+namespace {
+struct PerfHintApi {
+  PH_VoidPP mCreate = nullptr;
+  PH_SetInt mSetSceneType = nullptr;
+  PH_SetInt mSetSceneState = nullptr;
+  PH_SetInt mSetDurationType = nullptr;
+  PH_Build mBuild = nullptr;
+  PH_DestroyConfig mDestroyConfig = nullptr;
+  PH_DestroyBuilder mDestroyBuilder = nullptr;
+  PH_PerfHint mPerfHint = nullptr;
+};
+
+PerfHintApi gApi;
+std::once_flag gInitOnce;
+// 探测结论:0=未探测 1=可用 2=不可用(降级)。日志侧读,SendHint 不再查。
+std::atomic<int> gAvailable{0};
+
+// libxul 内部日志汇点(同 OHOSNativeWindowBridge.cpp 定义,文件作用域声明,
+// 连续踩 4 次的 SOP:跨文件符号声明一律放文件作用域,不得 block-scope)。
+extern "C" void OHOS_DiagLog(const char* aFmt, ...);
+
+void PerfHintInit() {
+  void* lib = dlopen("libscheduling_optimization.z.so", RTLD_NOW | RTLD_LOCAL);
+  if (!lib) {
+    gAvailable.store(2);
+    // 设备 API<26 无此库属正常形态(如旧系统),日志留痕一次即可。
+    OHOS_DiagLog("[PERFHINT] 库不可用,场景上报降级 no-op: %s",
+                 dlerror() ? dlerror() : "dlopen failed");
+    return;
+  }
+  gApi.mCreate = (PH_VoidPP)dlsym(lib, "HMS_FAST_PerfHintConfigBuilder_Create");
+  gApi.mSetSceneType =
+      (PH_SetInt)dlsym(lib, "HMS_FAST_PerfHintConfigBuilder_SetSceneType");
+  gApi.mSetSceneState =
+      (PH_SetInt)dlsym(lib, "HMS_FAST_PerfHintConfigBuilder_SetSceneState");
+  gApi.mSetDurationType =
+      (PH_SetInt)dlsym(lib, "HMS_FAST_PerfHintConfigBuilder_SetDurationType");
+  gApi.mBuild = (PH_Build)dlsym(lib, "HMS_FAST_PerfHintConfigBuilder_Build");
+  gApi.mDestroyConfig =
+      (PH_DestroyConfig)dlsym(lib, "HMS_FAST_PerfHintConfig_Destroy");
+  gApi.mDestroyBuilder = (PH_DestroyBuilder)dlsym(
+      lib, "HMS_FAST_PerfHintConfigBuilder_Destroy");
+  gApi.mPerfHint =
+      (PH_PerfHint)dlsym(lib, "HMS_FAST_SchedulingOptimization_PerfHint");
+  if (!gApi.mCreate || !gApi.mSetSceneType || !gApi.mSetSceneState ||
+      !gApi.mSetDurationType || !gApi.mBuild || !gApi.mDestroyConfig ||
+      !gApi.mDestroyBuilder || !gApi.mPerfHint) {
+    gApi = PerfHintApi{};  // 部分符号缺失视为整体不可用,防半初始化
+    gAvailable.store(2);
+    OHOS_DiagLog("[PERFHINT] 符号绑定不全,场景上报降级 no-op");
+    return;
+  }
+  gAvailable.store(1);
+  OHOS_DiagLog("[PERFHINT] 绑定成功,场景上报启用(scene API26+)");
+}
+
+void SendHint(int aScene, int aState, int aDuration) {
+  std::call_once(gInitOnce, PerfHintInit);
+  if (gAvailable.load() != 1) {
+    return;
+  }
+  // v228c: BEGIN 本地节流。真机定性(err=1027700005=INTERVAL):系统对同
+  // 场景两次 BEGIN 的间隔按 DurationType 限流(MEDIUM 要求 >30s),而页面
+  // 加载/绘制场景 BEGIN 天然高频(主文档+每 iframe 各一次、滚动窗口反复
+  // 开合)——不节流时几乎全部被系统拒。本地按 scene 记录上次 BEGIN 时刻,
+  // 31s(30s 契约+1s 裕量)内的 BEGIN 直接跳过;END 不节流(关闭语义,系统
+  // 全收,实测 state=0 全部 sent)。scene=1 冷启首呼不受影响(距上次进程
+  // 会话必然 >31s 或首启无记录)。
+  static std::atomic<long long> sLastBeginNs[16];  // 静态零初始化=0
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  const long long nowNs = (long long)ts.tv_sec * 1000000000ll + ts.tv_nsec;
+  if (aState == OHOS_PH_BEGIN && aScene >= 0 && aScene < 16) {
+    const long long last = sLastBeginNs[aScene].load();
+    if (last > 0 && nowNs - last < 31000000000ll) {
+      return;  // 系统必拒(INTERVAL),不发无效调用
+    }
+    sLastBeginNs[aScene].store(nowNs);
+  }
+  HMS_FAST_PerfHintConfigBuilder* builder = nullptr;
+  HMS_FAST_PerfHintConfig* config = nullptr;
+  int err = 0;
+  bool ok = false;
+  do {
+    if ((err = gApi.mCreate(&builder)) != 0 || !builder) break;
+    if ((err = gApi.mSetSceneType(builder, aScene)) != 0) break;
+    if ((err = gApi.mSetSceneState(builder, aState)) != 0) break;
+    if ((err = gApi.mSetDurationType(builder, aDuration)) != 0) break;
+    if ((err = gApi.mBuild(builder, &config)) != 0 || !config) break;
+    // 官方约束:提示仅为建议,系统综合考量后决定;失败不影响功能。
+    err = gApi.mPerfHint(config);
+    ok = (err == 0);
+  } while (false);
+  if (config) gApi.mDestroyConfig(config);
+  if (builder) gApi.mDestroyBuilder(builder);
+  // 采样日志:成功只记前 8 次(确认通道活着),失败全记且带错误码(诊断)。
+  static std::atomic<uint32_t> sOkLogs{0};
+  static std::atomic<uint32_t> sFailLogs{0};
+  if (!ok) {
+    if (err != 1027700005 /*INTERVAL:本地节流后仍偶发(跨 scene 维度差异
+                             或系统侧时钟窗),降为计数不打全行*/) {
+      OHOS_DiagLog("[PERFHINT] scene=%d state=%d dur=%d err=%d(%s)", aScene,
+                   aState, aDuration, err,
+                   sFailLogs.fetch_add(1) < 24 ? "rejected" : "quiet");
+    }
+  } else if (sOkLogs.fetch_add(1) < 8) {
+    OHOS_DiagLog("[PERFHINT] scene=%d state=%d dur=%d sent", aScene, aState,
+                 aDuration);
+  }
+}
+}  // namespace
+
+// libxul 内部接口(文件作用域 extern "C" 声明后调用,勿导出)。
+extern "C" void OHOS_PerfHintScene(int aScene, int aState, int aDuration) {
+  SendHint(aScene, aState, aDuration);
+}
diff --git a/widget/openharmony/OHOSPrintBridge.cpp b/widget/openharmony/OHOSPrintBridge.cpp
new file mode 100644
index 0000000000..048f59aaab
--- /dev/null
+++ b/widget/openharmony/OHOSPrintBridge.cpp
@@ -0,0 +1,57 @@
+/* -*- Mode: C++; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// P1: 打印跨 .so 桥实现(libxul.so 导出端)
+//
+// 一个导出符号(visibility("default"),libxul.symbols 中登记):
+//   GeckoBridge_SetPrintCallback   libgeckoview.so → libxul.so(注册回调)
+// 内部转发函数:
+//   OHOSPrintBridge_Notify         libxul.so 内部(nsDeviceContextSpecOHOS)→ gPrintCb
+//
+// 与 OHOSRevealBridge 结构一致:同为单向 fire-and-forget,未注册时不兜底,
+// 仅记日志后返回。临时 PDF 文件由 nsDeviceContextSpecOHOS 析构安全网兜底删除,
+// 故桥缺失不会泄露临时文件。
+
+#include "OHOSPrintBridge.h"
+
+#include "OHOSDebug.h"  // OHOS_LOG / OHOS_DiagLog
+
+namespace mozilla {
+namespace widget {
+
+// 打印回调函数指针(由 libgeckoview.so 通过 GeckoBridge_SetPrintCallback 注册)
+// 签名:(临时 PDF 文件绝对路径)。libgeckoview.so 内部再 tsfn 投递到
+// ArkTS registerPrintCallback。
+// set-once-before-use:libgeckoview.so 在 GeckoMainThread 启动早期注册,
+// nsDeviceContextSpecOHOS::DoEndDocument 仅在用户触发打印时调用,时序安全。
+static void (*gPrintCb)(const char* aPath) = nullptr;
+
+// libxul.so 内部入口:由 nsDeviceContextSpecOHOS::DoEndDocument 调用,
+// 转发临时 PDF 路径到 libgeckoview.so。
+void OHOSPrintBridge_Notify(const char* aPath) {
+  if (!gPrintCb) {
+    // 桥未注册(ArkTS 层尚未 initFirefox 或 libgeckoview.so 未注册回调)。
+    // 打印是 fire-and-forget,直接返回即可;临时 PDF 文件由
+    // nsDeviceContextSpecOHOS 析构安全网兜底删除。
+    OHOS_LOG("[Print] 回调桥未注册,丢弃打印 PDF 路径: %s\n",
+             aPath ? aPath : "(null)");
+    return;
+  }
+  gPrintCb(aPath);
+}
+
+}  // namespace widget
+}  // namespace mozilla
+
+// ============================================================================
+// 导出符号(visibility default,在 libxul.symbols 登记,供 libgeckoview.so 调用)
+// ============================================================================
+
+// libgeckoview.so 启动时调:RegisterPrintCallback 等价物,登记回调函数指针
+__attribute__((visibility("default")))
+extern "C" void GeckoBridge_SetPrintCallback(void (*cb)(const char* aPath)) {
+  mozilla::widget::gPrintCb = cb;
+  OHOS_LOG("[Print] GeckoBridge_SetPrintCallback 已注册 cb=%p\n", (void*)cb);
+}
