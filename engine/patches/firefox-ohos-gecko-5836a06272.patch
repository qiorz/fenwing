+
+void gfxOHosPlatform::GetCommonFallbackFonts(
+    uint32_t aCh, Script aRunScript, FontPresentation aPresentation,
+    nsTArray<const char*>& aFontList) {
+  // stage1:fallback 字体清单。OpenHarmony 系统通常预装 Noto 系列,
+  // 这里提供一个保守的 CJK + Emoji fallback,stage2 可对接 OHOS 字体服务细化。
+  static const char kNotoSansCJK[] = "Noto Sans CJK SC";
+  static const char kNotoColorEmoji[] = "Noto Color Emoji";
+
+  if (PrefersColor(aPresentation)) {
+    aFontList.AppendElement(kNotoColorEmoji);
+  }
+
+  // 对 BMP 之外或常见 CJK 区段给出 Noto Sans CJK 作为兜底。
+  aFontList.AppendElement(kNotoSansCJK);
+}
