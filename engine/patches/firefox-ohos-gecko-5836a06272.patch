+// 向 Gecko 插入文本(v64:由 ArkTS 层 TextInput onChange 调用)
+// 参数:text: string
+// 将用户输入的文本通过 GeckoBridge_InsertText 传递到 Gecko 主线程,
+// 由 nsWindow::OnInsertText → WidgetContentCommandEvent 插入到当前焦点文本框。
+napi_value InsertText(napi_env env, napi_callback_info info) {
+    size_t argc = 1;
+    napi_value args[1];
+    napi_value thisArg;
+    napi_get_cb_info(env, info, &argc, args, &thisArg, nullptr);
+    if (argc < 1) {
+        OH_LOG_ERROR(LOG_APP, "InsertText 参数缺失");
+        napi_throw_type_error(env, nullptr, "参数缺失,期望 text 字符串");
+        return nullptr;
+    }
+
+    // v64 修复:直接使用 napi_get_value_string_utf16 获取 UTF-16 字符串,
+    // 避免 UTF-8 → UTF-16 手动转换的 bug(之前转换代码导致字符乱码)
+    //
+    // v64 修复2(use-after-free):必须用 new[] 分配缓冲,不能用 std::u16string::c_str()。
+    // 原因:GeckoBridge_InsertText 将指针传给 OHOSInsertTextRunnable,延迟到 Gecko
+    // 主线程执行。若用 std::u16string,函数返回时其内部缓冲被释放,Runnable 执行时
+    // 访问已释放内存导致乱码。new[] 缓冲所有权转移给 Runnable,Run() 中 delete[] 释放。
+    size_t length16 = 0;
+    napi_get_value_string_utf16(env, args[0], nullptr, 0, &length16);
+    char16_t* buf = new char16_t[length16 + 1];
+    napi_get_value_string_utf16(env, args[0], buf, length16 + 1, &length16);
+
+    // 日志:在传递前输出(传递后 buf 所有权转移,不可再访问)
+    std::string textAscii;
+    for (size_t i = 0; i < length16; i++) {
+        if (buf[i] < 0x80) {
+            textAscii.push_back((char)buf[i]);
+        } else {
+            textAscii.push_back('?');
+        }
+    }
+    OH_LOG_INFO(LOG_APP, "[IME] InsertText '%{public}s' → GeckoBridge_InsertText (len=%{public}zu)",
+                textAscii.c_str(), length16);
+    printf("[IME] InsertText '%s' → GeckoBridge_InsertText (len=%zu)\n",
+           textAscii.c_str(), length16); fflush(stdout);
+
+    // 传递 new[] 缓冲,所有权转移给 GeckoBridge_InsertText → OHOSInsertTextRunnable
+    GeckoBridge_InsertText(buf, length16);
+
+    napi_value result;
+    napi_get_null(env, &result);
+    return result;
+}
