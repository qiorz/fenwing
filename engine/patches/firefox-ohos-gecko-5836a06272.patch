+    # DIST_SUBDIR="browser" 与 browser/app 的 GeckoProgram 已用 MOZ_WIDGET_TOOLKIT
+    # 守护跳过(OHOS 不需要 ELF 与 browser 子目录),不会破坏 chrome 注册路径。
+    # browser/app 的递归进入由 browser/moz.build 的 DIRS 中 "app" 项同样守护。
+    "/browser",
+]
